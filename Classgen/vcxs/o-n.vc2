	#INCLUDE "..\..\bsinfo\progs\const.h"
	*<DefinedPropArrayMethod>
		*m: activabotones		&& Activa botones de control del grid
		*m: activar_botones		&& Activa los botones de edicion segun el grid en el que se esta posicionado
		*m: agrega_item_grid
		*m: borra_detalle		&& Borra item de la tabla remota
		*m: borra_item_blanco_grid
		*m: borra_item_grid
		*m: carga_grid
		*m: chrtoarray		&& Convierte cadena separada por un caracter  especifico en un vector (arreglo )
		*m: concatenavalores		&& Genera una cadena con los valores de los campos que conforman la clave
		*m: graba_cmps_key		&& Graba  campos de la clave
		*m: graba_datos_adic		&& Graba datos adicionales en el registro activo del grid
		*m: graba_detalle
		*m: graba_detalle_adicional		&& Graba datos adicionales provenientes del cursor a otras tablas distinta al origen de datos del grid
		*m: graba_item_grid
		*m: habilita_grid
		*m: init_grids		&& Inicializa grids
		*m: modifica_item_grid
		*m: refrescar		&& Actualiza el contenido de los grids
		*m: validitem		&& Valida los componentes de la clave del item que se esta editando
		*m: vincular_controles
		*p: ccampo_id1
		*p: ccampo_id2
		*p: ccampo_id3
		*p: ccampo_id4
		*p: ccmpfk1		&& Campos de la clave foranea
		*p: ccmpfk2		&& Campos de la clave foranea
		*p: ccmpfk3		&& Campos de la clave foranea
		*p: ccmpfk4		&& Campos de la clave foranea
		*p: ccmpkey1		&& Campos de la Clave
		*p: ccmpkey2
		*p: ccmpkey3
		*p: ccmpkey4
		*p: ccmpkgen		&& Campos que conforman la llave general que sirve para cargar el grid principal
		*p: ccmps_id1
		*p: ccmps_id2
		*p: ccmps_id3
		*p: ccmps_id4
		*p: ccursor1
		*p: ccursor2
		*p: ccursor3
		*p: ccursor4
		*p: ctabla_det1
		*p: ctabla_det2
		*p: ctabla_det3
		*p: ctabla_det4
		*p: cvalfk1		&& Valor de llave foranea
		*p: cvalfk2		&& Valor de llave foranea
		*p: cvalfk3		&& Valor de llave foranea
		*p: cvalfk4		&& Valor de llave foranea
		*p: cvalkey1		&& Valor de la clave
		*p: cvalkey2
		*p: cvalkey3
		*p: cvalkey4
		*p: cvalkgen		&& Valor de la llave general que sirve para cargar el grid principal
		*p: cvalor_id1
		*p: cvalor_id2
		*p: cvalor_id3
		*p: cvalor_id4
		*p: flagedicion
		*p: lctipope
		*p: lsetfocus		&& Obtener el foco
		*p: nbtnadi_left_ini		&& Posicion inicial del valor de LEFT del boton adicionar
		*p: nbtnadi_top_ini		&& Posicion inicial del valor TOP de el boton adicionar
		*p: nbtncan_top_ini
		*p: nbtneli_top_ini
		*p: nbtngrb_top_ini
		*p: nbtnmod_top_ini
		*p: ntipoenlace		&& Tipo de enlace entre los grid :          1  Cascada , relación  uno a  muchos entre los grids.                    2  Una sola clave ,  todos los grids dependen de una sola clave (cvalkgen)
		*p: ntipo_cnt		&& Tipo de contenedor:   1 depende de cursor   2  Depende de la cabecera
		*p: ogridactivo		&& Referencia a grid activo
	*</DefinedPropArrayMethod>

