DEFINE CLASS base_cmdhelp AS base_command OF "admvrs.vcx" 
 	*< CLASSDATA: Baseclass="commandbutton" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: ccamposfiltro_assign
		*m: chrtoarray
		*m: cnombreentidad_assign
		*m: configurarparametros
		*m: cvaloresfiltro_assign
		*m: cwheresql_assign
		*m: generarsecuenciacampos		&& Convierte los codigo de la secuencia de atributos a nombres de campos validos para la sentencia SQL
		*m: generarsql		&& Genera cadena de sentencia SQL
		*m: generarwhere		&& Genera cadena de sentencia WHERE
		*m: validardato		&& Este metodo se encarga de validar el dato ingresado en un control text o una cualquier otro control
		*m: validarparametros
		*p: caliascursor
		*p: ccamporetorno
		*p: ccamposfiltro		&& Cadena que contiene los campos de Filtro
		*p: ccampovisualizacion
		*p: cmodoobtenerdatos		&& Indica si permite seleccionar multiples valores, un solo valor o un rango de valores
		*p: cnombreentidad
		*p: cremotepathentidad
		*p: csecuenciaatributos		&& Contiene la secuencia de codigos de los atributos
		*p: csql		&& Contiene la sentencia SQL generada por la clase
		*p: ctituloayuda
		*p: cvalordescripcion		&& Retorna la descripcion del registro escogido
		*p: cvaloresfiltro
		*p: cvalorvalida
		*p: cwhere		&& Contiene la sentencia WHERE generada por la clase
		*p: cwheresql		&& Se ingresa sentencia para la Clausua WHERE en lenguaje SQL (incluir operador AND,OR)
		*p: lflagbusqueda		&& Indica que tipo de Formulario se mostrará para la ayuda, con criterios o sin criterios
		*p: lvalidadato		&& Especifica si deja pasar valores en Blanco en un control Texto asociado al boton ayuda
		*a: acamposfiltro[1,1]
		*a: avaloresfiltro[1,1]
	*</DefinedPropArrayMethod>

	*<PropValue>
		caliascursor = (SYS(2015))
		Caption = ""
		ccamporetorno = ("")
		ccamposfiltro = ("")
		ccampovisualizacion = ("")
		cmodoobtenerdatos = V
		cnombreentidad = ("")
		cremotepathentidad = ("")
		csecuenciaatributos = ("")
		csql = ("")
		ctituloayuda = Ayuda de Códigos
		cvalordescripcion = ("")
		cvaloresfiltro = ("")
		cvalorvalida = ("")
		cwhere = ("")
		cwheresql = ("")
		Height = 24
		Name = "base_cmdhelp"
		Picture = ..\..\grafgen\iconos\help_dots.bmp
		Width = 24
	*</PropValue>
	
	HIDDEN PROCEDURE ccamposfiltro_assign
		LPARAMETERS vNewVal
		*To do: Modify this routine for the Assign method
		THIS.CCAMPOSFILTRO = m.vNewVal
		
	ENDPROC

	PROCEDURE chrtoarray
	ENDPROC

	PROCEDURE cnombreentidad_assign
		LPARAMETERS vNewVal
		*To do: Modify this routine for the Assign method
		THIS.CNOMBREENTIDAD = m.vNewVal
		
	ENDPROC

	PROCEDURE configurarparametros
	ENDPROC

	HIDDEN PROCEDURE cvaloresfiltro_assign
		LPARAMETERS tcValoresFiltro
		
		tcValoresFiltro	= IIF( VARTYPE(tcValoresFiltro)<>"C" , "" , ALLTRIM(tcValoresFiltro) )
		THIS.cValoresFiltro	= tcValoresFiltro
		
		DIMENSION aCampos[1]
		IF !EMPTY( THIS.cValoresFiltro )
			THIS.ChrToArray( THIS.cValoresFiltro, ";" , @aCampos )
			=ACOPY(aCampos, THIS.aValoresFiltro )
		ENDIF
		RETURN .T.
		
		
	ENDPROC

	HIDDEN PROCEDURE cwheresql_assign
		LPARAMETERS vNewVal
		*To do: Modify this routine for the Assign method
		THIS.CWHERESQL = m.vNewVal
		
	ENDPROC

	PROCEDURE generarsecuenciacampos		&& Convierte los codigo de la secuencia de atributos a nombres de campos validos para la sentencia SQL
	ENDPROC

	PROCEDURE generarsql		&& Genera cadena de sentencia SQL
	ENDPROC

	PROCEDURE generarwhere		&& Genera cadena de sentencia WHERE
	ENDPROC

	PROCEDURE validardato		&& Este metodo se encarga de validar el dato ingresado en un control text o una cualquier otro control
	ENDPROC

	PROCEDURE validarparametros
	ENDPROC

ENDDEFINE

