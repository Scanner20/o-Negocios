DEFINE CLASS base_form AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="tools" UniqueID="" Timestamp="" />

	#INCLUDE "..\..\bsinfo\progs\const.h"
	*<DefinedPropArrayMethod>
		*m: cargar_cursor
		*m: cargar_cursor_detalle
		*m: envia
		*m: generarlog
		*m: lcargado_access
		*m: lcargado_assign
		*m: mensajeerr		&& Muestra el error segun tabla de errores
		*m: recalculo		&& Realiza operaciones para almacenar totales y otros calculos en general
		*m: setdatasource		&& Aqui direccionamos las tablas que se usan como origen de datos para el la cabecera y el detalle de la transacción
		*m: tabla
		*m: validcliente		&& Valida el cliente
		*m: validitem
		*m: validnroref		&& Valida documento de referencia
		*p: ccampo_id		&& Campo que define el valor unico de la llave principal debe estar contenido en cCmpKey
		*p: ccmdinssql_tr
		*p: ccmdsqldel_tr
		*p: ccmdsql_cl		&& Comando sql a ejecutar para generar el cursor local
		*p: ccmdupdsql_tr
		*p: ccmpkey		&& contiene los campos contatenados de la clave de la tabla remota (cTabla_remota)
		*p: ccmps_id		&& Campos utilizados para calcular el el campo correlativo que debe estar incluido en ccmpkey
		*p: ccursor_local		&& Cursor local para seleccion de datos
		*p: codigoformulario		&& Codigo del Formulario actual
		*p: corder_cl		&& Orden del cursor local
		*p: corder_tr		&& Orden de la tabla remota
		*p: ctabla_remota		&& Tabla de donde se extraen los registros del cursor local
		*p: ctag_tr		&& Indice de la tabla remota
		*p: ctipoacceso		&& Tipo de acceso que tiene el cliente, Consulta, Modificación, Inserción, Todo.
		*p: cvalkey		&& valor de los campos clave de la  tabla remota
		*p: cvalor_id		&& Valor del correlativo contenido dentro de los valores de cvalkey
		*p: cwheresql		&& Condicion de filtro para generar el cursor local
		*p: c_validitem		&& Cursor que contiene los datos validados del item
		*p: lcargado		&& Indica si el formulario ya fue cargado o no, esta propiedad la actualiza en el evento INIT
		*p: lctipope		&& Controla actualización del detalle
		*p: lgrabado		&& Indica si el  registro editado ya fue grabado en la base de datos.
		*p: lignora_id_correlativo		&& Ingnora el  correlativo generado automaticamente , para que sea ingresado por el usuario.
		*p: lload		&& Indica si el formulario fue o no cargado, ver LCARGADO
		*p: lnavegando		&& Estado de navegacion, Viendo los datos (Solo navegando)  o modificando ( Update, Insert o Delete)
		*p: lnuevo		&& Indica que si el registro que se esta editando es nuevo o ya existia en la tabla
		*p: nombreobjref		&& Nombre del objeto de negocios que se  va a vincular al formulario
		*p: nombreobjrefdata		&& Nombre del objeto de datos que se va a vincular al formulario
		*p: nomobjcntcab
		*p: nomobjcntpage
		*p: nomobjcnt_ref		&& Nombre de contenedor de documentos de referencia
		*p: nresulttrn		&& Resultado de la transaccion
		*p: objcntcab		&& Objeto contenedor para controles de la cabecera
		*p: objcntpage		&& Objeto contenedor de los controles de la pagina principal del formulario
		*p: objcntref		&& Objeto contenedor de documentos de referencia
		*p: objreftran		&& Propiedad utilizada para referenciar un objeto que controle las transacciones
		*p: objreftrandata		&& Propiedad que referencia a un objeto que contiene los datos de la transacción
		*p: ocnx_odbc		&& Controla la conexion ODBC
		*p: sqlentorno		&& Propiedad usada para determinar si estamos en ambiente Cliente/Servidor o de tablas libres
		*p: xreturn		&& Valor de retorno del formulario
		*a: arutalog[1,0]
		*a: aruta_tablas[1,0]		&& Arreglo que contiene las rutas de las tablas que se usarán en el formulario
	*</DefinedPropArrayMethod>

	HIDDEN arutalog,lload
	*<PropValue>
		AutoCenter = .T.
		BackColor = 223,223,223
		BufferMode = 2
		Caption = "Caption"
		ccmdinssql_tr = ([])
