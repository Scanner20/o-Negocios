		*< END OBJECT: ClassLib="fpadmvrs.vcx" BaseClass="label" />

	ADD OBJECT 'CboCodDoc' AS base_cbohelp WITH ;
		BackColor = 230,255,255, ;
		caliascursor = c_coddoc, ;
		ccamporetorno = coddoc, ;
		ccamposfiltro = , ;
