				.TxtCodMat.InputMask = REPLICATE('X',GnLenDiv)+'-'+REPLICATE('X',GaLencod(3)-GnLenDiv)
				.TxtPreuni.VISIBLE = .f.
				.TxtImpCto.VISIBLE = .f.
				.LblPreuni.VISIBLE = .f.
