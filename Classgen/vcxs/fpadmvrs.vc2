				.LblSubTot.VISIBLE	= .f.
				.LblIgv.VISIBLE		= .f.
				.LblTotal.VISIBLE	= .f.
				.LblPorDto.ViSible  = .F.
				.LblImpDto.Visible	= .F.
				.LblImpInt.Visible	= .f.
				.LblImpFlt.Visible	= .F.
				.LblImpSeg.Visible	= .f.
				.LblImpAdm.Visible	= .F.
		
				**
				.cmdadicionar1.ENABLED	= .F.
				.cmdModificar1.ENABLED	= .F.
