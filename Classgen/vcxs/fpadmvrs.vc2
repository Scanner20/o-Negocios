DEFINE CLASS base_pageframe AS pageframe 
 	*< CLASSDATA: Baseclass="pageframe" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<PropValue>
		ErasePage = .T.
		Height = 169
		Name = "base_pageframe"
		PageCount = 2
		Width = 253
		Page1.Caption = "Page1"
		Page1.Name = "Page1"
		Page2.Caption = "Page2"
		Page2.Name = "Page2"
	*</PropValue>
	
	PROCEDURE Init
		*!*	-------------------------------------------------------------------------------
		*!*	Titulo			:
		*!*	Propósito		:	Configurar el PageFrame de acuerdo al Estandar
		*!*
		*!*	PARÁMETROS		:	<Ninguno>
		*!*	Valor de retorno:	<Ninguno>
		*!*	LLAMADAS		:	<Ninguno>
		*!*	CLASES HEREDADAS
		*!*	Comentarios 	:
		*!*
		*!*	CREACIÓN
		*!*		Fecha  		:	29-Oct-1999
		*!*		Autor		:	Giuliano Gonzales Zeballos
		*!*		Comentario	:
		*!*
		*!*	ULTIMA MODIFICACIÓN
		*!*		Fecha		:
		*!*		Autor		:
		*!*		Comentario	:
		*!*	-------------------------------------------------------------------------------
		LOCAL m.lnCount1
		
		*!*	Recorrer todos las Páginas del PageFrame
		FOR m.lnCount1 = 1 TO THIS.PAGECOUNT
			WITH THIS.PAGES(m.lnCount1)
				.FONTSIZE	= 9
				.FORECOLOR	= RGB(255,0,0)		&& Rojo Oscuro
				.BACKCOLOR	= RGB(223,223,223)	&& Gris Claro
			ENDWITH
		ENDFOR
		*THIS.CLICK()
		THIS.PAGES(1).FONTBOLD	= .T.
	ENDPROC

	PROCEDURE Refresh
			LOCAL m.lnCount1
		*	Recorrer todos las Páginas del PageFrame
			FOR m.lnCount1 = 1 TO THIS.PAGECOUNT
				THIS.PAGES(m.lnCount1).FONTBOLD	= m.lnCount1 == THIS.ACTIVEPAGE
			ENDFOR
	ENDPROC

ENDDEFINE

