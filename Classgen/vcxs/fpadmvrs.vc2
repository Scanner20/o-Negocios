		WITH THISFORM
			.desvincular_controles
			this.objcntcab.iniciar_var()
		    *this.objcntcab.Limpiar_var()
		    
			this.objcntpage.iniciar_var()
		    this.objcntpage.Limpiar_var()
		    
			with thisform.pgfdetalle.page1
				.txtNroDoc.ENABLED		= .F.
				.cmdHelpNroDoc.ENABLED	= .F.
				.txtFchDoc.ENABLED		= .F.
		*!*			.TxtTpoCmb.ENABLED		= .F.
				.TxtObserv.ENABLED		= .F.
		
