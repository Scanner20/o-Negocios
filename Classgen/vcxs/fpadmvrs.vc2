			ENDWITH
		
		    THISFORM.LIMPIAR_VAR()
			
			.CmdSalir.ENABLED 		= .T.
			.CmdGrabar.ENABLED 		= .F.
			.CmdIniciar.ENABLED		= .F.
		
		ENDWITH
		=this.objreftran.inicializavariablesCFG()
