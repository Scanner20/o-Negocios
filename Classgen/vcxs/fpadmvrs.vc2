				.cmdadicionar.ENABLED	= .T.
				.cmdModificar.ENABLED	= .T.
				.cmdEliminar.ENABLED	= .T.
				
			endwith		
		    *
			
		    
			with thisform.pgfdetalle.page2
				.TxtPorIgv.VISIBLE	= .F.
				.txtImpBrt.VISIBLE	= .F.
				.txtImpIgv.VISIBLE  = .F.
				.txtImpTot.VISIBLE	= .F.
				.txtPorDto.ViSible   = .F.
				.txtImpDto.Visible	= .F.
				.txtImpInt.Visible	= .f.
				.TxtImpFlt.Visible	= .F.
				.TxtImpSeg.Visible	= .f.
				.TxtImpAdm.Visible	= .F.
		
				**
