				ENDIF
				*
				IF !THIS.AbrirTabla('ABRIR','almCatgE','CATG','CATG01','')		
				   LlRetVal =  .f.	
				ENDIF
				*
				IF !THIS.AbrirTabla('ABRIR','almCATAL','CALM','CATA01','')		
				   LlRetVal =  .f.	
				ENDIF
				*
				IF !THIS.AbrirTabla('ABRIR','CCBRGDOC','GDOC','GDOC01','')		
				   LlRetVal =  .f.	
				ENDIF
				*
