					ENDIF
					IF USED('TCMB')
						USE IN TCMB
					ENDIF
					IF USED('GUIA')
						USE IN GUIA
					ENDIF
					IF USED('CLIE')
						USE IN CLIE
					ENDIF
					IF USED('VPED')
						USE IN VPED
					ENDIF
					IF USED('RPED')
						USE IN RPED
					ENDIF
					IF USED('DOCM')
						USE IN DOCM
					ENDIF
					IF USED('GDOC')
						USE IN GDOC
					ENDIF
					RETURN LlRetVal
				ENDIF
			
			CASE _CodDoc $ [FACT|BOLE|N/C|NC|N\C]
				*
				IF !THIS.AbrirTabla('ABRIR','cbdmauxi','CLIE','AUXI01','')		
