				ENDIF
					*
				IF !THIS.AbrirTabla('ABRIR','vtatdocm','DOCM','DOCM01','')
				   LlRetVal =  .f.	
				ENDIF
					*
				IF !THIS.AbrirTabla('ABRIR','CCBRGDOC','GDOC','GDOC01','')		
