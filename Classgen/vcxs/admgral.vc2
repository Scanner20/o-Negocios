 	*< CLASSDATA: Baseclass="commandbutton" Timestamp="" Scale="Pixels" Uniqueid="" ProjectClassIcon="..\..\grafgen\iconos\eliminar.bmp" ClassIcon="..\..\grafgen\iconos\eliminar.bmp" />

