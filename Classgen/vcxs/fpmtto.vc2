	PROCEDURE CmdHelpSeccion.Click
		thisform.capcontrolcab() 		
		DODEFAULT()
		
		LcOldVal = OLDVAL(This.cCamporetorno,this.Parent.cntO_t_Activi.grdDetalle1.RecordSource)
		IF ISNULL(LcOldVal)
			LcOldVal = ''
		ENDIF
		LlCambio = !(LcOldVal==this.cvalorvalida) AND !EMPTY(this.cvalorvalida)
		IF LlCambio 
			this.Parent.cntO_t_Activi.grdDetalle1.column2.text1.Value = this.cvalordescripcion 
			LsCmpGrb=this.Parent.cntO_t_Activi.grdDetalle1.RecordSource+'.'+This.cCamporetorno
			replace (LsCmpGrb) WITH this.cvalorvalida  IN this.Parent.cntO_t_Activi.grdDetalle1.RecordSource
		ENDIF
		this.Parent.cntO_t_Activi.grdDetalle1.column2.text1.SetFocus
		IF !EMPTY(this.Parent.cntO_t_Activi.grdDetalle1.column2.text1.Value)
			KEYBOARD '{ENTER}'
		ENDIF
		 
	ENDPROC

	PROCEDURE CntO_t_Activi.graba_datos_adic
		PARAMETERS LoGrid
		SELECT (this.ccursor_local) 
		SCATTER NAME oRegLoc 
		=Cargar_actividad_defecto_detalle_OT(oRegLoc,LoGrid.RecordSource,this.ctabla_det1)
		SELECT (LoGrid.RecordSource) 
		LoGrid.Refresh
	ENDPROC

