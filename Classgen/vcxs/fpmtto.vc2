	PROCEDURE habilita
		DODEFAULT()
		
		IF VARTYPE(thisform.ObjRefTran)<>'0'
			RETURN
		ENDIF
		DO case
			CASE INLIST(thisform.ObjRefTran.XsCodDoc,'N/C','N\C','NC')  && Nota de credito
			
			CASE INLIST(thisform.ObjRefTran.XsCodDoc,'N/D','N\D','ND')  && Nota de debito
		   
		
			 
		ENDCASE
		
	ENDPROC

	PROCEDURE iniciar_var
		WITH THIS
			LOCAL i
			FOR i = 1 to .ControlCount
				.Controls(i).Enabled  = .F.
				.Controls(i).Visible  = .F.
			NEXT 
		ENDWITH
	ENDPROC

	PROCEDURE limpiar_var
		WITH this
			LOCAL i
			FOR i = 1 to .ControlCount
				DO CASE 
					CASE AT('FECHA',UPPER(.Controls(i).Class))>0
						.Controls(i).Value = {}
					CASE AT('NUMERO',UPPER(.Controls(i).Class))>0				
						.Controls(i).Value = 0
					CASE AT('MONEDA',UPPER(.Controls(i).Class))>0								
						.Controls(i).Value = 0.00
					CASE AT('TEXTBOX',UPPER(.Controls(i).Class))>0								
						.Controls(i).Value = []
					CASE AT('CBOHELP',UPPER(.Controls(i).Class))>0								
						.Controls(i).Value = []
						
				ENDCASE
								
			NEXT 
		ENDWITH
		
	ENDPROC

	PROCEDURE CboCodMaq.Valid
		THIS.InteractiveChange() 
		
		*!*	IF !EOF(this.cAliascursor)
		*!*		THIS.Parent.CntO_t_Activi.habilita() 
		*!*	ELSE
		*!*		THIS.Parent.CntO_t_Activi.Deshabilita() 
		*!*	ENDIF
	ENDPROC

	PROCEDURE CboCodPro.InteractiveChange
		LOCAL lExisteClie
		lExisteClie=SEEK(THIS.ccadenavalores+THIS.Value,this.Cnombreentidad,'AUXI01')
		IF lExisteClie
			this.Parent.txtRucAux.Value =  EVALUATE(this.Cnombreentidad+'.RucAux')
			RETURN S_OK
		ELSE
			RETURN PROVEEDOR_NO_EXISTE
		ENDIF	
	ENDPROC

	PROCEDURE CboCodPro.Valid
		
		IF EMPTY(this.Value)
			RETURN 
		ENDIF
		
		M.ERR=THIS.InteractiveChange() 
		IF m.err<0
			thisform.MensajeErr(m.err)
			RETURN .f.
		ENDIF
		*!*	thisform.ObjRefTran.XsCodCli = this.Value 
		*this.parent.txtdirAux.value=EVALUATE(this.PARENT.c_validCliente+'.DesDire')
		*!*	this.parent.txtrucAux.Value=EVALUATE(this.PARENT.C_validCliente+'.CodAux')
		*!*	this.Parent.cmdHELPNROREF.ccamposfiltro  = [FlgEst;CodCli]
		*!*	this.Parent.cmDHELPNROREF.cvaloresfiltro = thisform.ObjRefTran.XcFlgEst_Ref+';'+thisform.objreftran.XsCodCli
	ENDPROC

	PROCEDURE CboParametro.Valid
		thisform.ObjRefTran.XnTpoVta = VAL(THIS.Value)
		thisform.Calcular_Totales()
	ENDPROC

	PROCEDURE CboTipAct.Valid
		
		
		
	ENDPROC

	PROCEDURE CboTipMaqui.Valid
		
		
		*!*	WITH THISFORM.pgfCtaAux.PAGES(1)
		*!*		.grdCtaAux.RECORDSOURCE		= ""
		*!*		.grdCtaAux.RECORDSOURCETYPE	= 4
		*!*		.cmdAdicionar1.ENABLED	    = .F.
		*!*		.cmdModificar1.ENABLED   	= .F.
		*!*		.cmdEliminar1.ENABLED   	= .F.
		*!*		.CmdImprimir1.ENABLED       = .F.
		*!*	ENDWITH
		
		*!*	WITH THISFORM
		*!*		.Tools.CloseTable(thisform.cCursor_local)
		
		*!*		.cValor_id = GsCodCia+.cboTipAct.value +.CboTipMaqui.Value 
		*!*		LoDatAdm.abrirtabla('ABRIR',.ctabla_remota,.ctabla_remota,.CTAg_tr,'')
		*!*	  
		*!*		LoDatAdm.genCursor(.Ccursor_Local,.ctabla_remota,.CTAg_tr,.cCmps_ID,.cValor_id,'',.CORder_cl)
		*!*		
		*!*		lnControl = 1
		*!*		IF lnControl < 0
		*!*			RETURN
		*!*		ENDIF
		*!*		WITH .pgfCtaAux.PAGES(1)
		*!*	         .grdCtaAux.RECORDSOURCETYPE	= 1
		*!*			 .grdCtaAux.RECORDSOURCE		= thisform.cCursor_local
		*!*			 .grdCtaAux.COLUMNS(1).CONTROLSOURCE	= thisform.cCursor_local+".CodMaq"
		*!*			 .grdCtaAux.COLUMNS(2).CONTROLSOURCE	= thisform.cCursor_local+".DesMaq"
		*!*			 .grdCtaAux.COLUMNS(3).CONTROLSOURCE	= thisform.cCursor_local+".Ubic_actua"
		*!*	 		 .grdCtaAux.COLUMNS(4).CONTROLSOURCE	= thisform.cCursor_local+".Respon"
		*!*			 .grdCtaAux.COLUMNS(5).CONTROLSOURCE	= thisform.cCursor_local+".Conto_Actu"
		*!*	 		 .grdCtaAux.COLUMNS(6).CONTROLSOURCE	= thisform.cCursor_local+".Dias_Avanc"
		*!*	 
		*!*			 .cmdAdicionar1.ENABLED	= .T.
		*!*			  LlHayRegistros = NOT THISFORM.Tools.cursor_esta_vacio(thisform.cCursor_local)
		*!*			 .cmdModificar1.ENABLED	= LlHayRegistros
		*!*			 .cmdEliminar1.ENABLED	= LlHayRegistros
		*!*			 .CmdImprimir1.ENABLED  = LlHayRegistros
		*!*			 .grdCtaAux.AfterRowColChange()
		*!*			 THIS.CLICK()	
		*!*		ENDWITH
		*!*		WITH .pgfCtaAux.PAGES(2)
		*!*			
		*!*		ENDWITH
		*!*		
		*!*	ENDWITH
		this.Parent.cboCodMaq.cvaloresfiltro=GsCodCia+';'+this.Parent.cbotipAct.Value+';'+this.Value 
		this.Parent.CboCodMaq.generarcursor()
		this.Parent.CboCodMaq.InteractiveChange() 
	ENDPROC

	PROCEDURE CboTip_Man.Valid
		thisform.ObjRefTran.XnTpoVta = VAL(THIS.Value)
		thisform.Calcular_Totales()
	ENDPROC

	PROCEDURE CmdHelpActividad.Click
		thisform.capcontrolcab() 		
		DODEFAULT()
		
		LcOldVal = OLDVAL(This.Ccamporetorno,this.Parent.cntO_t_Activi.grdDetalle1.RecordSource)
		IF ISNULL(LcOldVal)
			LcOldVal = ''
		ENDIF
		LlCambio = !(LcOldVal==this.cvalorvalida)  AND !EMPTY(this.cvalorvalida)
		IF LlCambio OR .T.
			this.Parent.cntO_t_Activi.grdDetalle1.column4.text1.Value = this.cvalordescripcion 
			LsCmpGrb=this.Parent.cntO_t_Activi.grdDetalle1.RecordSource+'.'+This.Ccamporetorno
			replace (LsCmpGrb) WITH this.cvalorvalida  IN this.Parent.cntO_t_Activi.grdDetalle1.RecordSource
		ENDIF
		this.Parent.cntO_t_Activi.grdDetalle1.column4.text1.SetFocus
		IF !EMPTY(this.Parent.cntO_t_Activi.grdDetalle1.column4.text1.Value)
			KEYBOARD '{ENTER}'
		ENDIF
		 
	ENDPROC

