	PROCEDURE CntO_t_Activi.graba_datos_adic
		PARAMETERS LoGrid
		SELECT (this.ccursor_local) 
		SCATTER NAME oRegLoc 
		=Cargar_actividad_defecto_detalle_OT(oRegLoc,LoGrid.RecordSource,this.ctabla_det1)
		SELECT (LoGrid.RecordSource) 
		LoGrid.Refresh
	ENDPROC

	PROCEDURE CntO_t_Activi.graba_detalle_adicional
		Parameters LcTipOpe,LcCursor,LcCmpKey,LcValKey,LcTabla 
		** Colocar esta rutina en un procedimiento almacenado !!!!
		LOCAL oRegLoc AS Object 
		SCATTER MEMO NAME oRegLoc 
		SELECT ACTI
		SEEK oRegLoc.CodCia+;
			oRegLoc.CodigoTA+;
			oRegLoc.CodigoTM+;
			oRegLoc.CodMaq+;
			oRegLoc.CodSec+;
			oRegLoc.CodEqu+;  
			oRegLoc.CodPar+;  
			oRegLoc.Cod_Activi
		IF !FOUND()	
			APPEND BLANK
			GATHER NAME oRegLoc
		ELSE
			IF RLOCK()
				REPLACE Des_Act WITH oRegLoc.Des_Act
				UNLOCK	
			ENDIF
		ENDIF	
	ENDPROC

	PROCEDURE CntO_t_Activi.GrdDetalle1.Column1.Text1.DblClick
		KEYBOARD '{F8}' 
	ENDPROC

	PROCEDURE CntO_t_Activi.GrdDetalle1.Column1.Text1.KeyPress
		LPARAMETERS TnKeyCode, TnShiftAltCtrl
		LOCAL lcOldSearchString, lnLength
		*
		* The user has entered some data
		* Save the old search string
		*
		IF this.Parent.Parent.Columns(1).Readonly
			RETURN
		ENDIF
		
		*SET STEP ON 
		
		
		lcOldSearchString = This.cSearchString
		
		DO CASE
			CASE (TnKeyCode  = CTRLW OR TnKeyCode  = 103) AND  TnShiftAltCtrl = 2
				UltTecla = TnKeyCode
				IF this.Valid()
					this.Parent.Parent.Parent.cmdgrabar1.Click() 
				ENDIF
			CASE TnKeyCode  = F9   		
				UltTecla = TnKeyCode
		*		IF this.Valid()
					this.Parent.Parent.Parent.Cmdcancelar1 .Click() 
		*		ENDIF
		
		   CASE tnKeyCode >= 32 AND tnKeyCode <= 126
		      *
		      * Add the character to the current search string
		      *
		      this.cSearchString = this.cSearchString + CHR(tnKeyCode)
		
		   CASE tnKeyCode = 127 && Backspace
		      *
		      * Delete the last character from the search string
		      *
		      lnLength = LENC(This.cSearchString) - 1
		
		      IF lnLength > 0
		         This.cSearchString = SUBSTR(This.cSearchString, 1, lnLength)
		      ELSE
		         This.cSearchString = ''
		      ENDIF
		   CASE TnKeyCode  = Enter 
				UltTecla = TnKeyCode
		   CASE TnKeyCode  = F8   
				UltTecla = TnKeyCode
				this.Parent.parent.Parent.Parent.cmdHelpSeccion.Click() 
		*!*			KEYBOARD '{ENTER}' 
				
		   OTHERWISE
		      *
		      * Some other key, just do the default actions
		      *
		      This.SelLength = LENC(This.cSearchString)
		      RETURN
		ENDCASE
		
		
		
	ENDPROC

