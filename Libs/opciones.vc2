	*< OBJECTDATA: ObjPath="Cmb_secuencia" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: carga_secuencia
		*p: periodoactual
	*</DefinedPropArrayMethod>

	*<PropValue>
		Caption = "Cambia Periodo"
		DataSession = 2
		DoCreate = .T.
		Height = 375
		Icon = ..\imag\clock03.ico
		Name = "periodo"
		periodoactual = ("")
		Width = 305
		entorno.Name = "entorno"
		StatusBar.Height = 23
		StatusBar.Left = 0
		StatusBar.Name = "StatusBar"
		StatusBar.Top = 352
		StatusBar.Width = 305
		cristal.Left = 240
		cristal.Name = "cristal"
		cristal.Top = 228
		botongrupo.Cmb_Aceptar.Left = 3
		botongrupo.Cmb_Aceptar.Name = "Cmb_Aceptar"
		botongrupo.Cmb_Aceptar.Top = 5
		botongrupo.Cmb_Ayuda.Left = 3
		botongrupo.Cmb_Ayuda.Name = "Cmb_Ayuda"
		botongrupo.Cmb_Ayuda.Top = 60
		botongrupo.Cmb_Cancelar.Left = 3
		botongrupo.Cmb_Cancelar.Name = "Cmb_Cancelar"
		botongrupo.Cmb_Cancelar.Top = 120
		botongrupo.Left = 219
		botongrupo.Name = "botongrupo"
		botongrupo.Top = 0
		botongrupo.ZOrderSet = 2
	*</PropValue>

