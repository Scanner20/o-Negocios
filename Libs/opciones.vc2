		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE botongrupo.Cmb_Aceptar.Click
		Oentorno.codigocia=compania_cia.cia_codcia
		Oentorno.codigosuc=compania_cia.suc_codsuc
		Oentorno.nombrecia=compania_cia.cia_nomcia
		Oentorno.nombresuc=compania_cia.suc_nomsuc
		Oentorno.ruccia=compania_cia.cia_numruc
		 
		PRIVATE lcad, lcancampos
		IF Ocnx.Tipo_BD=1 OR Ocnx.Tipo_BD=4
			lcad="Exec dbo.PA_DATOS_USUARIO @usuario='"+ALLTRIM(Ocnx.Usuario)+"',@codcia='"+ALLTRIM(compania_cia.cia_codcia)+"'" 
		ENDIF
		IF Ocnx.Tipo_BD=3
			lcad="Select s10_nivusu as nivel,"+;
			     "  IfNull(s19_codidi,'') as idioma,"+;
			     "  IfNULL(s10_coddbf,'') as coddbf, "+;
			     "  SPACE(4) as codven "+;
				 "	From SYS_TABLA_USUARIOS_S10 "+;
				 "  Where Upper(s10_usuario)=Upper('"+Ocnx.Usuario+"')"
		ENDIF
						
		IF Ocnx.Tipo_BD=2
			lcad="Select s10_nivusu as nivel,"+;
			     "  Nvl(s19_codidi,'') as idioma,"+;
			     "  Nvl(s10_coddbf,'') as coddbf, "+;
			     "  LPAD (' ', 4) as codven "+;
				 "	From "+Ocnx.Esquema+".SYS_TABLA_USUARIOS_S10 "+;
				 "  Where Upper(s10_usuario)=Upper('"+Ocnx.Usuario+"')"
		ENDIF
		
		
		IF (Ocnx.Tipo_bd = 1 OR Ocnx.Tipo_bd = 3 OR Ocnx.Tipo_bd = 2)
			IF SQLEXEC(Ocnx.Conexion,lcad,"Tdatusu")<0
				Messagebox(MESSAGE()+CHR(13)+lcad,16,ThisForm.Caption)
				RETURN .F.
			ENDIF
		ENDIF
		
		IF Ocnx.Tipo_bd = 4
			IF Ocnx.Ms_Ejecuta_SQL(lcad,"Tdatusu",ThisForm.DataSessionId)<0
				RETURN .F.
			ENDIF
		ENDIF
		
		lcancampos=afields(lcamarre,"Tdatusu")
		
		if ascan(lcamarre,upper("codven"))>0
			Ocnx.codigo_vendedor=Tdatusu.codven
		endif
		
		IF USED("Tdatusu")
			USE IN "Tdatusu"
		ENDIF
		
		
		IF ThisForm.Entorno.Compatible_osisv1 
			Gcod_cia=Oentorno.codigocia
			Gcod_suc=Oentorno.codigosuc
			Gcia	=Oentorno.nombrecia
		ENDIF
		 
		ThisForm.Release()
	ENDPROC

	PROCEDURE Datos1.defineselect
		PRIVATE lfil,lcodusuario
		lfil=" Where a.cia_indest='1' "
		
		lcodusuario=ALLTRIM(ocnx.usuario)
		
		IF !EMPTY(NVL(Ocnx.Usuario_perfil,''))
			lcodusuario=ALLTRIM(Ocnx.Usuario_perfil)
		ENDIF
		
		IF Ocnx.Tipo_BD <> 2
			IF Ocnx.nivel<9
				lfil="Where a.cia_indest='1' and a.cia_codcia+b.suc_codsuc in ("+;
				     "SELECT  t.cia_codcia+t.suc_codsuc "+;
					 "FROM 	SYS_COMPANIAS_USUARIOS_S14  t "+;
					 "Where Upper(t.s10_usuario)=Upper('"+ALLTRIM(lcodusuario)+"') "+;
					 "and   s14_indest='1') "		 
			ENDIF
			IF !ThisForm.Entorno.Compatible_osisv1  	
				This.SqlSelect="SELECT  a.CIA_CODCIA ,"+;
					           "        a.CIA_NOMCIA ,"+;
				           	   "        b.SUC_CODSUC ,"+;
				               "        b.SUC_NOMSUC ,"+;
				               "        a.cia_numruc "+;   
							   "FROM COMPANIA_CIA a inner join SUCURSAL_SUC b  "+;  
							   "On ( b.CIA_CODCIA = a.CIA_CODCIA )  "+lfil 
			ELSE
				This.SqlSelect="SELECT  a.CIA_CODCIA ,"+;
					           "        a.cia_nomlar as 'CIA_NOMCIA' ,"+;
				           	   "        b.SUC_CODSUC ,"+;
				               "        b.suc_nomlar as 'SUC_NOMSUC' ,"+;
				               "        a.cia_ruccia as 'cia_numruc' "+;   
							   "FROM dbo.comp_cia a inner join  dbo.sucu_suc b  "+;  
							   "On ( b.CIA_CODCIA = a.CIA_CODCIA )  "+lfil 
		
			ENDIF
		ELSE
			IF Ocnx.nivel<9
				lfil="Where a.cia_indest='1' and a.cia_codcia||b.suc_codsuc in ("+;
				     "SELECT  t.cia_codcia||t.suc_codsuc "+;
					 "FROM 	"+Ocnx.Esquema+".SYS_COMPANIAS_USUARIOS_S14  t "+;
					 "Where Upper(t.s10_usuario)=Upper('"+ALLTRIM(lcodusuario)+"') "+;
					 "and   s14_indest='1') "		 
			ENDIF
			IF !ThisForm.Entorno.Compatible_osisv1  	
				This.SqlSelect="SELECT  a.CIA_CODCIA ,"+;
					           "        a.CIA_NOMCIA ,"+;
				           	   "        b.SUC_CODSUC ,"+;
				               "        b.SUC_NOMSUC ,"+;
				               "        a.cia_numruc "+;   
							   "FROM "+Ocnx.Esquema+".COMPANIA_CIA a inner join "+Ocnx.Esquema+".SUCURSAL_SUC b  "+;  
							   "On ( b.CIA_CODCIA = a.CIA_CODCIA )  "+lfil 
			ELSE
				This.SqlSelect="SELECT  a.CIA_CODCIA ,"+;
					           "        a.cia_nomlar as 'CIA_NOMCIA' ,"+;
				           	   "        b.SUC_CODSUC ,"+;
				               "        b.suc_nomlar as 'SUC_NOMSUC' ,"+;
				               "        a.cia_ruccia as 'cia_numruc' "+;   
							   "FROM "+Ocnx.Esquema+".comp_cia a inner join  "+Ocnx.Esquema+".sucu_suc b  "+;  
							   "On ( b.CIA_CODCIA = a.CIA_CODCIA )  "+lfil 
		
			ENDIF
		ENDIF 	
			
			
					   
		DODEFAULT()			   
		
	ENDPROC

	PROCEDURE Datos1.Init
		IF !ThisFOrm.Entorno.Compatible_osisv1  
			This.Nombretabla = "compania_cia"
		ELSE
			This.Nombretabla = "comp_cia"
		ENDIF
			
		DODEFAULT()
	ENDPROC

	PROCEDURE Detalle.DblClick
		ThisForm.Botongrupo.Cmb_Aceptar.Click()
		
		
		
	ENDPROC

	PROCEDURE Detalle.Refresh
		DODEFAULT()
		This.GridLineColor = THisForm.BackColor 
		This.BackColor  = ThisForm.BackColor 
		IF !EMPTY(This.RecordSource) AND USED(This.RecordSource)
			This.SetAll("DynamicBackColor","rgb(255,255,255)","Column")
		ENDIF
		
	ENDPROC

ENDDEFINE

