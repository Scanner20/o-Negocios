		FontName = "MS Sans Serif", ;
		GridLines = 0, ;
		Height = 265, ;
		Left = 0, ;
		Name = "Ano", ;
		pintaregistro = .T., ;
		ReadOnly = .T., ;
		Top = 0, ;
		Width = 84, ;
		ZOrderSet = 3, ;
		Column1.FontName = "MS Sans Serif", ;
		Column1.Name = "Column1", ;
		Column1.ReadOnly = .T.
		*< END OBJECT: ClassLib="claseosis.vcx" BaseClass="grid" />

	ADD OBJECT 'Ano.Column1.Header1' AS header WITH ;
