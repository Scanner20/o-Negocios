		botongrupo.Cmb_Ayuda.Left = 5
		botongrupo.Cmb_Ayuda.Name = "Cmb_Ayuda"
		botongrupo.Cmb_Ayuda.Top = 69
		botongrupo.Cmb_Ayuda.Visible = .F.
		botongrupo.Cmb_Cancelar.Left = 5
		botongrupo.Cmb_Cancelar.Name = "Cmb_Cancelar"
		botongrupo.Cmb_Cancelar.Top = 138
		botongrupo.Cmb_Cancelar.Visible = .F.
		botongrupo.Height = 30
		botongrupo.Left = 0
		botongrupo.Name = "botongrupo"
		botongrupo.Top = 297
		botongrupo.Width = 456
	*</PropValue>

	ADD OBJECT 'Edita' AS editbox WITH ;
		DisabledBackColor = 255,255,255, ;
		FontName = "MS Sans Serif", ;
		Height = 222, ;
		Left = 0, ;
		Name = "Edita", ;
		ReadOnly = .T., ;
		Top = 75, ;
		Width = 447
		*< END OBJECT: BaseClass="editbox" />

	ADD OBJECT 'Image1' AS image WITH ;
		Height = 72, ;
		Left = 0, ;
		Name = "Image1", ;
		Picture = ..\imag\logoosis.jpg, ;
		Top = 1, ;
		Width = 446
		*< END OBJECT: BaseClass="image" />
	
	PROCEDURE Init
		DODEFAULT()
		
		This.Caption="Acerca del Sistema OSIS" 
	ENDPROC

	PROCEDURE Resize
		DODEFAULT()
		This.Botongrupo.Top=This.StatusBar.Top - This.Botongrupo.Height - 2
		  
	ENDPROC

	PROCEDURE botongrupo.Cmb_Aceptar.Click
		ThisForm.Cerrar() 
	ENDPROC

	PROCEDURE Edita.Init
		PRIVATE lexe,lalias,lused,ldatos
		
		ldatos=""
		lalias=SYS(2015)
		
		IF Ocnx.Tipo_BD=1 AND Ocnx.Conexion>0
			lexe="Select convert(char(200),@@VERSION) as tversion "
			IF SQLEXEC(Ocnx.Conexion,lexe,lalias)>0
				ldatos="Sobre la Base de Datos: "+CHR(13)+ALLTRIM(NVL(tversion,''))+CHR(13)
			ENDIF
			IF USED(lalias)
				lused="Use in '"+lalias+"'"
				&lused
			ENDIF
			lexe="Select convert(char(10),SERVERPROPERTY('ProductLevel')) as tversion "
			IF SQLEXEC(Ocnx.Conexion,lexe,lalias)>0
				ldatos=ldatos+"Service Pack: "+ALLTRIM(NVL(tversion,''))
			ENDIF
			IF USED(lalias)
				lused="Use in '"+lalias+"'"
				&lused
			ENDIF
		
		ENDIF
		
		
		
		This.Value=""+;
		"Organization and System Integral Solution"+CHR(13)+;
		"Copyright © 1996 - 2005 OSIS S.R.L. "+CHR(13)+;
		"Reservado todos los derechos. "+CHR(13)+CHR(13)+;
		"Se autoriza el uso de este producto a: "+CHR(13)+;
		ThisForm.Entorno.Nombrecia+CHR(13)+CHR(13)+;
		"Versión "+IIF(TYPE("Oapp.Version")=="C",Oapp.Version,"3.7")+CHR(13)+CHR(13)+;
		"Modificado y Adaptado para: "+CHR(13)+;
		ThisForm.Entorno.Nombrecia+CHR(13)+CHR(13)+ldatos
		  
		
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS boton_opcion AS boton OF "claseosis.vcx" 
 	*< CLASSDATA: Baseclass="commandbutton" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*p: programa		&& Código de Programa Asociado
	*</DefinedPropArrayMethod>

	*<PropValue>
		FontName = "Wingdings 2"
		FontSize = 10
		Height = 23
		Name = "boton_opcion"
		programa = ("")
		Width = 25
	*</PropValue>
	
	PROCEDURE Click
		IF _Screen.FormCount >0
			PRIVATE ln,lf
			lf=0
			FOR ln=1 TO _Screen.FormCount
				IF UPPER(_Screen.Forms[ln].Class)=="OPCIONES"
					lf=ln
					EXIT 
				ENDIF
			ENDFOR 
			IF lf>0
				_Screen.Forms[ln].Abrir(UPPER(ALLTRIM(This.Name))) 
			ENDIF
		ENDIF
		
	ENDPROC

ENDDEFINE

