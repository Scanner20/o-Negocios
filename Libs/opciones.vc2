		Panel = 1, ;
		pintaregistro = .T., ;
		ReadOnly = .T., ;
		ScrollBars = 0, ;
		Top = 0, ;
		Width = 131, ;
		ZOrderSet = 4, ;
		Column1.FontName = "MS Sans Serif", ;
		Column1.Name = "Column1", ;
		Column1.ReadOnly = .T., ;
		Column1.Width = 100
		*< END OBJECT: ClassLib="claseosis.vcx" BaseClass="grid" />

	ADD OBJECT 'Mes.Column1.Header1' AS header WITH ;
		Alignment = 2, ;
		Caption = "Mes", ;
		FontName = "MS Sans Serif", ;
		Name = "Header1"
		*< END OBJECT: BaseClass="header" />

	ADD OBJECT 'Mes.Column1.Text1' AS textbox WITH ;
		BackColor = 255,255,255, ;
		BorderStyle = 0, ;
		FontName = "MS Sans Serif", ;
		ForeColor = 0,0,0, ;
		Margin = 0, ;
		Name = "Text1", ;
		ReadOnly = .T.
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Shape1' AS shape WITH ;
		BackStyle = 0, ;
		Height = 82, ;
		Left = 0, ;
		Name = "Shape1", ;
		SpecialEffect = 0, ;
		Top = 266, ;
		Width = 305, ;
		ZOrderSet = 0
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'txt_periodo' AS texto WITH ;
		DisabledBackColor = 255,255,255, ;
		DisabledForeColor = 0,0,255, ;
		Enabled = .F., ;
		Format = "!r", ;
		Height = 23, ;
		InputMask = "9999-99", ;
		Left = 120, ;
		MaxLength = 6, ;
		Name = "txt_periodo", ;
		Top = 278, ;
		Width = 76, ;
		ZOrderSet = 7
		*< END OBJECT: ClassLib="claseosis.vcx" BaseClass="textbox" />
	
	PROCEDURE carga_secuencia
		PRIVATE lcarea,lcse
		
		lcarea=SELECT()
		
		lano=ThisForm.Datos1.campo_valor("ano_codano") 
		lmes=ThisForm.Datos2.campo_valor("mes_codmes") 
		
		
		lcse="Select ppe_corppe "+;
			 "From PERIODO_PLANILLA_PPE "+;
			 "Where cia_codcia='"+This.Entorno.Codigocia+"' "+;
			 "and   suc_codsuc='"+This.Entorno.Codigosuc+"' "+;
			 "and   ano_codano='"+lano+"' "+;
			 "and   mes_codmes='"+lmes+"' "+;
			 "and  tpl_codtpl='"+NVL(ThisForm.Entorno.Nomina,"")+"' " 
		
		IF Ocnx.Tipo_BD=2
			lcse="Select ppe_corppe "+;
				 "From "+Ocnx.Esquema+".PERIODO_PLANILLA_PPE "+;
				 "Where cia_codcia='"+This.Entorno.Codigocia+"' "+;
				 "and   suc_codsuc='"+This.Entorno.Codigosuc+"' "+;
				 "and   ano_codano='"+lano+"' "+;
				 "and   mes_codmes='"+lmes+"' "+;
				 "and  tpl_codtpl='"+NVL(ThisForm.Entorno.Nomina,"")+"' " 
		
		ENDIF 
		
		IF Ocnx.Tipo_BD=1 OR Ocnx.Tipo_BD=2
			IF SQLEXEC(Ocnx.Conexion,lcse,"TempSecuen")<0
				MESSAGEBOX(MESSAGE()+CHR(13)+lcse,16,ThisForm.Caption)
				RETURN ""
			ENDIF
		ENDIF
		IF Ocnx.Tipo_BD=4
			IF Ocnx.Ms_Ejecuta_SQL(lcse,"TempSecuen",ThisForm.DataSessionId)<0
				MESSAGEBOX(MESSAGE()+CHR(13)+lcse,16,ThisForm.Caption)
				RETURN ""
			ENDIF
		ENDIF
		
		lvalor=""
		GO BOTTOM 
		IF !EOF() AND !BOF()
			lvalor=TempSecuen.ppe_corppe
		ENDIF
		
		ThisForm.Cmb_secuencia.BoundColumn = 1
		ThisForm.Cmb_secuencia.RowSource = "TempSecuen"
		ThisForm.Cmb_secuencia.RowSourceType = 2 
		
		ThisForm.Cmb_secuencia.Requery()   
		IF !EMPTY(lvalor)
			ThisForm.Cmb_secuencia.Value = lvalor
		EndIf
		SELECT (lcarea)
		ThisForm.Cmb_secuencia.Refresh() 
		
	ENDPROC

	PROCEDURE Init
		DODEFAULT()
		This.Tag = SPACE(6)
		
		*!*	IF UPPER(Ocnx.Usuario)=="EPALOMINO"
		*!*		SUSP
		*!*	ENDIF
		
		SELECT (This.Datos1.Area)
		GO top
		SCAN
		   IF ano_codano=This.Entorno.Ano
		      Exit
		   ENdIf
		ENDSCAN
		This.Ano.Refresh()
		
		This.Ano.AfterRowColChange()
		
		
		
		This.txt_periodo.Refresh()
		This.PeriodoActual=This.txt_periodo.Value
		ThisForm.Carga_secuencia() 
		This.Cmb_secuencia.Value =  This.Entorno.Secuencia 
		This.Cmb_secuencia.Refresh() 
		SELECT (This.Datos2.Area)
		GO top
		SCAN
		   IF mes_codmes=This.Entorno.Mes
		      Exit
		   ENdIf
		ENDSCAN
		This.Mes.Refresh()
		
	ENDPROC

	PROCEDURE Unload
		PRIVATE lperiodo
		lperiodo=This.Tag
		RETURN lperiodo
	ENDPROC

	PROCEDURE Ano.AfterRowColChange
		LPARAMETERS nColIndex
		DODEFAULT(nColIndex)
		IF TYPE("ThisForm.Datos2")=="O"
			ThisForm.Datos2.Selecciona()
			ThisForm.Mes.AsociaTabla(ThisForm.Datos2)
			ThisForm.MES.AfterRowColChange()  
			PRIVATE lcodano,lcodmes
			lcodano=ThisForm.Datos1.Campo_valor("ano_codano")
			IF ThisForm.Entorno.Ano==lcodano
				SELECT (ThisForm.Datos2.Area)
					GO top
					SCAN
					   IF mes_codmes=ThisForm.Entorno.Mes
					      Exit
					   ENdIf
				ENDSCAN
				ThisForm.Mes.AfterRowColChange() 
			ENDIF
		ENDIF
		ThisForm.Txt_Periodo.Refresh()
		
		
		 
	ENDPROC

	PROCEDURE botongrupo.Cmb_Aceptar.Click
		Oentorno.Secuencia=ThisForm.Cmb_secuencia.Value  
		ThisForm.Tag=ThisForm.Txt_Periodo.Value
		ThisForm.Release()
	ENDPROC

	PROCEDURE botongrupo.Cmb_Cancelar.Click
		ThisForm.Tag=ThisForm.PeriodoActual
		DODEFAULT()
	ENDPROC

	PROCEDURE Cmb_secuencia.Refresh
		This.Visible = !EMPTY(Oentorno.Nomina) And !Oentorno.Modulo$'56'
		Thisform.Etiqueta_Secuencia.Visible = This.Visible 
	ENDPROC

	PROCEDURE Datos1.defineselect
		IF EMPTY(ThisForm.Entorno.Nomina) 
			This.SqlSelect="Select distinct ano_codano "+;
			               "From  SYS_PERIODO_MODULOS_S04 "+;
			               "Where cia_codcia='"+NVL(ThisForm.Entorno.Codigocia,"")+"' "+;
			               "and   suc_codsuc='"+NVL(ThisForm.Entorno.Codigosuc,"")+"' "+;
			               "and   s03_codmod='"+NVL(ThisForm.Entorno.Modulo,"")+"' "  
			               
			 IF Ocnx.Tipo_BD=2
				This.SqlSelect="Select distinct ano_codano "+;
				               "From  "+Ocnx.Esquema+".SYS_PERIODO_MODULOS_S04 "+;
				               "Where cia_codcia='"+NVL(ThisForm.Entorno.Codigocia,"")+"' "+;
				               "and   suc_codsuc='"+NVL(ThisForm.Entorno.Codigosuc,"")+"' "+;
				               "and   s03_codmod='"+NVL(ThisForm.Entorno.Modulo,"")+"' "  	 
			 ENDIF 
		ELSE
			This.SqlSelect="Select distinct ano_codano "+;
			               "From  SYS_PERIODO_MODULOS_S04 "+;
			               "Where cia_codcia='"+NVL(ThisForm.Entorno.Codigocia,"")+"' "+;
			               "and   suc_codsuc='"+NVL(ThisForm.Entorno.Codigosuc,"")+"' "+;
			               "and   s03_codmod='"+NVL(ThisForm.Entorno.Modulo,"")+"' "+;
			               "and   ano_codano in "+;
			               "(Select distinct ano_codano "+;
			               " From PERIODO_PLANILLA_PPE  "+;
			               " Where cia_codcia='"+NVL(ThisForm.Entorno.Codigocia,"")+"' "+;
			               " and   suc_codsuc='"+NVL(ThisForm.Entorno.Codigosuc,"")+"' "+;
			               " and   tpl_codtpl='"+NVL(ThisForm.Entorno.Nomina,"")+"') " 
			 IF Ocnx.Tipo_BD=2
				This.SqlSelect="Select distinct ano_codano "+;
				               "From  "+Ocnx.Esquema+".SYS_PERIODO_MODULOS_S04 "+;
				               "Where cia_codcia='"+NVL(ThisForm.Entorno.Codigocia,"")+"' "+;
				               "and   suc_codsuc='"+NVL(ThisForm.Entorno.Codigosuc,"")+"' "+;
				               "and   s03_codmod='"+NVL(ThisForm.Entorno.Modulo,"")+"' "+;
				               "and   ano_codano in "+;
				               "(Select distinct ano_codano "+;
				               " From "+Ocnx.Esquema+".PERIODO_PLANILLA_PPE  "+;
				               " Where cia_codcia='"+NVL(ThisForm.Entorno.Codigocia,"")+"' "+;
				               " and   suc_codsuc='"+NVL(ThisForm.Entorno.Codigosuc,"")+"' "+;
				               " and   tpl_codtpl='"+NVL(ThisForm.Entorno.Nomina,"")+"') " 	 
			 ENDIF 	               
		ENDIF
		               
	ENDPROC

	PROCEDURE Datos2.defineselect
		IF !USED(ThisForm.Datos1.Alias)
		   ThisForm.Datos1.Init() 
		ENDIF
		
		IF EMPTY(ThisForm.Entorno.Nomina) 
			This.SqlSelect="Select mes_codmes,"+;
			               "(Case mes_codmes "+;
			               "When '00' then 'APERTURA' "+;
			               "When '01' then 'ENERO' "+;
			               "When '02' then 'FEBRERO' "+;
			               "When '03' then 'MARZO' "+;
			               "When '04' then 'ABRIL' "+;
			               "When '05' then 'MAYO' "+;
			               "When '06' then 'JUNIO' "+;
			               "When '07' then 'JULIO' "+;
			               "When '08' then 'AGOSTO' "+;
			               "When '09' then 'SEPTIEMBRE' "+;
			               "When '10' then 'OCTUBRE' "+;
			               "When '11' then 'NOVIEMBRE' "+;
			               "When '12' then 'DICIEMBRE' "+;
			               "When '13' then 'CIERRE' "+;  
			               "End) as mes_desmes "+;             
			               "From  SYS_PERIODO_MODULOS_S04 "+;
			               "Where cia_codcia='"+NVL(ThisForm.Entorno.Codigocia,"")+"' "+;
			               "and   suc_codsuc='"+NVL(ThisForm.Entorno.Codigosuc,"")+"' "+;
			               "and   s03_codmod='"+NVL(ThisForm.Entorno.Modulo,"")+"' "+;
			               "and   ano_codano='"+NVL(sys_anos.ano_codano,"")+"'"
			               
			 IF Ocnx.Tipo_BD=2
				This.SqlSelect="Select mes_codmes,"+;
				               "(Case mes_codmes "+;
				               "When '00' then 'APERTURA' "+;
				               "When '01' then 'ENERO' "+;
				               "When '02' then 'FEBRERO' "+;
				               "When '03' then 'MARZO' "+;
				               "When '04' then 'ABRIL' "+;
				               "When '05' then 'MAYO' "+;
				               "When '06' then 'JUNIO' "+;
				               "When '07' then 'JULIO' "+;
				               "When '08' then 'AGOSTO' "+;
				               "When '09' then 'SEPTIEMBRE' "+;
				               "When '10' then 'OCTUBRE' "+;
				               "When '11' then 'NOVIEMBRE' "+;
				               "When '12' then 'DICIEMBRE' "+;
				               "When '13' then 'CIERRE' "+;  
				               "End) as mes_desmes "+;             
				               "From  "+Ocnx.Esquema+".SYS_PERIODO_MODULOS_S04 "+;
				               "Where cia_codcia='"+NVL(ThisForm.Entorno.Codigocia,"")+"' "+;
				               "and   suc_codsuc='"+NVL(ThisForm.Entorno.Codigosuc,"")+"' "+;
				               "and   s03_codmod='"+NVL(ThisForm.Entorno.Modulo,"")+"' "+;
				               "and   ano_codano='"+NVL(sys_anos.ano_codano,"")+"'"	 
			 ENDIF 
		ELSE
			This.SqlSelect="Select mes_codmes,"+;
			               "(Case mes_codmes "+;
			               "When '00' then 'APERTURA' "+;
			               "When '01' then 'ENERO' "+;
			               "When '02' then 'FEBRERO' "+;
			               "When '03' then 'MARZO' "+;
			               "When '04' then 'ABRIL' "+;
			               "When '05' then 'MAYO' "+;
			               "When '06' then 'JUNIO' "+;
			               "When '07' then 'JULIO' "+;
			               "When '08' then 'AGOSTO' "+;
			               "When '09' then 'SEPTIEMBRE' "+;
			               "When '10' then 'OCTUBRE' "+;
			               "When '11' then 'NOVIEMBRE' "+;
			               "When '12' then 'DICIEMBRE' "+;
			               "When '13' then 'CIERRE' "+;  
			               "End) as mes_desmes "+;             
			               "From  SYS_PERIODO_MODULOS_S04 "+;
			               "Where cia_codcia='"+NVL(ThisForm.Entorno.Codigocia,"")+"' "+;
			               "and   suc_codsuc='"+NVL(ThisForm.Entorno.Codigosuc,"")+"' "+;
			               "and   s03_codmod='"+NVL(ThisForm.Entorno.Modulo,"")+"' "+;
			               "and   ano_codano='"+NVL(sys_anos.ano_codano,"")+"' "+;
			               "and   mes_codmes in "+;
			    	       "(Select distinct mes_codmes "+;
				           " From PERIODO_PLANILLA_PPE  "+;
				           " Where cia_codcia='"+NVL(ThisForm.Entorno.Codigocia,"")+"' "+;
				           " and   suc_codsuc='"+NVL(ThisForm.Entorno.Codigosuc,"")+"' "+;
				           " and   tpl_codtpl='"+NVL(ThisForm.Entorno.Nomina,"")+"' "+; 
			               " and   ano_codano='"+NVL(sys_anos.ano_codano,"")+"') "
			  IF Ocnx.Tipo_BD=2
				This.SqlSelect="Select mes_codmes,"+;
				               "(Case mes_codmes "+;
				               "When '00' then 'APERTURA' "+;
				               "When '01' then 'ENERO' "+;
				               "When '02' then 'FEBRERO' "+;
				               "When '03' then 'MARZO' "+;
				               "When '04' then 'ABRIL' "+;
				               "When '05' then 'MAYO' "+;
				               "When '06' then 'JUNIO' "+;
				               "When '07' then 'JULIO' "+;
				               "When '08' then 'AGOSTO' "+;
				               "When '09' then 'SEPTIEMBRE' "+;
				               "When '10' then 'OCTUBRE' "+;
				               "When '11' then 'NOVIEMBRE' "+;
				               "When '12' then 'DICIEMBRE' "+;
				               "When '13' then 'CIERRE' "+;  
				               "End) as mes_desmes "+;             
				               "From  "+Ocnx.Esquema+".SYS_PERIODO_MODULOS_S04 "+;
				               "Where cia_codcia='"+NVL(ThisForm.Entorno.Codigocia,"")+"' "+;
				               "and   suc_codsuc='"+NVL(ThisForm.Entorno.Codigosuc,"")+"' "+;
				               "and   s03_codmod='"+NVL(ThisForm.Entorno.Modulo,"")+"' "+;
				               "and   ano_codano='"+NVL(sys_anos.ano_codano,"")+"' "+;
				               "and   mes_codmes in "+;
				    	       "(Select distinct mes_codmes "+;
					           " From "+Ocnx.Esquema+".PERIODO_PLANILLA_PPE  "+;
					           " Where cia_codcia='"+NVL(ThisForm.Entorno.Codigocia,"")+"' "+;
					           " and   suc_codsuc='"+NVL(ThisForm.Entorno.Codigosuc,"")+"' "+;
					           " and   tpl_codtpl='"+NVL(ThisForm.Entorno.Nomina,"")+"' "+; 
				               " and   ano_codano='"+NVL(sys_anos.ano_codano,"")+"') "	  
			  ENDIF 
		ENDIF
		               
		               
	ENDPROC

	PROCEDURE Mes.AfterRowColChange
		LPARAMETERS nColIndex
		DODEFAULT(nColIndex)
		ThisForm.Txt_Periodo.Refresh()
		ThisForm.Carga_secuencia() 
		
	ENDPROC

	PROCEDURE txt_periodo.Init
		This.Value=ThisForm.Entorno.Periodo
		ThisForm.Tag=This.Value
	ENDPROC

	PROCEDURE txt_periodo.Refresh
		This.Value=sys_anos.ano_codano+sys_mes.mes_codmes
	ENDPROC

ENDDEFINE

DEFINE CLASS tiempo AS contenedor OF "claseosis.vcx" 
 	*< CLASSDATA: Baseclass="container" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Timer" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="tiempo" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="IndTie" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="IndVer" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: activar_sonido		&& Se ejecuta el archivo de sonido activo
		*m: configura
		*m: ejecuta_accion		&& Se Ejecuta la Accion determina de acuerdo al tiempo Indicado
		*p: archivo_sonido		&& El Archivo Donde se guarda el El Sonido , icluido la ruta
		*p: numero_veces_sonido		&& Numero de Veces que se activa el sonido
	*</DefinedPropArrayMethod>

	*<PropValue>
		archivo_sonido = ("")
		Height = 27
		Name = "tiempo"
		numero_veces_sonido = (1)
		Width = 306
	*</PropValue>

	ADD OBJECT 'IndTie' AS combo WITH ;
		DisabledBackColor = 192,192,192, ;
		DisabledForeColor = 128,128,128, ;
		Enabled = .F., ;
		Height = 24, ;
		Left = 216, ;
		Name = "IndTie", ;
		Top = 1, ;
		Value = ("MIN"), ;
		Width = 48
		*< END OBJECT: ClassLib="claseosis.vcx" BaseClass="combobox" />

	ADD OBJECT 'IndVer' AS check WITH ;
		Alignment = 0, ;
		Caption = "Verificación Automática Cada", ;
		Left = 0, ;
		Name = "IndVer", ;
		Top = 5
		*< END OBJECT: ClassLib="claseosis.vcx" BaseClass="checkbox" />

	ADD OBJECT 'tiempo' AS numerico WITH ;
		Enabled = .F., ;
		Height = 23, ;
		InputMask = "999", ;
		Left = 163, ;
		Name = "tiempo", ;
		Top = 2, ;
		Value = 5, ;
		Width = 50
		*< END OBJECT: ClassLib="claseosis.vcx" BaseClass="spinner" />

	ADD OBJECT 'Timer' AS timer WITH ;
		Height = 25, ;
		Left = 276, ;
		Name = "Timer", ;
		Top = 1, ;
		Width = 24
		*< END OBJECT: BaseClass="timer" />
	
	PROCEDURE activar_sonido		&& Se ejecuta el archivo de sonido activo
		IF !EMPTY(This.Archivo_sonido)
		   IF FILE(This.Archivo_sonido)
		      PRIVATE lset ,lns
			  lset="SET BELL TO '"+ALLTRIM(This.Archivo_sonido)+"'"
			  &lset
			  FOR lns=1 TO This.Numero_veces_sonido 
				  ?? CHR(7)
			  ENDFOR
			  SET BELL TO         
		   ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE configura
		PRIVATE lunidad
		lunidad=1000
		DO 	CASE
			CASE This.IndTie.Value="SEG" 
				 This.Timer.Interval=lunidad*This.Tiempo.Value    
			CASE This.IndTie.Value="MIN" 
				 This.Timer.Interval=(lunidad*60)*This.Tiempo.Value    
			CASE This.IndTie.Value="HOR" 
				 This.Timer.Interval=((lunidad*60)*60)*This.Tiempo.Value    
		ENDCASE
		
	ENDPROC

	PROCEDURE ejecuta_accion		&& Se Ejecuta la Accion determina de acuerdo al tiempo Indicado
	ENDPROC

	PROCEDURE IndTie.Init
		This.AddItem("SEG") 
		This.AddItem("MIN")
		This.AddItem("HOR")
		This.Value="MIN"
	ENDPROC

	PROCEDURE IndTie.Valid
		IF This.Value$"MIN,SEG"
		   This.Parent.Tiempo.KeyboardHighValue=60
		   This.Parent.Tiempo.KeyboardLowValue=1
		   This.Parent.Tiempo.SpinnerHighValue=60
		   This.Parent.Tiempo.SpinnerLowValue=1
		ELSE
		   This.Parent.Tiempo.KeyboardHighValue=24
		   This.Parent.Tiempo.KeyboardLowValue=1
		   This.Parent.Tiempo.SpinnerHighValue=24
		   This.Parent.Tiempo.SpinnerLowValue=1
		ENDIF
		IF !BETWEEN(This.Parent.Tiempo.Value,This.Parent.Tiempo.SpinnerLowValue,This.Parent.Tiempo.SpinnerHighValue)
		   This.Parent.Tiempo.Value=This.Parent.Tiempo.SpinnerLowValue    
		ENDIF
		
		This.Parent.Configura() 
	ENDPROC

	PROCEDURE IndVer.Click
		This.Parent.Tiempo.Enabled=IIF(This.Value=1,.T.,.F.) 
		This.Parent.IndTie.Enabled=IIF(This.Value=1,.T.,.F.) 
		This.Parent.Refresh()
	ENDPROC

	PROCEDURE tiempo.Click
		This.Valid()
	ENDPROC

	PROCEDURE tiempo.DownClick
		This.Valid()
	ENDPROC

	PROCEDURE tiempo.UpClick
		This.Valid()
	ENDPROC

	PROCEDURE tiempo.Valid
		This.Parent.Configura() 
	ENDPROC

	PROCEDURE Timer.Timer
		IF This.Parent.IndVer.Value=1
		   This.Parent.Ejecuta_Accion()  
		EndIf 
	ENDPROC

ENDDEFINE

DEFINE CLASS toolbar_opciones AS toolbar 
 	*< CLASSDATA: Baseclass="toolbar" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: agrega_boton
		*p: numero
	*</DefinedPropArrayMethod>

	*<PropValue>
		Caption = "Toolbar1"
		Name = "toolbar_opciones"
		numero = (0)
	*</PropValue>
	
	PROCEDURE agrega_boton
		LPARAMETERS lp_programa as String, lp_imagen as String, lp_descripcion as String 
		
		IF PARAMETERS()<3
			MESSAGEBOX("Faltan Parametros para agregar boton de opción",16,"Tool Bar Opciones")
			RETURN .F.
		ENDIF
		
		PRIVATE lsetclass
		lsetclass="Set class to '"+Oentorno.Rutaosis+"libs\opciones' additive " 
		&lsetclass
		This.AddObject(lp_programa,"boton_opcion") 
		PRIVATE lcommand
		lcommand="This."+ALLTRIM(lp_programa)+".Visible=.T."
		&lcommand
		IF !EMPTY(NVL(lp_imagen,''))
			lcommand="This."+ALLTRIM(lp_programa)+".Picture='"+Oentorno.Rutaosis+"imag\"+ALLTRIM(lp_imagen)+".bmp'"
		ELSE
			lcommand="This."+ALLTRIM(lp_programa)+".Caption='"+ALLTRIM(STR(This.Numero))+"'"
			This.Numero = This.Numero + 1
		ENDIF
		&lcommand
		lcommand="This."+ALLTRIM(lp_programa)+".ToolTipText='"+ALLTRIM(lp_descripcion)+"'"
		&lcommand
		
		
		
		
		
		
		
		 
	ENDPROC

	PROCEDURE Init
		This.Dock(0) 
	ENDPROC

ENDDEFINE

DEFINE CLASS ubica_sistema AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Etiqueta1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txt_ruta" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="BtnBusca" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Etiqueta2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="BtnAceptar" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="BtnCancelar" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Etiqueta3" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: estado
	*</DefinedPropArrayMethod>

	*<PropValue>
		AutoCenter = .T.
		Caption = "Ubique la Carpeta del Sistema"
		DoCreate = .T.
		estado = (0)
		Height = 169
		Name = "ubica_sistema"
		Width = 563
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'BtnAceptar' AS boton WITH ;
		Caption = "\<Aceptar", ;
		Left = 163, ;
		Name = "BtnAceptar", ;
		SpecialEffect = 0, ;
		Top = 120
		*< END OBJECT: ClassLib="claseosis.vcx" BaseClass="commandbutton" />

	ADD OBJECT 'BtnBusca' AS boton WITH ;
		Caption = "...", ;
		Height = 27, ;
		Left = 468, ;
		Name = "BtnBusca", ;
		SpecialEffect = 0, ;
		Top = 58, ;
		Width = 26
		*< END OBJECT: ClassLib="claseosis.vcx" BaseClass="commandbutton" />

	ADD OBJECT 'BtnCancelar' AS boton WITH ;
		Caption = "\<Cancelar", ;
		Left = 295, ;
		Name = "BtnCancelar", ;
		SpecialEffect = 0, ;
		Top = 120
		*< END OBJECT: ClassLib="claseosis.vcx" BaseClass="commandbutton" />

	ADD OBJECT 'Etiqueta1' AS etiqueta WITH ;
		Caption = "Ubique la carpeta (directorio donde se encuentra el sistema)", ;
		ForeColor = 0,0,255, ;
		Left = 12, ;
		Name = "Etiqueta1", ;
		Top = 12
		*< END OBJECT: ClassLib="claseosis.vcx" BaseClass="label" />

	ADD OBJECT 'Etiqueta2' AS etiqueta WITH ;
		Caption = "Ejemplo:  R:\Osiscli7\MiCompañia", ;
		ForeColor = 0,0,255, ;
		Left = 12, ;
		Name = "Etiqueta2", ;
		Top = 32
		*< END OBJECT: ClassLib="claseosis.vcx" BaseClass="label" />

	ADD OBJECT 'Etiqueta3' AS etiqueta WITH ;
		Caption = "Ruta", ;
		Left = 12, ;
		Name = "Etiqueta3", ;
		Top = 64
		*< END OBJECT: ClassLib="claseosis.vcx" BaseClass="label" />

	ADD OBJECT 'txt_ruta' AS texto WITH ;
		Height = 23, ;
		Left = 48, ;
		Name = "txt_ruta", ;
		Top = 60, ;
		Width = 420
		*< END OBJECT: ClassLib="claseosis.vcx" BaseClass="textbox" />
	
	PROCEDURE Init
		This.Tag = ""
	ENDPROC

	PROCEDURE Unload
		RETURN This.Tag 
	ENDPROC

	PROCEDURE BtnAceptar.Click
		ThisForm.Tag = ALLTRIM(ThisForm.txt_ruta.Value)  
		ThisForm.Release() 
	ENDPROC

	PROCEDURE BtnBusca.Click
		ThisForm.Txt_ruta.Value = GETDIR() 
	ENDPROC

	PROCEDURE BtnCancelar.Click
		ThisForm.Release() 
	ENDPROC

ENDDEFINE
