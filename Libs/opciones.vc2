	PROCEDURE Init
		DODEFAULT()
		
		This.Caption="Mensajes del Sistema"
		
		This.txtMensaje.Value  = This.Caption
		This.BtnActualiza.Click() 
	ENDPROC

	PROCEDURE BtnActualiza.Click
		ThisForm.Tiempo1.Ejecuta_accion()  
	ENDPROC

	PROCEDURE BtnCerrar.Click
		IF ThisForm.Activa_icon
			ThisForm.CmdDesactiva.Click()  
		ENDIF
		
		ThisForm.Release() 
	ENDPROC

	PROCEDURE BtnOcultar.Click
		ThisForm.Activa_icon = .T.
		ThisForm.CmdActiva.Click()  
		ThisForm.Visible=.F. 
		ThisFOrm.Deactivate 
		ThisForm.Hide 
		
	ENDPROC

	PROCEDURE Datos1.defineselect
		lfil=""
		IF ThisForm.IndLeido.Value = 1
			lfil=" and (mtr_indlec=0 or mtr_indmar<>0 ) "
		ENDIF
		
		This.SqlSelect = "Select "+;
					     "mtr_fecmtr,tms_deslar,mtr_obsmtr,mtr_indlec,"+;
					     "mtr_indmar,mtr_obsusu,tms_codtms "+;
					     "From dbo.V_Mensajes "+;
					     "Where cia_codcia='"+ThisForm.Entorno.Codigocia+"' "+; 
					     "and   UPPER(RTRIM(LTRIM(s10_usuario)))='"+ALLTRIM(UPPER(Ocnx.Usuario))+"' "+;
					     lfil+" Order By mtr_fecmtr desc "
					     
					     
	ENDPROC

	PROCEDURE Detalle.Column4.Check1.Click
		SELECT (ThisForm.Datos1.Area) 
		lcodtms=ThisForm.Datos1.Campo_valor("tms_codtms") 
		lfecmtr=ThisForm.Datos1.Campo_valor("mtr_fecmtr") 
		lobsmtr=ThisForm.Datos1.Campo_valor("mtr_obsmtr") 
		
		lcupd="Update dbo.MENSAJES_TRANSACCIONES_MTR Set "+;
			  "mtr_indlec="+STR(This.Value,1)+" "+; 
			  "From dbo.MENSAJES_TRANSACCIONES_MTR a "+;
			  "Inner Join dbo.MENSAJES_USUARIO_MSU b "+;
			  "On (b.cia_codcia=a.cia_codcia "+; 
			  "and b.tms_codtms=a.tms_codtms "+;
			  "and UPPER(RTRIM(LTRIM(b.s10_usuario)))='"+UPPER(ocnx.usuario)+"') "+;
			  "Where a.cia_codcia='"+ThisForm.Entorno.Codigocia+"' "+;
			  "and   a.tms_codtms='"+lcodtms+"' "+;
			  "and   a.mtr_obsmtr='"+lobsmtr+"'"
			  
		IF SQLEXEC(Ocnx.Conexion,lcupd)<0
			MESSAGEBOX(MESSAGE()+CHR(13)+lcupd,16,ThisForm.Caption)
		ENDIF
		ThisForm.Detalle.Refresh()  	  
	ENDPROC

	PROCEDURE Detalle.Column5.Check1.Click
		SELECT (ThisForm.Datos1.Area) 
		lcodtms=ThisForm.Datos1.Campo_valor("tms_codtms") 
		lfecmtr=ThisForm.Datos1.Campo_valor("mtr_fecmtr") 
		lobsmtr=ThisForm.Datos1.Campo_valor("mtr_obsmtr") 
		
		lcupd="Update dbo.MENSAJES_TRANSACCIONES_MTR Set "+;
			  "mtr_indmar="+STR(This.Value,1)+" "+; 
			  "From dbo.MENSAJES_TRANSACCIONES_MTR a "+;
			  "Inner Join dbo.MENSAJES_USUARIO_MSU b "+;
			  "On (b.cia_codcia=a.cia_codcia "+; 
			  "and b.tms_codtms=a.tms_codtms "+;
			  "and UPPER(RTRIM(LTRIM(b.s10_usuario)))='"+UPPER(ocnx.usuario)+"') "+;
			  "Where a.cia_codcia='"+ThisForm.Entorno.Codigocia+"' "+;
			  "and   a.tms_codtms='"+lcodtms+"' "+;
			  "and   a.mtr_obsmtr='"+lobsmtr+"'"
			  
		IF SQLEXEC(Ocnx.Conexion,lcupd)<0
			MESSAGEBOX(MESSAGE()+CHR(13)+lcupd,16,ThisForm.Caption)
		ENDIF
		ThisForm.Detalle.Refresh()  	  
	ENDPROC

	PROCEDURE Detalle.Column6.Text1.Valid
		SELECT (ThisForm.Datos1.Area) 
		lcodtms=ThisForm.Datos1.Campo_valor("tms_codtms") 
		lfecmtr=ThisForm.Datos1.Campo_valor("mtr_fecmtr") 
		lobsmtr=ThisForm.Datos1.Campo_valor("mtr_obsmtr") 
		
		lcupd="Update dbo.MENSAJES_TRANSACCIONES_MTR Set "+;
			  "mtr_obsusu='"+ALLTRIM(NVL(This.Value,""))+"' "+; 
			  "From dbo.MENSAJES_TRANSACCIONES_MTR a "+;
			  "Inner Join dbo.MENSAJES_USUARIO_MSU b "+;
			  "On (b.cia_codcia=a.cia_codcia "+; 
			  "and b.tms_codtms=a.tms_codtms "+;
			  "and UPPER(RTRIM(LTRIM(b.s10_usuario)))='"+UPPER(ocnx.usuario)+"') "+;
			  "Where a.cia_codcia='"+ThisForm.Entorno.Codigocia+"' "+;
			  "and   a.tms_codtms='"+lcodtms+"' "+;
			  "and   a.mtr_obsmtr='"+lobsmtr+"'"
			  
		IF SQLEXEC(Ocnx.Conexion,lcupd)<0
			MESSAGEBOX(MESSAGE()+CHR(13)+lcupd,16,ThisForm.Caption)
		ENDIF
		ThisForm.Detalle.Refresh()  	  
	ENDPROC

	PROCEDURE Detalle.Refresh
		DODEFAULT()
		IF USED(ThisForm.Datos1.Alias)  
			This.SetAll("DynamicFontBold","Iif("+ALLTRIM(ThisForm.Datos1.Alias)+".mtr_indlec=0,.T.,.F.)","Column")
			This.SetAll("DynamicForeColor","Iif("+ALLTRIM(ThisForm.Datos1.Alias)+".mtr_indmar=0,0,16711680)","Column")
		ENDIF
		
	ENDPROC

	PROCEDURE Entorno.Init
		DODEFAULT()
		This.Programa = "MENSAJES_USUARIO"
	ENDPROC

	PROCEDURE Tiempo1.ejecuta_accion
		IF !ThisForm.Mensaje_activo 
		    WAIT WINDOW "Verificando Mensajes....." NoWait
		
			ThisForm.Datos1.Selecciona()  
		    ThisForm.Mensaje_activo=.T. 
		
		
			SELECT (ThisForm.Datos1.Area)
			COUNT TO ThisForm.Acumulado FOR mtr_indlec=0
			GO top
			WAIT clea
			lver=.F.
			IF ThisForm.Acumulado>0
			    This.Activar_sonido() 
				IF MESSAGEBOX("Tiene "+ALLTRIM(STR(ThisForm.Acumulado))+" Nuevo(s) "+;
						   "mensaje(s) del Sistema "+CHR(13)+;
						   "¿Desea ver los mensajes?",4+32,ThisForm.Caption)=6
					lver=.T.	   	
			    ENDIF
			    					   
		    EndIf		
			ThisForm.Mensaje_activo=.F. 
			IF lver
				IF ThisForm.Activa_icon
					ThisForm.CmdDesactiva.Click() 
					ThisForm.Show()
				ENDIF
			ENDIF
			
			
		ELSE
		  	This.Activar_sonido() 
		ENDIF
		
	ENDPROC

	PROCEDURE Tiempo1.IndTie.Init
		DODEFAULT()
		This.Value = "MIN"
		This.Parent.Configura() 
	ENDPROC

	PROCEDURE Tiempo1.Init
		This.Archivo_sonido = Oentorno.RutaOsis+"imag\sonido.wav"
		DODEFAULT()
		This.indVer.Click  
	ENDPROC

	PROCEDURE Tiempo1.tiempo.Init
		DODEFAULT()
		This.Value = 1
		This.Parent.Configura() 
	ENDPROC

	PROCEDURE txtNomIco.Init
		
		ThisForm.Entorno.Init()
		This.Value=ThisForm.BtnOcultar.Picture  
		IF !FILE(This.Value)
		   MESSAGEBOX("NO EXISTE: "+ALLTRIM(This.Value))
		endIf
	ENDPROC

ENDDEFINE

