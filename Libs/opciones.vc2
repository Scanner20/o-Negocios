		cuadriculaasociada = ThisForm.Ano, ;
		Left = 240, ;
		Name = "Datos1", ;
		nombretabla = SYS_PERIODO_MODULOS_S04, ;
		Top = 96
		*< END OBJECT: ClassLib="claseosis.vcx" BaseClass="custom" />

	ADD OBJECT 'Datos2' AS datos WITH ;
		alias = SYS_MES, ;
		cuadriculaasociada = ThisForm.Mes, ;
		Left = 252, ;
