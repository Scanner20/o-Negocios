		*< END OBJECT: ClassLib="claseosis.vcx" BaseClass="label" />

	ADD OBJECT 'Etiqueta_Secuencia' AS etiqueta WITH ;
		Caption = "SECUENCIA:", ;
		Left = 48, ;
