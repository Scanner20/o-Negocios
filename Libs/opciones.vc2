	PROCEDURE Activate
		This.StatusBar.Panels[1].AutoSize=2
		This.StatusBar.Panels[1].Text="Set autoriza el uso  a: "
		This.StatusBar.Panels[2].AutoSize=2
		This.StatusBar.Panels[2].Text=ALLTRIM(ThisForm.Entorno.Nombrecia)
		This.StatusBar.Panels[3].AutoSize=2
		This.StatusBar.Panels[3].Text=TTOC(DATETIME())
		
		
	ENDPROC

	PROCEDURE Init
		DODEFAULT()
		
		
		
		 
		
		*!*	IF Ocnx.Conexion_ODBC
		*!*		This.Chk_Servidor.Visible = .F.
		*!*		This.txt_servidor.Visible = .F.
		*!*		This.txt_odbc.Visible = .T.
		*!*		This.Et_odbc.Visible = .T.
		*!*		This.Etiqueta4.Visible = .F. 
		*!*		This.Cmb_data.Visible = .F.
		*!*	    This.Cmb_conexion.Visible = .F. 
		*!*		This.Etiqueta3.Visible = .F. 
		*!*	ELSE
		*!*		This.Chk_Servidor.Visible = .T.
		*!*		This.txt_servidor.Visible = .T.
		*!*		This.txt_odbc.Visible = .F.
		*!*		This.Et_odbc.Visible = .F.
		*!*		This.Etiqueta4.Visible = .T. 
		*!*		This.Cmb_data.Visible = .T.
		*!*	    This.Cmb_conexion.Visible = .T. 
		*!*		This.Etiqueta3.Visible = .T.
		*!*	ENDIF
		
	ENDPROC

	PROCEDURE Load
		DODEFAULT()
		ON SHUTDOWN Oapp.OnShutdown()
		
	ENDPROC

	PROCEDURE Refresh
		DODEFAULT()
		IF This.CtnOtros.Visible  
			This.Height = This.CtnOtros.Top + This.CtnOtros.Height + This.StatusBar.Height + 6
		ELSE
			This.Height = This.BtnVerOtros.Top + This.BtnVerOtros.Height +   This.StatusBar.Height + 6
		ENDIF
		This.AutoCenter = .T.
			 
	ENDPROC

	PROCEDURE Unload
		RETURN This.Continua
	ENDPROC

	PROCEDURE verifica_usuario		&& Este Metodo se utiliza para Verificar si usuario Existe Registrado como usuario del Sistema
	ENDPROC

	PROCEDURE botongrupo.Cmb_Aceptar.Click
		lb=.t.
		IF EMPTY(ThisForm.Txt_usuario.Value)
		   MESSAGEBOX("TIENE QUE INGRESAR UN USUARIO",64,"LOGIN")
		   RETURN .f.
		ENDIF
		
		IF EMPTY(ThisForm.Txt_password.Value) AND ThisForm.Txt_password.Enabled  
		   MESSAGEBOX("TIENE QUE INGRESAR SU PASSWORD",64,"LOGIN")
		   RETURN .f.
		ENDIF
		&&SUSP
		Ocnx.Driver	   = ThisForm.CtnOtros.Cmb_conexion.List[ThisForm.CtnOtros.Cmb_conexion.ListIndex,3]   
		Ocnx.servidor  = ALLTRIM(ThisForm.CtnOtros.Txt_servidor.Value)
		Ocnx.usuario   = ALLTRIM(ThisForm.Txt_usuario.Value)
		Ocnx.password  = ALLTRIM(ThisForm.Txt_password.Value)
		Ocnx.Tipo_Bd   = VAL(ThisForm.CtnOtros.Cmb_conexion.List[ThisForm.CtnOtros.Cmb_conexion.ListIndex,4])  
		Ocnx.Confianza = (ThisForm.CtnOtros.IndCon.Value = 1)
		Ocnx.BaseDatos = ALLTRIM(ThisForm.CtnOtros.Cmb_data.Value)  
		Oentorno.Tienda= ALLTRIM(ThisForm.CtnOtros.txt_tienda.Value)  
		Ocnx.ODBC	   = ALLTRIM(Thisform.CtnOtros.txt_odbc.Value)  
		Ocnx.TNS	   = ALLTRIM(Thisform.CtnOtros.txt_tns.Value)  
		Ocnx.Conexion_odbc =IIF(ThisForm.ctnOtros.txt_odbc.Enabled,.T.,.F.)
		&&susP
		IF !Ocnx.Conectar()
		    RETURN .f.
		ENDIF
		ThisForm.Entorno.Idioma_ingles = Oentorno.Idioma_ingles
		ThisForm.Continua=.t.
		ThisForm.Release()
		
	ENDPROC

	PROCEDURE botongrupo.Cmb_Cancelar.Click
		DODEFAULT()
		CLEAR EVENTS
		
	ENDPROC

	PROCEDURE BtnVerOtros.Click
		IF ALLTRIM(This.Caption)==">>"
			This.Caption ="<<"
			This.Refresh() 
			ThisForm.CtnOtros.Visible = .T.
			ThisForm.CtnOtros.Refresh() 
			
		ELSE
			This.Caption=">>"
			This.Refresh() 
			ThisForm.CtnOtros.Visible = .F.
			ThisForm.CtnOtros.Refresh() 
		ENDIF
		ThisForm.Refresh() 
	ENDPROC

	PROCEDURE CtnOtros.Chk_Tienda.Click
		IF THis.Value = 0
			This.Parent.txt_tienda.Init()   
		ENDIF
		
		This.Parent.Txt_tienda.Refresh()   
	ENDPROC

	PROCEDURE CtnOtros.Cmb_conexion.Init
		TRY 
		*!*		CREATE CURSOR "Temcnx"(descri c(30), codigo c(1), driver c(60), tipo c(1))
		
		*!*		INSERT INTO "Temcnx" VALUES ("SQL Server","1","SQL Server","1")
		*!*		INSERT INTO "Temcnx" VALUES ("Oracle","2","Oracle in XE","2")
		*!*		INSERT INTO "Temcnx" VALUES ("MySQL ODBC 3.51 Driver","3","MySQL ODBC 3.51 Driver;option=1","3")
		*!*		INSERT INTO "Temcnx" VALUES ("WEBSERVICE - OSIS","4","","4")
		*!*		INSERT INTO "Temcnx" VALUES ("SQL Native Client","5","SQL Native Client","1")
		
			lruta=ThisForm.Entorno.Rutaosis +"libs\"
			
			SELECT descri,codigo,driver,tipo,confianza,;
				   dns,server,database,tns ;
			From lruta+"confconect" INTO CURSOR  "Temcnx"
			
			IF USED("confconect")
				USE IN "confconect"
			ENDIF
			
			
		
			This.BoundColumn = 2
			This.RowSourceType = 2
			This.RowSource = "Temcnx"
			This.Requery() 
		
			This.Value =  STR(Ocnx.Tipo_BD,1)
			This.Refresh() 
		CATCH TO lerror
			MESSAGEBOX(lerror.message+CHR(13)+MESSAGE(1),16,ThisForm.Caption) 
		ENDTRY
		
	ENDPROC

	PROCEDURE CtnOtros.Cmb_conexion.InteractiveChange
		DODEFAULT()
		This.Parent.Cmb_conexion.Refresh()   
		This.Parent.Cmb_data.Refresh()   
		This.Parent.txt_odbc.Refresh()   
		This.Parent.txt_servidor.Refresh()   
		This.Parent.txt_tienda.Refresh()   
		This.Parent.txt_tns.Refresh()   
		This.Parent.indCon.Refresh()   
		This.Parent.chk_Tienda.Refresh()   
		IF This.Parent.txt_odbc.Enabled 
			This.Parent.txt_odbc.Init() 
		ENDIF
		
	ENDPROC

	PROCEDURE CtnOtros.Cmb_data.Init
		DODEFAULT()
		This.AddItem(Ocnx.BaseDatos) 
		This.Value=Ocnx.BaseDatos
	ENDPROC

	PROCEDURE CtnOtros.Cmb_data.Refresh
		This.DisabledBackColor = THisForm.BackColor 
		This.DisabledForeColor = RGB(0,0,160)
		This.Enabled=(ALLTRIM(This.Parent.Cmb_conexion.List[This.Parent.Cmb_conexion.ListIndex,8])=="1")
	ENDPROC

	PROCEDURE CtnOtros.IndCon.Click
		ThisForm.txt_usuario.Refresh()  
		ThisForm.txt_password.Refresh()  
	ENDPROC

	PROCEDURE CtnOtros.IndCon.Refresh
		This.Enabled=(ALLTRIM(This.Parent.Cmb_conexion.List[This.Parent.Cmb_conexion.ListIndex,5])=="1")
	ENDPROC

	PROCEDURE CtnOtros.txtPropietario.Init
		DODEFAULT()
		This.Value = Ocnx.Esquema
		
	ENDPROC

	PROCEDURE CtnOtros.txtPropietario.Refresh
		This.DisabledBackColor = THisForm.BackColor 
		This.DisabledForeColor = RGB(0,0,160)
		This.Enabled=(ALLTRIM(This.Parent.Cmb_conexion.List[This.Parent.Cmb_conexion.ListIndex,9])=="1")
	ENDPROC

	PROCEDURE CtnOtros.txt_odbc.Init
		DODEFAULT()
		This.Clear() 
		m.regfile = "\osisv9\progs\registry.fxp"
		lodbc=.T.
		IF FILE(m.regfile)
			SET PROCEDURE TO (m.regfile) ADDITIVE 
			DIMENSION aODBCData[1]
			oReg = CreateObject("ODBCReg")
			oReg.GetODBCDrvrs(@aODBCData,.T.)
			PRIVATE lcanfil,ln
			lcanfil=ALEN(aODBCData,1)
		
			IF lcanfil>1
			   FOR  ln=1 TO lcanfil
				    IF ALLTRIM(UPPER(aODBCData[ln,2]))==UPPER(ALLTRIM(This.Parent.Cmb_conexion.List[This.Parent.Cmb_conexion.ListIndex,3]))	   		
					   lodbc=.F.		    	
					   This.AddItem(UPPER(aODBCData[ln,1])) 
				    ENDIF
			   ENDFOR
			ENDIF
		ENDIF
		IF lodbc=.T.
			This.AddItem(Ocnx.ODBC)
		ENDIF
		This.Value = UPPER(Ocnx.ODBC)
			
		
			
	ENDPROC

	PROCEDURE CtnOtros.txt_odbc.Refresh
		This.DisabledBackColor = THisForm.BackColor 
		This.DisabledForeColor = RGB(0,0,160)
		This.Enabled=(ALLTRIM(This.Parent.Cmb_conexion.List[This.Parent.Cmb_conexion.ListIndex,6])=="1")
	ENDPROC

	PROCEDURE CtnOtros.txt_servidor.Init
		DODEFAULT()
		This.Value = Ocnx.Servidor
	ENDPROC

	PROCEDURE CtnOtros.txt_servidor.Refresh
		This.DisabledBackColor = THisForm.BackColor 
		This.DisabledForeColor = RGB(0,0,160)
		This.Enabled=(ALLTRIM(This.Parent.Cmb_conexion.List[This.Parent.Cmb_conexion.ListIndex,7])=="1")
	ENDPROC

	PROCEDURE CtnOtros.txt_tienda.Init
		DODEFAULT()
		This.Value = Oentorno.tienda
		
	ENDPROC

	PROCEDURE CtnOtros.txt_tienda.Refresh
		This.DisabledBackColor = THisForm.BackColor 
		This.DisabledForeColor = RGB(0,0,160)
		This.Enabled = (This.Parent.Chk_Tienda.Value = 1)
	ENDPROC

	PROCEDURE CtnOtros.txt_tns.Init
		DODEFAULT()
		This.Value = Ocnx.TNS
		
	ENDPROC

	PROCEDURE CtnOtros.txt_tns.Refresh
		This.DisabledBackColor = THisForm.BackColor 
		This.DisabledForeColor = RGB(0,0,160)
		This.Enabled=(ALLTRIM(This.Parent.Cmb_conexion.List[This.Parent.Cmb_conexion.ListIndex,9])=="1")
	ENDPROC

	PROCEDURE txt_password.Refresh
		DODEFAULT()
		This.DisabledBackColor = THisForm.BackColor 
		This.DisabledForeColor = RGB(0,0,160)
		This.Enabled = (ThisForm.CtnOtros.IndCon.Value=0) 
	ENDPROC

	PROCEDURE txt_usuario.Refresh
		DODEFAULT()
		This.DisabledBackColor = THisForm.BackColor 
		This.DisabledForeColor =RGB(0,0,160)
		This.Enabled = (ThisForm.CtnOtros.IndCon.Value=0) 
	ENDPROC

ENDDEFINE

