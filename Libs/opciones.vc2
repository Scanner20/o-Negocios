	PROCEDURE Activate
		DODEFAULT()
		This.Entorno.Programa ="OPCIONES" 
		This.Resize()
		This.Caption = "Opciones del Sistema"
		IF UPPER(This.ENtorno.Idioma_ingles)==UPPER(Ocnx.Idioma)
			This.Caption="Options of the System"
		ENDIF
		
	ENDPROC

	PROCEDURE actualizadatos		&& Se ejecuta para actulizar los Datos de la Pantalla
		PRIVATE lperiodoactivo
		lperiodoactivo=""
		IF !EMPTY(This.Entorno.Periodo)
			lvalor=VAL(RIGHT(This.Entorno.Periodo,2))
			IF BETWEEN(lvalor,1,12)
			   lcmes=UPPER(Oapp.Mes[lvalor])
			ELSE
			   IF lvalor=0 
			      lcmes="APERTURA"
			   ELSE
			      lcmes="CIERRE"
			   EndIf
			ENDIF
			lperiodoactivo=LEFT(This.Entorno.Periodo,4)+" "+lcmes
		ENDIF
		
		ThisForm.Marco1.Txt_periodo.Value=lperiodoactivo
		ThisForm.Marco1.Txt_periodo.Refresh()
		*!*	ThisForm.Marco1.Txt_nomina.Value=Oentorno.NombreNomina
		*!*	ThisForm.Marco1.Txt_nomina.Refresh() 
		ThisForm.Marco1.txt_periodo_nomina.Value = Oentorno.PeriodoPlanilla 
		ThisForm.Marco1.txt_periodo_nomina.Refresh() 
		
		    
		
		 
		
	ENDPROC

	PROCEDURE agrega_toolbar_opciones
		LPARAMETERS lp_caption as String 
		
		
		IF TYPE("This.Botones[1,1]")=="C"
			PRIVATE llen,ln,lsetclass 
			PUBLIC ltoolbar_opciones
			llen=ALEN(This.Botones,1)
			lsetclass="Set Class to '"+ALLTRIM(ThisForm.Entorno.Rutaosis)+"libs\opciones' additive "
			&lsetclass
			ltoolbar_opciones=CREATEOBJECT("toolbar_opciones")  
			ltoolbar_opciones.visible=.T.
			ltoolbar_opciones.Caption=lower(ALLTRIM(lp_caption))
			&&LPARAMETERS lp_programa as String, lp_rutaimagen as String, lp_descripcion as String 
		
			FOR  ln=1 TO llen
				ltoolbar_opciones.Agrega_Boton(ALLTRIM(This.Botones[ln,1]),This.Botones[ln,3],This.Botones[ln,2])
			ENDFOR
		ENDIF
		
	ENDPROC

	PROCEDURE cerrar
		IF MESSAGEBOX("¿ Seguro de Salir del Sistema ?",4+32,"Salir")=7
		   RETURN 
		ENDIF
		DODEFAULT()
		CLEAR EVENTS
		
	ENDPROC

	PROCEDURE compania
		This.Marco1.ImagenCia.PictureVal =""  
		This.Abrir("companias",.f.,This.Entorno.RutaOSIS)
		This.Entorno.Codigocia=Oentorno.Codigocia
		This.Entorno.Codigosuc=Oentorno.Codigosuc
		This.Entorno.Nombrecia=Oentorno.Nombrecia
		This.Entorno.Nombresuc=Oentorno.Nombresuc
		
		This.Logo_cia() 
		This.OleTree2.Nodes.Clear   
		This.OleTree.Nodes.Clear
		This.OleTree.Init()  	 
		This.Oletree.NodeClick(This.Oletree.Object.SelectedItem)
		This.Entorno.Init()
		This.Marco1.txt_nomina.Init()
	ENDPROC

	PROCEDURE Destroy
		DODEFAULT()
		Otbr.Refresh()
	ENDPROC

	PROCEDURE Init
		DODEFAULT()
		&&SUSP
		This.WindowState=2 
		This.StatusBar.Align=2 
		This.StatusBar.Refresh()
		This.StatusBar.Panels[3].Text="Conexión: "+IIF(Ocnx.tipo_bd=4,"WEB","ODBC")  
		
		IF UPPER(This.ENtorno.Idioma_ingles)==UPPER(Ocnx.Idioma)
			This.Caption="Options of the System"
			This.StatusBar.Panels[3].Text="Connection "+IIF(Ocnx.tipo_bd=4,"WEB","ODBC")  
		ENDIF
		
		PRIVATE lvaexe,lalias,lused
		
		IF Ocnx.tipo_bd=1 OR Ocnx.tipo_bd=3
			lalias=SYS(2015)
			IF Ocnx.tipo_bd=1 
				lvaexe="SELECT   CONVERT(char(20), SERVERPROPERTY('servername')) as servidor "
			ENDIF
			IF Ocnx.tipo_bd=2
				lvaexe="SELECT sys_context('USERENV', 'SERVER_HOST')  AS servidor FROM dual "
			ENDIF
		
			IF Ocnx.tipo_bd=3
				lvaexe="SELECT   '"+ALLTRIM(Ocnx.Servidor)+"' as servidor "
			ENDIF
					
			IF SQLEXEC(Ocnx.Conexion,lvaexe,lalias)>0
		   	    This.StatusBar.Panels[1].Text="Servidor: "+ALLTRIM(Nvl(Servidor,''))
			ENDIF
			IF USED(lalias)
				lused="Use in '"+lalias+"'"
				&lused
			ENDIF
			lalias=SYS(2015)
			IF Ocnx.Tipo_BD=1
				lvaexe="Select @@spid as conexion "
			ENDIF
			IF Ocnx.Tipo_BD=2
				lvaexe="SELECT sys_context('USERENV', 'SID') as conexion FROM dual"
			ENDIF
				
			IF Ocnx.Tipo_BD=3
				lvaexe="Select CONNECTION_ID() as conexion "
			ENDIF
					
			IF SQLEXEC(Ocnx.Conexion,lvaexe,lalias)>0
				lncx=IIF(TYPE("conexion")=="N",conexion,VAL(conexion))
		   	    This.StatusBar.Panels[2].Text="Spid: "+ALLTRIM(STR(Nvl(lncx,0)))
			ENDIF
			IF USED(lalias)
				lused="Use in '"+lalias+"'"
				&lused
			ENDIF
		
		ENDIF
		This.Logo_cia() 
		IF This.Dockable = 2 
			This.Dock(1) 
		ENDIF
		
		
		
		
		  
		
		
		
		
		
		
	ENDPROC

	PROCEDURE logo_cia
		PRIVATE lexe,lalias,lused,lcampo
		
		TRY 
			lexe="Select cia_logcia "+;
				 "From COMPANIA_CIA "+;
				 "Where cia_codcia='"+This.Entorno.Codigocia+"' "
			
			IF Ocnx.Tipo_BD = 2
				lexe="Select cia_logcia "+;
					 "From "+Ocnx.Esquema+".COMPANIA_CIA "+;
					 "Where cia_codcia='"+This.Entorno.Codigocia+"' "	
		*!*			lexe="Select '' as cia_imacia "+;
		*!*				 "From "+Ocnx.Esquema+".COMPANIA_CIA "+;
		*!*				 "Where cia_codcia='"+This.Entorno.Codigocia+"' "	
			ENDIF 
		
			lalias=SYS(2015)	 
			&&MESSAGEBOX(lexe)
			IF SQLEXEC(Ocnx.Conexion,lexe,lalias)<0
				MESSAGEBOX(MESSAGE()+CHR(13)+LEXE,16,This.Caption) 
			ELSE
				lcampo=lalias+".cia_logcia" 
				&&lcampo=lalias+".cia_imacia"
				IF !EMPTY(NVL(&lcampo,''))
					This.Marco1.ImagenCia.PictureVal = &lcampo
				ENDIF
					
			ENDIF
		
			IF USED(lalias)	
				lused="USE IN '"+lalias+"' "
				&lused
			ENDIF
		CATCH TO lerror
			MESSAGEBOX(lerror.message+CHR(13)+CHR(13)+MESSAGE(1),16,This.Name+"."+NVL(lerror.procedure,"")) 
		ENDTRY
		
	ENDPROC

	PROCEDURE menu_modulos
		LPARAMETERS lp_alias as String 
		
		IF PARAMETERS()=0
			MESSAGEBOX("Falta Parametros")
			RETURN .F.
		ENDIF
		
		
		CREATE  Cursor &lp_alias (s03_codmod c(5),s03_nomlar c(50),s03_indnom n(10,0))
		
		Private lcodmod,lnomlar,lnomcor,lsitreg,ltipopc,lnivmod,lperext
		Private lindest,lindes2,lnivusu,lcodus2,lcodci2,lcodsu2,lindins,lindexi,lindnom
		
		
		PRIVATE lexe
		
		IF !EMPTY(ALLTRIM(NVL(Ocnx.Usuario_Perfil,'')))
			lcodusu=Ocnx.Usuario_Perfil
		ELSE
			lcodusu=Ocnx.Usuario
		ENDIF 
		
		lexe="Select s10_nivusu "+;
		     "From SYS_TABLA_USUARIOS_S10 "+;
		     "Where Upper(s10_usuario)='"+UPPER(lcodusu)+"'"
		     
		IF Ocnx.Tipo_BD = 2
			lexe="Select s10_nivusu "+;
			     "From "+Ocnx.Esquema+".SYS_TABLA_USUARIOS_S10 "+;
			     "Where Upper(s10_usuario)='"+UPPER(lcodusu)+"'"
		ENDIF 
		
		IF SQLEXEC(Ocnx.Conexion,lexe,"TemMenu")<0
			MESSAGEBOX(MESSAGE()+CHR(13)+lexe,16,This.Caption)
			RETURN .F.
		ENDIF
		
		
		lnivusu=NVL(TemMenu.s10_nivusu,0)
		
		
		lindins=0
		
		DO CASE 
			CASE Ocnx.Tipo_BD=1
				lexe=""+;
				"Select "+;
				"a.s03_codmod,a.s03_nomlar,a.s03_nomcor,a.s09_tipopc,"+;
				"a.s09_sitreg,a.s03_nivmod,a.s03_perext,ISNULL(a.s03_indest,'0') as s03_indest,"+;
				" (Select ISNULL(x.s03_indest,'0') "+;
				"  From SYS_TABLA_MODULOS_S03 x "+;
				"  Where x.s03_codmod=(Case When length(a.s03_codmod)=1 "+; 
				"              			   Then a.s03_codmod "+;
				"              			   Else left(a.s03_codmod,length(a.s03_codmod)-1) "+;
				"                     	End) "+;
				"  and  length(x.s03_codmod)>=1 "+;
				" ) as 's03_indes2',"+;
				"a.s03_indnom "+;
				"From SYS_TABLA_MODULOS_S03 a "+;
				"Where length(a.s03_codmod)>=1  "
			CASE Ocnx.Tipo_BD=2
				lexe=""+;
				"Select "+;
				"a.s03_codmod,a.s03_nomlar,a.s03_nomcor,a.s09_tipopc,"+;
				"a.s09_sitreg,a.s03_nivmod,a.s03_perext,Nvl(a.s03_indest,'0') as s03_indest,"+;
				" (Select NVL(x.s03_indest,'0') "+;
				"  From "+Ocnx.Esquema+".SYS_TABLA_MODULOS_S03 x "+;
				"  Where rtrim(LTRIM(x.s03_codmod))=(Case When length(RTRIM(LTRIM(a.s03_codmod)))=1 "+; 
				"              			   Then rtrim(LTRIM(a.s03_codmod)) "+;
				"              			   Else Substr(a.s03_codmod,1,length(RTRIM(LTRIM(a.s03_codmod)))-1) "+;
				"                     	End) "+;
				"  and  length(RTRIM(LTRIM(x.s03_codmod)))>=1 "+;
				" ) as s03_indes2,"+;
				"a.s03_indnom "+;
				"From "+Ocnx.Esquema+".SYS_TABLA_MODULOS_S03 a "+;
				"Where length(RTRIM(LTRIM(a.s03_codmod)))>=1  "+;
				"Order By a.s03_codmod "
		ENDCASE
		
		IF SQLEXEC(Ocnx.Conexion,lexe,"TemMenu")<0
			MESSAGEBOX(MESSAGE()+CHR(13)+lexe,16,This.Caption)
			RETURN .F.
		ENDIF
		GO top
		SCAN
			 lcodmod=s03_codmod
			 lnomlar=s03_nomlar
			 lnomcor=s03_nomcor
			 ltipopc=s09_tipopc
			 lsitreg=s09_sitreg
			 lnivmod=s03_nivmod
			 lperext=s03_perext
			 lindest=s03_indest
			 lindes2=s03_indes2
			 lindnom=s03_indnom
		                           
			&&********************************************************************************/
		        &&********************* Codiciones ********************/
			If lindest=='1' and lindes2=='1'
				lindins=1
		    Else
			    lindins=0
		    ENDIF 
		 
		    If lindins=1 and lnivusu<9
					&&**** Verifica Acceso por Compañia ******/
					lexe="Select count(*) as Canti "+;
			             "From SYS_MODULOS_USUARIOS_S11 "+;
			             "Where cia_codcia='"+This.Entorno.Codigocia+"' "+;
						 "and   suc_codsuc='"+This.Entorno.CodigoSuc+"' "+;
						 "and   s03_codmod='"+ALLTRIM(lcodmod)+"' "+;
			             "and   Upper(s10_usuario)='"+UPPER(lcodusu)+"'"
			 
			 		IF Ocnx.Tipo_BD = 2
						lexe="Select count(*) as Canti "+;
				             "From "+Ocnx.Esquema+".SYS_MODULOS_USUARIOS_S11 "+;
				             "Where cia_codcia='"+This.Entorno.Codigocia+"' "+;
							 "and   suc_codsuc='"+This.Entorno.CodigoSuc+"' "+;
							 "and   s03_codmod='"+ALLTRIM(lcodmod)+"' "+;
				             "and   Upper(s10_usuario)='"+UPPER(lcodusu)+"'"	 		
			 		ENDIF 
			 
			 	   IF SQLEXEC(Ocnx.Conexion,lexe,"temexis")<0
			 	   		MESSAGEBOX(MESSAGE()+CHR(13)+lexe,16,This.Caption)
			 	   		RETURN .F.
			 	   ENDIF
			 	   
			                             
			       lindexi=temexis.Canti
			                    
			       IF USED("temexis") 
			       	  USE IN "temexis"
			       ENDIF
			                            
				   If lindexi=0
					   lindins=0
			       ENDIF
			  ENDIF
			  	       
		       &&*************Inserta Opciones Disponibles ***********/  
		       If lindins=1
					Insert Into &lp_alias (s03_codmod,s03_nomlar,s03_indnom) ;	
		            	    Values (lcodmod,lnomlar,Nvl(lindnom,0))	
			   ENDIF
				   
			&&********************************************************************************/
		
			SELECT "TemMenu"
		ENDSCAN
		
		
			
	ENDPROC

	PROCEDURE menu_opciones
		LPARAMETERS lp_alias as String , lp_codmod as String 
		
		IF PARAMETERS()<2
			MESSAGEBOX("Faltan Parametros")
			RETURN .F.
		ENDIF
		
		
		CREATE Cursor &lp_alias (s08_codmen c(5),s08_codenl c(5),s08_nomopc c(80),s09_tipopc c(4),s07_codopc c(20),;
								s08_indbot n(1),s07_nomima c(20))
		
		
		PRIVATE  lcodmen,lcodenl,lnomopc,ltipopc,lindest,lindes2,lnivusu,lindins,lcoden2,lcodme2,lcoden3 char(5)
		PRIVATE  lcodme3,lindexi,lindcon,lindacc,lindpas,lcodopc
		
		lindins=0
		
		PRIVATE lexe
		
		IF !EMPTY(ALLTRIM(NVL(Ocnx.Usuario_Perfil,'')))
			lcodusu=Ocnx.Usuario_Perfil
		ELSE
			lcodusu=Ocnx.Usuario
		ENDIF 
		
		lexe="Select s10_nivusu "+;
			 "From SYS_TABLA_USUARIOS_S10 "+;
			 "Where Upper(s10_usuario)='"+UPPER(lcodusu)+"'"
		
		IF Ocnx.Tipo_BD = 2
			lexe="Select s10_nivusu "+;
				 "From "+Ocnx.Esquema+".SYS_TABLA_USUARIOS_S10 "+;
				 "Where Upper(s10_usuario)='"+UPPER(lcodusu)+"'"
		ENDIF 
		
		IF SQLEXEC(Ocnx.Conexion,lexe,"TempUsu")<0
			MESSAGEBOX(MESSAGE()+CHR(13)+lexe,16,ThisForm.Caption)
			RETURN .F.
		ENDIF
			 
		
		lnivusu=NVL(TempUsu.s10_nivusu,0)
		
		IF Ocnx.Tipo_BD=1 OR Ocnx.Tipo_BD=4
			lisnull="IsNull(s11_indcon,'0')"
		ENDIF
		IF Ocnx.Tipo_BD=2
			lisnull="Nvl(s11_indcon,'0')"
		ENDIF
		
		IF Ocnx.Tipo_BD=3
			lisnull="IfNull(s11_indcon,'0')"
		ENDIF
			
		lexe="Select "+lisnull+" as s11_indcon "+;
			 "From sys_modulos_usuarios_s11 "+;
			 "Where cia_codcia='"+This.Entorno.CodigoCia+"' "+;
			 "and   suc_codsuc='"+This.Entorno.CodigoSuc+"' "+;		
			 "and   s03_codmod='"+lp_codmod+"' 				"+;
			 "And   UPPER(s10_usuario)='"+TRIM(UPPER(lcodusu))+"' "	
		
		IF Ocnx.Tipo_BD = 2
			lexe="Select "+lisnull+" as s11_indcon "+;
				 "From "+Ocnx.Esquema+".sys_modulos_usuarios_s11 "+;
				 "Where cia_codcia='"+This.Entorno.CodigoCia+"' "+;
				 "and   suc_codsuc='"+This.Entorno.CodigoSuc+"' "+;		
				 "and   s03_codmod='"+lp_codmod+"' "+;
			 	 "And   TRIM(UPPER(s10_usuario))='"+TRIM(UPPER(lcodusu))+"' "			 
		ENDIF 
		
		IF SQLEXEC(Ocnx.Conexion,lexe,"Temmodu")<0
			MESSAGEBOX(MESSAGE()+CHR(13)+lexe,16,This.Caption)
			RETURN .F.
		ENDIF
		
		
		lindcon=Temmodu.s11_indcon
		
		lindpas=1
		
		DO CASE 
			CASE Ocnx.Tipo_BD=1
				lexec=""+;
				"Select a.s08_codmen,a.s08_codenl,a.s08_nomopc,"+;
				" ISNULL(b.s09_tipopc,'') as s09_tipopc,"+;
				" a.s08_indest,ISNULL(c.smu_indacc,0) as smu_indacc,"+;
				" b.s07_codopc,a.s08_indbot,b.s07_nomima  "+;
				"  From sys_menu_modulos_s08 a  "+;
				"  Left outer join SYS_TABLA_OPCIONES_S07 b "+;
				"          On (b.s07_codopc=a.s07_codopc)  "+;
				"Left Outer Join SYS_MODULOS_MENU_USUARIOS_SMU c "+;
				"On (c.s03_codmod=a.s03_codmod "+;			   
				"and c.s08_codmen=a.s08_codmen "+;
				"and Upper(c.s10_usuario)='"+UPPER(lcodusu)+"') "+;
				"Where a.s03_codmod='"+lp_codmod+"' "+;
				"and   a.s08_indest='1' "
			CASE Ocnx.Tipo_BD=2
				lexec=""+;
				"Select a.s08_codmen,a.s08_codenl,a.s08_nomopc,"+;
				" NVL(b.s09_tipopc,'') as s09_tipopc,"+;
				" a.s08_indest,NVL(c.smu_indacc,0) as smu_indacc,"+;
				" b.s07_codopc ,NVL(a.s08_indbot,0) as s08_indbot,NVL(b.s07_nomima,'') as s07_nomima "+;
				"  From "+Ocnx.Esquema+".sys_menu_modulos_s08 a  "+;
				"  Left join "+Ocnx.Esquema+".SYS_TABLA_OPCIONES_S07 b "+;
				"          On (b.s07_codopc=a.s07_codopc)  "+;
				"Left Join "+Ocnx.Esquema+".SYS_MODULOS_MENU_USUARIOS_SMU c "+;
				"On (c.s03_codmod=a.s03_codmod "+;			   
				"and c.s08_codmen=a.s08_codmen "+;
				"and Upper(RTRIM(LTRIM(c.s10_usuario)))='"+UPPER(ALLTRIM(lcodusu))+"') "+;
				"Where RTRIM(LTRIM(a.s03_codmod))='"+ALLTRIM(lp_codmod)+"' "+;
				"and   a.s08_indest='1' "+;
				"Order By a.s08_codmen "
		ENDCASE
		
		
		IF SQLEXEC(Ocnx.Conexion,lexec,"Temmodu")<0
			MESSAGEBOX(MESSAGE()+CHR(13)+lexec,16,This.Caption)
			RETURN .F.
		ENDIF
		INDEX On s08_codmen Tag I
		GO TOP 
		SCAN
			lcodmen=s08_codmen
			lcodenl=s08_codenl
			lnomopc=s08_nomopc
			ltipopc=s09_tipopc
			lindest=s08_indest
			lindacc=smu_indacc
			lcodopc=s07_codopc
			lindbot=s08_indbot
			lnomima=s07_nomima
			&&*************** Verifica Situación ***************************/
		    If lindcon=='1' and lnivusu<9
				If lindacc=1
				   lindpas=1	
				   lindins=1		
		        Else
				   lindpas=0	
				   lindins=0		
		        ENDIF
		    ELSE
			      lindpas=1	
				  lindins=1		
			ENDIF
			&&*************************************************************/
			If lindins=1
				Insert Into &lp_alias (s08_codmen,s08_codenl,s08_nomopc,s09_tipopc,s07_codopc) ;
				Values (NVL(lcodmen,''),NVL(lcodenl,''),NVL(lnomopc,''),NVL(ltipopc,''),NVL(lcodopc,''))
		     ENDIF
		     SELECT "Temmodu"      
		ENDSCAN
		
		IF USED("Temmodu")
			USE IN "Temmodu"
		ENDIF
		
		lselec="Select '"+lp_alias+"'"
		&lselec
		
	ENDPROC

	PROCEDURE periodo
		PRIVATE lperidev
		lperidev=This.Entorno.Periodo
		This.OleTree2.SetFocus()
		
		lperidev=This.Abrir("periodo",lperidev,This.Entorno.RutaOsis) 
		lperidev=NVL(lperidev,SPACE(6))
		
		*!*	IF UPPER(Ocnx.Usuario)=="EPALOMINO"
		*!*		SUSP
		*!*	ENDIF
		
		
		IF EMPTY(lperidev)
		   RETURN 
		ENDIF
		
		This.Entorno.Periodo=lperidev
		This.Entorno.Ano=Left(lperidev,4)
		This.Entorno.Mes=Right(lperidev,2)
		
		Oentorno.Periodo=This.Entorno.Periodo
		Oentorno.Ano=This.Entorno.Ano
		Oentorno.Mes=This.Entorno.Mes
		
		This.Entorno.PeriodoPlanilla=This.Entorno.Ano+This.Entorno.Mes+Oentorno.Nomina+Oentorno.Secuencia
		Oentorno.PeriodoPlanilla=This.Entorno.PeriodoPlanilla
		
		IF Oentorno.Compatible_OSISV1
			Ganop=Oentorno.Ano
			Gmesp=Oentorno.Mes
		ENDIF
		
		This.ActualizaDatos()
		
		
		   
		
	ENDPROC

	PROCEDURE Resize
		DODEFAULT()
		TRY 
			This.Marco1.Top=0
			This.Marco1.Left=0
			This.Marco1.Width=This.Width
			This.OleTree.Top=This.Marco1.Top + This.Marco1.Height + 2
			This.OleTree2.Top = This.OleTree.Top 
			This.OleTree.Height=This.Height - This.Marco1.Height - This.StatusBar.Height  - 2 
			This.OleTree.Width=INT(This.Width*40/100)
			This.OleTree2.Left=This.OleTree.Width + 1
			This.OleTree2.Height=This.Height - This.Marco1.Height - This.StatusBar.Height  - 2
			This.OleTree2.Width=INT(This.Width*60/100)
		CATCH TO lerror
			MESSAGEBOX(lerror.message+CHR(13)+CHR(13)+MESSAGE(1),16,This.Name) 
		ENDTRY 
		
	ENDPROC

	PROCEDURE verifica_barras
		LPARAMETERS lmodulo as String 
		
		IF PARAMETERS()>0
			PRIVATE lexe
		
		
			lexe="Select "+;
				 "S03_CODMOD, S22_CORS22, S22_NOMBAR "+;
				 "From SYS_TOOLBAR_MODULOS_S22	"
		
			IF Ocnx.Tipo_BD = 2
				lexe="Select "+;
					 "S03_CODMOD, S22_CORS22, S22_NOMBAR "+;
					 "From "+Ocnx.Esquema+".SYS_TOOLBAR_MODULOS_S22	"
			ENDIF 
					 
			IF (Ocnx.Tipo_BD=1 OR Ocnx.Tipo_BD=3 OR Ocnx.Tipo_BD=2)
				IF SQLEXEC(Ocnx.Conexion,lexe,"Ts22")<0
					MESSAGEBOX(MESSAGE(),16,"ToolBar")
					RETURN 
				ENDIF
				
			ENDIF
			IF Ocnx.Tipo_BD=4
				IF Ocnx.Ms_Ejecuta_SQL(lexe,"Ts22",This.DataSessionId)<0
					MESSAGEBOX(MESSAGE(),16,"ToolBar")
					RETURN 
				ENDIF
			ENDIF
			SELECT "Ts22"	 
			&&SuSP
			IF !EOF() AND FILE(ThisForm.Entorno.Unidad_red+ThisForm.Entorno.RutaOsis+"Libs\objetos_barras.vcx")
			   SET CLASSLIB TO ThisForm.Entorno.Unidad_red+ThisForm.Entorno.RutaOsis+"Libs\objetos_barras" ADDITIVE 
			   SCAN
				   lcomm=ALLTRIM(Ts22.s22_nombar)
				   IF  ALLTRIM(s03_codmod)=lmodulo
					   IF !TYPE(lcomm)=="O"
						   lcomm="Public "+ALLTRIM(Ts22.s22_nombar)
						   &lcomm
						   lcomm=ALLTRIM(Ts22.s22_nombar)+"=CREATEOBJECT('"+ALLTRIM(Ts22.s22_nombar)+"')"
						   &lcomm
					   ENDIF
					   lcomm=ALLTRIM(Ts22.s22_nombar)+".Visible=.T."
					   &lcomm
				   ELSE
					   IF TYPE(lcomm)=="O"
						   lcomm=ALLTRIM(Ts22.s22_nombar)+".Visible=.F."
						   &lcomm
					   ENDIF
				   ENDIF
				   
				   SELECT "Ts22"	 
			   ENDSCAN
		
			   IF USED("Ts22")
			   		USE IN  "Ts22"
			   ENDIF
			   
			ENDIF
		ENDIF
		
		
		
		
		
	ENDPROC

	PROCEDURE entorno.Init
		DODEFAULT()
		ThisForm.Marco1.Txt_cia.Value=This.NombreCia 
		ThisForm.Marco1.Txt_suc.Value=This.NombreSuc
		ThisForm.Marco1.Txt_usuario.Value=Ocnx.usuario
		
		Otbr.Show()
		
	ENDPROC

	PROCEDURE Marco1.txt_nomina.Init
		PRIVATE lexe , lxalias
		lexe = "Select tpl_deslar,tpl_codtpl "+;
		       "From TIPO_PLANILLA_TPL "+;
		       "Where tpl_indest='1' "
		
		IF Ocnx.Tipo_BD = 2
			lexe = "Select tpl_deslar,tpl_codtpl "+;
			       "From "+Ocnx.Esquema+".TIPO_PLANILLA_TPL 	"+;
			       "Where tpl_indest='1' 						"+;
			       "And   tpl_codtpl in (Select tpl_codtpl									"+;
				   "						From "+Ocnx.Esquema+".sys_usuarios_nominas_s25	"+;
				   "						Where cia_codcia='"+Oentorno.Codigocia+"'  "+;
				   "						And   suc_codsuc='"+Oentorno.Codigosuc+"'  "+;
				   "					    And   upper(trim(s10_usuario))='"+UPPER(ALLTRIM(Ocnx.Usuario))+"') "
			IF ThisForm.Entorno.Modulo=='51' 
				lexe=lexe+" And tpl_codtpl<>'99' "
			ENDIF   
		ENDIF 
		
		&&SYS(2015)
		lxalias="TempNominasCia" 			     
		IF SQLEXEC(Ocnx.Conexion,lexe,lxalias)<0
			MESSAGEBOX(MESSAGE())
			RETURN 
		ENDIF
		This.BoundColumn = 2
		This.RowSourceType = 2
		This.RowSource =lxalias
		This.Requery() 
		IF This.ListCount>0 
			This.Value = This.List[1,2]  
		ENDIF
		
		
	ENDPROC

	PROCEDURE Marco1.txt_nomina.InteractiveChange
		Oentorno.Nomina=This.Value 
		Oentorno.NombreNomina=This.List[This.ListIndex,1]  
		
		IF !(Oentorno.Modulo$'56')
			lperiodo=Oapp.PeriodoReal(ThisForm.Entorno.CodigoCia,ThisForm.Entorno.CodigoSuc,Oentorno.Modulo,This.Value)
			ThisForm.Entorno.PeriodoReal = lperiodo
			ThisForm.Entorno.Periodo	 = lperiodo
			ThisForm.Entorno.Ano		 = LEFT(lperiodo,4)
			ThisForm.Entorno.Mes		 = Righ(lperiodo,2)
			Oentorno.PeriodoReal = ThisForm.Entorno.PeriodoReal
			Oentorno.Periodo	 = ThisForm.Entorno.Periodo
			Oentorno.Modulo		 = ThisForm.Entorno.Modulo
			Oentorno.Ano		 = ThisForm.Entorno.Ano
			Oentorno.Mes		 = ThisForm.Entorno.Mes
		ENDIF 
		ThisForm.Actualizadatos() 
	ENDPROC

	PROCEDURE OleTree.Click
		*** Evento ActiveX Control ***
		
		
	ENDPROC

	PROCEDURE OleTree.Collapse
		*** Evento ActiveX Control ***
		LPARAMETERS node
		IF node.expanded
		   node.image=6
		ELSE
		   node.image=4
		ENDIF
		
		This.Click()
	ENDPROC

	PROCEDURE OleTree.Expand
		*** Evento ActiveX Control ***
		LPARAMETERS node
		IF node.expanded
		   node.image=6
		ELSE
		   node.image=4
		ENDIF
		
		This.Click()
	ENDPROC

	PROCEDURE OleTree.GotFocus
		This.Click()
	ENDPROC

	PROCEDURE OleTree.Init
		PRIVATE lcad
		ThisForm.Entorno.Init()  
		&&This.Top=74
		This.Left=0
		
		PRIVATE lxusurio
		lxusurio=Ocnx.usuario
		IF !EMPTY(NVL(Ocnx.usuario_perfil,''))
			lxusurio=Ocnx.usuario_perfil
		ENDIF
		
		
		
		IF Ocnx.Tipo_BD=1 OR Ocnx.Tipo_BD=4
			lcad="Exec pa_menu_modulos '"+Oentorno.codigocia+"','"+Oentorno.codigosuc+"','"+lxusurio+"' "
		ENDIF
		IF Ocnx.Tipo_BD=3 OR Ocnx.Tipo_BD=2
			IF !ThisForm.Menu_modulos("SYS_TABLA_MODULOS_S03")
				RETURN .F.
			ENDIF
			 
		ENDIF
			
		
		IF Ocnx.Tipo_BD=1
			IF SQLEXEC(Ocnx.conexion,lcad,"SYS_TABLA_MODULOS_S03")<0
			   MESSAGEBOX(MESSAGE(),16,"")
			   RETURN .F.
			ENDIF	 
		ENDIF
		IF Ocnx.Tipo_BD=4
			IF !Ocnx.Ms_Ejecuta_SQL(lcad,"SYS_TABLA_MODULOS_S03",ThisForm.DataSessionId)>0
			   RETURN .F.
			ENDIF	 
		ENDIF
		
		SELECT "SYS_TABLA_MODULOS_S03"
		GO TOP 
		
		IF EOF()
		   RETURN 
		ENDIF
		lotree = This
		Lotree.Object.ImageList=This.Parent.OleImagen	   
		PRIVATE ldescri
		
		SCAN
			ldescri=ALLTRIM(SYS_TABLA_MODULOS_S03.s03_nomlar)
			
		 	IF Ocnx.Idioma==ThisForm.Entorno.Idioma_ingles AND !EMPTY(NVL(ALLTRIM(SYS_TABLA_MODULOS_S03.s03_noming),''))
			 	ldescri=ALLTRIM(SYS_TABLA_MODULOS_S03.s03_noming)
		 	ENDIF
		 	 
		 
		    IF LEN(ALLTRIM(SYS_TABLA_MODULOS_S03.s03_codmod))=1
			   lnode=lotree.Nodes.Add(,1,ALLTRIM(SYS_TABLA_MODULOS_S03.s03_codmod)+"_",ldescri,4)
			ELSE
			   llen=LEN(ALLTRIM(SYS_TABLA_MODULOS_S03.s03_codmod))
			   lparent=LEFT(ALLTRIM(SYS_TABLA_MODULOS_S03.s03_codmod),llen - 1)+"_"
			   IF !ISNULL(ALLTRIM(SYS_TABLA_MODULOS_S03.s03_codmod))
			   	  lnode=lotree.Nodes.Add(lparent,4,ALLTRIM(SYS_TABLA_MODULOS_S03.s03_codmod)+"_",ldescri,5)
			   ENDIF
			   
			ENDIF
			IF TYPE("lnode")=="O"
				lnode.tag=STR(SYS_TABLA_MODULOS_S03.s03_indnom,1)
			ENDIF
			
		EndScan	
		This.NodeClick(This.Object.SelectedItem)
		
		
		
	ENDPROC

	PROCEDURE OleTree.NodeClick
		*** Evento ActiveX Control ***
		LPARAMETERS node 
		
		
		DODEFAULT()
		
		ThisForm.Marco1.Txt_nomina.Visible = .F.  
		ThisForm.Marco1.txt_periodo_nomina.Visible = .F.  
		ThisForm.Marco1.Etiqueta_Nomina.Visible= .F. 
		ThisForm.Marco1.Etiqueta_Periodo_Nomina.Visible = .F.   
		
			IF TYPE("ltoolbar_opciones")=="O"
				RELEASE ltoolbar_opciones
			ENDIF
				
		&&IF ThisForm.Activo = .F.
			ThisForm.Activo = .T.
			This.Enabled =.F.
		
			IF ISNULL(node)
			   RETURN 
			ENDIF
			TRY 
				PRIVATE lkey,lvalor,lcmes,lperiodoactivo,lperiodo
				lkey=LEFT(node.Key,LEN(node.Key)-1)
		
				ThisForm.Marco1.Txt_Modulo.Value=lkey+" "+node.text
				ThisForm.Marco1.Txt_Modulo.Refresh()
		
				lperiodo=Oapp.PeriodoReal(ThisForm.Entorno.CodigoCia,ThisForm.Entorno.CodigoSuc,lkey,"")
		
				IF ThisForm.Entorno.Compatible_osisv1 
					Gperi=lperiodo
					Gperr=lperiodo
				ENDIF
				 
				Oentorno.Nomina="" 
				Oentorno.PeriodoPlanilla=""
				Oentorno.Secuencia=""
				 
				ThisForm.Marco1.Txt_periodo_real.Value=LEFT(lperiodo,4)+"-"+RIGHT(lperiodo,2)
				ThisForm.Marco1.Txt_periodo_real.Refresh()
		
				ThisForm.Entorno.PeriodoReal = lperiodo
				ThisForm.Entorno.Periodo	 = lperiodo
				ThisForm.Entorno.Modulo		 = lkey
				ThisForm.Entorno.Ano		 = LEFT(lperiodo,4)
				ThisForm.Entorno.Mes		 = Righ(lperiodo,2)
		
				Oentorno.PeriodoReal = ThisForm.Entorno.PeriodoReal
				Oentorno.Periodo	 = ThisForm.Entorno.Periodo
				Oentorno.Modulo		 = ThisForm.Entorno.Modulo
				Oentorno.Ano		 = ThisForm.Entorno.Ano
				Oentorno.Mes		 = ThisForm.Entorno.Mes
				
			CATCH TO lerror 
				MESSAGEBOX(lerror.message+CHR(13)+CHR(13)+MESSAGE(1),16,This.Name+"."+lerror) 	
			ENDTRY
			
		
			lotree=node
		
			IF ISNULL(lotree)
			   RETURN 
			ENDIF
			
			TRY 
				lkey=LEFT(lotree.Key,LEN(lotree.Key)-1)
		
				ThisForm.Entorno.Modulo=lkey
				ThisForm.Verifica_barras(lkey)
				ThisForm.Entorno.NombreModulo=lotree.text
				Oentorno.NombreModulo=ThisForm.Entorno.NombreModulo
				_Screen.Caption=ALLTRIM(ThisForm.Entorno.Nombrecia)+" - ["+ALLTRIM(ThisForm.Entorno.Modulo)+"-"+ALLTRIM(ThisForm.Entorno.NombreModulo)+"] "
			CATCH TO lerror
				MESSAGEBOX(lerror.message+CHR(13)+CHR(13)+MESSAGE(1),16,This.Name+"."+lerror.procedure) 	
			ENDTRY
			
		
			IF LEN(lkey)=1
			   return
			Endif
		
		
			TRY 
					&&---- Se cambio en esta parte del codigo 18/02/2008 OBM
					&&----IF node.tag=="1" AND ThisForm.Nomina_activa = .F.&& Nomina
					
					IF (node.tag=="1" AND ThisForm.Nomina_activa = .F.) OR Oentorno.Modulo$'56'  && Nomina
						ThisForm.Marco1.Txt_nomina.Visible = .T.  
						ThisForm.Marco1.txt_periodo_nomina.Visible = .T.  
						ThisForm.Marco1.Etiqueta_Nomina.Visible= .T. 
						ThisForm.Marco1.Etiqueta_Periodo_Nomina.Visible = .T.   
						
						IF Oentorno.Modulo$'56'
							ThisForm.Marco1.txt_periodo_nomina.Visible= .F.
							ThisForm.Marco1.Etiqueta_Periodo_Nomina.Visible = .F.
						ENDIF 
		
						lnomina=""
						ThisForm.Nomina_activa = .T.
						
						lwind=ThisForm.WindowState
		*!*					ThisForm.WindowState =1 		
		
		*!*	*!*					ldonomina="DO FORM '"+ThisForm.Entorno.RutaOsis+"Forms\Nomina'  TO lnomina "
		*!*	*!*					&ldonomina
		*!*					&&DO FORM "'"+ThisForm.Entorno.RutaOsis+"Forms\Nomina'"  TO lnomina
		*!*					
		*!*					ThisForm.WindowState =lwind
						
					*!*		IF UPPER(Ocnx.Usuario)=="EPALOMINO"
					*!*			SUSP
					*!*		ENDIF
						lnomina=ThisForm.Marco1.txt_nomina.Value   
		
						lperiodo=Oapp.PeriodoReal(ThisForm.Entorno.CodigoCia,ThisForm.Entorno.CodigoSuc,lkey,lnomina)
		
						ThisForm.Entorno.PeriodoReal = lperiodo
						ThisForm.Entorno.Periodo	 = lperiodo
						ThisForm.Entorno.Modulo		 = lkey
						ThisForm.Entorno.Ano		 = LEFT(lperiodo,4)
						ThisForm.Entorno.Mes		 = Righ(lperiodo,2)
		
						Oentorno.PeriodoReal = ThisForm.Entorno.PeriodoReal
						Oentorno.Periodo	 = ThisForm.Entorno.Periodo
						Oentorno.Modulo		 = ThisForm.Entorno.Modulo
						Oentorno.Ano		 = ThisForm.Entorno.Ano
						Oentorno.Mes		 = ThisForm.Entorno.Mes
		
						
						Oentorno.Nomina=lnomina
						ThisForm.Marco1.txt_nomina.Value =   Oentorno.Nomina
						
						Oentorno.PeriodoPlanilla=ThisForm.Periodo_planilla(Oentorno.Ano,Oentorno.Mes,Oentorno.Nomina) 
						Oentorno.Secuencia=RIGHT(Oentorno.PeriodoPlanilla,3)
						ThisForm.Nomina_activa = .F.
		
					ENDIF
					ThisForm.ActualizaDatos() 
					ThisForm.Marco1.txt_nomina.Init()
					PRIVATE lxusurio
					lxusurio=Ocnx.usuario
					IF !EMPTY(NVL(Ocnx.usuario_perfil,''))
						lxusurio=Ocnx.usuario_perfil
					ENDIF
					
					IF Ocnx.Tipo_BD=1 OR Ocnx.Tipo_BD=4
						lcad="Exec pa_menu_opciones '"+Oentorno.codigocia+"','"+Oentorno.codigosuc+"','"+lkey+"','"+lxusurio+"'"
					ENDIF
					SET MESSAGE TO "Cargando Opciones del Modulo........."
			CATCH TO lerror
				MESSAGEBOX(lerror.message+CHR(13)+CHR(13)+MESSAGE(1),16,This.Name+"."+lerror.procedure) 		
			ENDTRY
		
			IF Ocnx.Tipo_BD=3 OR Ocnx.Tipo_BD=2
				IF !ThisForm.Menu_opciones("sys_menu_modulos_s08",lkey)
					RETURN .F.
				ENDIF
				SELECT "sys_menu_modulos_s08"
			ENDIF
				
			IF Ocnx.Tipo_BD=1
				IF SQLEXEC(Ocnx.conexion,lcad,"sys_menu_modulos_s08")<0
				   MESSAGEBOX(MESSAGE(),16,lotree.text)
				   RETURN .f.
				ENDIf     
			ENDIF
		
			IF Ocnx.Tipo_BD=4
				IF !Ocnx.Ms_Ejecuta_SQL(lcad,"sys_menu_modulos_s08",ThisForm.DataSessionId)>0
				   RETURN .f.
				ENDIf     
			ENDIF
			PRIVATE ldescri
			
			TRY 
					DIMENSION ThisForm.Botones[1,3]
					ThisForm.Botones[1,1]=.F.
					
					SELECT s07_codopc,s08_nomopc,s07_nomima ;
					FROM "sys_menu_modulos_s08" ;
					INTO ARRAY ThisForm.Botones ; 
					Where LEN(NVL(s07_codopc,''))>0 ;
					and   s08_indbot=1
					
					ThisForm.Agrega_toolbar_opciones(node.text) 
					
					THISFORM.OleTree2.Nodes.Clear
					lotree = ThisForm.OleTree2
		
					lotree.Object.ImageList=This.Parent.OleImagen	   
					SELECT "sys_menu_modulos_s08"
					SCAN
					   TRY 
						   limage=0
						   IF EMPTY(s09_tipopc)
						      limage=2   
						   ELSE
						      IF s09_tipopc$"FORM"
						         limage=1   
						      ENDIF
						      IF s09_tipopc$"INFO"
						         limage=7   
						      ENDIF
						      IF s09_tipopc$"PROC"
						         limage=8   
						      ENDIF
						      IF s09_tipopc$"CIER"
						         limage=9   
						      ENDIF
						      IF s09_tipopc$"LURL"
						         limage=10   
						      ENDIF
						      IF s09_tipopc$"FXML"
						         limage=11  
						      ENDIF
						   ENDIF
						   
						   lnumopc=IIF(!EMPTY(NVL(sys_menu_modulos_s08.s07_codopc,'')),ALLTRIM(LOWER(NVL(sys_menu_modulos_s08.s07_codopc,''))),'')
						   lparent=ALLTRIM(sys_menu_modulos_s08.s08_codenl)+"_"
						   IF !ISNULL(lparent) AND !ISNULL(ALLTRIM(sys_menu_modulos_s08.s08_codmen))
			   				   ldescri=ALLTRIM(sys_menu_modulos_s08.s08_nomopc)
		
							   IF Ocnx.Idioma==ThisForm.Entorno.Idioma_ingles
							   	   IF !EMPTY(NVL(ALLTRIM(sys_menu_modulos_s08.s08_noming),'')) 
									   ldescri=ALLTRIM(sys_menu_modulos_s08.s08_noming)
								   ENDIF
							   	   IF !EMPTY(NVL(ALLTRIM(sys_menu_modulos_s08.s07_noming),'')) 
									   ldescri=ALLTRIM(sys_menu_modulos_s08.s07_noming)
								   ENDIF
							   ENDIF
							
							   IF lparent="0_"
								  xnewnode=lotree.Nodes.Add(,1,ALLTRIM(sys_menu_modulos_s08.s08_codmen)+"_",ldescri,limage)
							   ELSE
							      xnewnode=lotree.Nodes.Add(lparent,4,ALLTRIM(sys_menu_modulos_s08.s08_codmen)+"_",ldescri,limage)
							      xnewnode.Tag=lnumopc
							   ENDIF
						   ENDIF
						CATCH TO lerrorx
							MESSAGEBOX( lerrorx.message +CHR(13)+CHR(13)+MESSAGE(1),16,This.Name+"."+lerrorx.procedure)   
					  	ENDTRY
					  	
					ENDSCAN
			CATCH TO lerrorx
				MESSAGEBOX( lerrorx +CHR(13)+CHR(13)+MESSAGE(1),16,This.Name+"."+lerrorx.procedure)   
		  	ENDTRY
		
			ThisForm.OleTree2.Refresh
			SET MESSAGE to
			ThisForm.Activo = .F.
		
			This.Enabled =.T.
		&&ENDIF
		
	ENDPROC

	PROCEDURE OleTree2.Collapse
		*** Evento ActiveX Control ***
		LPARAMETERS node
		IF node.expanded
		   node.image=3
		ELSE
		   node.image=2
		ENDIF
		   
	ENDPROC

	PROCEDURE OleTree2.DblClick
		*** Evento ActiveX Control ***
		&&SUSP
		lotree=This.Object.SelectedItem
		
		lkey=LEFT(lotree.Key,LEN(lotree.Key)-1)
		
		IF LEN(lkey)=1
		   return
		ENDIF
		IF (Ocnx.Tipo_BD=1 OR Ocnx.Tipo_BD=4)
			lcad="Select ISNULL(a.s07_codopc,'') as 's07_codopc',ISNULL(b.s09_tipopc,'') as s09_tipopc  "+;
			     "From dbo.sys_menu_modulos_s08 a "+;
			     "     left outer join dbo.SYS_TABLA_OPCIONES_S07 b "+;
			     "On (b.s07_codopc=a.s07_codopc) "+;
			     "Where a.s03_codmod='"+ThisForm.Entorno.Modulo+"' "+;
			     "and   a.s08_codmen='"+lkey+"' "
		ENDIF
		
		IF Ocnx.Tipo_BD=2
			lcad="Select Nvl(a.s07_codopc,'') as s07_codopc,nvl(b.s09_tipopc,'') as s09_tipopc  "+;
			     "From "+Ocnx.Esquema+".sys_menu_modulos_s08 a "+;
			     "     left outer join "+Ocnx.Esquema+".SYS_TABLA_OPCIONES_S07 b "+;
			     "On (b.s07_codopc=a.s07_codopc) "+;
			     "Where a.s03_codmod='"+ThisForm.Entorno.Modulo+"' "+;
			     "and   a.s08_codmen='"+lkey+"' "
		ENDIF
		     
		IF Ocnx.Tipo_BD=3
			lcad="Select IfNULL(a.s07_codopc,'') as 's07_codopc',IfNULL(b.s09_tipopc,'') as s09_tipopc  "+;
			     "From sys_menu_modulos_s08 a "+;
			     "     left outer join SYS_TABLA_OPCIONES_S07 b "+;
			     "On (b.s07_codopc=a.s07_codopc) "+;
			     "Where a.s03_codmod='"+ThisForm.Entorno.Modulo+"' "+;
			     "and   a.s08_codmen='"+lkey+"' "
		ENDIF
		     
		IF (Ocnx.Tipo_BD=1 OR Ocnx.Tipo_BD=3 OR Ocnx.Tipo_BD=2)
			IF SQLEXEC(Ocnx.Conexion,lcad,"sys_menu_modulos_s08")<0
			   MESSAGEBOX("Error: "+MESSAGE()+CHR(13)+lcad,16,ThisForm.Entorno.NombreModulo)
			   RETURN .f.
			EndIf     
		ENDIF
		IF Ocnx.Tipo_BD=4
			IF !Ocnx.Ms_Ejecuta_SQL(lcad,"sys_menu_modulos_s08",ThisForm.DataSessionId)>0
			   RETURN .f.
			EndIf     
		ENDIF
		
		
		IF EMPTY(s07_codopc)
		   RETURN 
		ENDIF
		Oentorno.Titulo_Menu=lotree.text
		
		PRIVATE lindcier
		lindcier=.F.
		
		IF sys_menu_modulos_s08.s09_tipopc=="CIER"
		   lindcier=.T.
		ENDIF
		
		IF ThisForm.Entorno.Compatible_osisv1 
			Gprograma=s07_codopc
		ENDIF
		 
		IF s09_tipopc=="LURL"
			ThisForm.HyperLink.NavigateTo("http://www.gruporecord.com.pe/scrsamples/"+ALLTRIM(UPPER(s07_codopc))+".htm")
			RETURN 
		ENDIF
		 
		
		IF s09_tipopc<>"INFO" 
		   IF s09_tipopc<>"FXML" 
			   ThisForm.Abrir(s07_codopc)    
			   IF lindcier
				   ThisForm.Oletree.NodeClick(ThisForm.Oletree.OBJECT.SelectedItem)
			   ENDIF
		   ELSE
			   ThisForm.Formulario_filtro(s07_codopc)  
		   ENDIF
		ELSE
		   ThisForm.Imprime(s07_codopc)  
		ENDIF
		
	ENDPROC

	PROCEDURE OleTree2.Expand
		*** Evento ActiveX Control ***
		LPARAMETERS node
		IF node.expanded
		   node.image=3
		ELSE
		   node.image=2
		ENDIF
		
	ENDPROC

	PROCEDURE OleTree2.Init
		&&This.Top=74
	ENDPROC

	PROCEDURE OleTree2.NodeClick
		*** Evento ActiveX Control ***
		LPARAMETERS node
		
		*** Evento ActiveX Control ***
		
		node=This.Object.SelectedItem
		
		lkey=LEFT(node.Key,LEN(node.Key)-1)
		
		IF LEN(lkey)=1
		   return
		ENDIF
		
		ThisForm.StatusBar.Panels[1].Text=node.Tag
		ThisForm.StatusBar.Panels[2].Text=node.fullpath
		ThisForm.StatusBar.Panels[2].AutoSize=1
		
		
		
		
		
	ENDPROC

	PROCEDURE StatusBar.Refresh
		*** ActiveX Control Method ***
		
	ENDPROC

ENDDEFINE

DEFINE CLASS periodo AS responde OF "claseosis.vcx" 		&& Selección  de Periodo
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Shape1" UniqueID="" Timestamp="" />
