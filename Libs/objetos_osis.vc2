			    IF LEN(ALLTRIM(This.Value))<>This.NumeroDigitos AND This.restringedigito
			       MESSAGEBOX("El Código de Flujo de Caja tiene que tener "+STR(This.NumeroDigitos)+" Digitos",64,"Flujo de Caja")
				   IF This.Estricto
