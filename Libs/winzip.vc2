*--------------------------------------------------------------------------------------------------------------------------------------------------------
* (EN) AUTOGENERATED - ATTENTION!! - NOT INTENDED FOR EXECUTION!! USE ONLY FOR MERGING CHANGES AND STORING WITH SCM TOOLS!!
*--------------------------------------------------------------------------------------------------------------------------------------------------------
*< FOXBIN2PRG: Version="1.21" SourceFile="winzip.vcx" CPID="1252" /> (Solo para binarios VFP 9 / Only for VFP 9 binaries)
*
*
DEFINE CLASS winzip AS custom 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: agrega_archivos		&& Este metodo agrega en una lista los archivos a empaquetar
		*m: desempaqueta		&& Desempaqueta varios archivos utilizando el WINZIP (UNZIP)
		*m: empaqueta		&& Empaqueta uno o varios archivos utilizando el WINZIP (PKZIP)
		*p: archivo		&& Ruta y nombre de archivo a empaquetar o desempaquetar
		*p: nivel		&& Es el  nivel de compresion: 0 - no compression, 1 - minimum compression, maximum speed,  9 - maximum compression, minimum speed
		*a: lista[1,2]		&& Lista de Archivos a Empaquetar
	*</DefinedPropArrayMethod>

	*<PropValue>
		archivo = ("")
		Height = 23
		Name = "winzip"
		nivel = (9)
		Width = 29
	*</PropValue>
	
	PROCEDURE agrega_archivos		&& Este metodo agrega en una lista los archivos a empaquetar
		LPARAMETERS ls_archivo as Character 
		
		IF EMPTY(This.Lista[1,1])
		   This.Lista[1,1]=ls_archivo
		ELSE
		   lnumlis=ALEN(This.Lista,1) + 1
		   DIMENSION This.Lista[lnumlis,2]
		   This.Lista[lnumlis,1]=ls_archivo
		ENDIF
		
	ENDPROC

	PROCEDURE desempaqueta		&& Desempaqueta varios archivos utilizando el WINZIP (UNZIP)
		PRIVATE i
		oZip = Createobject("MoleZip.ZipFile")
		
		lfile=ALLTRIM(This.Archivo) 
		
		IF !FILE(lfile)
		   MESSAGEBOX("No se encontro el Archivo: "+CHR(13)+lfile)
		   RETURN
		ENDIF
		
		
		oZip.Open(lfile)
		oLista = oZip.Enumerate()
		
		*
		* Contamos ficheros:
		*
		
		i=0
		Do While oLista.Next
			i=i+1
		EndDo
		&&? i
		
		*
		* Extraemos todos:
		*
		
		oLista.reset
		Do While oLista.Next()
		
		       oZip.Extract( oLista.value, ; && Nombre del fichero en el Zip
		        oLista.value ) && Nombre del fichero destino
		EndDo
		
		oZip.Close
		release oZip
		RETURN 
		
	ENDPROC

	PROCEDURE empaqueta		&& Empaqueta uno o varios archivos utilizando el WINZIP (PKZIP)
		PRIVATE ldn
		
		oZip = createobject("MoleZip.ZipFile")
		
		
		*
		* Añadir ficheros: -----------------------------------------------
		*
		lfile=UPPER(This.Archivo)
		
		IF RIGHT(ALLTRIM(lfile),4)<>".ZIP"
		   lfile=ALLTRIM(lfile)+".ZIP"
		ENDIF
		
		
		oZip.Create(lfile)
		FOR ldn=1 TO ALEN(This.Lista,1)
			oZip.PackInplace(This.Lista[1,2],; && Nombre del fichero en el Zip
			  This.Lista[1,1], ;      && Nombre del fichero origen
			  This.Nivel) && Nivel de compresión (de 0 a 9)
		ENDFOR 
		oZip.Close
		
	ENDPROC

ENDDEFINE
