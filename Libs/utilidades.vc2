DEFINE CLASS frmgca AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="cmdAyuda" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: acercade		&& Muestra el Autor y datos del Programa en un dialogo especial!!
		*p: autor		&& Muestra los datos del Autor de esta Pantalla
		*p: obtenfoco		&& Flag para activar una correccion al bug que hace que el formulario pierda el foco
		*p: rutaanterior		&& Almacena la  informacion de la ruta desde donde se llamo a la forma
	*</DefinedPropArrayMethod>

	PROTECTED rutaanterior
	*<PropValue>
		AutoCenter = .T.
		autor = 
		Caption = "FrmGCA"
		DataSession = 2
		DoCreate = .T.
		FontName = "Verdana"
		FontSize = 8
		Name = "frmgca"
		rutaanterior = 
		ShowTips = .T.
	*</PropValue>

	ADD OBJECT 'cmdAyuda' AS commandbutton WITH ;
		Caption = "?", ;
		FontName = "Verdana", ;
		FontSize = 7, ;
		ForeColor = 255,0,0, ;
		Height = 20, ;
		Left = 0, ;
		Name = "cmdAyuda", ;
		ToolTipText = "Acerca de ...", ;
		Top = 0, ;
		Width = 20
		*< END OBJECT: BaseClass="commandbutton" />
	
	PROCEDURE acercade		&& Muestra el Autor y datos del Programa en un dialogo especial!!
		&& Metodo que muestra en Pantalla el Autor la Propiedad
		&& Acercade del Objeto
		Priv _Wmensaje,_VarUno
		
		if Vartype(This.Caption)='C'
		   _Wmensaje="Acerca de : <"+allt(This.Caption)+">"+chr(13)
		Else
		   _Wmensaje="Acerca de : <Thisform.Caption Error>"+chr(13)
		Endif   
		
		if Vartype(This.Autor)='C'
		   _Wmensaje=_Wmensaje + This.Autor
		   _Wmensaje = StrTran(_Wmensaje,'\n',chr(13))
		   _VarUno   = StrTran(_Wmensaje,chr(13)+' ',chr(13))
		   Do While _VarUno#_Wmensaje
		      _Wmensaje=_VarUno
		      _VarUno  =StrTran(_Wmensaje,chr(13)+' ',chr(13))  
		   Enddo
		Else
		   _Wmensaje=_Wmensaje+;
		             " Autor : No Identificado "+chr(13)+;
		             " Fecha : "+ttoc(datetime())
		Endif
		=Messagebox(_Wmensaje,0+64+4096)
		Return .t.
	ENDPROC

	PROCEDURE Load
		&& Agregar la accion que devuelve la ruta desde donde se le llamo a la Forma
		&& Gerardo 17/07/2001
		Thisform.RutaAnterior = sys(5) + curdir()
		
		&& Flag que corrige el Bug de los Formularios que pierden el foco 
		&& Es solo para Vf 6.0
		If This.obtenfoco
		   Declare Long "FindWindow" in USER32 as apiFindWindow String lpClassName,String lpWindowName
		   Declare Long "SetFocus"   in USER32 as apiSetFocus   Long hWnd
		   Local lhWnd
		   lhWnd = apiFindWindow( 0, This.Caption )
		   If lhWnd # 0   
		      apiSetFocus( lhWnd )
		   Endif
		Endif   
		DoDefault()
	ENDPROC

	PROCEDURE Unload
		Set defa to (Thisform.RutaAnterior)
	ENDPROC

	PROCEDURE cmdAyuda.Click
		Thisform.AcercaDe()
	ENDPROC

ENDDEFINE

DEFINE CLASS frmicon AS frmgca OF "utilidades.vcx" 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="NotifyIcon" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtNomIco" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Etiqueta1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdActiva" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdDesactiva" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="GcaTray" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Etiqueta2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtMensaje" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="chkModi" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: activabarra		&& Coloca la pantalla en la barra del reloj
		*m: desactivabarra		&& Desactiva la Barra
		*p: activa_mouse
	*</DefinedPropArrayMethod>

	*<PropValue>
		Caption = "frmIcon"
		DoCreate = .T.
		Height = 199
		Icon = ..\..\osiscli7\fibraforte\
		Name = "frmicon"
		Width = 429
		cmdAyuda.Name = "cmdAyuda"
		cmdAyuda.Top = 0
	*</PropValue>

	ADD OBJECT 'chkModi' AS checkbox WITH ;
		Alignment = 0, ;
		AutoSize = .T., ;
		BackStyle = 0, ;
		Caption = "Habilitar ", ;
		FontName = "Verdana", ;
		FontSize = 8, ;
		ForeColor = 255,0,0, ;
		Height = 15, ;
		Left = 20, ;
		Name = "chkModi", ;
		Top = 85, ;
		Width = 70
		*< END OBJECT: BaseClass="checkbox" />

	ADD OBJECT 'cmdActiva' AS commandbutton WITH ;
		Caption = "Activa", ;
		Height = 55, ;
		Left = 360, ;
		Name = "cmdActiva", ;
		Picture = ..\grafico\trffc10a.ico, ;
		Top = 5, ;
		Width = 60
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'cmdDesactiva' AS commandbutton WITH ;
		Caption = "Desactiva", ;
		Height = 55, ;
		Left = 360, ;
		Name = "cmdDesactiva", ;
		Picture = ..\grafico\trffc10c.ico, ;
		Top = 60, ;
		Width = 60
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Etiqueta1' AS etiqueta WITH ;
		AutoSize = .T., ;
		Caption = "Icono", ;
		Left = 20, ;
		Name = "Etiqueta1", ;
		Top = 30
		*< END OBJECT: ClassLib="utilidades.vcx" BaseClass="label" />

	ADD OBJECT 'Etiqueta2' AS etiqueta WITH ;
		Caption = "Mensaje", ;
		Left = 20, ;
		Name = "Etiqueta2", ;
		Top = 56
		*< END OBJECT: ClassLib="utilidades.vcx" BaseClass="label" />

	ADD OBJECT 'GcaTray' AS olecontrol WITH ;
		Height = 20, ;
		Left = 96, ;
		Name = "GcaTray", ;
		Top = 0, ;
		Width = 60
		*< END OBJECT: BaseClass="olecontrol" OLEObject="c:\windows\system32\foxhwnd.ocx" Value="" />

	ADD OBJECT 'NotifyIcon' AS notifyicondata WITH ;
		Height = 20, ;
		Left = 26, ;
		Name = "NotifyIcon", ;
		Top = 0, ;
		Width = 60
		*< END OBJECT: ClassLib="utilidades.vcx" BaseClass="custom" />

	ADD OBJECT 'txtMensaje' AS texto WITH ;
		Enabled = .F., ;
		Height = 20, ;
		Left = 80, ;
		MaxLength = 200, ;
		Name = "txtMensaje", ;
		Top = 56, ;
		Width = 275
		*< END OBJECT: ClassLib="utilidades.vcx" BaseClass="textbox" />

	ADD OBJECT 'txtNomIco' AS texto WITH ;
		Enabled = .F., ;
		Height = 20, ;
		Left = 80, ;
		MaxLength = 200, ;
		Name = "txtNomIco", ;
		Top = 30, ;
		Width = 275
		*< END OBJECT: ClassLib="utilidades.vcx" BaseClass="textbox" />
	
	PROCEDURE activabarra		&& Coloca la pantalla en la barra del reloj
		If Empty(Allt(ThisForm.txtNomIco.Value))
		   =Messagebox("Falta Indicar el Archivo de Icono!!",0+16)
		   Return .f.
		Endif
		
		If !File(Allt(ThisForm.txtNomIco.Value))
		   =Messagebox("Archivo de Icono no existe!!!! ",0+16)
		   Return .f.
		Endif
		
		#DEFINE NIM_ADD 0x0
		#DEFINE NIF_MESSAGE 0x1
		#DEFINE NIF_ICON 0x2
		#DEFINE NIF_TIP 0x4
		#DEFINE WM_LBUTTONDOWN 0x201
		
		DECLARE INTEGER ExtractIcon IN "Shell32" LONG, STRING, INTEGER
		
		sPath = Allt(ThisForm.txtNomIco.Value)
		
		hIcon = ExtractIcon(ThisForm.GCATray.hWnd, sPath, 0)   
		
		DECLARE INTEGER Shell_NotifyIcon IN "Shell32" LONG, STRING
		
		With This.NotifyIcon
			.cbSize = 88
			.hWnd	= ThisForm.GCATray.hWnd
			.uFlags = NIF_MESSAGE + NIF_ICON + NIF_TIP
			.uId = 0
			.ucallbackMessage = WM_LBUTTONDOWN
			.hIcon = hIcon
			.szTip = Allt(This.txtMensaje.Value) + chr(0)
		EndWith	
		
		=Shell_NotifyIcon(NIM_ADD, This.NotifyIcon.sAPI)
		
		&&Thisform.WindowState = 1
		Thisform.Visible = .f.
		
		
	ENDPROC

	PROCEDURE desactivabarra		&& Desactiva la Barra
		#DEFINE NIM_DELETE 0x2
		=Shell_NotifyIcon(NIM_DELETE, This.NotifyIcon.sAPI)
	ENDPROC

	PROCEDURE chkModi.Click
		If This.Value = 1
		   If Messagebox("Seguro de Modificar Parametros!!!",4+32)=6
		      ThisForm.txtNomIco.Enabled  = .t.
		      ThisForm.txtMensaje.Enabled = .t.
		   Else
		      This.value = 0   
		      This.Refresh()
		   Endif   
		Else
		   ThisForm.txtNomIco.Enabled  = .f.
		   ThisForm.txtMensaje.Enabled = .f.   
		Endif   
	ENDPROC

	PROCEDURE cmdActiva.Click
		Thisform.ActivaBarra()
	ENDPROC

	PROCEDURE cmdDesactiva.Click
		Thisform.DesactivaBarra()
	ENDPROC

	PROCEDURE GcaTray.MouseDown
		*** ActiveX Control Event ***
		LPARAMETERS button, shift, x, y
		
		#DEFINE VFPM_RBUTTONDWN 516
		#DEFINE VFPM_LBUTTONDBLCLK 515
		#DEFINE VFPM_LBUTTONDWN 513
			DO CASE
			   CASE X = VFPM_LBUTTONDBLCLK
			     	Thisform.WindowState = 0
			     	Thisform.Visible = .t.
			     	ThisForm.cmdDesactiva.Click()
		&&	   CASE X = VFPM_RBUTTONDWN
		&&	   		=MessageBox("Click con el botón derecho")
			ENDCASE
		
	ENDPROC

ENDDEFINE

DEFINE CLASS ftp AS frmgca OF "utilidades.vcx" 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" ProjectClassIcon="..\..\windows\forms\configs\mapif4l.ico" ClassIcon="..\..\windows\forms\configs\mapif4l.ico" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Etiqueta1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtURL" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="edtRpta" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdFtp" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdBajar" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdSubir" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Etiqueta2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtClave" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Etiqueta3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtUser" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtArchivoUrl" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtArchivoLocal" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Etiqueta4" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Etiqueta5" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdListar" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtnRep" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Etiqueta6" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: actualizahistorico		&& registra los eventos suscitados al implementar la coneccion ftp
		*m: bajararchivo		&& Inicia la descarga del Archivo desde el servidor Ftp conectado con el metodo conectar
		*m: conectar		&& Establece la Sesion con el Servidor FTP indicado
		*m: ctoword
		*m: desconectar
		*m: ejecutaaccion		&& Metodo que llama a todos los posibles Eventos  en forma repetitiva hasta que se cumpla el numero de reintentos Indicado
		*m: listararchivo		&& Muestra un listado de los archivos del directorio actual
		*m: subirarchivo		&& Graba un archivo en el Servidor Ftp indicado en el metodo conectar
		*p: coneccionok		&& Indica el estado de la Sesion Ftp si esta conectado o desconectado
		*p: nftp		&& Identifica la sesion del Servicio FTP, primero se activa el nInternet y despues el nFTP
		*p: ninternet		&& Numero que identifica la Sesion de Internet activada si es 0 esta desactivada!!
	*</DefinedPropArrayMethod>

	*<PropValue>
		Caption = "Ftp"
		coneccionok = .F.
		DoCreate = .T.
		Height = 227
		MaxButton = .F.
		MinButton = .F.
		Name = "ftp"
		nftp = 0
		ninternet = 0
		ShowWindow = 2
		Width = 420
		WindowState = 0
		WindowType = 1
		cmdAyuda.Name = "cmdAyuda"
	*</PropValue>

