		Top = 94, ;
		Width = 60
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'edtRpta' AS editbox WITH ;
		FontName = "Times New Roman", ;
		FontSize = 7, ;
		Height = 97, ;
		Left = 9, ;
		Name = "edtRpta", ;
		Top = 121, ;
		Width = 310
		*< END OBJECT: BaseClass="editbox" />

	ADD OBJECT 'Etiqueta1' AS etiqueta WITH ;
		AutoSize = .T., ;
		Caption = "URL", ;
		Left = 9, ;
		Name = "Etiqueta1", ;
