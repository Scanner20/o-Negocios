	PROCEDURE Init
		LPARAMETERS ldatosfijos
		DODEFAULT(ldatosfijos)
		THISFORM.m_carga_grid()
	ENDPROC

	PROCEDURE m_carga_grid
		thisform.LockScreen=.t.
		
		*************
		*  USUARIOS  *
		*************
		this.pageframe1.page1.grid1.RecordSource=SPACE(0)
		wcad=" select distinct 0 as ind,S10_USUARIO,S10_NOMUSU "
		wcad=wcad+" from SYS_TABLA_USUARIOS_S10  "
		IF SQLEXEC(ocnx.conexion,wcad,'USUARIO')<0
			MESSAGEBOX(MESSAGE())
			RETURN .f.
		ENDIF
		INDEX ON s10_usuario TAG a
		this.pageframe1.page1.grid1.RecordSource='usuario'
		this.pageframe1.page1.grid1.column1.ControlSource='usuario.ind'
		this.pageframe1.page1.grid1.column2.ControlSource='usuario.s10_usuario'
		this.pageframe1.page1.grid1.column3.ControlSource='usuario.s10_nomusu'
		
		
		*************
		*** MODULO **
		*************
		this.pageframe1.page2.grid1.RecordSource=SPACE(0)
		wcad=" select distinct 0 as ind,S03_CODMOD, S03_NOMLAR  "
		wcad=wcad+" from SYS_TABLA_MODULOS_S03 "
		wcad=wcad+" where LEN(s03_codmod) = 2 "
		IF SQLEXEC(ocnx.conexion,wcad,'MODULO')<0
			MESSAGEBOX(MESSAGE())
			RETURN .f.
		ENDIF
		INDEX ON s03_codmod TAG a
		this.pageframe1.page2.grid1.RecordSource='modulo'
		this.pageframe1.page2.grid1.column1.ControlSource='modulo.ind'
		this.pageframe1.page2.grid1.column2.ControlSource='modulo.s03_codmod'
		this.pageframe1.page2.grid1.column3.ControlSource='modulo.s03_nomlar'
		
		
		****************
		***   MENU    **
		****************
		this.pageframe1.page3.grid1.RecordSource=SPACE(0)
		wcad=" select distinct 0 as ind,s08_codmen,s08_nomopc "
		wcad=wcad+" from SYS_MENU_MODULOS_S08  "
		wcad=wcad+" where s08_indest='1' "
		IF SQLEXEC(ocnx.conexion,wcad,'MENU')<0
			MESSAGEBOX(MESSAGE())
			RETURN .f.
		ENDIF
		INDEX ON s08_codmen TAG a
		this.pageframe1.page3.grid1.RecordSource='menu'
		this.pageframe1.page3.grid1.column1.ControlSource='menu.ind'
		this.pageframe1.page3.grid1.column2.ControlSource='menu.s08_codmen'
		this.pageframe1.page3.grid1.column3.ControlSource='menu.s08_nomopc'
		
		****************
		*** OPCIONES  **
		****************
		this.pageframe1.page4.grid1.RecordSource=SPACE(0)
		wcad=" select distinct 0 as ind,S07_CODOPC,S07_NOMS07 "
		wcad=wcad+" from SYS_TABLA_OPCIONES_S07  "
		wcad=wcad+" where s07_indest='1' "
		IF SQLEXEC(ocnx.conexion,wcad,'OPCION')<0
			MESSAGEBOX(MESSAGE())
			RETURN .f.
		ENDIF
		INDEX ON s07_codopc TAG a
		this.pageframe1.page4.grid1.RecordSource='opcion'
		this.pageframe1.page4.grid1.column1.ControlSource='opcion.ind'
		this.pageframe1.page4.grid1.column2.ControlSource='opcion.s07_codopc'
		this.pageframe1.page4.grid1.column3.ControlSource='opcion.s07_noms07'
		
		thisform.LockScreen=.f.
		
	ENDPROC

	PROCEDURE botongrupo.Cmb_Cancelar.Click
		IF USED('USUARIO')
			SELECT ('USUARIO')
			=TABLEUPDATE()
		ENDIF	
		
		IF USED('MODULO')
			SELECT ('MODULO')
			=TABLEUPDATE()
		ENDIF	
		
		IF USED('MENU')
			SELECT ('MENU')
			=TABLEUPDATE()
		ENDIF	
		
		IF USED('OPCION')
			SELECT ('OPCION')
			=TABLEUPDATE()
		ENDIF	
		
		DODEFAULT()
	ENDPROC

