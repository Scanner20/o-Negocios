	PROCEDURE actualizahistorico		&& registra los eventos suscitados al implementar la coneccion ftp
		LParam cEvento,cCadena
		If cEvento='0' && Inicializa los registros de los Eventos!!!
		   ThisForm.edtRpta.Value = '' 
		   ThisForm.edtRpta.Refresh()
		   Return .t.
		Endif
		
		&& Implementar el registro de Eventos!!
		ThisForm.edtRpta.value = ThisForm.edtRpta.value + chr(13)
		ThisForm.edtRpta.value = ThisForm.edtRpta.value + " Evento : " + cEvento + " --> " + cCadena
		ThisForm.edtRpta.refresh()
		
		Return .t.
		
	ENDPROC

	PROCEDURE bajararchivo		&& Inicia la descarga del Archivo desde el servidor Ftp conectado con el metodo conectar
		Local cCadVar, cCadEve
		cCadEve = 'BajarArchivo'
		cCadVar = ''
		If Empty(ThisForm.txtArchivoUrl.Value)
		   cCadVar = "Error : No se ha indicado el Archivo a Leer desde el Servidor!!!"
		   Thisform.ActualizaHistorico(cCadEve,cCadVar)
		   &&=Messagebox(cCadVar,0+16)
		   Return .f.
		Endif
		
		If Empty(ThisForm.txtArchivoLocal.Value)
		   cCadVar = "Error : Nombre de Archivo de Destino en Blanco!!!"
		   Thisform.ActualizaHistorico(cCadEve,cCadVar)
		   &&=Messagebox(cCadVar,0+16)
		   Return .f.
		Endif
		
		#DEFINE GENERIC_READ                2147483648   
		#DEFINE GENERIC_WRITE               1073741824
		#DEFINE FTP_TRANSFER_TYPE_ASCII              1
		#DEFINE FTP_TRANSFER_TYPE_BINARY             2
		
		Declare Long FtpOpenFile in "WinInet.dll" Long hFtpSession, String lpszFileName,;
		             Integer fdwAccess, Integer dwFlags, Integer dwContext
		             
		Declare Long InternetReadFile In "WinInet.dll" Long hFtpSession, String @lpBuffer,;
		             Long dwNumberOfBytesToRead, Long @lpNumberOfBytesRead
		             
		If Thisform.Conectar()             
		   nFichFTP = FtpOpenFile( Thisform.nFtp, Allt(ThisForm.txtArchivoURL.Value),;
		                           GENERIC_READ, FTP_TRANSFER_TYPE_ASCII, 0)
		   If nFichFTP = 0
		      cCadVar = "Error : " + Ltrim(Str( GetLastError() )) + " En FtpOpenFile."
		      Thisform.ActualizaHistorico(cCadEve,cCadVar)
		      &&=Messagebox(cCadVar,0+16)
		      Thisform.Desconectar()
		      Return .f.
		   Endif        
		   
		   nFich = Fcreate( Allt(Thisform.txtArchivoLocal.Value) )
		   nTama = 0
		   nLen  = 1
		   
		   cCadVar = " Iniciando Transmision de Archivo  " + Allt(Thisform.txtArchivoLocal.Value)
		   Thisform.ActualizaHistorico(cCadEve,cCadVar)
		   
		   Do While nLen # 0
		      cBuffer = Replicate(chr(0), 2048 )
		      InternetReadFile( nFichFtp, @cBuffer, Len(cBuffer), @nLen)
		      Fwrite( nFich, Subs(cBuffer,1,nLen))
		      nTama = nTama + nLen
		      Wait Wind "Recibidos " + Ltrim(Str( nTama )) Nowait
		   EndDo
		   
		   cCadVar = " Transmision Finalizada , Total Recibidos " + Ltrim(Str( nTama ))
		   Thisform.ActualizaHistorico(cCadEve,cCadVar)
		   
		   Fclose(nFich)
		   InternetCloseHandle( nFichFTP )
		   
		   Thisform.Desconectar()  
		
		Else
		   Return .f.
		Endif
		
	ENDPROC

	PROCEDURE conectar		&& Establece la Sesion con el Servidor FTP indicado
		Local nTempWeb, nTempFtp, cCadVar, cCadEve
		cCadVar = ''
		cCadEve = 'conectar'
		
		If Thisform.ConeccionOk
		   Return .t.
		Endif
		
		If Thisform.nInternet # 0
		   cCadVar = "Ya se ha Establecido la Sesion en Internet!!!"
		   Thisform.ActualizaHistorico(cCadEve,cCadVar)
		   &&=Messagebox(cCadVar,0+16)
		   Return .f.
		Endif
		
		If Thisform.nFtp # 0 
		   cCadVar = "Sesion Ftp ya fue Iniciada!!!"
		   Thisform.ActualizaHistorico(cCadEve,cCadVar)
		   &&=Messagebox(cCadVar,0+16)
		   Return .f.
		Endif
		
		#DEFINE INTERNET_OPEN_TYPE_PRECONFIG        0
		#DEFINE INTERNET_OPEN_TYPE_DIRECT           1
		#DEFINE INTERNET_OPEN_TYPE_PROXY            3
		#DEFINE INTERNET_DEFAULT_FTP_PORT          21
		#DEFINE INTERNET_SERVICE_FTP                1
		#DEFINE INTERNET_FLAG_PASSIVE        14217728
		
		&& Decalarando las funciones API
		Declare LONG InternetOpen in "Wininet.dll" ;
		        String lpszAgent , Long dwAccessType, String lpszProxyName, String lpszProxyBypass, Long dwFlags
		
		Declare LONG InternetConnect in "WinInet.dll"  ;
		        Long hInternetSession, String lpszServerName, Long nServerPort, String lpszUsername,;
		        String lpszPassword, Long dwService, Long dwFlags, Long dwContext
		
		Declare INTEGER InternetCloseHandle in "WinInet.dll"  ;
		        Long hInet
		
		Declare Long GetLastError in WIN32API
		
		Wait "Estableciendo Coneccion Web..." Wind Nowait NoClea
		nTempWeb = InternetOpen( "ClaseFTP", INTERNET_OPEN_TYPE_DIRECT, "", "", 0)
		
		If nTempWeb = 0
		   cCadVar = "Error : " + Ltrim( Str( GetLastError() ) )+ " en InternetOpen."
		   Thisform.ActualizaHistorico(cCadEve,cCadVar)
		   &&=Messagebox(cCadVar,0+16)
		   InternetCloseHandle(nTempFtp)
		   Wait Clea
		Endif
		
		
		cCadVar = "Estableciendo Comunicacion FTP..."
		Thisform.ActualizaHistorico(cCadEve,cCadVar)
		Wait cCadVar Wind Nowait NoClea
		
		nTempFtp = InternetConnect( nTempWeb, Allt(ThisForm.txtURL.Value) , INTERNET_DEFAULT_FTP_PORT,;
		                        Allt(ThisForm.txtUser.Value), Allt(ThisForm.txtClave.Value) ,;
		                        INTERNET_SERVICE_FTP, INTERNET_FLAG_PASSIVE, 0 )
		
		If nTempFtp = 0
		   cCadVar = "Error : " + Ltrim( Str( GetLastError() ) )+ " en InternetConnect."
		   Thisform.ActualizaHistorico(cCadEve,cCadVar)
		   &&=Messagebox(cCadVar,0+16)
		   Wait Clea
		   Return .f.
		Endif                        
		
		Thisform.nInternet   = nTempWeb
		Thisform.nFTP        = nTempFtp
		Thisform.ConeccionOk = .t.
		cCadVar = "Conexion FTP OK"
		Thisform.ActualizaHistorico(cCadEve,cCadVar)
		Wait Clea
		Return .t.
		
		
	ENDPROC

	PROCEDURE ctoword
		LPARAMETER cBuffer
		RETURN ASC(SUBSTR(cBuffer,1,1)) ;
			+ ASC(SUBSTR(cBuffer,2,1))*256 ;
			+ ASC(SUBSTR(cBuffer,3,1))*65536 ;
			+ ASC(SUBSTR(cBuffer,4,1))*16777216 
		
	ENDPROC

	PROCEDURE desconectar
		Local cCadVar, cCadEve
		cCadEve = 'desconectar'
		cCadVar = ''
		
		If !Thisform.ConeccionOk
		   cCadVar = "Error : No hay ninguna Sesion FTP Activa, Verifique!!!"
		   Thisform.ActualizaHistorico(cCadEve,cCadVar)
		   &&=Messagebox(cCadVar,0+16)
		   Return .f.
		Endif
		
		If Thisform.nInternet = 0
		   cCadVar = "Error : Identificador de Sesion Internet no esta Activo!!!"
		   Thisform.ActualizaHistorico(cCadEve,cCadVar)
		   &&=Messagebox(cCadVar,0+16)
		   Return .f.
		Endif
		
		If Thisform.nFtp = 0
		   cCadVar = "Error : Identificador de la Sesion FTP con valor errado!!!"
		   Thisform.ActualizaHistorico(cCadEve,cCadVar)
		   &&=Messagebox(cCadVar,0+16)
		   Return .f.
		Endif
		
		cCadVar = "Desconectando!!!"
		Thisform.ActualizaHistorico(cCadEve,cCadVar)
		Wait "Desconectando!!!" Wind Nowait Noclea
		&& Cierre del la conexion FTP
		InternetCloseHandle( Thisform.nFtp )
		&& Cierre del Uso del API
		InternetCloseHandle( Thisform.nInternet )
		Wait Clea
		Thisform.nFtp = 0
		Thisform.nInternet = 0
		Thisform.ConeccionOK = .f.
		cCadVar = "Finalizacion de Conexion OK!!!"
		Thisform.ActualizaHistorico(cCadEve,cCadVar)
		
		
		
	ENDPROC

	PROCEDURE ejecutaaccion		&& Metodo que llama a todos los posibles Eventos  en forma repetitiva hasta que se cumpla el numero de reintentos Indicado
		LParam nAccion
		Local nRepeticion, nCont, cCadEve, cCadVar
		cCadEve = 'EjecutaAccion'
		cCadVar = ''
		nCont = 0
		nRepeticion = ThisForm.txtnRep.Value
		
		Do Case
		   Case nAccion = 0  && prueba de Coneccion
		        Thisform.ActualizaHistorico('0','')
		        If ThisForm.Conectar()
		           Thisform.Desconectar()
		           Return .t.
		        Else
		           Do While nCont < nRepeticion
		              cCadVar = ' Reintento ' + Transf(nCont+1,'999')
		              Thisform.ActualizaHistorico(cCadEve,cCadVar)
		              If ThisForm.Conectar()
		                 Thisform.Desconectar()
		                 Return .t.
		              Endif
		              nCont = nCont + 1
		           Enddo
		        Endif 
		   Case nAccion = 1  && recibir Archivo
		        Thisform.ActualizaHistorico('0','')
		        If Thisform.BajarArchivo()
		           Return .t.
		        Else
		           Do While nCont < nRepeticion
		              cCadVar = ' Reintento ' + Transf(nCont+1,'999')
		              Thisform.ActualizaHistorico(cCadEve,cCadVar)
		              If Thisform.BajarArchivo()
		                 Return .t.
		              Endif
		              nCont = nCont + 1
		           Enddo
		        Endif
		   Case nAccion = 2  && Enviar Archivo 
		        Thisform.ActualizaHistorico('0','')
		        If Thisform.SubirArchivo()
		           return .t.
		        Else
		           Do While nCont < nRepeticion
		              cCadVar = ' Reintento ' + Transf(nCont+1,'999')
		              Thisform.ActualizaHistorico(cCadEve,cCadVar)
		              If Thisform.SubirArchivo()
		                 Return .t.
		              Endif
		              nCont = nCont + 1
		           Enddo
		        Endif   
		   Case nAccion = 3  && Listar
		        Thisform.ActualizaHistorico('0','')
		        If Thisform.ListarArchivo()
		           return .t.
		        Else
		           Do While nCont < nRepeticion
		              cCadVar = ' Reintento ' + Transf(nCont+1,'999')
		              Thisform.ActualizaHistorico(cCadEve,cCadVar)
		              If Thisform.Listararchivo()
		                 Return .t.
		              Endif
		              nCont = nCont + 1
		           Enddo
		        Endif   
		   
		Endcase
	ENDPROC

	PROCEDURE Init
		LParameter cHost, cUser, cClave, nAccion, cNomArc1, cNomArc2, nNumRep, cRpta
		*!*	cHost    --> Nombre o direccion IP del Servidor Ftp
		*!*	cUser    --> Usuario que realizara la conexion al Servidor
		*!*	cClave   --> Clave (Si se pone usuario y clave en blanco se toma como referencia el usuario Anonymous)
		*!*	nAccion  --> Accion a Ejecutar valores van desde 0 a 3 
		*!*	             0 , Verifica conexion
		*!*	             1 , Baja Archivo
		*!*	             2 , Sube Archivo
		*!*	             3 , Listar (Opcion aun no disponible!!!)
		*!*	cNomArc1 --> Nombre de archivo en el servidor
		*!*	cNomArc2 --> Nombre de archivo en la PC (Local)
		*!*	nNumRep  --> Numero de repeticiones antes de finalizar
		*!*	cRpta    --> Flag que indica si hay que retornar respuesta
		*!*	             desde donde se llamo (valor en .t. el valor se 
		*!*              regresara en una variable publica _okFTP ) 
		
		nNum = 0
		
		If Vartype(cHost)#'C'
		   &&=Messagebox("Nombre de Host no valido!!!",0+16)
		   &&Return .f.
		   cHost = ''
		Endif
		ThisForm.txtURL.value = Allt(cHost)
		
		If Vartype(cUser)#'C' and Vartype(cClave)#'C'
		   &&=Messagebox("Usuario y Contraseña no validos",0+16)
		   &&Return .f.
		   cUser  = ''
		   cClave = ''
		Endif
		
		ThisForm.txtUser.Value  = cUser
		ThisForm.txtClave.Value = cClave
		
		If Vartype(nAccion)#'N'
		   nAccion = -1
		Endif
		
		If Parameter()>4
		   If Vartype(cNomArc1)#'C'
		      cNomArc1 = ''
		   Endif   
		   If Vartype(cNomArc2)#'C'
		      cNomArc2 = cNomArc1
		   Endif
		   If Vartype(nNumRep)#'N'
		      nNumRep = 0
		   Endif
		   ThisForm.txtArchivoUrl.Value   = cNomArc1
		   ThisForm.txtArchivoLocal.value = cNomArc2
		   ThisForm.txtnRep.Value         = nNumRep
		Endif
		
		finalOk = .f.
		&& Determinar la Accion a Realizar
		If nAccion > -1
		   Do Case
		      Case nAccion = 0
		           If Thisform.EjecutaAccion(0)         
		              FinalOk = .t.  
		           Endif
		      Case nAccion = 1
		           If Thisform.EjecutaAccion(1)
		              FinalOk = .t.  
		           Endif
		      Case nAccion = 2
		           If Thisform.EjecutaAccion(2)
		              FinalOk = .t.  
		           Endif
		      Case nAccion = 3
		           If Thisform.EjecutaAccion(3)
		              FinalOk = .t.  
		           Endif
		   Endcase
		   If cRpta && Si hay que retornar respuesta
		      _okFTP = FinalOK
		   Endif
		   Return .f.
		Endif   
		
		
		
	ENDPROC

	PROCEDURE listararchivo		&& Muestra un listado de los archivos del directorio actual
		Local cCadVar, cCadEve
		cCadEve = 'Listar Archivos'
		cCadVar = ''
		If Empty(ThisForm.txtArchivoUrl.Value)
		   cCadVar = "Error : No se ha indicado la ruta a usar desde el Servidor!!!"
		   Thisform.ActualizaHistorico(cCadEve,cCadVar)
		   Return .f.
		Endif
		
		*** Definición de constantes
		#DEFINE FILE_ATTRIBUTE_NORMAL          128
		#DEFINE FILE_ATTRIBUTE_DIRECTORY        16
		#DEFINE INTERNET_FLAG_RAW_DATA   1073741824
		*** Declaración de Funciones
		Declare Integer InternetFindNextFile IN "wininet.dll" Long hFind, String @lpFindFileData
		Declare Integer FtpFindFirstFile IN "wininet.dll" Long hFtpSession, String lpszSearchFile, ;
			String  @lpFindFileData, Long dwFlags, Long dwContext
		Declare Integer FtpSetCurrentDirectory IN "wininet.dll" Long hFtpSession, String lpszDirectory
		Declare Long FileTimeToSystemTime IN Win32api STRING lpFileTime, STRING @lpSystemTime
		
		Create Cursor ftpserver (nombre C(254),Tipo C(10),Tama I)
		*** Realizar la conexión...
		If Thisform.Conectar()        
		   *** Modificar la configuración de la fecha
		   cOldDate = SET("DATE")
		   Set Date To DMY
		   *** Ir al directorio de la KB de FoxPro
		   c_LocDir = Justpath(Alltrim(ThisForm.txtArchivoUrl.Value))
		   c_NomArc = Juststem(Alltrim(ThisForm.txtArchivoUrl.Value))
		   FtpSetCurrentDirectory(Thisform.nFtp,c_LocDir)&&"/developr/fox/kb/" )
		   *** Empezar el recorrido de busqueda
		   cFindData = Replicate( Chr(0), 320  )
		   nFind = FtpFindFirstFile( thisform.nFtp,NULL,@cFindData,INTERNET_FLAG_RAW_DATA,0 )
		   nSeguir = 1
		   Do While nSeguir # 0
		      *** Obtener el nombre de la matriz
			  cNombre = SUBSTR( cFindData, 45,AT(CHR(0), SUBSTR(cFindData,45)) -1 )
		      *** Directorio o Fichero
			  If Thisform.CToWord( SUBSTR( cFindData, 1, 4 ) )= FILE_ATTRIBUTE_DIRECTORY
		         cTipo = "Directorio"
		         nTama = 0
		      Else
				 cTipo = "Fichero"
				 *** Tamaño del fichero
				 nTama = Thisform.CToWord(SUBSTR( cFindData, 33, 4 ) )
			  Endif
			  *** Cambiar el formato de Fecha y Hora
			  cSystemTime = Replicate( CHR(0), 16 )
			  FileTimeToSystemTime( SUBSTR( cFindData, 21, 8 ),@cSystemTime )
			  *** Obtener cada uno de los elementos
			  *** Insertar el dato en el cursor
			  Insert Into ftpserver Values ( cNombre, cTipo, nTama)
		      *** Continuar con la búsqueda
			  cFindData = REPLICATE( CHR(0), 320 )
			  nSeguir = InternetFindNextFile(nFind,@cFindData )
		   Enddo
		   *** Realizar la desconexión...
		   Thisform.Desconectar()  
		Endif   
		*** Restaurar la configuración de la fecha
		Set Date To (cOldDate)
		*** Mostrar el cursor obtenido
		Select ftpServer
		Go Top
		brow
	ENDPROC

	PROCEDURE subirarchivo		&& Graba un archivo en el Servidor Ftp indicado en el metodo conectar
		Local cCadVar, cCadEve
		cCadEve = 'SubirArchivo'
		cCadVar = ''
		   
		If Empty(ThisForm.txtArchivoLocal.Value)
		   cCadVar = "Error : No se ha indicado el Archivo a Enviar al Servidor!!!"
		   Thisform.ActualizaHistorico(cCadEve,cCadVar)
		   &&=Messagebox(cCadVar,0+16)
		   Return .f.
		Endif
		
		If Empty(ThisForm.txtArchivoUrl.Value)
		   cCadVar = "Error : Nombre de Archivo de Destino en Blanco!!!"
		   Thisform.ActualizaHistorico(cCadEve,cCadVar)
		   &&=Messagebox(cCadVar,0+16)
		   Return .f.
		Endif
		
		#DEFINE GENERIC_READ                2147483648   
		#DEFINE GENERIC_WRITE               1073741824
		#DEFINE FTP_TRANSFER_TYPE_ASCII              1
		#DEFINE FTP_TRANSFER_TYPE_BINARY             2
		
		Declare Long FtpOpenFile in "WinInet.dll" Long hFtpSession, String lpszFileName,;
		             Integer fdwAccess, Integer dwFlags, Integer dwContext
		             
		Declare Long InternetWriteFile In "WinInet.dll" Long hFtpSession, String lpBuffer,;
		             Long dwNumberOfBytesToWrite, Long @lpNumberOfBytesWrite
		             
		If Thisform.Conectar()             
		
		   nFich = Fopen( Allt(Thisform.txtArchivoLocal.Value) )
		   nToTal = FSeek(nFich, 0, 2)
		   If nTotal <= 0
		      cCadVar = "Error : Archivo Local vacio!! --> " + Allt(Thisform.txtArchivoLocal.Value)
		      Thisform.ActualizaHistorico(cCadEve,cCadVar)
		      &&=Messagebox(cCadVar,0+16)
		      Thisform.Desconectar()
		      Return .f.
		   Endif
		
		   nFichFTP = FtpOpenFile( Thisform.nFtp, Allt(ThisForm.txtArchivoURL.Value),;
		                           GENERIC_WRITE, FTP_TRANSFER_TYPE_ASCII, 0)
		   If nFichFTP = 0
		      cCadVar = "Error : " + Ltrim(Str( GetLastError() )) + " En FtpOpenFile."
		      Thisform.ActualizaHistorico(cCadEve,cCadVar)
		      &&=Messagebox(cCadVar,0+16)
		      Thisform.Desconectar()
		      Return .f.
		   Endif        
		   
		   = FSeek(nFich, 0, 0)
		   nTama = 0
		   nLen  = 1
		   nLenBuffer = nTotal
		   cCadvar = "Iniciando Transmision de : " + Allt(Thisform.txtArchivoLocal.Value)
		   Thisform.ActualizaHistorico(cCadEve,cCadVar)
		   Do While nLenBuffer > 0
		      cBuffer = FRead( nFich, 2048 )
		      nLenBuffer = Len(cBuffer)
		      InternetWriteFile( nFichFtp, cBuffer, Len(cBuffer), @nLen)
		      nTama = nTama + nLen
		      Wait Wind "Enviados " + Ltrim(Str( nTama ))+ " de " + Ltrim(Str( nTotal )) Nowait
		   EndDo
		   cCadvar = "Transmision Finalizada!!! Total Enviados " + Ltrim(Str( nTama ))+ " de " + Ltrim(Str( nTotal ))
		   Thisform.ActualizaHistorico(cCadEve,cCadVar)
		   Fclose(nFich)
		   InternetCloseHandle( nFichFTP )
		   
		   Thisform.Desconectar()  
		
		Else
		   Return .f.
		Endif
		        
	ENDPROC

	PROCEDURE cmdBajar.Click
		*!*	Thisform.ActualizaHistorico('0','')
		*!*	Thisform.BajarArchivo()
		Thisform.EjecutaAccion(1)
	ENDPROC

	PROCEDURE cmdFtp.Click
		*!*	Thisform.ActualizaHistorico('0','')
		*!*	If ThisForm.Conectar()
		*!*	   &&  =Messagebox("Conexion OK")
		*!*	   Thisform.Desconectar()
		*!*	Endif  
		Thisform.EjecutaAccion(0)
	ENDPROC

	PROCEDURE cmdListar.Click
		*Thisform.ActualizaHistorico('0','')
		Thisform.EjecutaAccion(3)
	ENDPROC

	PROCEDURE cmdSubir.Click
		*!*	Thisform.ActualizaHistorico('0','')
		*!*	Thisform.SubirArchivo()
		Thisform.EjecutaAccion(2)
	ENDPROC

ENDDEFINE

DEFINE CLASS notifyicondata AS custom 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: b10
		*m: b256
		*m: sapi_access
		*m: sapi_assign
		*p: cbsize		&& 4 bytes	Tamaño de la cadena
		*p: hicon		&& 4 bytes	handle al icono para mostrar
		*p: hwnd		&& 4 bytes	Handle de la ventana dueña y procesador de mensajes
		*p: sapi		&& Cadena para API
		*p: sztip		&& 64 bytes	Texto del Tooltip
		*p: ucallbackmessage		&& 4 bytes	Mensaje a usar para eventos del icono
		*p: uflags		&& 4 bytes	Flags
		*p: uid		&& 4 bytes	Identificador único para la ventana SysTray
	*</DefinedPropArrayMethod>

	*<PropValue>
		hicon = 0
		hwnd = 0
		Name = "notifyicondata"
		sapi = 
		sztip = 
		ucallbackmessage = 0
		uflags = 0
		uid = 0
	*</PropValue>
	
	PROCEDURE b10
		LParameter sCadena
		
		Local i, iValor
		iValor = 0
		For i = 1 to Len(sCadena)
			iValor = iValor + Asc(SubStr(sCadena,i,1)) * 256 ^ (i-1)
		Next i
		
		Return Int(iValor)
	ENDPROC

	PROCEDURE b256
		LPARAMETERS lNumero, iBytes
		LOCAL i
		STORE "" TO cRet
		FOR i = iBytes-1 TO 0 STEP -1
			vTmp = INT(lNumero / 256^i)
			lNumero = lNumero - vTmp * (256^i)
			cRet = CHR(vTmp) + cRet
		ENDFOR
		RETURN cRet
	ENDPROC

	PROCEDURE sapi_access
		*Pendiente: modificar esta rutina para el método Access
		Local CadenaParaAPI
		   If len(This.szTip) > 63 then 
		      This.szTip = Left(This.szTip,63)
		   EndIf
		   This.cbSize = 88	&&<- Tamaño máximo
			
		   CadenaParaAPI = This.B256(This.cbSize,4) + This.B256(This.hWnd,4)+ This.B256(This.uId,4)+ This.B256(This.uFlags,4)
		   CadenaParaAPI = CadenaParaAPI + This.B256(This.ucallbackMessage,4)+ This.B256(This.hIcon,4)+ This.szTip + Chr(0)
				
		Return CadenaParaAPI
		
		
	ENDPROC

	PROCEDURE sapi_assign
		&&LPARAMETERS vNewVal
		*To do: Modify this routine for the Assign method
		LPARAMETER tAssign
		   If len(tAssign) > 23 Then
			  With This
					.cbSize 			= .B10(SubStr(tAssign,1,4))
					.hWnd	 			= .B10(SubStr(tAssign,5,4))
					.uId 				= .B10(SubStr(tAssign,9,4))
					.uFlags 			= .B10(SubStr(tAssign,13,4))
					.uCallBackMessage 	= .B10(SubStr(tAssign,17,4))
					.hIcon 				= .B10(SubStr(tAssign,21,4))
					.szTip 				= SubStr(tAssign,25,Len(tAssign)-24)
					.szTip 				= Left(.szTip,AT(Chr(0),.szTip))
					.sAPI 				= tAssign
			  EndWith
		  EndIf
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS texto AS textbox 
 	*< CLASSDATA: Baseclass="textbox" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: antesayuda		&& Procedimiento a ejecutar antes de que se muestre la ayuda si retorna falso no se activa el formulario de ayuda
		*p: activa_ayuda		&& Flag que indica si se llama  o no  a la ayuda
		*p: alias_tabla		&& Indica el alias desde donde se llamara a la Ayuda
		*p: campos_alias		&& Indicar que campos especificos que mostrara la Ayuda
		*p: campo_retorno		&& Campo que indicara a la Ayuda que Valor Retornara
		*p: cond_otrocampo		&& Indica cual sera la condicion que relacionara al otro campos Especificado
		*p: flag_ayuda		&& Flag que indica al DESARROLLADOR que la ayuda esta activa o se activara y quer no valide algunos parametros (.t. Ayuda activada, .f. Ayuda Desactivada)
		*p: orden_alias		&& Especifica el Orden o Tag que usara la Ayuda
		*p: otro_campo		&& Indica a la ayuda si se usara un campo de otra tabla
		*p: ruta		&& Especifica de donde se tomara el formulario de ayuda, si el Formulario que contiene a este TextBox tiene la Propiedad ruta_fuente entonces el TextBox tomara la ruta de Alli
		*p: valor_keyfiltro		&& Valor del Rango o Key que tomara la Ayuda si se desea especificar un filtro separarlo del Key por ; y colocarlo como segundo valor Ej . <Key>;<filtro>
	*</DefinedPropArrayMethod>

	*<PropValue>
		alias_tabla = .F.
		campos_alias = 
		cond_otrocampo = 
		FontName = "Verdana"
		FontSize = 8
		Height = 20
		Name = "texto"
		orden_alias = .F.
		otro_campo = 
		ruta = 
		valor_keyfiltro = 
		Width = 100
	*</PropValue>
	
	PROCEDURE antesayuda		&& Procedimiento a ejecutar antes de que se muestre la ayuda si retorna falso no se activa el formulario de ayuda
	ENDPROC

	PROCEDURE DblClick
		Priv Valor
		   If This.Activa_Ayuda
		   
		      If !File(Allt(This.Ruta)+"\Ayuda.scx")
		         Return .f.
		      Endif
		      && Ejecutar el Metodo antes Ayuda para algun
		      && proceso de creacion de cursor u otra cosa
		      If !This.AntesAyuda()
		         Return .f.
		      Endif
		      
		      This.Flag_Ayuda = .t.
		      If Empty(This.Otro_Campo)
		         If Empty(This.Campos_Alias)
		            Do form (This.Ruta)+"Ayuda" With This.Alias_Tabla,This.Campo_Retorno,This.Orden_Alias,;
		                                             This.Valor_KeyFiltro To Valor               
		         Else
		            Do form (This.Ruta)+"Ayuda" With This.Alias_Tabla,This.Campo_Retorno,This.Orden_Alias,;
		                                             This.Valor_KeyFiltro,This.Campos_Alias To Valor
		         Endif
		      Else
		         Do form (This.Ruta)+"Ayuda" With This.Alias_Tabla,This.Campo_Retorno,This.Orden_Alias,;
		                                          This.Valor_KeyFiltro,This.Campos_Alias,This.Otro_Campo,;
		                                          This.Cond_OtroCampo To Valor
		      
		      Endif
		      This.Flag_Ayuda = .f.
		      If !Empty(Valor)
		         This.value = Valor
		         This.Valid()
		      Endif
		      
		   Endif
		
		Dodefault()
	ENDPROC

	PROCEDURE Init
		If Empty(This.Ruta)
		   If Vartype(ThisForm.Ruta_Fuente) = 'C'
		      If !Empty(Thisform.Ruta_Fuente)
		         This.Ruta = Thisform.Ruta_Fuente
		      Endif
		   Endif   
		Endif
		DoDefault()
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
	ENDPROC

ENDDEFINE
