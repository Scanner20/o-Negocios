	PROCEDURE Destroy
		Thisform.FinalizaSesion()
		
		
	ENDPROC

	PROCEDURE enviacorreo		&& Efectua el Envio de mail mediante el control MAPI
		Local nTot,i, okVacio, n_User, n_LenA
		
		If !Thisform.Sesion
		   =Messagebox("No se ha iniciado Sesion de Correo... Favor Reintentar ",0+64)
		   Return .f.
		Endif
		
		nTot = ThisForm.lstDestino.Listcount
		
		If Vartype(ArrUsr) = 'U'
		   Public Array ArrUsr(nTot)
		Endif   
		
		If nTot < 1
		   =messagebox("No se puede enviar el mensaje no hay Destinatarios ",0+64)
		   Return .f.
		endif
		
		ThisForm.ObjMensaje.MsgIndex = -1
		
		okVacio = .t.
		&& Agregado por GCA  21/03/2002
		n_LenA = 1
		n_User = 1
		Dimension ArrUsr(n_LenA)
		&& Agregado por GCA 21/03/2002
		For i=1 to nTot
		    If !Empty(ThisForm.lstDestino.ListItem(i))
		       If n_USer > n_LenA
		          Dimension ArrUSr(n_User)
		          n_LenA  = Alen(ArrUsr)
		       Endif
		       ArrUsr(n_User)                       = Allt(ThisForm.lstDestino.ListItem(i))
		       ThisForm.ObjMensaje.RecipIndex       =  n_User - 1
		       Thisform.ObjMensaje.RecipDisplayName = ArrUsr(n_User)
		       n_User = n_User + 1
		       okVacio = .f.
		    Endif
		Endfor
		
		ThisForm.ObjMensaje.RecipIndex = 0
		
		If OkVacio
		   =Messagebox("No se ha indicado un Destinatario del Mensaje!!!",0+16)
		   Return .f.
		Endif
		
		&& Si hay un archivo adjunto que enviar
		If !Empty(ThisForm.txtArchivo.Value)
		   ThisForm.ObjMensaje.AttachmentPathname = ThisForm.txtArchivo.Value
		endif
		
		ThisForm.ObjMensaje.MsgNoteText         = ThisForm.EdtMensaje.value
		ThisForm.ObjMensaje.MsgSubject          = ThisForm.txtAsunto.value
		
		&& Confirmacion de Lectura!!!
		ThisForm.ObjMensaje.MsgReceiptRequested = .T.
		
		ThisForm.ObjMensaje.Send()
		
		Return .t.
		
	ENDPROC

	PROCEDURE Error
		LPARAMETERS nError, cMethod, nLine
		Do Case
		   CASE nError = 1429 
		        Wait "Lista de Destinatarios Cancelada por Usuario..." Window NoWait
		   Case !Empty(ThisForm.ObjSesion.SessionID)
		        Wait "Un Momento No se ha Iniciado sesion de Correo...." Wind Nowait
		   Otherwise
		        =Messagebox("Ocurrio un error al tratar de Enviar un mail...  "+chr(13)+;
		                    "Numero de Error   : " + nerror + chr(13)+;
		                    "Programa / Metodo : " + cMethod + chr(13)+;
		                    "Linea             : " + nLine ,0+16)
		Endcase        
	ENDPROC

	PROCEDURE finalizasesion		&& Finaliza la Sesion de Correo Inicializada por el Control MAPI
		If Thisform.Sesion
		   ThisForm.ObjSesion.SignOff
		Endif
		Return .t.   
	ENDPROC

	PROCEDURE iniciasesion		&& Inicia la Sesion de Correo usando los controles MAPI
		
		&& Controlar si existe sesion activada o si necesita Activarla
		
		Thisform.Sesion = .f.  && sesion no Iniciada
		
		ThisForm.ObjSesion.NewSession = .f.
		ThisForm.ObjSesion.Downloadmail=.f.
		ThisForm.ObjSesion.LogonUI=.f.
		ThisForm.ObjSesion.SignOn
		If Empty(ThisForm.ObjSesion.SessionID)
		   If !ThisForm.ObjSesion.Newsession
		       ThisForm.ObjSesion.Newsession=.t.
		       ThisForm.ObjSesion.Downloadmail=.f.
		       ThisForm.ObjSesion.LogonUI=.t.
		       ThisForm.ObjSesion.SignOn
		       If Empty(ThisForm.ObjSesion.SessionID)
		          Return .f.
		       Endif
		   Else
		      Return .f.
		   Endif   
		Endif
		
		Thisform.Sesion = .t. && Sesion Iniciada
		
		Return .t.
		
	ENDPROC

	PROCEDURE Init
		LParameter cAsunto, cMensa1, cMensa2, bFlag, cNomDest, cNomArch, p_modal
		*******************************************************************************************************
		*!*	Parametros a usar : 
		*!*	    cAsunto    : Asunto del Mensaje a Enviar
		*!*	    cMensa1    : Primera parte del Mensaje
		*!*	    cMensa2    : Segunda parte del Mensaje
		*!*	    bFlag      : Indicador para que se muestre o no esta ventana
		*!*	                  false --> no se muestra la pantalla de envio y se envia el mail automaticamente.
		*!*	                  True  --> Activar la visualizacion de la ventana
		*!*	    cNomDest   : Nombre del destinatario
		*!*	                 = '*' -->  entonces se enviara un mail a varias personas!!!              
		*!*	                            en un arreglo llamado ArrUsr()
		*!*	    cNomArch   : Nombre del archivo adjunto que se enviara.         
		*!*	    p_modal    : .T. = Formulario modal,  .F. = No es modal
		*******************************************************************************************************
		IF !EMPTY(p_modal)
			This.WindowType = 1
		ENDIF
		This.Activate()
		
		&& Verificar el Nombre del Destino
		If VarType(cNomDest) # 'C'
		   cNomDest = ''
		Endif
		If Vartype(cMensa1) # 'C'
		   cMensa1 = ''
		Endif
		If Vartype(cMensa2) # 'C'
		   cMensa2 = ''
		Endif
		
		&& Verificar los datos del Mensaje
		If !Empty(cAsunto)
		   ThisForm.txtAsunto.Value = cAsunto 
		endif
		
		If !Empty(cMensa1+cMensa2)
		   ThisForm.EdtMensaje.Value = cMensa1 + cMensa2
		ENDIF
		
		
		If !Empty(cNomArch)
		   ThisForm.txtArchivo.Value      = NVL(ALLTRIM(cNomArch),"")
		
		   IF !FILE(This.txtArchivo.Value)
		   		MESSAGEBOX("El Archivo Adjunto: "+ThisForm.txtArchivo.Value+" No Existe ",16,"Envio de Correo")
		   		RETURN .F.
		   ENDIF
		ENDIF
		
		
		
		
		If !Thisform.IniciaSesion()
		   =Messagebox("No se ha iniciado Sesion de Correo!!!",0+16)
		   Return .f.
		Endif   
		
		If !Thisform.Sesion
		   =Messagebox("Variable de Inicio de Sesion no actualizada!!! ",0+64)
		   Return .f.
		Endif
		 
		ThisForm.ObjMensaje.SessionID = ThisForm.ObjSesion.SessionID
		ThisForm.ObjMensaje.MsgIndex  = -1
		
		&& Seleccionar la Opcion a Usar 
		ThisForm.lstDestino.Clear()
		Do Case 
		   && Pasar un Grupo de Usuario
		   Case cNomdest = '*'
		        && Buscar el Arreglo de Usuarios!!!
		        If vartype(ArrUsr)#'U'
		           nTot = Alen(ArrUsr)
			       If nTot>0
			          for i=1 to nTot
			             If !Empty(ArrUsr(i)) 
			                ThisForm.lstDestino.additem(ArrUsr(i))
			             Endif   
			          Endfor
			       Else
			          Messagebox("No se ha especificado un Grupo de Usuarios ",0+16)   
			          return .f.
			       Endif  
		        Else
		           =Messagebox("No se ha especificado el grupo de Usuarios!!!",0+16)
		           Return .f.
		        Endif
		   && Un solo destinatario     
		   Otherwise     
		        Public array ArrUsr(1)
		  	    ArrUsr(1) = cNomDest
		  	    If !Empty(ArrUsr(1))
		           ThisForm.lstDestino.additem(ArrUsr(1))
		        Endif   
		Endcase 
		        
		&& Si se activa la edicion de esta pantalla!!!
		If !bFlag and !Empty(cNomDest)
		   Thisform.EnviaCorreo()
		   Return .f.
		Endif
		
		Thisform.Refresh()
		
	ENDPROC

	PROCEDURE cmdArchivo.Click
		Local cNomArchivo
		cNomArchivo = ""
		cNomArchivo = getfile()
		
		If !Empty(cNomArchivo)
		   ThisForm.txtArchivo.Value = cNomArchivo
		   ThisForm.txtArchivo.refresh()
		Endif
	ENDPROC

	PROCEDURE cmdCancela.Click
		If Messagebox("Seguro de cancelar el Envio de Mensajes!!!",4+32)#6
		   Return .f.
		Endif
		Thisform.release()
	ENDPROC

	PROCEDURE cmdCancela.Error
		LPARAMETERS nError, cMethod, nLine
		Thisform.Error(nError,cMethod,nLine)
		Return .t.
	ENDPROC

	PROCEDURE cmdEnvia.Click
		If !Thisform.EnviaCorreo()
		   =Messagebox("No se ha podido enviar el Mensaje!!! , Verifique los datos",0+16)
		   Return .f.
		Endif
		Thisform.Release()
	ENDPROC

	PROCEDURE cmdEnvia.Error
		LPARAMETERS nError, cMethod, nLine
		Thisform.Error(nError,cMethod,nLine)
		Return .t.
	ENDPROC

	PROCEDURE cmdExt.Click
		If !Empty(ThisForm.TxtExt.Value)
		   ThisForm.lstDestino.AddItem(Allt(ThisForm.TxtExt.Value))
		   ThisForm.txtExt.Value = ""
		   ThisForm.txtExt.Refresh()
		Else
		   =Messagebox("Digite una cuenta de Correo que no exista Libreta de Direcciones",0+16,"Correo")
		   ThisForm.txtExt.SetFocus()
		Endif
		
	ENDPROC

	PROCEDURE cmdLista.Click
		ThisForm.ObjMensaje.show()
		
		If ThisForm.ObjMensaje.RecipCount > 0
		
		   ThisForm.lstDestino.clear()
		   nTot = ThisForm.ObjMensaje.RecipCount
		   
		   For i=1 to nTot
		       Thisform.ObjMensaje.RecipIndex = i-1
		       ThisForm.lstDestino.additem( ThisForm.ObjMensaje.RecipDisplayName)
		   Endfor
		   
		   ThisForm.ObjMensaje.RecipIndex = 0
		   
		endif
		
		Thisform.refresh()
	ENDPROC

	PROCEDURE cmdLista.Error
		LPARAMETERS nError, cMethod, nLine
		Thisform.Error(nError,cMethod,nLine)
		Return .t.
	ENDPROC

	PROCEDURE lstDestino.DblClick
		If !Empty(This.List(This.ListIndex))
		   If Messagebox("Desea Eliminar Destino?",0+4+32)=6
		      This.RemoveItem(This.ListIndex)
		   Endif   
		Endif   
		This.Refresh()
	ENDPROC

ENDDEFINE

