	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		DO CASE
			CASE nKeyCode = 27
				OFormato.ps_opcion = ""
				This.Release()
		ENDCASE
		
	ENDPROC

	PROCEDURE cmd_aceptar.Click
		****************************************************************
		***---	Acepta imprimir el formato
		****************************************************************
		DO CASE
			CASE ThisForm.Destino.Pantalla.Value = 1
				OFormato.ps_opcion = "P"	&& Pantalla
			CASE ThisForm.Destino.Impresora.Value = 1
				OFormato.ps_opcion = "I"	&& Impresora
			CASE ThisForm.Destino.Cancelar.Value = 1
				OFormato.ps_opcion = ""		&& Cancelar
		ENDCASE
		
	ENDPROC

	PROCEDURE Destino.Cancelar.DblClick
		ThisForm.cmd_aceptar.Click()
		
	ENDPROC

	PROCEDURE Destino.Cancelar.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		DO CASE
			CASE nKeyCode = 13
				ThisForm.cmd_aceptar.Click()
		ENDCASE
		
	ENDPROC

	PROCEDURE Destino.Impresora.DblClick
		ThisForm.cmd_aceptar.Click()
	ENDPROC

	PROCEDURE Destino.Impresora.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		DO CASE
			CASE nKeyCode = 13
				ThisForm.cmd_aceptar.Click()
		ENDCASE
		
	ENDPROC

	PROCEDURE Destino.Pantalla.DblClick
		ThisForm.cmd_aceptar.Click()
	ENDPROC

	PROCEDURE Destino.Pantalla.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		DO CASE
			CASE nKeyCode = 13
				ThisForm.cmd_aceptar.Click()
		ENDCASE
		
	ENDPROC

ENDDEFINE

DEFINE CLASS cls_runformato AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: configura_puerto
		*m: convierte_caracteres
		*m: mh_cierras_tablas		&& cierra las tablas
		*m: mh_construye_arreglos		&& crea archivos .MEN
		*m: mh_control_caracteres		&& Control de caracteres a imprimir
		*m: mh_convierte
		*m: mh_crea_formato		&& crea formato
		*m: mh_crea_men		&& crea archivo men
		*m: mh_cuenta
		*m: mh_ejecuta_formato		&& ejecuta el formato
		*m: mh_ejecuta_sqlrollback
		*m: mh_final_formato		&& comando para ejecutar despues del formato
		*m: mh_formato
		*m: mh_inicializa_printer		&& inicia la impresora
		*m: mh_inicializa_variables		&& inicializa las propiedades
		*m: mh_inicia_formato		&& inicia el formato
		*m: mh_inicio		&& similar al maestro de procesos de la plataforma
		*m: mh_interpreta
		*m: mh_numero_letra
		*m: mh_pone_alias
		*m: mh_programa_tablas_formato		&& ejecuta consulta desde el maestro de opciones para extraer las tablas que se usan en el formato
		*m: mh_rangos		&& rangos de impresión
		*m: mh_resolucion		&& calcula la resolución de la pantalla
		*m: mh_setea_entorno		&& setea el entorno de trabajo < SET >
		*m: mh_sumatoria
		*m: mh_temporal_pruebas
		*m: mh_traduce
		*m: mh_tresdigi
		*m: mh_ve_archivo		&& muestra el archivo a pantalla
		*m: procesos_memoria
		*p: areaante
		*p: cantidad_procesos_entrada
		*p: cantidad_procesos_salida
		*p: l6area		&& guarda el area 1
		*p: l6aream		&& guarda el area 2
		*p: lop		&& condicion
		*p: numero_proc_anterior
		*p: ph_n_conexion		&& pruebas -   conexion a base de datos ALSA
		*p: ps_cadena_llave		&& guarda la cadena llave del registro actual para imprimir el formato
		*p: ps_indicador		&& "1" = crea archio .MEN,    "2" = Ejecuta el formato
		*p: ps_nombre_cia		&& nombre de la compañia
		*p: ps_opcion		&& "I" = Formato a Impresora,     "P" = Formato a pantalla
		*p: ps_programa_codigo		&& codigo del programa
		*p: ps_programa_nombre		&& nombre del programa
		*p: ps_ruta		&& ruta del sistema - aplicación
		*p: ps_ruta_osis		&& ruta de las librerias osis
		*p: ps_ruta_reporte		&& ruta de los reportes
		*a: lista_proceso_memoria[1,0]
	*</DefinedPropArrayMethod>

	*<PropValue>
		areaante = .F.
		AutoCenter = .T.
		cantidad_procesos_entrada = 0
		cantidad_procesos_salida = 0
		Caption = "FORMATOS"
		ClipControls = .T.
		Closable = .T.
		ControlBox = .T.
		DataSession = 2
		DoCreate = .T.
		Height = 119
		Icon = ..\imag\note17.ico
		l6area = 1
		l6aream = 2
		lop = 
		MaxButton = .F.
		MinButton = .F.
		Name = "cls_runformato"
		numero_proc_anterior = 0
		ph_n_conexion = -1
		ps_cadena_llave = 
		ps_indicador = ('1')
		ps_nombre_cia = 
		ps_opcion = ('P')
		ps_programa_codigo = 
		ps_programa_nombre = 
		ps_ruta = 
		ps_ruta_osis = 
		ps_ruta_reporte = 
		Visible = .T.
		Width = 116
		WindowType = 1
	*</PropValue>
	
	PROCEDURE configura_puerto
		PRIVATE lxarea1
		lxarea1=SELECT()
		***--- << CREA ARCHIVOS MEN -  PASO 1>>
		SELECT 0 
		ps_cadena=           "SELECT A.* "
		ps_cadena=ps_cadena+ "FROM DBO.SYS_TABLA_FORMATOS_FOC A "
		ps_cadena=ps_cadena+ "WHERE LTRIM(RTRIM(A.PROGRAMA))='"+NVL(THIS.Ps_Programa_Codigo,"")+"' "
		IF Ocnx.Tipo_BD=1
			IF SQLEXEC(ocnx.conexion, ps_cadena, "WFORM")<1
				MESSAGEBOX("Error al abrir el archivo FORMATO CABECERA"+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		IF Ocnx.Tipo_BD=4
			IF ocnx.ms_ejecuta_Sql(ps_cadena, "WFORM",This.DataSessionId)<1
				MESSAGEBOX("Error al abrir el archivo FORMATO CABECERA"+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		
		SELECT "WFORM"
		INDEX ON PROGRAMA TAG I ADDI
		
		
		***************************************************************************
		************  Rutinas que Armas Programa Intrucciones   de     ************
		************                F o r m a t o s                    ************
		***************************************************************************
		ps_cadena="SELECT * FROM dbo.SYS_FORMATOS_LETRAS_FOL "
		SELECT 0 
		IF Ocnx.Tipo_BD=1
			IF SQLEXEC(ocnx.conexion, ps_cadena, "w233")<1
				MESSAGEBOX("Error al abrir el archivo FORMATO LETRAS"+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		IF Ocnx.Tipo_BD=4
			IF ocnx.Ms_Ejecuta_SQL(ps_cadena, "w233",ThisForm.DataSessionId)<1
				MESSAGEBOX("Error al abrir el archivo FORMATO LETRAS"+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		
		SELECT "w233"
		INDEX ON prefijo+codigo TAG I ADDI
		
		SELECT "wform"
		if seek("PR"+letra,"w233")
		   store alltrim(w233.caracter1) to l6_char,l6_char_c
		*!*	endif
		*!*	l6_letra  = letra
		*!*	l6_fijo   = Tscroll
		*!*	l6_qc     = copias
		*!*	l6_pi     = fil_ini
		*!*	l6_ci     = col_ini
		*!*	l6_ancho  = ancho
		*!*	l6_movi   = qmovi
		*!*	l6_lineas = qlineas
		*!*	l6_hoja   = hoja
		*!*	l6_space  = iif(espacio="06",chr(27)+chr(48),"")
		if "LPT"$puerto or puerto=" "
		   l6_puerto = iif(puerto=" ",l6_puerto,allt(puerto))
		else
		   if !"999"$puerto and seek("IM"+rtrim(puerto),"w233")
		      store upper(alltrim(w233.deScri)) to l6_puerto
		   else
		      l6_puerto="999"    
		   endif   
		endif  
		ENDIF
		IF USED("wform")
			USE IN "wform"
		ENDIF
		IF USED("w233")
			USE IN "w233"
		ENDIF
		SELECT (lxarea1)
	ENDPROC

	PROCEDURE convierte_caracteres
		LPARAMETERS lpcadena
		
		lpcadena=STRTRAN(lpcadena,"Ñ","¥")
		lpcadena=STRTRAN(lpcadena,"ñ","¤")
		lpcadena=STRTRAN(lpcadena,"ó","¢")
		lpcadena=STRTRAN(lpcadena,"í","¡")
		
		
		
		RETURN lpcadena
		
		
	ENDPROC

	PROCEDURE Load
		This.mh_ejecuta_sqlrollback()
		
		This.Mh_setea_entorno()
		********************************************************************************************
		***--- init del objeto
		********************************************************************************************
		PUBLIC l6_s,  l6_e,  l6_m,  l6_m1, l6_t, l6_z, l6_com, l6_files, l6_files, l6_qfiles
		PUBLIC l6_qc, l6_pi, l6_ci, l6_movi, l6_ancho, l6_lineas, l6_hoja, l6_char, l6_char_c
		PUBLIC l6_fijo, l6_desp, l6_puerto, l6_prog, l6aream, l6area, l6_campo1, l6_campo2
		PUBLIC l6_qcom, l6_qs, l6_qe, l6_qm, l6_qm1, l6_qt, l6_qz, l6_qcom, l6_ini_e, l6_f_e, l6_f_t
		PUBLIC l6_q_e, l6_q_t, l6_f_m, l6_f_mm, l6_f_m1, l6_f_m2, l6_lin_movi
		PUBLIC l6siglo, pdesde, phasta, l6fecha, l6limite, gwalto, gwancho, l6final
		PUBLIC l6final_erase_fxp
		
		PUBLIC l6_com_final, l6_qcom_final
		
		l6_qcom       = 0
		l6_qcom_final = 0
		
		
		This.ps_indicador       = OFormato.ps_indicador
		This.ps_opcion          = OFormato.ps_opcion
		This.Ps_Programa_Codigo = OFormato.ps_codigo_programa
		This.Ps_Programa_Nombre = OFormato.ps_nombre_programa
		This.ps_cadena_llave    = OFormato.ps_cadena_llave
		
		&&MESSAGEBOX(This.Ps_Programa_Codigo)
		
		&&SUSP
		This.Mh_Inicializa_Variables()
		This.mh_resolucion()
		DO CASE
			CASE This.ps_indicador = "1"
				This.mh_crea_men()
			CASE This.ps_indicador = "2"
				DO CASE
					CASE This.ps_opcion = "P"	&& Pantalla
						*DO FORM ALLTRIM(Oentorno.RutaOsis) + "FORMS/FORMATO.SCX" TO ps_opcion
						*This.ps_opcion = OFormato.ps_opcion
						*IF ALLTRIM(This.ps_opcion) == ""
						*	***--- El usuario cancela la opción
						*	RETURN .F.
						*ENDIF
						This.mh_ejecuta_formato()
					CASE This.ps_opcion = "I"	&& Impresora
						This.Areaante = SELECT()
						This.Configura_puerto() 
						SELECT (This.Areaante)	
						This.mh_ejecuta_formato(.t.)
					OTHERWISE
						MESSAGEBOX("Destino de la opción del formato no definido"+CHR(13)+;
								   "Sólo son válidos :"+CHR(13)+;
								   "[ P ] = Pantalla "+CHR(13)+;
								   "[ I ] = Impresora "+CHR(13)+;
								   "Verifique ...!!!",64,"Opciones de formato")
				ENDCASE
		ENDCASE
		RETURN .f.
		
		
	ENDPROC

	PROCEDURE mh_cierras_tablas		&& cierra las tablas
	ENDPROC

	PROCEDURE mh_construye_arreglos		&& crea archivos .MEN
		***************************************************************************
		************  Rutinas que Armas Programa Intrucciones   de     ************
		************                F o r m a t o s                    ************
		***************************************************************************
		ps_cadena="SELECT * FROM dbo.SYS_FORMATOS_LETRAS_FOL "
		IF Ocnx.Tipo_BD=1
			IF SQLEXEC(ocnx.conexion, ps_cadena, "w233")<1
				MESSAGEBOX("Error al abrir el archivo FORMATO LETRAS"+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		IF Ocnx.Tipo_BD=4
			IF ocnx.Ms_Ejecuta_SQL(ps_cadena, "w233",ThisForm.DataSessionId)<1
				MESSAGEBOX("Error al abrir el archivo FORMATO LETRAS"+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		
		SELECT "w233"
		INDEX ON prefijo+codigo TAG I ADDI
		
		SELECT "wform"
		if seek("PR"+letra,"w233")
		   store alltrim(w233.caracter1) to l6_char,l6_char_c
		endif
		l6_letra  = letra
		l6_fijo   = Tscroll
		l6_qc     = copias
		l6_pi     = fil_ini
		l6_ci     = col_ini
		l6_ancho  = ancho
		l6_movi   = qmovi
		l6_lineas = qlineas
		l6_hoja   = hoja
		l6_space  = iif(espacio="06",chr(27)+chr(48),"")
		if "LPT"$puerto or puerto=" "
		   l6_puerto = iif(puerto=" ",l6_puerto,allt(puerto))
		else
		   if !"999"$puerto and seek("IM"+rtrim(puerto),"w233")
		      store upper(alltrim(w233.deScri)) to l6_puerto
		   else
		      l6_puerto="999"    
		   endif   
		endif   
		
		use in w233
		store 1 to i1,i2,i3,i4,i5,y1,z1,wco,i9, IFINAL
		store "" to x1,x2
		
		wprog=this.ps_programa_codigo
		SELECT "sys_for1"
		do while ALLTRIM(wprog)==ALLTRIM(programa)
		      lc=alltrim(campo1)
		      lc=strtran(lc,'"',"'")
		      if (".0"$lc or ".1"$lc or ".2"$lc or ".3"$lc or ".4"$lc) and !"0."$lc
		         if ".."$lc
		            lc=this.mh_sumatoria(lc)
		         endif
		         lc=this.mh_interpreta(lc)
		      endif
		      do case
		      case tipo="="   && Reporte Equivalente
		         xx=val(right(lc,3))
		         seek upper(left(lc,5))+str(xx,3)
		         wprog=upper(left(lc,5))
		         skip -1
		      case tipo$"CRF"   && Modo Comando
		         if longitud > 0
		            l6_com(i1)="sele "+str(longitud,2)
		            i1=i1+1
		         endif
		         if "GRABA"$UPPER(LC)
		             L6_Z(y1)="replace "+ SUBs(LC,AT(":",LC)+1)
		             L6_Z(y1)=strtran(L6_Z(y1),"="," with ")
		             y1=y1+1
		         ELSE
		           do case
		           case tipo="F"
		               l6_com(i1)="set filter to "+ lc + x1
		               x1=" additive"
		            case tipo="R"
		               l6_com(i1)="set rela to "+ lc + x2
		               x2=" additive"
		            otherwise
		               l6_com(i1)=lc
		            endcase
		            i1=i1+1
		         ENDIF   
				***-----------------------------------------------
		      case tipo$"Z"   && Modo Comando - FINAL
		      	l6_com_FINAL(IFINAL)=lc
		      	IFINAL = IFINAL + 1
				***-----------------------------------------------
				
		      case tipo="?"   && Pregunta de seleccion
		         l6_p(separacion)=lc
		      case tipo="S"   && Mascara
		         fin=i2
		         ini=i2
		         if "HASTA"$upper(edicion)
		            fin=int(val(right(alltrim(edicion),3)))
		         endif
		         for i=ini to fin
		            l6_s(i)=campo1
		            l6_s(i)=left(l6_s(i),l6_ancho)
		         endfor
		         i2=i
		      case tipo="E"
		         l6_e(i3,1)=lc
		         l6_e(i3,2)=linea
		         l6_e(i3,3)=columna
		         l6_e(i3,4)=longitud
		         l6_e(i3,5)=alltrim(edicion)
		         l6_e(i3,6)=alltrim(lectura)
		         i3=i3+1
		      case tipo="M"
		         if wco=1
		            l6_m(i4,1)=lc
		            l6_m(i4,2)=linea
		            l6_m(i4,3)=columna
		            l6_m(i4,4)=longitud
		            l6_m(i4,5)=alltrim(edicion)
		            l6_m(i4,6)=alltrim(lectura)
		            i4=i4+1
		         else
		            wco=2
		            l6_m1(i9,1)=lc
		            l6_m1(i9,2)=linea
		            l6_m1(i9,3)=columna
		            l6_m1(i9,4)=longitud
		            l6_m1(i9,5)=alltrim(edicion)
		            l6_m1(i9,6)=alltrim(lectura)
		            i9=i9+1
		         endif   
		         if wco#2
		            wla=linea
		            skip
		            wco=iif(wla=linea,1,0)
		            skip -1
		         endif
		      case tipo="T" or tipo="D"
		         l6_desp=iif(tipo="D",.t.,.f.)
		         l6_t(i5,1)=lc
		         l6_t(i5,2)=linea
		         l6_t(i5,3)=columna
		         l6_t(i5,4)=longitud
		         l6_t(i5,5)=alltrim(edicion)
		         l6_t(i5,6)=alltrim(lectura)
		         i5=i5+1
		      ENDCASE
		      SKIP
		      ***--- Código adicional para validar fin de la tabla <<LEHV-18/06/2003>>
		      IF EOF("sys_for1")
		      	EXIT
		      ENDIF
		enddo
		retu
		
	ENDPROC

	PROCEDURE mh_control_caracteres		&& Control de caracteres a imprimir
		para a,b,c,d
		priv pfont
		if parameter()=3
		   if !empty(a)
		      @0,0 say &a
		   endif
		   if !"PRINTER"$b and !empty(c)
		      @0,0 say &c
		   endif     
		else
		   pfont=a+","+b
		   SET PRINTER FONT (pfont) style (c)
		endif   
		retu               
		
	ENDPROC

	PROCEDURE mh_convierte
		para dato,wc
		pnum=alltrim(str(dato,10,2))
		pnum=strt(pnum,",",".")
		pent=left(pnum,at(".",pnum)-1)
		pdec=subs(pnum,at(".",pnum)+1)
		if pent#"0"
		   wc=0
		   for i=len(pent) to 1 step-1
		       wc=wc+1
		       wn(wc)=int(val(subs(pent,i,1)))
		   endfor
		   wbase=0
		   do case
		      case len(pent)<4
		           wtope=iif(len(pent)>3,3,len(pent))
		           this.mh_tresdigi()   
		      case len(pent)<7 and len(pent)>3
		           wtope=iif(len(pent)>3,3,len(pent))
		           this.mh_tresdigi()   
		           wbase=3
		           c2   = " MIL "
		           wtope=iif(len(pent)>6,6,len(pent))
		           this.mh_tresdigi()
		      case len(pent)>6
		           wtope=iif(len(pent)>3,3,len(pent))
		           this.mh_tresdigi()   
		           wbase=3
		           c2   = " MIL "
		           wtope=iif(len(pent)>6,6,len(pent))
		           this.mh_tresdigi()
		           wbase=6
		           c2   =iif(wn(4)+wn(5)+wn(6)=0,"",c2)
		           c3   =iif(wn(9)+wn(8)+wn(7)=1," MILLON "," MILLONES ")
		           wtope=iif(len(pent)>9,9,len(pent))
		           this.mh_tresdigi()
		   endcase
		else
		   c1(1)="CERO"    
		endif    
		retu ALLTRIM(c1(9)+c1(8)+c1(7)+c3+c1(6)+c1(5)+c1(4)+c2+c1(3)+c1(2)+c1(1)+" Y "+pdec+"/100")
		
	ENDPROC

	PROCEDURE mh_crea_formato		&& crea formato
		********************************************************************************************
		***--- crea el formato
		********************************************************************************************
		   la=1
		   for i=1 to l6_lin_movi - 1
		      dime txt(l6_qe)
		      pcadena="'"+iif(l6_qs>0,l6_s(i),space(l6_ancho))+"'"
		      if la < l6_qe+1
		         if i=l6_e(la,2)
		            p_i=1
		            for j= la to l6_qe
		               if i <> l6_e(j,2)
		                  exit
		               endif
		               txt(j)=subs(iif(l6_qs>0,l6_s(i),space(l6_ancho)),p_i,l6_e(j,3)-p_i)
		               p_i=l6_e(j,3)+l6_e(j,4)
		            endfor
		            final=subs(iif(l6_qs>0,l6_s(i),space(l6_ancho)),p_i)
		            pcadena=""
		            for j = la to l6_qe
		               if i <> l6_e(j,2)
		                  exit
		               endif
		               do case
		               case type("&l6_e(j,01)")="N" or "9."$l6_e(J,05) or "9,9"$l6_e(J,05)
		                    pcadena=pcadena+"'"+txt(j)+"'+left("+l6b+"("+l6_e(j,01)+",'"+l6_e(j,05)+"'),"+str(l6_e(j,04),3)+")+"
		               case type("&l6_e(j,01)")="C"
		                  x1=l6_e(j,01)
		                  if LEN(l6_e(j,06))#0
		                     x1="lectura("+left(l6_e(j,06),2)+","+alltrim(subs(l6_e(j,06),4))+",'"+l6_e(j,01)+"')"
		                  endif   
		                  if len(l6_e(j,05))=0
		                        pcadena=pcadena+"'"+txt(j)+"'+left("+X1+","+str(l6_e(j,04),3)+")+"
		                  else
		                     if "@"$l6_e(j,05)
		                        pcadena=pcadena+"'"+txt(j)+"'+strtran(left(transform("+X1+",'"+l6_e(j,05)+"'),"+str(l6_e(j,04),3)+"),'- ','  ')+"
		                     else                     
		                        if at(",",l6_e(j,05))=0
		                           lcampo1="edita("+X1+",'"+l6_e(j,05)+"','-')"
		                        else
		                           lcampo1="edita("+X1+",'"+left(l6_e(j,05),at(',',l6_e(j,05))-1)+"',"+right(l6_e(j,05),1)+")"
		                        endif
		                        pcadena=pcadena+"'"+txt(j)+"'+left("+lcampo1+","+str(l6_e(j,04),3)+")+"
		                     endif
		                  endif
		               case type("&l6_e(j,01)")="D"
		                  pcadena=pcadena+"'"+txt(j)+"'+left(fechae("+l6_e(j,01)+"),"+str(l6_e(j,04),3)+")+"
		               otherwise
		                  pcadena=pcadena+"'"+txt(j)+"'+left("+l6_e(j,01)+","+str(l6_e(j,04),3)+")+"
		               endcase
		            endfor
		            pcadena=left(pcadena,len(pcadena)-1)
		            pcadena=pcadena+"+'"+final+"'"
		            la=j
		         endif
		      endif
		      l6_f_e(i)=pcadena
		      l6_q_e=i
		   endfor
		   dime l6_f_e(l6_q_e)
		   if l6_qm > 0
		      dime txt(l6_qm)
		      txt=""
		      pcadena=""
		      p_i=1
		      i=l6_lin_movi
		      l6_f_m1=iif(l6_qs>0,l6_s(i),space(l6_ancho))
		      for j=1 to l6_qm
		         txt(j)=subs(iif(l6_qs>0,l6_s(i),space(l6_ancho)),p_i,l6_m(j,3)-p_i)
		         p_i=l6_m(j,3)+l6_m(j,4)
		      endfor
		      final=subs(iif(l6_qs>0,l6_s(i),space(l6_ancho)),p_i)
		      for j=1 to l6_qm
		         do case
		         case type("&l6_m(j,01)")="N"
		              pcadena=pcadena+"'"+txt(j)+"'+left("+l6b+"("+l6_m(j,01)+",'"+l6_m(j,05)+"'),"+str(l6_m(j,04),3)+")+"
		         case type("&l6_m(j,01)")="C"
		            x1=l6_m(j,01)
		            if LEN(l6_m(j,06))#0
		                x1="lectura("+left(l6_m(j,06),2)+","+alltrim(subs(l6_m(j,06),4))+",'"+l6_m(j,01)+"')"
		            endif   
		            if len(l6_m(j,05))=0
		               pcadena=pcadena+"'"+txt(j)+"'+left("+X1+","+str(l6_m(j,04),3)+")+"
		            else
		               if "@"$l6_m(j,05)
		                   pcadena=pcadena+"'"+txt(j)+"'+strtran(left(transform("+X1+",'"+l6_m(j,05)+"'),"+str(l6_m(j,04),3)+"),'- ','  ')+"
		               else            
		                  if at(",",l6_m(j,05))=0
		                     lcampo1="edita("+X1+",'"+l6_m(j,05)+"','-')"
		                  else
		                     lcampo1="edita("+X1+",'"+left(l6_m(j,05),at(',',l6_m(j,05))-1)+"',"+right(l6_m(j,05),1)+")"
		                  endif
		                  pcadena=pcadena+"'"+txt(j)+"'+left("+lcampo1+","+str(l6_m(j,04),3)+")+"
		               endif
		            endif
		         case type("&l6_m(j,01)")="D"
		            pcadena=pcadena+"'"+txt(j)+"'+left(fechae("+l6_m(j,01)+"),"+str(l6_m(j,04),3)+")+"
		         otherwise
		            pcadena=pcadena+"'"+txt(j)+"'+left("+l6_m(j,01)+","+str(l6_m(j,04),3)+")+"
		         endcase
		      endfor
		      pcadena=left(pcadena,len(pcadena)-1)
		      pcadena=pcadena+"+'"+final+"'"
		      l6_f_m=pcadena
		   endif
		   la=1
		   x1=0
		   if l6_qm1 > 0
		      dime txt(l6_qm1)
		      txt=""
		      pcadena=""
		      p_i=1
		      i=l6_lin_movi
		      l6_f_m2=iif(l6_qs>0,l6_s(i),space(l6_ancho))
		      for j=1 to l6_qm1
		         txt(j)=subs(iif(l6_qs>0,l6_s(i),space(l6_ancho)),p_i,l6_m1(j,3)-p_i)
		         p_i=l6_m1(j,3)+l6_m1(j,4)
		      endfor
		      final=subs(iif(l6_qs>0,l6_s(i),space(l6_ancho)),p_i)
		      for j=1 to l6_qm1
		         do case
		         case type("&l6_m1(j,01)")="N" or "9."$l6_m1(J,05) or "9,9"$l6_m1(J,05)
		              pcadena=pcadena+"'"+txt(j)+"'+left("+l6b+"("+l6_m1(j,01)+",'"+l6_m1(j,05)+"'),"+str(l6_m1(j,04),2)+")+"
		         case type("&l6_m1(j,01)")="C"
		            x2=l6_m1(j,01)
		            if LEN(l6_m1(j,06))#0
		                x2="lectura("+left(l6_m1(j,06),2)+","+alltrim(subs(l6_m1(j,06),4))+",'"+l6_m1(j,01)+"')"
		            endif   
		            if len(l6_m1(j,05))=0
		               pcadena=pcadena+"'"+txt(j)+"'+left("+X2+","+str(l6_m1(j,04),2)+")+"
		            else
		               if "@"$l6_m1(j,05)
		                   pcadena=pcadena+"'"+txt(j)+"'+strtran(left(transform("+X2+",'"+l6_m1(j,05)+"'),"+str(l6_m1(j,04),2)+"),'- ','  ')+"
		               else            
		                  if at(",",l6_m1(j,05))=0
		                     lcampo1="edita("+X2+",'"+l6_m1(j,05)+"','-')"
		                  else
		                     lcampo1="edita("+X2+",'"+left(l6_m1(j,05),at(',',l6_m1(j,05))-1)+"',"+right(l6_m1(j,05),1)+")"
		                  endif
		                  pcadena=pcadena+"'"+txt(j)+"'+left("+lcampo1+","+str(l6_m1(j,04),2)+")+"
		               endif
		            endif
		         case type("&l6_m1(j,01)")="D"
		            pcadena=pcadena+"'"+txt(j)+"'+left(fechae("+l6_m1(j,01)+"),"+str(l6_m1(j,04),2)+")+"
		         otherwise
		            pcadena=pcadena+"'"+txt(j)+"'+left("+l6_m1(j,01)+","+str(l6_m1(j,04),2)+")+"
		         endcase
		      endfor
		      pcadena=left(pcadena,len(pcadena)-1)
		      pcadena=pcadena+"+'"+final+"'"
		      l6_f_mm=pcadena
		   endif
		   if l6_qt>0
		      *l6t=iif(l6_qs=0,l6_lin_movi + l6_movi + l6_qt ,l6_qs)
		      l6t=iif(l6_qs=0,l6_lineas,l6_qs)
		      if l6_lin_movi + l6_movi >= l6t
		         =messagebox("Hay muchas lineas de Movimiento",16,gcia)
		      endif
		      for i=l6_lin_movi + l6_movi  to l6t
		         x1=x1+1
		         dime txt(l6_qt)
		         txt=""
		         pcadena="'"+iif(l6_qs>0,l6_s(i),space(l6_ancho))+"'"
		         if la < l6_qt+1
		            if i=l6_t(la,2)
		               p_i=1
		               for j= la to l6_qt
		                  if i <> l6_t(j,2)
		                     exit
		                  endif
		                  txt(j)=subs(iif(l6_qs>0,l6_s(i),space(l6_ancho)),p_i,l6_t(j,3)-p_i)
		                  p_i=l6_t(j,3)+l6_t(j,4)
		               endfor
		               final=subs(iif(l6_qs>0,l6_s(i),space(l6_ancho)),p_i)
		               pcadena=""
		               for j = la to l6_qt
		                  if i <> l6_t(j,2)
		                     exit
		                  endif
		                  do case
		                  case type("&l6_t(j,01)")="N" or "9."$L6_T(J,05) or "9,9"$L6_T(J,05)
		                       pcadena=pcadena+"'"+txt(j)+"'+left("+l6b+"("+l6_t(j,01)+",'"+l6_t(j,05)+"'),"+str(l6_t(j,04),3)+")+"
		                  case type("&l6_t(j,01)")="C"
		                     yx1=l6_t(j,01)
		                     if LEN(l6_t(j,06))#0
		                        yx1="lectura("+left(l6_t(j,06),2)+","+alltrim(subs(l6_t(j,06),4))+",'"+l6_t(j,01)+"')"
		                     endif   
		                     if len(l6_t(j,05))=0
		                        pcadena=pcadena+"'"+txt(j)+"'+left("+yx1+","+str(l6_t(j,04),3)+")+"
		                     else
		                        if "@"$l6_t(j,05)
		                            pcadena=pcadena+"'"+txt(j)+"'+strtran(left(transform("+yx1+",'"+l6_t(j,05)+"'),"+str(l6_t(j,04),3)+"),'- ','  ')+"
		                        else              
		                           if at(",",l6_t(j,05))=0
		                              lcampo1="edita("+yx1+",'"+l6_t(j,05)+"','-')"
		                           else
		                              lcampo1="edita("+yx1+",'"+left(l6_t(j,05),at(',',l6_t(j,05))-1)+"',"+right(l6_t(j,05),1)+")"
		                           endif
		                           pcadena=pcadena+"'"+txt(j)+"'+left("+lcampo1+","+str(l6_t(j,04),3)+")+"
		                       endif    
		                     endif
		                  case type("&l6_t(j,01)")="D"
		                     pcadena=pcadena+"'"+txt(j)+"'+left(fechae("+l6_t(j,01)+"),"+str(l6_t(j,04),3)+")+"
		                  otherwise
		                     pcadena=pcadena+"'"+txt(j)+"'+left("+l6_t(j,01)+","+str(l6_t(j,04),3)+")+"
		                  endcase
		               endfor
		               pcadena=left(pcadena,len(pcadena)-1)
		               pcadena=pcadena+"+'"+final+"'"
		               la=j
		            endif
		         endif
		         l6_f_t(x1)=pcadena
		         l6_q_t=x1
		      endfor
		      if l6_q_t > 0
		         dime l_f_t(l6_q_t)
		      else
		         dime l_f_t(1)         
		      endif
		   endif
		retu
		
	ENDPROC

	PROCEDURE mh_crea_men		&& crea archivo men
		********************************************************************************************
		***--- crea archivos de extensión   .men
		********************************************************************************************
		***--- Maestro de Opciones : Extrae las tablas que se usan para el formato
		IF !This.Mh_Programa_Tablas_Formato()
			RETURN .f.
		ENDIF
		
		***--- << CREA ARCHIVOS MEN -  PASO 1>>
		ps_cadena=           "SELECT A.* "
		ps_cadena=ps_cadena+ "FROM DBO.SYS_TABLA_FORMATOS_FOC A "
		ps_cadena=ps_cadena+ "WHERE LTRIM(RTRIM(A.PROGRAMA))='"+NVL(THIS.Ps_Programa_Codigo,"")+"' "
		IF Ocnx.Tipo_BD=1
			IF SQLEXEC(ocnx.conexion, ps_cadena, "WFORM")<1
				MESSAGEBOX("Error al abrir el archivo FORMATO CABECERA"+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		IF Ocnx.Tipo_BD=4
			IF ocnx.ms_ejecuta_Sql(ps_cadena, "WFORM",This.DataSessionId)<1
				MESSAGEBOX("Error al abrir el archivo FORMATO CABECERA"+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		
		SELECT "WFORM"
		INDEX ON PROGRAMA TAG I ADDI
		
		ps_cadena=           "SELECT A.* "
		ps_cadena=ps_cadena+ "FROM DBO.SYS_FORMATOS_DETALLE_FOD A "
		ps_cadena=ps_cadena+ "WHERE LTRIM(RTRIM(A.PROGRAMA))='"+NVL(THIS.Ps_Programa_Codigo,"")+"' "
		IF Ocnx.Tipo_BD=1
			IF SQLEXEC(ocnx.conexion, ps_cadena, "SYS_FOR1")<1
				MESSAGEBOX("Error al abrir el archivo FORMATO DETALLE"+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		IF Ocnx.Tipo_BD=4
			IF ocnx.Ms_Ejecuta_SQL(ps_cadena, "SYS_FOR1",This.DataSessionId)<1
				MESSAGEBOX("Error al abrir el archivo FORMATO DETALLE"+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		
		SELECT "SYS_FOR1"
		INDEX ON PROGRAMA+ITEM TAG I ADDI
		
		
		lprog=allt(wform.detalle)
		l6b="tran"
		dime l6_s(90)            && Arreglo de Shell   Max 70 lineas
		dime l6_e(90,06)         && Arreglo de Encabezado - Datos Fijos
		dime l6_m(70,06)         && Arreglo de Movimientos 1
		dime l6_m1(70,06)        && Arreglo de Movimientos 2
		dime l6_t(70,06)         && Arreglo de Totales o de Pi‚ de Pagina
		dime l6_z(05)            && Intrucciones Finales de Grabaci¢n
		dime l6_com(30)
		dime l6_com_FINAL(30)
		dime l6_files(30)
		l6_files="*"
		l6_qfiles=ascan(l6_files,"*")-1
		store 0 to lqitems,ac1,ac2,ac3,l6_qc,l6_pi,l6_ci,l6_movi
		l6_ancho = 80        
		l6_lineas= 66
		l6_hoja  = 66
		l6_char  = 18
		l6_char_c= 18
		l6_fijo  = 20
		l6_desp  = .f.
		l6_puerto = " "
		l6_prog   = lprog
		if "3=2"$l6_prog
		   this.l6aream=3
		endif
		sele (this.l6area)
		a=key(val(sys(21)))
		l6_campo1=this.mh_pone_alias(a,this.l6area)
		l6_campo2=this.mh_pone_alias(a,this.l6aream)
		
		sele wform
		This.mh_construye_arreglos()
		
		sele (this.l6area)
		l6_qcom=ascan(l6_com,.f.)-1
		l6_qcom_FINAL=ascan(l6_com_FINAL,.f.)-1
		
		l6_qs  =ascan(l6_s,.f.)-1
		l6_qe  =(ascan(l6_e,.f.)-1)/6
		l6_qm  =(ascan(l6_m,.f.)-1)/6
		l6_qm1 =(ascan(l6_m1,.f.)-1)/6
		l6_qt  =(ascan(l6_t,.f.)-1)/6
		l6_qz  =(ascan(l6_z,.f.)-1)
		l6_qc  =l6_qc+1
		if l6_qcom > 0
			dime l6_com(l6_qcom)
		ENDIF
		if l6_qcom_FINAL > 0
			dime l6_com_FINAL(l6_qcom_FINAL)
		ENDIF
		if l6_qs > 0
			dime l6_s(l6_qs)
		else
			l6_ini_e=l6_e(01,02)   
		endif   
		if l6_qz>0
			dime l6_z(l6_qz)
		else
			rele l6_z
		endif
		if l6_qe > 0
			dime l6_e(l6_qe,06)
		endif
		if l6_qm>0
			dime l6_m(l6_qm,06)
		endif
		if l6_qm1>0
			dime l6_m1(l6_qm1,06)
		endif
		if l6_qt > 0
			dime l6_t(l6_qt,06)
		endif   
		dime l6_f_e(70)
		dime l6_f_t(70)
		l6_q_e=0
		l6_q_t=0
		l6_f_m=""
		l6_f_mm=""
		l6_f_m1=""
		l6_f_m2=""
		l6_lin_movi=iif(l6_qm>0,l6_m(01,02),iif(l6_qt>0,l6_e(l6_qe,02)+1,l6_lineas + 1))
		   
		this.mh_crea_formato()
		   
		rele l6_s,l6_e,l6_m,l6_t,l6_m1
		save to this.ps_ruta + "MEN\" + this.ps_programa_codigo+"F.MEM" all like l6_*
		
		IF USED("WFORM")
			USE IN "WFORM"
		ENDIF
		IF USED("SYS_FOR1")
			USE IN "SYS_FOR1"
		ENDIF
		
		this.Mh_Cierras_Tablas
		
	ENDPROC

	PROCEDURE mh_cuenta
		para a,b
		priv valor
		
		valor=int(a/b)
		if mod(a,b) > 0
		   valor=valor+1
		endif
		retu valor
		
	ENDPROC

	PROCEDURE mh_ejecuta_formato		&& ejecuta el formato
		********************************************************************************************
		***--- ejecuta el formato
		********************************************************************************************
		***--- << EJECUTA FORMATO -  PASO 2>>
		para pimpresora
		if parameters()=0
		   pimpresora=.F.
		ENDIF
		
		&&SET MESSAGE TO SET("Procedure")
		
		
		TRY 
				l6fecha  =set("date")
				l6_char_c=18
				l6vez    = 0
				l6_space = ""
		
				this.l6area   = 1
				this.l6aream  = 2
		
				gdef              = ""
				l6final           = ""
				l6final_erase_fxp = ""
				gorden            = ""
				l6pag             = 0
				store 0 to l6v1,l6v2,l6v3,l6v4,l6v5,l6v6,l6v7,l6v7,l8v8,l6v9
				l6_letra = ""
				if file(this.ps_ruta + "MEN\" + this.ps_programa_codigo + "F.MEM")
					RESTORE FROM this.ps_ruta + "MEN\" + this.ps_programa_codigo + "F.MEM" ADDITIVE
				ELSE
					MESSAGEBOX("No existe el archivo ===> " + this.ps_programa_codigo + "F.MEM" + CHR(13)+;
							   "Compile el formato en el maestro de Formatos y vuelva a intentarlo ....!!!")
				   	RETURN .f.
				endif
				if pimpresora=.f.
				   gf2="AYUDA-RANGO"$L6_PROG
				   set cursor on
				   this.lop="A"
		
					PRIVATE lsetclass,lobjpregunta,lcontinua
					lcontinua=.T.
					PUBLIC gn 
					gn =""
					lsetclass="Set Class to '"+ALLTRIM(Oentorno.RutaOSIS)+"libs\lib_reporte' additive "
					&lsetclass
					lobjpregunta=CREATEOBJECT("lib_reporte.opcion_formato_plataforma")
					lobjpregunta.Visible=.T.
					lobjpregunta.Show(1)
					
				*!*	   PUSH KEY CLEAR
				*!*	   defi wind reporte from 00,00 to 12,15 color scheme(15) Title "SELECCIONE OPCION"  system        
				*!*	   move wind reporte center
				*!*	   acti wind reporte
				*!*	   STORE 'PANTALLA ' TO gc
				*!*	   @ 1,1 GET gn FUNCTION '*T PANTALLA ;IMPRESORA ' DEFAULT gc;
				*!*	         SIZE 3,10 STYLE "BOQ" 
				*!*	   READ CYCLE TIMEOUT 30
				*!*	   POP KEY
				*!*	   rele wind reporte
				   do case
				      case gn="PANTALLA "
				           this.lop="A"
				      case gn="IMPRESORA"
				           this.lop="I"
				   ENDCASE
		*!*			   if readkey()=12 and readkey()=20
		*!*			      retu
		*!*			   endif
				   IF EMPTY(NVL(gn,""))
					  lcontinua=.F.
				   ENDIF
				   IF lcontinua
						   sele (this.l6area)
						   this.mh_rangos()
						   
						   &&if lastkey()#27 and readkey()#20
						      do case
						      case this.lop=="I"
						           this.mh_inicia_formato()
						           set devi to screen
						           wait clear
						      case this.lop=="A"
						           this.mh_inicia_formato()
						           set devi to screen
						           l6limite= gwalto-5
						           wait clear
						      endcase
						      if !empty(dbf())
						         set filter to
						      endif
		*!*					   else
		*!*					      retu
		*!*					   endif
					  ENDIF
				ELSE
				   this.lop='I'
				   this.mh_inicia_formato(pimpresora)
				endif   
				SET DATE TO (l6fecha)
		CATCH TO lerror
			MESSAGEBOX(lerror.message+CHR(13)+CHR(13)+MESSAGE(1),16,This.Caption+' - '+ALLTRIM(lerror.Procedure) )
		ENDTRY
				
		retu
		
		
		
		
	ENDPROC

	PROCEDURE mh_ejecuta_sqlrollback
		***--- ejecuta un rollback
		***--- 31-12-2003
		IF Ocnx.Tipo_BD=1
			=SQLROLLBACK(Ocnx.Conexion)
		ENDIF
		
		
	ENDPROC

	PROCEDURE mh_final_formato		&& comando para ejecutar despues del formato
		********************************************************************************************
		***--- usado para ejecutar lineas de comando para ejecutar despues de imprimir
		********************************************************************************************
		PRIVATE ps_cadena_comando
		ps_cadena_comando = ""
		
		RETURN ps_cadena_comando
		
	ENDPROC

	PROCEDURE mh_formato
		TRY 
			
			SET DATE TO DMY
			dime tabla(l6_lineas)
			if "3=2"$l6_prog
			   this.l6aream=3
			endif
			pcadena=space(l6_ancho)
			tabla=pcadena
			l6encaje=int(l6_hoja/l6_lineas)
			l6_cc=0
			q_veces=1
			l6m1=l6_lin_movi + l6_movi - 1
			l6m2=l6_lin_movi + l6_movi
			l6m3=iif(l6_qs=0,l6_lineas,l6_qs)
			****SUSPEND
		
			IF TYPE("phasta")<>"C"
				This.mh_rangos() 
			ENDIF
			
			do while !eof(this.l6area) and &l6_campo1 <= phasta and inkey()#27
			   for l6vez = 1 to l6_qc
			      l6pag=1
			      store 0 to lqi,ac1,ac2,ac3,ac4,ac5,ac6,ac7,ac8,ac9
			      if l6_qm > 0
			         sele (this.l6aream)
			         seek &l6_campo1
			         count rest while &l6_campo2=&l6_campo1 to lqitems
			         seek &l6_campo1
			         q_veces=iif(lqitems=0,1,THIS.mh_cuenta(lqitems,l6_movi))
			      endif   
			      sele (this.l6area)
			      for m=1 to q_veces
			         tabla=space(l6_ancho)
			         la=1
			         for i=1 to l6_q_e
			            xx=l6_f_e(i)
			            tabla(i)=&xx
			         endfor
			         if l6_qm > 0
			            sele (this.l6aream)
			            for i=l6_lin_movi to l6m1
			               lqi=lqi+1
			               if lqi <= lqitems
			                  xx=l6_f_m
			                  tabla(i)=&xx
			                  if l6_qm1 > 0
			                     xx=l6_f_mm
			                     tabla(i+1)=&xx
			                     I=I+1
			                  endif
			                  ac1=ac1+1
			                  skip
			               else
			                  tabla(i)=l6_f_m1
			               endif
			            endfor
			         endif
			         if l6_qt>0
			            sele (this.l6area)
			            la=1
			            for i=l6m2  to l6m3
			               xx=l6_f_t(la)           
			               tabla(i)=&xx
			               la=la+1
			            endfor
			         endif
			            if !l6_desp
			               for i=1 to l6m3
			                   if len(ALLT(tabla(i)))>0
			                      @l6_pi+i-1+l6_cc,l6_ci say This.Convierte_caracteres(left(tabla(i),l6_ancho))
			                   endif   
			                   if inkey()=27
			                      retu
			                   endif
			               endfor
			            else
			               for i=1 to l6_q_e
			                   @l6_pi+i-1+l6_cc,l6_ci say This.Convierte_caracteres(left(tabla(i),l6_ancho))
			               endfor   
			               ww=l6_lin_movi
			               for i=l6_lin_movi to l6m1
			                   if len(alltrim(tabla(i)))>0
			                      @l6_pi+i-1+l6_cc,l6_ci say This.Convierte_caracteres(left(tabla(i),l6_ancho))
			                      ww=ww+1
			                   endif   
			               endfor   
			               for i=l6m2  to l6m3
			                   @l6_pi+ww-1+l6_cc,l6_ci say This.Convierte_caracteres(left(tabla(i),l6_ancho))
			                   ww=ww+1
			               endfor
				        ENDIF
			            l6_cc  = l6_cc + l6_lineas
			   	        if l6_cc >= l6_hoja or l6encaje=1
			       	      l6pag=l6pag+1
			           	  l6_cc=0
			              @0,0 say ""
			   	        endif
			      endfor
			   endfor
			   sele (this.l6area)
			   if l6_qz > 0 and this.lop$"I"
			      for i=1 to l6_qz
			          &l6_z(i)
			      endfor
			   endif
			   skip
			   if l6xx=27
			      exit
			   endif
			ENDDO
		CATCH TO lerror
			MESSAGEBOX(lerror.message+CHR(13)+MESSAGE(1),16,NVL(This.Ps_Programa_Codigo,"")+" "+lerror.procedure)
		ENDTRY 	
		retu
		
	ENDPROC

	PROCEDURE mh_inicializa_printer		&& inicia la impresora
		para a,b,c
		if parameter()=2
		   if "PRINTER=HP"$a and l8printer="2" 
		      ??? chr(27)+"E"                       
		   else
		     ??? chr(27)+"@"
		      if b#0  &&and b#66 
		         ??? chr(27)+chr(67)+chr(b)
		      endif   
		   endif   
		else
		   =sys(1037)   
		endif
		retu           
		 
		
	ENDPROC

	PROCEDURE mh_inicializa_variables		&& inicializa las propiedades
		********************************************************************************************
		***--- Inicializa las variables de entorno
		********************************************************************************************
		This.Ps_Ruta            = Oentorno.ruta				&& ruta curdir
		This.Ps_Ruta_Reporte    = Oentorno.RutaReporte		&& ruta de reportes
		This.Ps_Ruta_Osis       = Oentorno.RutaOsis			&& ruta osis
		This.Ps_Nombre_Cia      = Oentorno.Nombrecia		&& nombre de la compañia
		
		*This.Ps_Programa_Nombre = ""						&& nombre del programa
		*This.Ps_Programa_Codigo = ""						&& código del programa
		*This.ps_cadena_llave    = ""						&& cadena de la llave del registro
		
		*!*	This.Ps_Programa_Nombre = Oentorno.titulo			&& nombre del programa
		*!*	This.Ps_Programa_Codigo = Oentorno.programa			&& código del programa
		
		*!*	This.ps_cadena_llave    = ""						&& cadena de la llave del registro
		
	ENDPROC

	PROCEDURE mh_inicia_formato		&& inicia el formato
		********************************************************************************************
		***--- inicializa el formato
		********************************************************************************************
		PARAMETERS p_impresora
		
		TRY 
			PRIVATE lxareaf
			lxareaf=SELECT()
			This.Procesos_memoria(1) 
			SELECT (lxareaf)
			l6xx=0
			l5hoja=l6_lineas
			q_hoja=int(l6_hoja/l6_lineas)
			defi wind copias from 00,00 to 03,50 color scheme(15) system title "Número de Copias" 
			move wind copias center
			if l6_qc=100 
			   acti wind copias
			   l6_qc=0
			   @01,02 say " CANTIDAD DE COPIAS ADICIONALES:" get l6_qc pict "999" color ,&gcolor1
			   read
			   deac wind copias
			   if lastkey()=27
			       retu
			   endif
			   l6_qc=l6_qc+1
			ENDIF
			***-----------------------------------------
			***--- Comandos Iniciales
			***-----------------------------------------
			FOR x=1 to l6_qcom
				&l6_com(x)
			ENDFOR
			&&MESSAGEBOX(l6_puerto)
			if this.lop$"I"
			   if "LPT$"$l6_puerto   
			      set print to &l6_puerto
			   else
			      if "999"$l6_puerto
			          wimpre=getprinter()
			          if !empty(wimpre) 
			             set print to name (wimpre)
			          else
			             wait wind("Voy a impimir en impresora default") timeout 2
			             set printer to default
			          endif   
			      else
			          if len(allt(l6_puerto))>0
			             set print to name (l6_puerto)
			          endif
			      endif    
			   endif   
			   do while !printstatus()
			      WAIT WINDOW("Impresora no Preparada - ENTER continua")
			      =inkey(0)
			      if lastkey()=27
			         exit
			      endif
			   enddo
			   if printstatus()
			     WAIT WINDOW("Estoy Imprimiendo Formato-Sirvase Esperar") NOCLEAR NOWAIT
			     set device to print
			     if !"NO-INI"$l6_prog
			        l8printer=iif(left(l6_letra,1)<"5","1","2")
			        this.mh_inicializa_printer(l6_prog,l6_hoja)
			     endif   
			     this.mh_control_caracteres(l6_char,l6_prog,l6_space)
			   else
			      return   
			   endif
			else
			   WAIT WIND("Estoy Generando Formato - Sirvase Esperar") NOCLEAR NOWAIT
			   *set device to file gworka+rtrim(this.ps_programa_codigo)+'.'+right(gcod_cia,1)+right(guser,2)   
			   ps_macro = "set device to file " + ALLTRIM(this.ps_ruta) + "WORKA\" + ALLTRIM(this.ps_programa_codigo) + ".TXT"
			   &ps_macro
			endif
			sele (this.l6area)
			l6siglo=set("CENTURY")
			set near on
			if "SIGLO"$l6_prog
			    set cent on
			else
			    set cent off
			endif  
			if !empty(pdesde) 
			   seek pdesde		&& AREA 1
			endif   
			rele wind copias
			THIS.MH_FOrmato()
		
			set near off
			SET DATE TO (l6fecha)
			set cent &l6siglo
			rele wind copias
			set print to
			set device to screen
			wait clear
			if this.lop$"I"
			else
			   if this.lop="A"
			      l6limite=gwalto-9
			      this.mh_ve_archivo()
			   endif
			ENDIF
		
			***-----------------------------------------
			***--- Comandos Finales
			***-----------------------------------------
			FOR x=1 to l6_qcom_FINAL
				&l6_com_FINAL(x)
			ENDFOR
		
			lxareaf=SELECT()
			This.Procesos_memoria(2) 
			PRIVATE lreleproc,lcandif,lnxf
			lcandif=This.Cantidad_procesos_salida-This.Cantidad_procesos_entrada 
			
			IF lcandif>0
				PRIVATE lreleproc
				FOR lnxf=1 TO lcandif
					lreleproc="RELEASE PROCEDURE '"+ALLTRIM(This.Lista_proceso_memoria[This.Cantidad_procesos_entrada+lnxf])+"'"
					&lreleproc
				ENDFOR
			ENDIF
			SELECT (lxareaf)
			 
			
		
		CATCH TO lerror
			MESSAGEBOX(NVL(This.Ps_Programa_Codigo,"")+":"+CHR(13)+lerror.message+CHR(13)+lerror.details+CHR(13)+MESSAGE(1)+;
							"Linea: "+ALLTRIM(STR(lerror.LineNo)) ,16,This.name+"."+lerror.procedure)
		ENDTRY
			
		RETURN
		
	ENDPROC

	PROCEDURE mh_inicio		&& similar al maestro de procesos de la plataforma
	ENDPROC

	PROCEDURE mh_interpreta
		para c
		p=""
		do while at(".",c) > 0
		   a  = subs(c,at(".",c)-1,4)
		   t  = left(c,at(".",c)-2)
		   x  = val(left(a,1))
		   y  = val(right(a,2))
		   z  = iif(this.ps_programa_codigo="U5000",".","->")
		   b  = chr(64+x)+z+field(y,x)
		   p  = p+t+b
		   c = strtran(c,t+a,"",1,1)
		enddo
		p=p+c
		retu p
		
		
	ENDPROC

	PROCEDURE mh_numero_letra
		para wnum
		private a1,a2,a3,a4,a5,wn,c1,wn,i,wtope
		dime a1(9),a2(9),a3(9),a4(9),a5(9),wn(10),c1(9)
		store 0  to wn
		store "" to c1,c2,c3
		a1(1)=" UNO"
		a1(2)=" DOS"
		a1(3)=" TRES"
		a1(4)=" CUATRO"
		a1(5)=" CINCO"
		a1(6)=" SEIS"
		a1(7)=" SIETE"
		a1(8)=" OCHO"
		a1(9)=" NUEVE"
		
		a2(1)=" ONCE"
