		a2(3)=" TRECE"
		a2(4)=" CATORCE"
		a2(5)=" QUINCE"
		a2(6)=" DIECISEIS"
		a2(7)=" DIECISIETE"
		a2(8)=" DIECIOCHO"
		a2(9)=" DIECINUEVE"
		
		a3(1)=" DIEZ"
		a3(2)=" VEINTE"
		a3(3)=" TREINTA"
		a3(4)=" CUARENTA"
		a3(5)=" CINCUENTA"
		a3(6)=" SESENTA"
		a3(7)=" SETENTA"
		a3(8)=" OCHENTA"
		a3(9)=" NOVENTA"
		
		a4(1)=" DIECI"
		a4(2)=" VEINTI"
		a4(3)=" TREINTI"
		a4(4)=" CUARENTI"
		a4(5)=" CINCUENTI"
		a4(6)=" SESENTI"
		a4(7)=" SETENTI"
