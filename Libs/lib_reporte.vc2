DEFINE CLASS cls_formato AS custom 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: mh_cierras_tablas		&& cirrar las tablas activas
		*m: mh_construye_arreglos		&& crea archivos .men
		*m: mh_control_caracteres
		*m: mh_convierte
		*m: mh_crea_formato		&& crea formato
		*m: mh_crea_men
		*m: mh_cuenta
		*m: mh_ejecuta_formato		&& ejecuta el formato
		*m: mh_final_formato		&& comando para ejecutar despues de ejecutar el formato
		*m: mh_formato
		*m: mh_inicializa_printer
		*m: mh_inicializa_variables		&& inicializa variables globales
		*m: mh_inicia_formato
		*m: mh_inicio		&& similar al maestro de procesos de la plataforma
		*m: mh_interpreta
		*m: mh_numero_letra
		*m: mh_pone_alias
		*m: mh_programa_tablas_formato		&& ejecuta consulta desde el maestro de opciones para extraer las tablas que se usan en el FORMATO
		*m: mh_rangos
		*m: mh_resolucion		&& Calcula la resolución de la pantalla
		*m: mh_sumatoria
		*m: mh_traduce
		*m: mh_tresdigi
		*m: mh_ve_archivo		&& archivo a pantalla
		*p: l6area		&& guarda el area numero 1
		*p: l6aream
		*p: lop
		*p: ph_n_conexion		&& guarda la conexión a la base de datos
		*p: ps_cadena_llave		&& guarda en una cadena de llave del registro actual.
		*p: ps_nombre_cia		&& nombre de la compañia
		*p: ps_programa_codigo		&& Código del programa
		*p: ps_programa_nombre		&& nombre del programa
		*p: ps_ruta		&& ruta de la aplicación
		*p: ps_ruta_osis		&& ruta de directorios OSIS
		*p: ps_ruta_reporte		&& Ruta de los reportes
	*</DefinedPropArrayMethod>

	*<PropValue>
		Height = 62
		l6area = 1
		l6aream = 1
		lop = 
		Name = "cls_formato"
		ph_n_conexion = -1
		ps_cadena_llave = 
		ps_nombre_cia = 
		ps_programa_codigo = 
		ps_programa_nombre = 
		ps_ruta = 
		ps_ruta_osis = 
		ps_ruta_reporte = 
		Width = 110
	*</PropValue>
	
	PROCEDURE Destroy
		RELEASE ALL LIKE L6_*
		*CLOSE DATABASES ALL
		
	ENDPROC

	PROCEDURE Init
		********************************************************************************************
		***--- init del objeto
		********************************************************************************************
		SET DECIMALS TO 18
		PUBLIC l6_s,  l6_e,  l6_m,  l6_m1, l6_t, l6_z, l6_com, l6_files, l6_files, l6_qfiles
		PUBLIC l6_qc, l6_pi, l6_ci, l6_movi, l6_ancho, l6_lineas, l6_hoja, l6_char, l6_char_c
		PUBLIC l6_fijo, l6_desp, l6_puerto, l6_prog, l6aream, l6area, l6_campo1, l6_campo2
		PUBLIC l6_qcom, l6_qs, l6_qe, l6_qm, l6_qm1, l6_qt, l6_qz, l6_qcom, l6_ini_e, l6_f_e, l6_f_t
		PUBLIC l6_q_e, l6_q_t, l6_f_m, l6_f_mm, l6_f_m1, l6_f_m2, l6_lin_movi
		PUBLIC l6siglo, pdesde, phasta, l6fecha, l6limite, gwalto, gwancho, l6final
		
		this.Mh_Inicializa_Variables()
		this.mh_resolucion()
		
		
	ENDPROC

	PROCEDURE mh_cierras_tablas		&& cirrar las tablas activas
		*CLOSE DATABASES all
		
	ENDPROC

	PROCEDURE mh_construye_arreglos		&& crea archivos .men
		***************************************************************************
		************  Rutinas que Armas Programa Intrucciones   de     ************
		************                F o r m a t o s                    ************
		***************************************************************************
		ps_cadena="SELECT * FROM dbo.SYS_FORMATOS_LETRAS_FOL "
		IF Ocnx.Tipo_BD=1
			IF SQLEXEC(ocnx.conexion, ps_cadena, "w233")<1
				MESSAGEBOX("Error al abrir el archivo FORMATO LETRAS"+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		ldatasession=SET("Datasession") 
		
		IF Ocnx.Tipo_BD=4
			IF ocnx.MS_Ejecuta_SQL(ps_cadena, "w233",ldatasession)<1
				MESSAGEBOX("Error al abrir el archivo FORMATO LETRAS"+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		
		SELECT "w233"
		INDEX ON prefijo+codigo TAG I ADDI
		
		SELECT "wform"
		if seek("PR"+letra,"w233")
		   store alltrim(w233.caracter1) to l6_char,l6_char_c
		endif
		l6_letra  = letra
		l6_fijo   = Tscroll
		l6_qc     = copias
		l6_pi     = fil_ini
		l6_ci     = col_ini
		l6_ancho  = ancho
		l6_movi   = qmovi
		l6_lineas = qlineas
		l6_hoja   = hoja
		l6_space  = iif(espacio="06",chr(27)+chr(48),"")
		if "LPT"$puerto or puerto=" "
		   l6_puerto = iif(puerto=" ",l6_puerto,allt(puerto))
		else
		   if !"999"$puerto and seek("IM"+rtrim(puerto),"w233")
		      store upper(alltrim(w233.deScri)) to l6_puerto
		   else
		      l6_puerto="999"    
		   endif   
		endif   
		use in w233
		store 1 to i1,i2,i3,i4,i5,y1,z1,wco,i9
		store "" to x1,x2
		
		wprog=this.ps_programa_codigo
		SELECT "sys_for1"
		do while ALLTRIM(wprog)==ALLTRIM(programa)
		      lc=alltrim(campo1)
		      lc=strtran(lc,'"',"'")
		      if (".0"$lc or ".1"$lc or ".2"$lc or ".3"$lc or ".4"$lc) and !"0."$lc
		         if ".."$lc
		            lc=this.mh_sumatoria(lc)
		         endif
		         lc=this.mh_interpreta(lc)
		      endif
		      do case
		      case tipo="="   && Reporte Equivalente
		         xx=val(right(lc,3))
		         seek upper(left(lc,5))+str(xx,3)
		         wprog=upper(left(lc,5))
		         skip -1
		      case tipo$"CRF"   && Modo Comando
		         if longitud > 0
		            l6_com(i1)="sele "+str(longitud,2)
		            i1=i1+1
		         endif
		         if "GRABA"$UPPER(LC)
		             L6_Z(y1)="replace "+ SUBs(LC,AT(":",LC)+1)
		             L6_Z(y1)=strtran(L6_Z(y1),"="," with ")
		             y1=y1+1
		         ELSE
		           do case
		           case tipo="F"
		               l6_com(i1)="set filter to "+ lc + x1
		               x1=" additive"
		            case tipo="R"
		               l6_com(i1)="set rela to "+ lc + x2
		               x2=" additive"
		            otherwise
		               l6_com(i1)=lc
		            endcase
		            i1=i1+1
		         ENDIF   
		      case tipo="?"   && Pregunta de seleccion
		         l6_p(separacion)=lc
		      case tipo="S"   && Mascara
		         fin=i2
		         ini=i2
		         if "HASTA"$upper(edicion)
		            fin=int(val(right(alltrim(edicion),3)))
		         endif
		         for i=ini to fin
		            l6_s(i)=campo1
		            l6_s(i)=left(l6_s(i),l6_ancho)
		         endfor
		         i2=i
		      case tipo="E"
		         l6_e(i3,1)=lc
		         l6_e(i3,2)=linea
		         l6_e(i3,3)=columna
		         l6_e(i3,4)=longitud
		         l6_e(i3,5)=alltrim(edicion)
		         l6_e(i3,6)=alltrim(lectura)
		         i3=i3+1
		      case tipo="M"
		         if wco=1
		            l6_m(i4,1)=lc
		            l6_m(i4,2)=linea
		            l6_m(i4,3)=columna
		            l6_m(i4,4)=longitud
		            l6_m(i4,5)=alltrim(edicion)
		            l6_m(i4,6)=alltrim(lectura)
		            i4=i4+1
		         else
		            wco=2
		            l6_m1(i9,1)=lc
		            l6_m1(i9,2)=linea
		            l6_m1(i9,3)=columna
		            l6_m1(i9,4)=longitud
		            l6_m1(i9,5)=alltrim(edicion)
		            l6_m1(i9,6)=alltrim(lectura)
		            i9=i9+1
		         endif   
		         if wco#2
		            wla=linea
		            skip
		            wco=iif(wla=linea,1,0)
		            skip -1
		         endif
		      case tipo="T" or tipo="D"
		         l6_desp=iif(tipo="D",.t.,.f.)
		         l6_t(i5,1)=lc
		         l6_t(i5,2)=linea
		         l6_t(i5,3)=columna
		         l6_t(i5,4)=longitud
		         l6_t(i5,5)=alltrim(edicion)
		         l6_t(i5,6)=alltrim(lectura)
		         i5=i5+1
		      ENDCASE
		      SKIP
		      ***--- Código adicional para validar fin de la tabla <<LEHV-18/06/2003>>
		      IF EOF("sys_for1")
		      	EXIT
		      ENDIF
		enddo
		retu
		
	ENDPROC

	PROCEDURE mh_control_caracteres
		para a,b,c,d
		priv pfont
		if parameter()=3
		   if !empty(a)
		      @0,0 say &a
		   endif
		   if !"PRINTER"$b and !empty(c)
		      @0,0 say &c
		   endif     
		else
		   pfont=a+","+b
		   SET PRINTER FONT (pfont) style (c)
		endif   
		retu               
		
	ENDPROC

	PROCEDURE mh_convierte
		para dato,wc
		pnum=alltrim(str(dato,10,2))
		pnum=strt(pnum,",",".")
		pent=left(pnum,at(".",pnum)-1)
		pdec=subs(pnum,at(".",pnum)+1)
		if pent#"0"
		   wc=0
		   for i=len(pent) to 1 step-1
		       wc=wc+1
		       wn(wc)=int(val(subs(pent,i,1)))
		   endfor
		   wbase=0
		   do case
		      case len(pent)<4
		           wtope=iif(len(pent)>3,3,len(pent))
		           this.mh_tresdigi()   
		      case len(pent)<7 and len(pent)>3
		           wtope=iif(len(pent)>3,3,len(pent))
		           this.mh_tresdigi()   
		           wbase=3
		           c2   = " MIL "
		           wtope=iif(len(pent)>6,6,len(pent))
		           this.mh_tresdigi()
		      case len(pent)>6
		           wtope=iif(len(pent)>3,3,len(pent))
		           this.mh_tresdigi()   
		           wbase=3
		           c2   = " MIL "
		           wtope=iif(len(pent)>6,6,len(pent))
		           this.mh_tresdigi()
		           wbase=6
		           c2   =iif(wn(4)+wn(5)+wn(6)=0,"",c2)
		           c3   =iif(wn(9)+wn(8)+wn(7)=1," MILLON "," MILLONES ")
		           wtope=iif(len(pent)>9,9,len(pent))
		           this.mh_tresdigi()
		   endcase
		else
		   c1(1)="CERO"    
		endif    
		retu ALLTRIM(c1(9)+c1(8)+c1(7)+c3+c1(6)+c1(5)+c1(4)+c2+c1(3)+c1(2)+c1(1)+" Y "+pdec+"/100")
		
	ENDPROC

	PROCEDURE mh_crea_formato		&& crea formato
		********************************************************************************************
		***--- crea el formato
		********************************************************************************************
		   la=1
		   for i=1 to l6_lin_movi - 1
		      dime txt(l6_qe)
		      pcadena="'"+iif(l6_qs>0,l6_s(i),space(l6_ancho))+"'"
		      if la < l6_qe+1
		         if i=l6_e(la,2)
		            p_i=1
		            for j= la to l6_qe
		               if i <> l6_e(j,2)
		                  exit
		               endif
		               txt(j)=subs(iif(l6_qs>0,l6_s(i),space(l6_ancho)),p_i,l6_e(j,3)-p_i)
		               p_i=l6_e(j,3)+l6_e(j,4)
		            endfor
		            final=subs(iif(l6_qs>0,l6_s(i),space(l6_ancho)),p_i)
		            pcadena=""
		            for j = la to l6_qe
		               if i <> l6_e(j,2)
		                  exit
		               endif
		               do case
		               case type("&l6_e(j,01)")="N" or "9."$l6_e(J,05) or "9,9"$l6_e(J,05)
		                    pcadena=pcadena+"'"+txt(j)+"'+left("+l6b+"("+l6_e(j,01)+",'"+l6_e(j,05)+"'),"+str(l6_e(j,04),3)+")+"
		               case type("&l6_e(j,01)")="C"
		                  x1=l6_e(j,01)
		                  if LEN(l6_e(j,06))#0
		                     x1="lectura("+left(l6_e(j,06),2)+","+alltrim(subs(l6_e(j,06),4))+",'"+l6_e(j,01)+"')"
		                  endif   
		                  if len(l6_e(j,05))=0
		                        pcadena=pcadena+"'"+txt(j)+"'+left("+X1+","+str(l6_e(j,04),3)+")+"
		                  else
		                     if "@"$l6_e(j,05)
		                        pcadena=pcadena+"'"+txt(j)+"'+strtran(left(transform("+X1+",'"+l6_e(j,05)+"'),"+str(l6_e(j,04),3)+"),'- ','  ')+"
		                     else                     
		                        if at(",",l6_e(j,05))=0
		                           lcampo1="edita("+X1+",'"+l6_e(j,05)+"','-')"
		                        else
		                           lcampo1="edita("+X1+",'"+left(l6_e(j,05),at(',',l6_e(j,05))-1)+"',"+right(l6_e(j,05),1)+")"
		                        endif
		                        pcadena=pcadena+"'"+txt(j)+"'+left("+lcampo1+","+str(l6_e(j,04),3)+")+"
		                     endif
		                  endif
		               case type("&l6_e(j,01)")="D"
		                  pcadena=pcadena+"'"+txt(j)+"'+left(fechae("+l6_e(j,01)+"),"+str(l6_e(j,04),3)+")+"
		               otherwise
		                  pcadena=pcadena+"'"+txt(j)+"'+left("+l6_e(j,01)+","+str(l6_e(j,04),3)+")+"
		               endcase
		            endfor
		            pcadena=left(pcadena,len(pcadena)-1)
		            pcadena=pcadena+"+'"+final+"'"
		            la=j
		         endif
		      endif
		      l6_f_e(i)=pcadena
		      l6_q_e=i
		   endfor
		   dime l6_f_e(l6_q_e)
		   if l6_qm > 0
		      dime txt(l6_qm)
		      txt=""
		      pcadena=""
		      p_i=1
		      i=l6_lin_movi
		      l6_f_m1=iif(l6_qs>0,l6_s(i),space(l6_ancho))
		      for j=1 to l6_qm
		         txt(j)=subs(iif(l6_qs>0,l6_s(i),space(l6_ancho)),p_i,l6_m(j,3)-p_i)
		         p_i=l6_m(j,3)+l6_m(j,4)
		      endfor
		      final=subs(iif(l6_qs>0,l6_s(i),space(l6_ancho)),p_i)
		      for j=1 to l6_qm
		         do case
		         case type("&l6_m(j,01)")="N"
		              pcadena=pcadena+"'"+txt(j)+"'+left("+l6b+"("+l6_m(j,01)+",'"+l6_m(j,05)+"'),"+str(l6_m(j,04),3)+")+"
		         case type("&l6_m(j,01)")="C"
		            x1=l6_m(j,01)
		            if LEN(l6_m(j,06))#0
		                x1="lectura("+left(l6_m(j,06),2)+","+alltrim(subs(l6_m(j,06),4))+",'"+l6_m(j,01)+"')"
		            endif   
		            if len(l6_m(j,05))=0
		               pcadena=pcadena+"'"+txt(j)+"'+left("+X1+","+str(l6_m(j,04),3)+")+"
		            else
		               if "@"$l6_m(j,05)
		                   pcadena=pcadena+"'"+txt(j)+"'+strtran(left(transform("+X1+",'"+l6_m(j,05)+"'),"+str(l6_m(j,04),3)+"),'- ','  ')+"
		               else            
		                  if at(",",l6_m(j,05))=0
		                     lcampo1="edita("+X1+",'"+l6_m(j,05)+"','-')"
		                  else
		                     lcampo1="edita("+X1+",'"+left(l6_m(j,05),at(',',l6_m(j,05))-1)+"',"+right(l6_m(j,05),1)+")"
		                  endif
		                  pcadena=pcadena+"'"+txt(j)+"'+left("+lcampo1+","+str(l6_m(j,04),3)+")+"
		               endif
		            endif
		         case type("&l6_m(j,01)")="D"
		            pcadena=pcadena+"'"+txt(j)+"'+left(fechae("+l6_m(j,01)+"),"+str(l6_m(j,04),3)+")+"
		         otherwise
		            pcadena=pcadena+"'"+txt(j)+"'+left("+l6_m(j,01)+","+str(l6_m(j,04),3)+")+"
		         endcase
		      endfor
		      pcadena=left(pcadena,len(pcadena)-1)
		      pcadena=pcadena+"+'"+final+"'"
		      l6_f_m=pcadena
		   endif
		   la=1
		   x1=0
		   if l6_qm1 > 0
		      dime txt(l6_qm1)
		      txt=""
		      pcadena=""
		      p_i=1
		      i=l6_lin_movi
		      l6_f_m2=iif(l6_qs>0,l6_s(i),space(l6_ancho))
		      for j=1 to l6_qm1
		         txt(j)=subs(iif(l6_qs>0,l6_s(i),space(l6_ancho)),p_i,l6_m1(j,3)-p_i)
		         p_i=l6_m1(j,3)+l6_m1(j,4)
		      endfor
		      final=subs(iif(l6_qs>0,l6_s(i),space(l6_ancho)),p_i)
		      for j=1 to l6_qm1
		         do case
		         case type("&l6_m1(j,01)")="N" or "9."$l6_m1(J,05) or "9,9"$l6_m1(J,05)
		              pcadena=pcadena+"'"+txt(j)+"'+left("+l6b+"("+l6_m1(j,01)+",'"+l6_m1(j,05)+"'),"+str(l6_m1(j,04),2)+")+"
		         case type("&l6_m1(j,01)")="C"
		            x2=l6_m1(j,01)
		            if LEN(l6_m1(j,06))#0
		                x2="lectura("+left(l6_m1(j,06),2)+","+alltrim(subs(l6_m1(j,06),4))+",'"+l6_m1(j,01)+"')"
		            endif   
		            if len(l6_m1(j,05))=0
		               pcadena=pcadena+"'"+txt(j)+"'+left("+X2+","+str(l6_m1(j,04),2)+")+"
		            else
		               if "@"$l6_m1(j,05)
		                   pcadena=pcadena+"'"+txt(j)+"'+strtran(left(transform("+X2+",'"+l6_m1(j,05)+"'),"+str(l6_m1(j,04),2)+"),'- ','  ')+"
		               else            
		                  if at(",",l6_m1(j,05))=0
		                     lcampo1="edita("+X2+",'"+l6_m1(j,05)+"','-')"
		                  else
		                     lcampo1="edita("+X2+",'"+left(l6_m1(j,05),at(',',l6_m1(j,05))-1)+"',"+right(l6_m1(j,05),1)+")"
		                  endif
		                  pcadena=pcadena+"'"+txt(j)+"'+left("+lcampo1+","+str(l6_m1(j,04),2)+")+"
		               endif
		            endif
		         case type("&l6_m1(j,01)")="D"
		            pcadena=pcadena+"'"+txt(j)+"'+left(fechae("+l6_m1(j,01)+"),"+str(l6_m1(j,04),2)+")+"
		         otherwise
		            pcadena=pcadena+"'"+txt(j)+"'+left("+l6_m1(j,01)+","+str(l6_m1(j,04),2)+")+"
		         endcase
		      endfor
		      pcadena=left(pcadena,len(pcadena)-1)
		      pcadena=pcadena+"+'"+final+"'"
		      l6_f_mm=pcadena
		   endif
		   if l6_qt>0
		      *l6t=iif(l6_qs=0,l6_lin_movi + l6_movi + l6_qt ,l6_qs)
		      l6t=iif(l6_qs=0,l6_lineas,l6_qs)
		      if l6_lin_movi + l6_movi >= l6t
		         =messagebox("Hay muchas lineas de Movimiento",16,gcia)
		      endif
		      for i=l6_lin_movi + l6_movi  to l6t
		         x1=x1+1
		         dime txt(l6_qt)
		         txt=""
		         pcadena="'"+iif(l6_qs>0,l6_s(i),space(l6_ancho))+"'"
		         if la < l6_qt+1
		            if i=l6_t(la,2)
		               p_i=1
		               for j= la to l6_qt
		                  if i <> l6_t(j,2)
		                     exit
		                  endif
		                  txt(j)=subs(iif(l6_qs>0,l6_s(i),space(l6_ancho)),p_i,l6_t(j,3)-p_i)
		                  p_i=l6_t(j,3)+l6_t(j,4)
		               endfor
		               final=subs(iif(l6_qs>0,l6_s(i),space(l6_ancho)),p_i)
		               pcadena=""
		               for j = la to l6_qt
		                  if i <> l6_t(j,2)
		                     exit
		                  endif
		                  do case
		                  case type("&l6_t(j,01)")="N" or "9."$L6_T(J,05) or "9,9"$L6_T(J,05)
		                       pcadena=pcadena+"'"+txt(j)+"'+left("+l6b+"("+l6_t(j,01)+",'"+l6_t(j,05)+"'),"+str(l6_t(j,04),3)+")+"
		                  case type("&l6_t(j,01)")="C"
		                     yx1=l6_t(j,01)
		                     if LEN(l6_t(j,06))#0
		                        yx1="lectura("+left(l6_t(j,06),2)+","+alltrim(subs(l6_t(j,06),4))+",'"+l6_t(j,01)+"')"
		                     endif   
		                     if len(l6_t(j,05))=0
		                        pcadena=pcadena+"'"+txt(j)+"'+left("+yx1+","+str(l6_t(j,04),3)+")+"
		                     else
		                        if "@"$l6_t(j,05)
		                            pcadena=pcadena+"'"+txt(j)+"'+strtran(left(transform("+yx1+",'"+l6_t(j,05)+"'),"+str(l6_t(j,04),3)+"),'- ','  ')+"
		                        else              
		                           if at(",",l6_t(j,05))=0
		                              lcampo1="edita("+yx1+",'"+l6_t(j,05)+"','-')"
		                           else
		                              lcampo1="edita("+yx1+",'"+left(l6_t(j,05),at(',',l6_t(j,05))-1)+"',"+right(l6_t(j,05),1)+")"
		                           endif
		                           pcadena=pcadena+"'"+txt(j)+"'+left("+lcampo1+","+str(l6_t(j,04),3)+")+"
		                       endif    
		                     endif
		                  case type("&l6_t(j,01)")="D"
		                     pcadena=pcadena+"'"+txt(j)+"'+left(fechae("+l6_t(j,01)+"),"+str(l6_t(j,04),3)+")+"
		                  otherwise
		                     pcadena=pcadena+"'"+txt(j)+"'+left("+l6_t(j,01)+","+str(l6_t(j,04),3)+")+"
		                  endcase
		               endfor
		               pcadena=left(pcadena,len(pcadena)-1)
		               pcadena=pcadena+"+'"+final+"'"
		               la=j
		            endif
		         endif
		         l6_f_t(x1)=pcadena
		         l6_q_t=x1
		      endfor
		      if l6_q_t > 0
		         dime l_f_t(l6_q_t)
		      else
		         dime l_f_t(1)         
		      endif
		   endif
		retu
		
	ENDPROC

	PROCEDURE mh_crea_men
		********************************************************************************************
		***--- crea archivos de extensión   .men
		********************************************************************************************
		***--- Maestro de Opciones : Extrae las tablas que se usan para el formato
		IF !This.Mh_Programa_Tablas_Formato()
			RETURN .f.
		ENDIF
		
		***--- << CREA ARCHIVOS MEN -  PASO 1>>
		ps_cadena=           "SELECT A.* "
		ps_cadena=ps_cadena+ "FROM DBO.SYS_TABLA_FORMATOS_FOC A "
		ps_cadena=ps_cadena+ "WHERE LTRIM(RTRIM(A.PROGRAMA))='"+NVL(THIS.Ps_Programa_Codigo,"")+"' "
		
		ldatasession = SET("Datasession") 
		IF Ocnx.Tipo_BD=1
			IF SQLEXEC(ocnx.conexion, ps_cadena, "WFORM")<1
				MESSAGEBOX("Error al abrir el archivo FORMATO CABECERA"+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		IF Ocnx.Tipo_BD=4
			IF ocnx.Ms_Ejecuta_SQL(ps_cadena, "WFORM",ldatasession)<1
				MESSAGEBOX("Error al abrir el archivo FORMATO CABECERA"+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		
		SELECT "WFORM"
		INDEX ON PROGRAMA TAG I ADDI
		
		ps_cadena=           "SELECT A.* "
		ps_cadena=ps_cadena+ "FROM DBO.SYS_FORMATOS_DETALLE_FOD A "
		ps_cadena=ps_cadena+ "WHERE LTRIM(RTRIM(A.PROGRAMA))='"+NVL(THIS.Ps_Programa_Codigo,"")+"' "
		
		IF Ocnx.Tipo_BD=1
			IF SQLEXEC(ocnx.conexion, ps_cadena, "SYS_FOR1")<1
				MESSAGEBOX("Error al abrir el archivo FORMATO DETALLE"+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		IF Ocnx.Tipo_BD=4
			IF ocnx.Ms_Ejecuta_SQL(ps_cadena, "SYS_FOR1",ldatasession)<1
				MESSAGEBOX("Error al abrir el archivo FORMATO DETALLE"+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		
		SELECT "SYS_FOR1"
		INDEX ON PROGRAMA+ITEM TAG I ADDI
		
		
		lprog=allt(wform.detalle)
		l6b="tran"
		dime l6_s(90)            && Arreglo de Shell   Max 70 lineas
		dime l6_e(90,06)         && Arreglo de Encabezado - Datos Fijos
		dime l6_m(70,06)         && Arreglo de Movimientos 1
		dime l6_m1(70,06)        && Arreglo de Movimientos 2
		dime l6_t(70,06)         && Arreglo de Totales o de Pi‚ de Pagina
		dime l6_z(05)            && Intrucciones Finales de Grabaci¢n
		dime l6_com(30)
		dime l6_files(30)
		l6_files="*"
		l6_qfiles=ascan(l6_files,"*")-1
		store 0 to lqitems,ac1,ac2,ac3,l6_qc,l6_pi,l6_ci,l6_movi
		l6_ancho = 80        
		l6_lineas= 66
		l6_hoja  = 66
		l6_char  = 18
		l6_char_c= 18
		l6_fijo  = 20
		l6_desp  = .f.
		l6_puerto = " "
		l6_prog   = lprog
		if "3=2"$l6_prog
		   this.l6aream=3
		endif
		sele (this.l6area)
		a=key(val(sys(21)))
		l6_campo1=this.mh_pone_alias(a,this.l6area)
		l6_campo2=this.mh_pone_alias(a,this.l6aream)
		
		sele wform
		This.mh_construye_arreglos()
		
		sele (this.l6area)
		l6_qcom=ascan(l6_com,.f.)-1
		l6_qs  =ascan(l6_s,.f.)-1
		l6_qe  =(ascan(l6_e,.f.)-1)/6
		l6_qm  =(ascan(l6_m,.f.)-1)/6
		l6_qm1 =(ascan(l6_m1,.f.)-1)/6
		l6_qt  =(ascan(l6_t,.f.)-1)/6
		l6_qz  =(ascan(l6_z,.f.)-1)
		l6_qc  =l6_qc+1
		if l6_qcom > 0
			dime l6_com(l6_qcom)
		endif
		if l6_qs > 0
			dime l6_s(l6_qs)
		else
			l6_ini_e=l6_e(01,02)   
		endif   
		if l6_qz>0
			dime l6_z(l6_qz)
		else
			rele l6_z
		endif
		if l6_qe > 0
			dime l6_e(l6_qe,06)
		endif
		if l6_qm>0
			dime l6_m(l6_qm,06)
		endif
		if l6_qm1>0
			dime l6_m1(l6_qm1,06)
		endif
		if l6_qt > 0
			dime l6_t(l6_qt,06)
		endif   
		dime l6_f_e(70)
		dime l6_f_t(70)
		l6_q_e=0
		l6_q_t=0
		l6_f_m=""
		l6_f_mm=""
		l6_f_m1=""
		l6_f_m2=""
		l6_lin_movi=iif(l6_qm>0,l6_m(01,02),iif(l6_qt>0,l6_e(l6_qe,02)+1,l6_lineas + 1))
		   
		this.mh_crea_formato()
		   
		rele l6_s,l6_e,l6_m,l6_t,l6_m1
		save to this.ps_ruta + "MEN\" + this.ps_programa_codigo+"F.MEM" all like l6_*
		
		IF USED("WFORM")
			USE IN "WFORM"
		ENDIF
		IF USED("SYS_FOR1")
			USE IN "SYS_FOR1"
		ENDIF
		
		this.Mh_Cierras_Tablas
		
	ENDPROC

	PROCEDURE mh_cuenta
		para a,b
		priv valor
		
		valor=int(a/b)
		if mod(a,b) > 0
		   valor=valor+1
		endif
		retu valor
		
	ENDPROC

	PROCEDURE mh_ejecuta_formato		&& ejecuta el formato
		********************************************************************************************
		***--- ejecuta el formato
		********************************************************************************************
		***--- << EJECUTA FORMATO -  PASO 2>>
		para pimpresora
		if parameters()=0
		   pimpresora=.F.
		endif
		l6fecha  =set("date")
		l6_char_c=18
		l6vez    = 0
		l6_space = ""
		
		this.l6area   = 1
		this.l6aream  = 2
		
		gdef     = ""
		l6final  = ""
		gorden   = ""
		l6pag    = 0
		store 0 to l6v1,l6v2,l6v3,l6v4,l6v5,l6v6,l6v7,l6v7,l8v8,l6v9
		l6_letra = ""
		if file(this.ps_ruta + "MEN\" + this.ps_programa_codigo + "F.MEM")
			RESTORE FROM this.ps_ruta + "MEN\" + this.ps_programa_codigo + "F.MEM" ADDITIVE
		ELSE
		   	RETURN
		endif
		if pimpresora=.f.
		   gf2="AYUDA-RANGO"$L6_PROG
		   set cursor on
		   PUSH KEY CLEAR
		   defi wind reporte from 00,00 to 12,15 color scheme(15) Title "SELECCIONE OPCION"  system        
		   move wind reporte center
		   acti wind reporte
		   this.lop="A"
		   STORE 'PANTALLA ' TO gc
		   @ 1,1 GET gn FUNCTION '*T PANTALLA ;IMPRESORA ' DEFAULT gc;
		         SIZE 3,10 STYLE "BOQ" 
		   READ CYCLE TIMEOUT 30
		   POP KEY
		   rele wind reporte
		   do case
		      case gn="PANTALLA "
		           this.lop="A"
		      case gn="IMPRESORA"
		           this.lop="I"
		   endcase
		   if readkey()=12 and readkey()=20
		      retu
		   endif
		   sele (this.l6area)
		   this.mh_rangos()
		   
		   if lastkey()#27 and readkey()#20
		      do case
		      case this.lop="I"
		           this.mh_inicia_formato()
		           set devi to screen
		           wait clear
		      case this.lop = "A"
		           this.mh_inicia_formato()
		           set devi to screen
		           l6limite= gwalto-5
		           wait clear
		      endcase
		      if !empty(dbf())
		         set filter to
		      endif
		   else
		      retu
		   endif
		ELSE
		   this.lop='I'
		   this.mh_inicia_formato(pimpresora)
		endif   
		SET DATE TO (l6fecha)
		retu
		
		
		
		
	ENDPROC

	PROCEDURE mh_final_formato		&& comando para ejecutar despues de ejecutar el formato
		********************************************************************************************
		***--- usado para ejecutar lineas de comando para ejecutar despues de imprimir
		********************************************************************************************
		PRIVATE ps_cadena_comando
		ps_cadena_comando = ""
		
		RETURN ps_cadena_comando
		
	ENDPROC

	PROCEDURE mh_formato
		SET DATE TO DMY
		dime tabla(l6_lineas)
		if "3=2"$l6_prog
		   this.l6aream=3
		endif
		pcadena=space(l6_ancho)
		tabla=pcadena
		l6encaje=int(l6_hoja/l6_lineas)
		l6_cc=0
		q_veces=1
		l6m1=l6_lin_movi + l6_movi - 1
		l6m2=l6_lin_movi + l6_movi
		l6m3=iif(l6_qs=0,l6_lineas,l6_qs)
		
		do while !eof(this.l6area) and &l6_campo1 <= phasta and inkey()#27
		   for l6vez = 1 to l6_qc
		      l6pag=1
		      store 0 to lqi,ac1,ac2,ac3,ac4,ac5,ac6,ac7,ac8,ac9
		      if l6_qm > 0
		         sele (this.l6aream)
		         seek &l6_campo1
		         count rest while &l6_campo2=&l6_campo1 to lqitems
		         seek &l6_campo1
		         q_veces=iif(lqitems=0,1,THIS.mh_cuenta(lqitems,l6_movi))
		      endif   
		      sele (this.l6area)
		      for m=1 to q_veces
		         tabla=space(l6_ancho)
		         la=1
		         for i=1 to l6_q_e
		            xx=l6_f_e(i)
		            tabla(i)=&xx
		         endfor
		         if l6_qm > 0
		            sele (this.l6aream)
		            for i=l6_lin_movi to l6m1
		               lqi=lqi+1
		               if lqi <= lqitems
		                  xx=l6_f_m
		                  tabla(i)=&xx
		                  if l6_qm1 > 0
		                     xx=l6_f_mm
		                     tabla(i+1)=&xx
		                     I=I+1
		                  endif
		                  ac1=ac1+1
		                  skip
		               else
		                  tabla(i)=l6_f_m1
		               endif
		            endfor
		         endif
		         if l6_qt>0
		            sele (this.l6area)
		            la=1
		            for i=l6m2  to l6m3
		               xx=l6_f_t(la)           
		               tabla(i)=&xx
		               la=la+1
		            endfor
		         endif
		            if !l6_desp
		               for i=1 to l6m3
		                   if len(ALLT(tabla(i)))>0
		                      @l6_pi+i-1+l6_cc,l6_ci say left(tabla(i),l6_ancho)
		                   endif   
		                   if inkey()=27
		                      retu
		                   endif
		               endfor
		            else
		               for i=1 to l6_q_e
		                   @l6_pi+i-1+l6_cc,l6_ci say left(tabla(i),l6_ancho)
		               endfor   
		               ww=l6_lin_movi
		               for i=l6_lin_movi to l6m1
		                   if len(alltrim(tabla(i)))>0
		                      @l6_pi+i-1+l6_cc,l6_ci say left(tabla(i),l6_ancho)
		                      ww=ww+1
		                   endif   
		               endfor   
		               for i=l6m2  to l6m3
		                   @l6_pi+ww-1+l6_cc,l6_ci say left(tabla(i),l6_ancho)
		                   ww=ww+1
		               endfor
			           l6_cc  = l6_cc + l6_lineas
		    	       if l6_cc >= l6_hoja or l6encaje=1
		        	      l6pag=l6pag+1
		            	  l6_cc=0
			              @0,0 say ""
		    	       endif
			        endif
		      endfor
		   endfor
		   sele (this.l6area)
		   if l6_qz > 0 and this.lop$"I"
		      for i=1 to l6_qz
		          &l6_z(i)
		      endfor
		   endif
		   skip
		   if l6xx=27
		      exit
		   endif
		enddo
		retu
		
	ENDPROC

	PROCEDURE mh_inicializa_printer
		para a,b,c
		if parameter()=2
		   if "PRINTER=HP"$a and l8printer="2" 
		      ??? chr(27)+"E"                       
		   else
		     ??? chr(27)+"@"
		      if b#0  &&and b#66 
		         ??? chr(27)+chr(67)+chr(b)
		      endif   
		   endif   
		else
		   =sys(1037)   
		endif
		retu           
		 
		
	ENDPROC

	PROCEDURE mh_inicializa_variables		&& inicializa variables globales
		********************************************************************************************
		***--- Inicializa las variables de entorno
		********************************************************************************************
		This.Ps_Ruta            = Oentorno.ruta				&& ruta curdir
		This.Ps_Ruta_Reporte    = Oentorno.RutaReporte		&& ruta de reportes
		This.Ps_Ruta_Osis       = Oentorno.RutaOsis			&& ruta osis
		This.Ps_Nombre_Cia      = Oentorno.Nombrecia		&& nombre de la compañia
		
		This.Ps_Programa_Nombre = ""						&& nombre del programa
		This.Ps_Programa_Codigo = ""						&& código del programa
		This.ps_cadena_llave    = ""						&& cadena de la llave del registro
		
		*!*	This.Ps_Programa_Nombre = Oentorno.titulo			&& nombre del programa
		*!*	This.Ps_Programa_Codigo = Oentorno.programa			&& código del programa
		
		*!*	This.ps_cadena_llave    = ""						&& cadena de la llave del registro
		
	ENDPROC

	PROCEDURE mh_inicia_formato
		********************************************************************************************
		***--- inicializa el formato
		********************************************************************************************
		PARAMETERS p_impresora
		
		l6xx=0
		l5hoja=l6_lineas
		q_hoja=int(l6_hoja/l6_lineas)
		defi wind copias from 00,00 to 03,50 color scheme(15) system title "Número de Copias" 
		move wind copias center
		if l6_qc=100 
		   acti wind copias
		   l6_qc=0
		   @01,02 say " CANTIDAD DE COPIAS ADICIONALES:" get l6_qc pict "999" color ,&gcolor1
		   read
		   deac wind copias
		   if lastkey()=27
		       retu
		   endif
		   l6_qc=l6_qc+1
		ENDIF
		&&MESSAGEBOX(l6_puerto)
		for x=1 to l6_qcom
		   *if !"DO FIN"$upper(l6_com(x))
		   IF !"this.mh_final_formato()"$upper(l6_com(x))	&& ejecuta despues del formato
		   													&& guarda el comando para ejecutar despues
		      &l6_com(x)			&& llama a los procesos de la plataforma osis <<LEHV-18/06/2003>>
		      
		      *this.mh_inicio()
		      *Set Proc to C:/+"proc\V34A000" addi  
		      *Set Proc to "C:/XIMESA/OSISCLI7/PROC/V34A000.PRG" ADDI
		   else
		      l6final=l6_com(x)   
		      *this.mh_inicio()
		   endif   
		endfor
		if this.lop$"I"
		   if "LPT$"$l6_puerto   
		      set print to &l6_puerto
		   else
		      if "999"$l6_puerto
		          wimpre=getprinter()
		          if !empty(wimpre) 
		             set print to name (wimpre)
		          else
		             wait wind("Voy a impimir en impresora default") timeout 2
		             set printer to default
		          endif   
		      else
		          if len(allt(l6_puerto))>0
		             set print to name (l6_puerto)
		          endif
		      endif    
		   endif   
		   do while !printstatus()
		      WAIT WINDOW("Impresora no Preparada - ENTER continua")
		      =inkey(0)
		      if lastkey()=27
		         exit
		      endif
		   enddo
		   if printstatus()
		     WAIT WINDOW("Estoy Imprimiendo Formato-Sirvase Esperar") NOCLEAR NOWAIT
		     set device to print
		     if !"NO-INI"$l6_prog
		        l8printer=iif(left(l6_letra,1)<"5","1","2")
		        this.mh_inicializa_printer(l6_prog,l6_hoja)
		     endif   
		     this.mh_control_caracteres(l6_char,l6_prog,l6_space)
		   else
		      return   
		   endif
		else
		   WAIT WIND("Estoy Generando Formato - Sirvase Esperar") NOCLEAR NOWAIT
		   *set device to file gworka+rtrim(this.ps_programa_codigo)+'.'+right(gcod_cia,1)+right(guser,2)   
		   set device to file this.ps_ruta + "WORKA\" + this.ps_programa_codigo + '.TXT'
		endif
		sele (this.l6area)
		
		l6siglo=set("CENTURY")
		set near on
		if "SIGLO"$l6_prog
		    set cent on
		else
		    set cent off
		endif  
		if !empty(pdesde) 
		   seek pdesde		&& AREA 1
		endif   
		rele wind copias
		
		THIS.MH_FOrmato()
		
		set near off
		SET DATE TO (l6fecha)
		set cent &l6siglo
		rele wind copias
		set print to
		set device to screen
		wait clear
		if this.lop$"I"
		else
		   if this.lop="A"
		      l6limite=gwalto-9
		      this.mh_ve_archivo()
		   endif
		endif
		if !empty(l6final)
		   &l6final
		endif
		retu
		
	ENDPROC

	PROCEDURE mh_inicio		&& similar al maestro de procesos de la plataforma
	ENDPROC

	PROCEDURE mh_interpreta
		para c
		p=""
		do while at(".",c) > 0
		   a  = subs(c,at(".",c)-1,4)
		   t  = left(c,at(".",c)-2)
		   x  = val(left(a,1))
		   y  = val(right(a,2))
		   z  = iif(this.ps_programa_codigo="U5000",".","->")
		   b  = chr(64+x)+z+field(y,x)
		   p  = p+t+b
		   c = strtran(c,t+a,"",1,1)
		enddo
		p=p+c
		retu p
		
		
	ENDPROC

	PROCEDURE mh_numero_letra
		para wnum
		private a1,a2,a3,a4,a5,wn,c1,wn,i,wtope
		dime a1(9),a2(9),a3(9),a4(9),a5(9),wn(10),c1(9)
		store 0  to wn
		store "" to c1,c2,c3
		a1(1)=" UNO"
		a1(2)=" DOS"
		a1(3)=" TRES"
		a1(4)=" CUATRO"
		a1(5)=" CINCO"
		a1(6)=" SEIS"
		a1(7)=" SIETE"
		a1(8)=" OCHO"
		a1(9)=" NUEVE"
		
		a2(1)=" ONCE"
		a2(2)=" DOCE"
		a2(3)=" TRECE"
		a2(4)=" CATORCE"
		a2(5)=" QUINCE"
		a2(6)=" DIECISEIS"
		a2(7)=" DIECISIETE"
		a2(8)=" DIECIOCHO"
		a2(9)=" DIECINUEVE"
		
		a3(1)=" DIEZ"
		a3(2)=" VEINTE"
		a3(3)=" TREINTA"
		a3(4)=" CUARENTA"
		a3(5)=" CINCUENTA"
		a3(6)=" SESENTA"
		a3(7)=" SETENTA"
		a3(8)=" OCHENTA"
		a3(9)=" NOVENTA"
		
		a4(1)=" DIECI"
		a4(2)=" VEINTI"
		a4(3)=" TREINTI"
		a4(4)=" CUARENTI"
		a4(5)=" CINCUENTI"
		a4(6)=" SESENTI"
		a4(7)=" SETENTI"
		a4(8)=" OCHENTI"
		a4(9)=" NOVENTI"
		
		a5(1)=" CIEN"
		a5(2)=" DOSCIENTOS"
		a5(3)=" TRESCIENTOS"
		a5(4)=" CUATROCIENTOS"
		a5(5)=" QUINIENTOS"
		a5(6)=" SEISCIENTOS"
		a5(7)=" SETECIENTOS"
		a5(8)=" OCHOCIENTOS"
		a5(9)=" NOVECIENTOS"
		***************************************
		RETURN THIS.MH_Convierte(wnum)
		
	ENDPROC

	PROCEDURE mh_pone_alias
		para a1,a2
		private p1,p2,p3,ppalias
		if type("a2")="N"
		   ppalias=chr(64+a2)   
		else
		   ppalias=a2   
		endif   
		p1=occurs("+",a1)+1
		p2=fcount(a2)
		a1="+"+a1
		i=1
		do while p1 > 0
		   p3=field(i,a2)
		   if p3+"+"$a1 or p3+")"$a1 or p3+","$a1 or p3+" "$a1+" "
		      if at("+"+field(i,a2),a1) > 0
		         a1=strtran(a1,"+"+field(i,a2),"+"+ppalias+"."+field(i,a2))
		         p1=p1-1
		      endif   
		      if at("("+field(i,a2),a1) > 0
		         a1=strtran(a1,"("+field(i,a2),"("+ppalias+"."+field(i,a2))
		         p1=p1-1
		      endif   
		   endif
		   i=i+1
		   if i > p2
		     exit
		   endif
		enddo
		retu subs(a1,2)
		
	ENDPROC

	PROCEDURE mh_programa_tablas_formato		&& ejecuta consulta desde el maestro de opciones para extraer las tablas que se usan en el FORMATO
		PARAMETERS PS_TIPO
		IF Ocnx.Tipo_BD=1
			This.Ph_N_Conexion = SQLCONNECT("alsa", "lhuapaya", "luihua")
			IF this.Ph_N_Conexion < 1
				MESSAGEBOX("Error al conectar a la base de datos alsa")
				RETURN .f.
			ENDIF
		ENDIF
		
		
		PRIVATE pn_nrotabla, pn_contador
		PRIVATE Ps_CodTabla
		
		ps_cadena=           "Select s18_indupd as 'Orden' ,s01_codtab as 'codtabla' "
		ps_cadena=ps_cadena+ "From Dbo.Sys_Opciones_Tablas_S18 "
		ps_cadena=ps_cadena+ "Where Ltrim(Rtrim(s07_codopc)) = '"+NVL(This.ps_programa_codigo,"")+"' "
		ps_cadena=ps_cadena+ "  and s18_indfor='1' "
		ps_cadena=ps_cadena+ "Order By s18_indupd "
		IF Ocnx.Tipo_BD=1
			IF SQLEXEC(Ocnx.Conexion, ps_cadena, "TmpDTablas")<1
				MESSAGEBOX("Error al abrir el archivo TABLAS DEL PROGRAMA [Formatos] "+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		
		ldatasession=SET("Datasession")
		
		IF Ocnx.Tipo_BD=4
			IF Ocnx.Ms_Ejecuta_SQL(ps_cadena, "TmpDTablas",ldatasession)<1
				MESSAGEBOX("Error al abrir el archivo TABLAS DEL PROGRAMA [Formatos] "+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		
		
		pl_diccionario_ok = .f.
		SELECT "TmpDTablas"
		IF RECCOUNT("TmpDTablas")<=0
			MESSAGEBOX("Cursor de diccionario de datos [ TABLAS ] esta vacio")
			RETURN .F.
		ENDIF
		
		pl_diccionario_ok = .t.
		pn_tablas = 1
		DIMENSION pa_tabllave(RECCOUNT("TmpDTablas"),11)
		GO TOP
		SCAN
			Ps_CodTabla = ALLTRIM(TmpDTablas.codtabla)
			ps_cadena = "Sp_Statistics '" + Allt(Ps_CodTabla) + "'"
			IF Ocnx.Tipo_BD=1
				IF SQLEXEC(This.Ph_N_Conexion, ps_cadena, "TmpLlaves")<1
					MESSAGEBOX("Error al abrir el archivo LLAVES ===> "+Ps_CodTabla+CHR(13)+MESSAGE())
					RETURN .F.
				ENDIF
			ENDIF
			IF Ocnx.Tipo_BD=4
				IF Ocnx.Ms_Ejecuta_SQL(ps_cadena, "TmpLlaves",ldatasession)<1
					MESSAGEBOX("Error al abrir el archivo LLAVES ===> "+Ps_CodTabla+CHR(13)+MESSAGE())
					RETURN .F.
				ENDIF
			ENDIF
			
			SELECT "TmpLlaves"
			IF RECCOUNT("TmpLlaves")=0
				MESSAGEBOX("La tabla de llaves esta vacia .CURSOR [ TMPLLAVES ]"+CHR(13)+;
						   "Verifique la tabla SQL ===> " + Ps_CodTabla ,64,"Llaves de Tabla")
				RETURN .F.
			ENDIF
			pn_llaves = 1
			GO TOP
			SCAN
				IF TmpLlaves.non_unique=0
					IF pn_llaves = 1
						pa_tabllave(pn_tablas, pn_llaves)= Ps_CodTabla				&& Código de tabla
						pn_llaves = pn_llaves + 1
					ENDIF
					pa_tabllave(pn_tablas, pn_llaves)= UPPER(TmpLlaves.column_name)	&& Nombre de campo
					pn_llaves = pn_llaves + 1
					SELECT "TmpLlaves"
				ENDIF
			ENDSCAN
			SELECT "TmpDTablas"
			pn_tablas = pn_tablas + 1
		ENDSCAN
		IF USED("TmpDTablas")
			USE IN "TmpDTablas"
		ENDIF
		IF USED("TmpLlaves")
			USE IN "TmpLlaves"
		ENDIF
		
		***--- Aqui, abre las tablas del diccionario de datos
		FOR LCon=1 TO ALEN(pa_tabllave,1)
			IF !EMPTY(pa_tabllave(LCon,1))
				ps_CadTabla  = ALLTRIM(pa_tabllave(LCon,1))
				Ps_CadLlaves = IIF(EMPTY(pa_tabllave(LCon,2)) , "" ,ALLTRIM(pa_tabllave(LCon,2))) + ;
							   IIF(EMPTY(pa_tabllave(LCon,3)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,3))) + ;
							   IIF(EMPTY(pa_tabllave(LCon,4)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,4))) + ;
							   IIF(EMPTY(pa_tabllave(LCon,5)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,5))) + ;
							   IIF(EMPTY(pa_tabllave(LCon,6)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,6))) + ;
							   IIF(EMPTY(pa_tabllave(LCon,7)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,7))) + ;
							   IIF(EMPTY(pa_tabllave(LCon,8)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,8))) + ;
							   IIF(EMPTY(pa_tabllave(LCon,9)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,9))) + ;
							   IIF(EMPTY(pa_tabllave(LCon,10)), "" ,"+" + ALLTRIM(pa_tabllave(LCon,10)))+ ;
							   IIF(EMPTY(pa_tabllave(LCon,11)), "" ,"+" + ALLTRIM(pa_tabllave(LCon,11)))
				Ps_CadWhere  = IIF(EMPTY(pa_tabllave(LCon,2)) , "" ,ALLTRIM(pa_tabllave(LCon,2))       + "='0'") + ;
							   IIF(EMPTY(pa_tabllave(LCon,3)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,3)) + "='0'") + ;
							   IIF(EMPTY(pa_tabllave(LCon,4)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,4)) + "='0'") + ;
							   IIF(EMPTY(pa_tabllave(LCon,5)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,5)) + "='0'") + ;
							   IIF(EMPTY(pa_tabllave(LCon,6)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,6)) + "='0'") + ;
							   IIF(EMPTY(pa_tabllave(LCon,7)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,7)) + "='0'") + ;
							   IIF(EMPTY(pa_tabllave(LCon,8)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,8)) + "='0'") + ;
							   IIF(EMPTY(pa_tabllave(LCon,9)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,9)) + "='0'") + ;
							   IIF(EMPTY(pa_tabllave(LCon,10)), "" ," And " + ALLTRIM(pa_tabllave(LCon,10)) + "='0'") + ;
							   IIF(EMPTY(pa_tabllave(LCon,11)), "" ," And " + ALLTRIM(pa_tabllave(LCon,11)) + "='0'")
				USE IN (LCon)
				SELECT (LCon)
				ps_cadena="Select * From Dbo." + ps_CadTabla + " " +;
						  "Where " + Ps_CadWhere
				
				IF Ocnx.Tipo_BD=1		  
					IF SQLEXEC(This.Ph_N_Conexion, ps_cadena, ps_CadTabla)<1
						MESSAGEBOX("Error al abrir el archivo ===> "+Ps_CodTabla+CHR(13)+MESSAGE())
						RETURN .F.
					ENDIF
				ENDIF
				
				IF Ocnx.Tipo_BD=4		  
					IF Ocnx.Ms_Ejecuta_SQL(ps_cadena, ps_CadTabla,ldatasession)<1
						MESSAGEBOX("Error al abrir el archivo ===> "+Ps_CodTabla+CHR(13)+MESSAGE())
						RETURN .F.
					ENDIF
				ENDIF
				
				SELECT (ps_CadTabla)
				ps_indices = "INDEX ON " + Ps_CadLlaves + " TAG I ADDI"
				&ps_indices
			ENDIF
		ENDFOR
		IF Ocnx.Tipo_BD=1
			=SQLDISCONNECT(this.Ph_N_Conexion)
		ENDIF
		
		
	ENDPROC

	PROCEDURE mh_rangos
		pdesde=''
		phasta='ZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZ'
		
		RETURN
		
		*!*	**************
		*!*	*FUNC Rangos
		*!*	**************
		*!*	para pc1,pc2
		*!*	priv pccampo,ppict,c1,c2,c3,porden,pdef,ll,hh,wop,cur_area,ptag,a11,pre
		*!*	if empty(gdef)
		*!*	   gdef=""
		*!*	endif
		*!*	if pni=6
		*!*	   set key to range rtri(pdesde),rtri(phasta)
		*!*	   go top
		*!*	   retu
		*!*	endif
		*!*	if  empty(pc1)
		*!*	   pc1=""
		*!*	else
		*!*	   pc1=upper(pc1)+"+"
		*!*	endif
		*!*	if empty(pc2)
		*!*	  pc2=""
		*!*	else
		*!*	  pc2=upper(pc2)
		*!*	endif
		*!*	pdef=""
		*!*	a11 =""
		*!*	pre =""
		*!*	if !empty(order())
		*!*	   ptag=upper(tag())
		*!*	   store key() TO pdesde,pcampo,porden
		*!*	   pcampo=strtran(pcampo,pc1,"")
		*!*	   porden=strtran(pcampo,pc1,"")
		*!*	   pdesde=&porden
		*!*	   if len(gdef) > len(pdesde)
		*!*	      store space(len(pdesde)) to pdesde,phasta
		*!*	   else
		*!*	      if gfij > 0 and "+"$pcampo
		*!*	         pcampo=subs(pcampo,at("+",pcampo,gfij)+1)
		*!*	         porden=pcampo
		*!*	         store space(len(pdesde)-len(gdef)) to pdesde,phasta               
		*!*	         pdef=gdef
		*!*	      else
		*!*	         store gdef+space(len(pdesde)-len(gdef)) to pdesde,phasta               
		*!*	      endif
		*!*	   endif   
		*!*	   ********* BUSCANDO DESCRIPCION EN DICCIONARIO DE DATOS **************
		*!*	   if empty(gorden)
		*!*	    wtabla=upper(rtrim(subs(dbf(),rat("\",dbf())+1)))
		*!*	    wtabla=strt(wtabla,".DBF","")
		*!*	    if (len(wtabla)=8 or len(wtabla)=6) and val(allt(subs(wtabla,5))) > 0 
		*!*	       wtabla=left(wtabla,4)
		*!*	    endif
		*!*	    use gosisv+"sys_dbf2" order i in 0 alias llaves  again
		*!*	    if len(wtabla) < 9
		*!*	       wtabla=left(wtabla+space(len(llaves.tabla)),len(llaves.tabla))
		*!*	    endif   
		*!*	    cur_area=sele()
		*!*	    sele llaves
		*!*	    set key to wtabla
		*!*	    go top
		*!*	    locate for upper(allt(tag_indi))=ptag
		*!*	    if found() and !empty(allt(reporte))
		*!*	       porden=rtrim(reporte)
		*!*	       gorden=porden
		*!*	    endif
		*!*	    use in llaves
		*!*	    sele (cur_area)
		*!*	   else
		*!*	   porden=gorden   
		*!*	   endif
		*!*	   ***************************************************************
		*!*	   wop="S"
		*!*	   ppict=repl("!",len(pdesde))
		*!*	   c3=0
		*!*	   if "+"$pcampo
		*!*	      ppict="@! "
		*!*	      pcampo=pcampo+"+"
		*!*	      c3=occurs("+",pcampo)
		*!*	      for i=1 to occurs("+",pcampo)
		*!*	          c1=subs(pcampo,1,at("+",pcampo)-1)
		*!*	          c2=&c1
		*!*	          c2=len(c2)
		*!*	          ppict=ppict+repli("X",c2)+"-"
		*!*	          pcampo=strtran(pcampo,c1+"+","")
		*!*	      endfor
		*!*	      ppict=left(ppict,len(ppict)-1)
		*!*	   endif
		*!*	   ll=len(pdesde)+occurs("+",porden)
		*!*	   hh=iif(len(pdesde)>len(porden),len(pdesde),len(porden))+13
		*!*	   if hh > 99
		*!*	      hh=99   
		*!*	   else
		*!*	      hh=iif(hh<23,23,hh)
		*!*	   endif
		*!*	   DEFI WIND RANGOS FROM 00,00 TO 10,hh;
		*!*	        SYSTEM NOCLOSE COLOR SCHEME(15) TITLE "Rango de Impresión  [F1] Tablas";
		*!*	        Footer "ESC -> RETORNO" 
		*!*	   MOVE WINDOW RANGOS CENTER
		*!*	   ACTI WIND RANGOS
		*!*	   SET READBORDER ON 
		*!*	   push key clear
		*!*	   on key label f1 do GAYUDA_MENU
		*!*	   if gf2=.T.  
		*!*	      wait wind("[F2 ] Ayuda Personalizada") nowait noclea
		*!*	      on key label f2 do gAyuda_Personalizada 
		*!*	   endif
		*!*	   do while .t.
		*!*	      wop="S"
		*!*	      @01,02 say "Orden :" get porden when .f. color ,gr+/bg
		*!*	      @03,02 say "Desde :" get pdesde pict ppict func "R"  valid pasa() size 1,ll
		*!*	      @05,02 say "Hasta :" get phasta pict ppict func "R" size 1,ll
		*!*	      @07,02 say "Correcto <S/N>?" get wop pict "!" 
		*!*	      read
		*!*	      if lastkey()=27 or wop="S"
		*!*	         exit
		*!*	      endif
		*!*	   enddo
		*!*	   if pdesde=" "
		*!*	      pdesde=pdef+""
		*!*	      phasta=pdef+"Z"
		*!*	   else
		*!*	      pdesde=pdef+rtrim(pdesde)
		*!*	      phasta=pdef+rtrim(phasta)   
		*!*	   endif
		*!*	   wait clear
		*!*	   pop key
		*!*	   RELE WIND RANGOS
		*!*	   SET READBORDER OFF 
		*!*	   if pni=3
		*!*	      set key to range PC2+rtri(pdesde),PC2+rtri(phasta)
		*!*	      go top
		*!*	   endif   
		*!*	endif
		*!*	RETU
		*!*	 
		
		*!*	      
	ENDPROC

	PROCEDURE mh_resolucion		&& Calcula la resolución de la pantalla
		priv pancho,palto
		pancho=sysmetric(1)
		palto =sysmetric(2)
		do case
		case pancho=1400 and palto=1050
		     gwancho=175
		     gwalto = 76
		case pancho=1280 and palto=1024
		     gwancho=159
		     gwalto = 74
		case pancho=1024 and palto=768
		     gwancho=127
		     gwalto = 53
		case pancho=800  and palto=60
		     gwancho= 99
		     gwalto = 39
		endcase
		retu
	ENDPROC

	PROCEDURE mh_sumatoria
		para dato
		private a,ini,b,n1,n2
		dato=alltrim(upper(dato))
		b=""
		if "F"$dato
		   ini=left(dato,at("=",lc))
		   a=subs(dato,at("=",lc)+1)
		   a=strtran(a,"F(","")
		   a=strtran(a,")","")
		   n1=left(a,at(".",a)-1)
		   n2=subs(a,rat(".",a)+1)
		   for i=val(n1) to val(n2)
		       b=b+"F("+str(i,2)+")+"
		   endfor
		   b=left(b,len(b)-1)
		   b=strtran(b," ","0")
		   dato=ini+b
		else
		   n1=left(dato,at("..",dato)-1)
		   n2=subs(dato,at("..",dato)+2)
		   a=left(n1,1)
		   n1=subs(n1,at(".",n1)+1)
		   n2=subs(n2,at(".",n2)+1)
		   for i=val(n1) to val(n2)
		       b=b+chr(64+val(a))+"->"+field(i,val(a)) +"+"
		   endfor
		   dato=left(b,len(b)-1)
		endif   
		retu dato
		
	ENDPROC

	PROCEDURE mh_traduce
		para pvar
		private cur_area,obj_area,ppref,pcampo,pcad
		pcad    =&pvar
		cur_area=select()
		obj_area=left(pcad,at("|",pcad)-1)
		pcad    =subs(pcad,at("|",pcad)+1)
		ppref   =subs(pcad,1,at("|",pcad)-1)
		pcad    =subs(pcad,at("|",pcad)+1)
		pcampo  =subs(pcad,1)
		obj_area=val(obj_area)
		sele (obj_area)
		seek ppref+&pcampo
		sele (cur_area)
		retu
	ENDPROC

	PROCEDURE mh_tresdigi
		for i=wbase+1 to wtope
		    do case
		       case i-wbase=1 and wn(i)>0
		            c1(i)=iif(wbase>0 and wn(i)=1,"UN",a1(wn(i)))
		       case i-wbase=2 and wn(i)>0
		            if wn(i)>1
		               if wn(i-1)=0
		                  c1(i)=a3(wn(i))
		               else
		                  c1(i)   = a4(wn(i))
		                  c1(i-1) = ltrim(c1(i-1))
		               endif   
		            else
		               c1(i-1)=iif(wn(i-1)=0,"DIEZ",a2(wn(i-1)))
		            endif   
		       case i-wbase=3 and wn(i)>0
		            if wn(i-1)+wn(i-2)=0
		               c1(i)=a5(wn(i))
		            else
		               c1(i)=iif(wn(i)=1,"CIENTO",a5(wn(i)))
		            endif
		     endcase
		endfor 
		retu
		
	ENDPROC

	PROCEDURE mh_ve_archivo		&& archivo a pantalla
		defi wind consulta from 00,00 to gwalto-2,gwancho system ;
		     Title this.ps_programa_codigo + ".- " + THIS.PS_PRograma_nombre close
		push key clear     
		on key label LeftMouse
		on key label RightMouse                                    
		*modi comm gworka+rtrim(this.ps_programa_codigo)+'.'+right(gcod_cia,1)+right(guser,2) noedit window consulta
		
		modi comm this.ps_ruta + "WORKA\" + this.ps_programa_codigo + '.TXT' noedit window consulta
		
		pop key
		rele wind consulta
		set safety off
		retu
		
	ENDPROC

ENDDEFINE

DEFINE CLASS cls_opciones AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Container1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Shape1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Destino" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmd_aceptar" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BorderStyle = 2
		Caption = "Opciones de Formato"
		ClipControls = .F.
		Closable = .F.
		ControlBox = .F.
		DoCreate = .T.
		Height = 160
		KeyPreview = .T.
		MaxButton = .F.
		MinButton = .F.
		Name = "cls_opciones"
		Width = 180
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmd_aceptar' AS commandbutton WITH ;
		Caption = "Aceptar", ;
		FontSize = 8, ;
		Height = 31, ;
		Left = 17, ;
		Name = "cmd_aceptar", ;
		Top = 103, ;
		Width = 143
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Container1' AS container WITH ;
		BorderWidth = 4, ;
		Height = 144, ;
		Left = 5, ;
		Name = "Container1", ;
		SpecialEffect = 0, ;
		Top = 8, ;
		Width = 169
		*< END OBJECT: BaseClass="container" />

	ADD OBJECT 'Destino' AS optiongroup WITH ;
		ButtonCount = 3, ;
		Height = 73, ;
		Left = 17, ;
		Name = "Destino", ;
		Top = 25, ;
		Value = 1, ;
		Width = 143, ;
		Option1.AutoSize = .T., ;
		Option1.Caption = "PANTALLA", ;
		Option1.FontBold = .F., ;
		Option1.FontName = "Arial", ;
		Option1.FontOutline = .T., ;
		Option1.FontSize = 9, ;
		Option1.ForeColor = 0,0,0, ;
		Option1.Height = 17, ;
		Option1.Left = 26, ;
		Option1.Name = "Pantalla", ;
		Option1.Top = 10, ;
		Option1.Value = 1, ;
		Option1.Width = 77, ;
		Option2.AutoSize = .T., ;
		Option2.Caption = "IMPRESORA", ;
		Option2.FontBold = .F., ;
		Option2.FontName = "Arial", ;
		Option2.FontOutline = .T., ;
