		a5(7)=" SETECIENTOS"
		a5(8)=" OCHOCIENTOS"
		a5(9)=" NOVECIENTOS"
		***************************************
		RETURN THIS.MH_Convierte(wnum)
		
	ENDPROC

	PROCEDURE mh_pone_alias
		para a1,a2
		private p1,p2,p3,ppalias
		if type("a2")="N"
		   ppalias=chr(64+a2)   
		else
		   ppalias=a2   
		endif   
		p1=occurs("+",a1)+1
		p2=fcount(a2)
		a1="+"+a1
		i=1
		do while p1 > 0
		   p3=field(i,a2)
		   if p3+"+"$a1 or p3+")"$a1 or p3+","$a1 or p3+" "$a1+" "
		      if at("+"+field(i,a2),a1) > 0
		         a1=strtran(a1,"+"+field(i,a2),"+"+ppalias+"."+field(i,a2))
		         p1=p1-1
		      endif   
		      if at("("+field(i,a2),a1) > 0
		         a1=strtran(a1,"("+field(i,a2),"("+ppalias+"."+field(i,a2))
		         p1=p1-1
		      endif   
		   endif
		   i=i+1
		   if i > p2
		     exit
		   endif
		enddo
		retu subs(a1,2)
		
	ENDPROC

	PROCEDURE mh_programa_tablas_formato		&& ejecuta consulta desde el maestro de opciones para extraer las tablas que se usan en el formato
		PARAMETERS PS_TIPO
		
		PRIVATE pn_nrotabla, pn_contador
		PRIVATE Ps_CodTabla
		ps_cadena=           "Select a.s07_cors07 as 'Orden' ,a.s01_codtab as 'codtabla', "
		ps_cadena=ps_cadena+ "       a.s35_etique as 'Etiqueta', "
		ps_cadena=ps_cadena+ "       b.s35_expres as 'Expresion' "
		ps_cadena=ps_cadena+ "From Dbo.Sys_Opciones_Tablas_S18 a "
		ps_cadena=ps_cadena+ "  Inner Join Dbo.sys_tabla_indices_s35 b "
		ps_cadena=ps_cadena+ "    On(   ltrim(rtrim(b.s01_codtab))=ltrim(rtrim(a.s01_codtab)) "
		ps_cadena=ps_cadena+ "      and ltrim(rtrim(b.s35_etique))=ltrim(rtrim(a.s35_etique))) "
		ps_cadena=ps_cadena+ "Where Ltrim(Rtrim(a.s07_codopc)) = '"+NVL(This.ps_programa_codigo,"")+"' "
		ps_cadena=ps_cadena+ "  and a.s18_indfor='1' "
		ps_cadena=ps_cadena+ "Order By a.s07_cors07 "
		IF Ocnx.Tipo_BD=1
			IF SQLEXEC(Ocnx.Conexion, ps_cadena, "TmpDTablas")<1
				MESSAGEBOX("Error al abrir el archivo TABLAS DEL PROGRAMA [Formatos] "+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		IF Ocnx.Tipo_BD=4
			IF Ocnx.Ms_Ejecuta_SQL(ps_cadena, "TmpDTablas",This.DataSessionId)<1
				MESSAGEBOX("Error al abrir el archivo TABLAS DEL PROGRAMA [Formatos] "+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
		ENDIF
		
		pl_diccionario_ok = .f.
		SELECT "TmpDTablas"
		IF RECCOUNT("TmpDTablas")<=0
			MESSAGEBOX("Cursor de diccionario de datos [ TABLAS ] no tiene registros...!!!"+CHR(13)+;
					   "Verifique el codigo de Programa ===>  "+ALLTRIM(this.ps_programa_codigo))
			RETURN .F.
		ENDIF
		pn_tablas = 1
		DIMENSION pa_tabllave(RECCOUNT("TmpDTablas"),11)
		GO TOP
		SCAN
			Ps_CodTabla = ALLTRIM(TmpDTablas.codtabla)
			pa_tabllave(pn_tablas, 1)= ALLTRIM(NVL(TmpDTablas.codtabla,''))
			pa_tabllave(pn_tablas, 2)= ALLTRIM(NVL(TmpDTablas.Etiqueta,''))
			pa_tabllave(pn_tablas, 3)= ALLTRIM(NVL(TmpDTablas.Expresion,''))
			pn_tablas = pn_tablas + 1
		ENDSCAN
		IF USED("TmpDTablas")
			USE IN "TmpDTablas"
		ENDIF
		
		***--- Aqui, abre las tablas del diccionario de datos
		FOR LCon=1 TO ALEN(pa_tabllave,1)
			IF !EMPTY(pa_tabllave(LCon,1))
				ps_CadTabla  = ALLTRIM(pa_tabllave(LCon, 1))
				Ps_CadLlaves = ALLTRIM(pa_tabllave(LCon, 3))
				Ps_CadWhere  = ALLTRIM(Ps_CadLlaves) + " = 'X1X1X0X0X0' "
				USE IN (LCon)
				SELECT (LCon)
				ps_cadena="Select * From Dbo." + ps_CadTabla + " " +;
						  "Where " + Ps_CadWhere
				IF Ocnx.Tipo_BD=1		  
					IF SQLEXEC(Ocnx.Conexion, ps_cadena, ps_CadTabla)<1
						MESSAGEBOX("Error al abrir el archivo ===> "+Ps_CodTabla+CHR(13)+MESSAGE())
						RETURN .F.
					ENDIF
				ENDIF
				IF Ocnx.Tipo_BD=4
					IF Ocnx.Ms_Ejecuta_SQL(ps_cadena, ps_CadTabla,This.DataSessionId)<1
						MESSAGEBOX("Error al abrir el archivo ===> "+Ps_CodTabla+CHR(13)+MESSAGE())
						RETURN .F.
					ENDIF
				ENDIF
				
				SELECT (ps_CadTabla)
				ps_indices = "INDEX ON " + Ps_CadLlaves + " TAG I ADDI"
				&ps_indices
			ENDIF
		ENDFOR
		
		
		
		
		
		*!*	PARAMETERS PS_TIPO
		
		*!*	IF ALLTRIM(NVL(This.Ps_Programa_Codigo,''))=="V34A000"	&& PRUEBAS DE ALSA
		*!*		THIS.MH_TEmporal_pruebas(PS_TIPO)
		*!*		RETU
		*!*	ENDIF
		
		*!*	PRIVATE pn_nrotabla, pn_contador
		*!*	PRIVATE Ps_CodTabla
		*!*	ps_cadena=           "Select s18_indupd as 'Orden' ,s01_codtab as 'codtabla' "
		*!*	ps_cadena=ps_cadena+ "From Dbo.Sys_Opciones_Tablas_S18 "
		*!*	ps_cadena=ps_cadena+ "Where Ltrim(Rtrim(s07_codopc)) = ?This.ps_programa_codigo "
		*!*	ps_cadena=ps_cadena+ "  and s18_indfor='1' "
		*!*	ps_cadena=ps_cadena+ "Order By s18_indupd "
		*!*	IF SQLEXEC(Ocnx.Conexion, ps_cadena, "TmpDTablas")<1
		*!*		MESSAGEBOX("Error al abrir el archivo TABLAS DEL PROGRAMA [Formatos] "+CHR(13)+MESSAGE())
		*!*		RETURN .F.
		*!*	ENDIF
		*!*	pl_diccionario_ok = .f.
		*!*	SELECT "TmpDTablas"
		*!*	IF RECCOUNT("TmpDTablas")<=0
		*!*		MESSAGEBOX("Cursor de diccionario de datos [ TABLAS ] no tiene registros...!!!"+CHR(13)+;
		*!*				   "Verifique el codigo de Programa ===>  "+ALLTRIM(this.ps_programa_codigo))
		*!*		RETURN .F.
		*!*	ENDIF
		
		*!*	pl_diccionario_ok = .t.
		*!*	pn_tablas = 1
		*!*	DIMENSION pa_tabllave(RECCOUNT("TmpDTablas"),11)
		*!*	GO TOP
		*!*	SCAN
		*!*		Ps_CodTabla = ALLTRIM(TmpDTablas.codtabla)
		*!*		ps_cadena = "Sp_Statistics '" + Allt(Ps_CodTabla) + "'"
		*!*		IF SQLEXEC(Ocnx.Conexion, ps_cadena, "TmpLlaves")<1
		*!*			MESSAGEBOX("Error al abrir el archivo LLAVES ===> "+Ps_CodTabla+CHR(13)+MESSAGE())
		*!*			RETURN .F.
		*!*		ENDIF
		*!*		SELECT "TmpLlaves"
		*!*		IF RECCOUNT("TmpLlaves")=0
		*!*			MESSAGEBOX("La tabla de llaves esta vacia .CURSOR [ TMPLLAVES ]"+CHR(13)+;
		*!*					   "Verifique la tabla SQL ===> " + Ps_CodTabla ,64,"Llaves de Tabla")
		*!*			RETURN .F.
		*!*		ENDIF
		*!*		pn_llaves = 1
		*!*		GO TOP
		*!*		SCAN
		*!*			IF TmpLlaves.non_unique=0
		*!*				IF pn_llaves = 1
		*!*					pa_tabllave(pn_tablas, pn_llaves)= Ps_CodTabla				&& Código de tabla
		*!*					pn_llaves = pn_llaves + 1
		*!*				ENDIF
		*!*				pa_tabllave(pn_tablas, pn_llaves)= UPPER(TmpLlaves.column_name)	&& Nombre de campo
		*!*				pn_llaves = pn_llaves + 1
		*!*				SELECT "TmpLlaves"
		*!*			ENDIF
		*!*		ENDSCAN
		*!*		SELECT "TmpDTablas"
		*!*		pn_tablas = pn_tablas + 1
		*!*	ENDSCAN
		*!*	IF USED("TmpDTablas")
		*!*		USE IN "TmpDTablas"
		*!*	ENDIF
		*!*	IF USED("TmpLlaves")
		*!*		USE IN "TmpLlaves"
		*!*	ENDIF
		
		*!*	***--- Aqui, abre las tablas del diccionario de datos
		*!*	FOR LCon=1 TO ALEN(pa_tabllave,1)
		*!*		IF !EMPTY(pa_tabllave(LCon,1))
		*!*			ps_CadTabla  = ALLTRIM(pa_tabllave(LCon,1))
		*!*			Ps_CadLlaves = IIF(EMPTY(pa_tabllave(LCon,2)) , "" ,ALLTRIM(pa_tabllave(LCon,2))) + ;
		*!*						   IIF(EMPTY(pa_tabllave(LCon,3)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,3))) + ;
		*!*						   IIF(EMPTY(pa_tabllave(LCon,4)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,4))) + ;
		*!*						   IIF(EMPTY(pa_tabllave(LCon,5)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,5))) + ;
		*!*						   IIF(EMPTY(pa_tabllave(LCon,6)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,6))) + ;
		*!*						   IIF(EMPTY(pa_tabllave(LCon,7)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,7))) + ;
		*!*						   IIF(EMPTY(pa_tabllave(LCon,8)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,8))) + ;
		*!*						   IIF(EMPTY(pa_tabllave(LCon,9)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,9))) + ;
		*!*						   IIF(EMPTY(pa_tabllave(LCon,10)), "" ,"+" + ALLTRIM(pa_tabllave(LCon,10)))+ ;
		*!*						   IIF(EMPTY(pa_tabllave(LCon,11)), "" ,"+" + ALLTRIM(pa_tabllave(LCon,11)))
		*!*			Ps_CadWhere  = IIF(EMPTY(pa_tabllave(LCon,2)) , "" ,ALLTRIM(pa_tabllave(LCon,2))       + "='0'") + ;
		*!*						   IIF(EMPTY(pa_tabllave(LCon,3)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,3)) + "='0'") + ;
		*!*						   IIF(EMPTY(pa_tabllave(LCon,4)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,4)) + "='0'") + ;
		*!*						   IIF(EMPTY(pa_tabllave(LCon,5)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,5)) + "='0'") + ;
		*!*						   IIF(EMPTY(pa_tabllave(LCon,6)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,6)) + "='0'") + ;
		*!*						   IIF(EMPTY(pa_tabllave(LCon,7)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,7)) + "='0'") + ;
		*!*						   IIF(EMPTY(pa_tabllave(LCon,8)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,8)) + "='0'") + ;
		*!*						   IIF(EMPTY(pa_tabllave(LCon,9)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,9)) + "='0'") + ;
		*!*						   IIF(EMPTY(pa_tabllave(LCon,10)), "" ," And " + ALLTRIM(pa_tabllave(LCon,10)) + "='0'") + ;
		*!*						   IIF(EMPTY(pa_tabllave(LCon,11)), "" ," And " + ALLTRIM(pa_tabllave(LCon,11)) + "='0'")
		*!*			USE IN (LCon)
		*!*			SELECT (LCon)
		*!*			ps_cadena="Select * From Dbo." + ps_CadTabla + " " +;
		*!*					  "Where " + Ps_CadWhere
		*!*			IF SQLEXEC(Ocnx.Conexion, ps_cadena, ps_CadTabla)<1
		*!*				MESSAGEBOX("Error al abrir el archivo ===> "+Ps_CodTabla+CHR(13)+MESSAGE())
		*!*				RETURN .F.
		*!*			ENDIF
		*!*			SELECT (ps_CadTabla)
		*!*			ps_indices = "INDEX ON " + Ps_CadLlaves + " TAG I ADDI"
		*!*			&ps_indices
		*!*		ENDIF
		*!*	ENDFOR
		
		
	ENDPROC

	PROCEDURE mh_rangos		&& rangos de impresión
		pdesde=''
		phasta='ZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZ'
		
		RETURN
		
		*!*	**************
		*!*	*FUNC Rangos
		*!*	**************
		*!*	para pc1,pc2
		*!*	priv pccampo,ppict,c1,c2,c3,porden,pdef,ll,hh,wop,cur_area,ptag,a11,pre
		*!*	if empty(gdef)
		*!*	   gdef=""
		*!*	endif
		*!*	if pni=6
		*!*	   set key to range rtri(pdesde),rtri(phasta)
		*!*	   go top
		*!*	   retu
		*!*	endif
		*!*	if  empty(pc1)
		*!*	   pc1=""
		*!*	else
		*!*	   pc1=upper(pc1)+"+"
		*!*	endif
		*!*	if empty(pc2)
		*!*	  pc2=""
		*!*	else
		*!*	  pc2=upper(pc2)
		*!*	endif
		*!*	pdef=""
		*!*	a11 =""
		*!*	pre =""
		*!*	if !empty(order())
		*!*	   ptag=upper(tag())
		*!*	   store key() TO pdesde,pcampo,porden
		*!*	   pcampo=strtran(pcampo,pc1,"")
		*!*	   porden=strtran(pcampo,pc1,"")
		*!*	   pdesde=&porden
		*!*	   if len(gdef) > len(pdesde)
		*!*	      store space(len(pdesde)) to pdesde,phasta
		*!*	   else
		*!*	      if gfij > 0 and "+"$pcampo
		*!*	         pcampo=subs(pcampo,at("+",pcampo,gfij)+1)
		*!*	         porden=pcampo
		*!*	         store space(len(pdesde)-len(gdef)) to pdesde,phasta               
		*!*	         pdef=gdef
		*!*	      else
		*!*	         store gdef+space(len(pdesde)-len(gdef)) to pdesde,phasta               
		*!*	      endif
		*!*	   endif   
		*!*	   ********* BUSCANDO DESCRIPCION EN DICCIONARIO DE DATOS **************
		*!*	   if empty(gorden)
		*!*	    wtabla=upper(rtrim(subs(dbf(),rat("\",dbf())+1)))
		*!*	    wtabla=strt(wtabla,".DBF","")
		*!*	    if (len(wtabla)=8 or len(wtabla)=6) and val(allt(subs(wtabla,5))) > 0 
		*!*	       wtabla=left(wtabla,4)
		*!*	    endif
		*!*	    use gosisv+"sys_dbf2" order i in 0 alias llaves  again
		*!*	    if len(wtabla) < 9
		*!*	       wtabla=left(wtabla+space(len(llaves.tabla)),len(llaves.tabla))
		*!*	    endif   
		*!*	    cur_area=sele()
		*!*	    sele llaves
		*!*	    set key to wtabla
		*!*	    go top
		*!*	    locate for upper(allt(tag_indi))=ptag
		*!*	    if found() and !empty(allt(reporte))
		*!*	       porden=rtrim(reporte)
		*!*	       gorden=porden
		*!*	    endif
		*!*	    use in llaves
		*!*	    sele (cur_area)
		*!*	   else
		*!*	   porden=gorden   
		*!*	   endif
		*!*	   ***************************************************************
		*!*	   wop="S"
		*!*	   ppict=repl("!",len(pdesde))
		*!*	   c3=0
		*!*	   if "+"$pcampo
		*!*	      ppict="@! "
		*!*	      pcampo=pcampo+"+"
		*!*	      c3=occurs("+",pcampo)
		*!*	      for i=1 to occurs("+",pcampo)
		*!*	          c1=subs(pcampo,1,at("+",pcampo)-1)
		*!*	          c2=&c1
		*!*	          c2=len(c2)
		*!*	          ppict=ppict+repli("X",c2)+"-"
		*!*	          pcampo=strtran(pcampo,c1+"+","")
		*!*	      endfor
		*!*	      ppict=left(ppict,len(ppict)-1)
		*!*	   endif
		*!*	   ll=len(pdesde)+occurs("+",porden)
		*!*	   hh=iif(len(pdesde)>len(porden),len(pdesde),len(porden))+13
		*!*	   if hh > 99
		*!*	      hh=99   
		*!*	   else
		*!*	      hh=iif(hh<23,23,hh)
		*!*	   endif
		*!*	   DEFI WIND RANGOS FROM 00,00 TO 10,hh;
		*!*	        SYSTEM NOCLOSE COLOR SCHEME(15) TITLE "Rango de Impresión  [F1] Tablas";
		*!*	        Footer "ESC -> RETORNO" 
		*!*	   MOVE WINDOW RANGOS CENTER
		*!*	   ACTI WIND RANGOS
		*!*	   SET READBORDER ON 
		*!*	   push key clear
		*!*	   on key label f1 do GAYUDA_MENU
		*!*	   if gf2=.T.  
		*!*	      wait wind("[F2 ] Ayuda Personalizada") nowait noclea
		*!*	      on key label f2 do gAyuda_Personalizada 
		*!*	   endif
		*!*	   do while .t.
		*!*	      wop="S"
		*!*	      @01,02 say "Orden :" get porden when .f. color ,gr+/bg
		*!*	      @03,02 say "Desde :" get pdesde pict ppict func "R"  valid pasa() size 1,ll
		*!*	      @05,02 say "Hasta :" get phasta pict ppict func "R" size 1,ll
		*!*	      @07,02 say "Correcto <S/N>?" get wop pict "!" 
		*!*	      read
		*!*	      if lastkey()=27 or wop="S"
		*!*	         exit
		*!*	      endif
		*!*	   enddo
		*!*	   if pdesde=" "
		*!*	      pdesde=pdef+""
		*!*	      phasta=pdef+"Z"
		*!*	   else
		*!*	      pdesde=pdef+rtrim(pdesde)
		*!*	      phasta=pdef+rtrim(phasta)   
		*!*	   endif
		*!*	   wait clear
		*!*	   pop key
		*!*	   RELE WIND RANGOS
		*!*	   SET READBORDER OFF 
		*!*	   if pni=3
		*!*	      set key to range PC2+rtri(pdesde),PC2+rtri(phasta)
		*!*	      go top
		*!*	   endif   
		*!*	endif
		*!*	RETU
		*!*	 
		
		*!*	      
	ENDPROC

	PROCEDURE mh_resolucion		&& calcula la resolución de la pantalla
		priv pancho,palto
		pancho=sysmetric(1)
		palto =sysmetric(2)
		do case
		case pancho=1400 and palto=1050
		     gwancho=175
		     gwalto = 76
		case pancho=1280 and palto=1024
		     gwancho=159
		     gwalto = 74
		case pancho=1024 and palto=768
		     gwancho=127
		     gwalto = 53
		case pancho=800  and palto=600
		     gwancho= 99
		     gwalto = 39
		OTHERWISE
		     gwancho= 99
		     gwalto = 39
		endcase
		retu
	ENDPROC

	PROCEDURE mh_setea_entorno		&& setea el entorno de trabajo < SET >
		SET SAFETY OFF
		SET EXACT ON
		SET TALK ON
		SET DELETED ON
		SET DATE BRITISH
		SET CENTURY ON
		SET DECIMALS TO 18
		
	ENDPROC

	PROCEDURE mh_sumatoria
		para dato
		private a,ini,b,n1,n2
		dato=alltrim(upper(dato))
		b=""
		if "F"$dato
		   ini=left(dato,at("=",lc))
		   a=subs(dato,at("=",lc)+1)
		   a=strtran(a,"F(","")
		   a=strtran(a,")","")
		   n1=left(a,at(".",a)-1)
		   n2=subs(a,rat(".",a)+1)
		   for i=val(n1) to val(n2)
		       b=b+"F("+str(i,2)+")+"
		   endfor
		   b=left(b,len(b)-1)
		   b=strtran(b," ","0")
		   dato=ini+b
		else
		   n1=left(dato,at("..",dato)-1)
		   n2=subs(dato,at("..",dato)+2)
		   a=left(n1,1)
		   n1=subs(n1,at(".",n1)+1)
		   n2=subs(n2,at(".",n2)+1)
		   for i=val(n1) to val(n2)
		       b=b+chr(64+val(a))+"->"+field(i,val(a)) +"+"
		   endfor
		   dato=left(b,len(b)-1)
		endif   
		retu dato
		
	ENDPROC

	PROCEDURE mh_temporal_pruebas
		***********************************************************************
		***---	PRUEBAS DE FORMATOS DE ALSA
		***********************************************************************
		PARAMETERS PS_TIPO
		
		This.Ph_N_Conexion = SQLCONNECT("alsa", "lhuapaya", "luihua")
		IF this.Ph_N_Conexion < 1
			MESSAGEBOX("Error al conectar a la base de datos alsa")
			RETURN .f.
		ENDIF
		
		PRIVATE pn_nrotabla, pn_contador
		PRIVATE Ps_CodTabla
		
		ps_cadena=           "Select s18_indupd as 'Orden' ,s01_codtab as 'codtabla' "
		ps_cadena=ps_cadena+ "From Dbo.Sys_Opciones_Tablas_S18 "
		ps_cadena=ps_cadena+ "Where Ltrim(Rtrim(s07_codopc)) = ?This.ps_programa_codigo "
		ps_cadena=ps_cadena+ "  and s18_indfor='1' "
		ps_cadena=ps_cadena+ "Order By s18_indupd "
		IF SQLEXEC(Ocnx.Conexion, ps_cadena, "TmpDTablas")<1
			MESSAGEBOX("Error al abrir el archivo TABLAS DEL PROGRAMA [Formatos] "+CHR(13)+MESSAGE())
			RETURN .F.
		ENDIF
		pl_diccionario_ok = .f.
		SELECT "TmpDTablas"
		IF RECCOUNT("TmpDTablas")<=0
			MESSAGEBOX("Cursor de diccionario de datos [ TABLAS ] no tiene registros...!!!"+CHR(13)+;
					   "Verifique el codigo de Programa ===>  "+ALLTRIM(this.ps_programa_codigo))
			RETURN .F.
		ENDIF
		
		pl_diccionario_ok = .t.
		pn_tablas = 1
		DIMENSION pa_tabllave(RECCOUNT("TmpDTablas"),11)
		GO TOP
		SCAN
			Ps_CodTabla = ALLTRIM(TmpDTablas.codtabla)
			ps_cadena = "Sp_Statistics '" + Allt(Ps_CodTabla) + "'"
			IF SQLEXEC(This.Ph_N_Conexion, ps_cadena, "TmpLlaves")<1
				MESSAGEBOX("Error al abrir el archivo LLAVES ===> "+Ps_CodTabla+CHR(13)+MESSAGE())
				RETURN .F.
			ENDIF
			SELECT "TmpLlaves"
			IF RECCOUNT("TmpLlaves")=0
				MESSAGEBOX("La tabla de llaves esta vacia .CURSOR [ TMPLLAVES ]"+CHR(13)+;
						   "Verifique la tabla SQL ===> " + Ps_CodTabla ,64,"Llaves de Tabla")
				RETURN .F.
			ENDIF
			pn_llaves = 1
			GO TOP
			SCAN
				IF TmpLlaves.non_unique=0
					IF pn_llaves = 1
						pa_tabllave(pn_tablas, pn_llaves)= Ps_CodTabla				&& Código de tabla
						pn_llaves = pn_llaves + 1
					ENDIF
					pa_tabllave(pn_tablas, pn_llaves)= UPPER(TmpLlaves.column_name)	&& Nombre de campo
					pn_llaves = pn_llaves + 1
					SELECT "TmpLlaves"
				ENDIF
			ENDSCAN
			SELECT "TmpDTablas"
			pn_tablas = pn_tablas + 1
		ENDSCAN
		IF USED("TmpDTablas")
			USE IN "TmpDTablas"
		ENDIF
		IF USED("TmpLlaves")
			USE IN "TmpLlaves"
		ENDIF
		
		***--- Aqui, abre las tablas del diccionario de datos
		FOR LCon=1 TO ALEN(pa_tabllave,1)
			IF !EMPTY(pa_tabllave(LCon,1))
				ps_CadTabla  = ALLTRIM(pa_tabllave(LCon,1))
				Ps_CadLlaves = IIF(EMPTY(pa_tabllave(LCon,2)) , "" ,ALLTRIM(pa_tabllave(LCon,2))) + ;
							   IIF(EMPTY(pa_tabllave(LCon,3)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,3))) + ;
							   IIF(EMPTY(pa_tabllave(LCon,4)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,4))) + ;
							   IIF(EMPTY(pa_tabllave(LCon,5)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,5))) + ;
							   IIF(EMPTY(pa_tabllave(LCon,6)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,6))) + ;
							   IIF(EMPTY(pa_tabllave(LCon,7)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,7))) + ;
							   IIF(EMPTY(pa_tabllave(LCon,8)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,8))) + ;
							   IIF(EMPTY(pa_tabllave(LCon,9)) , "" ,"+" + ALLTRIM(pa_tabllave(LCon,9))) + ;
							   IIF(EMPTY(pa_tabllave(LCon,10)), "" ,"+" + ALLTRIM(pa_tabllave(LCon,10)))+ ;
							   IIF(EMPTY(pa_tabllave(LCon,11)), "" ,"+" + ALLTRIM(pa_tabllave(LCon,11)))
				Ps_CadWhere  = IIF(EMPTY(pa_tabllave(LCon,2)) , "" ,ALLTRIM(pa_tabllave(LCon,2))       + "='0'") + ;
							   IIF(EMPTY(pa_tabllave(LCon,3)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,3)) + "='0'") + ;
							   IIF(EMPTY(pa_tabllave(LCon,4)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,4)) + "='0'") + ;
							   IIF(EMPTY(pa_tabllave(LCon,5)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,5)) + "='0'") + ;
							   IIF(EMPTY(pa_tabllave(LCon,6)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,6)) + "='0'") + ;
							   IIF(EMPTY(pa_tabllave(LCon,7)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,7)) + "='0'") + ;
							   IIF(EMPTY(pa_tabllave(LCon,8)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,8)) + "='0'") + ;
							   IIF(EMPTY(pa_tabllave(LCon,9)) , "" ," And " + ALLTRIM(pa_tabllave(LCon,9)) + "='0'") + ;
							   IIF(EMPTY(pa_tabllave(LCon,10)), "" ," And " + ALLTRIM(pa_tabllave(LCon,10)) + "='0'") + ;
							   IIF(EMPTY(pa_tabllave(LCon,11)), "" ," And " + ALLTRIM(pa_tabllave(LCon,11)) + "='0'")
				USE IN (LCon)
				SELECT (LCon)
				ps_cadena="Select * From Dbo." + ps_CadTabla + " " +;
						  "Where " + Ps_CadWhere
				IF SQLEXEC(This.Ph_N_Conexion, ps_cadena, ps_CadTabla)<1
					MESSAGEBOX("Error al abrir el archivo ===> "+Ps_CodTabla+CHR(13)+MESSAGE())
					RETURN .F.
				ENDIF
				SELECT (ps_CadTabla)
				ps_indices = "INDEX ON " + Ps_CadLlaves + " TAG I ADDI"
				&ps_indices
			ENDIF
		ENDFOR
		=SQLDISCONNECT(this.Ph_N_Conexion)
		
		
	ENDPROC

	PROCEDURE mh_traduce
		para pvar
		private cur_area,obj_area,ppref,pcampo,pcad
		pcad    =&pvar
		cur_area=select()
		obj_area=left(pcad,at("|",pcad)-1)
		pcad    =subs(pcad,at("|",pcad)+1)
		ppref   =subs(pcad,1,at("|",pcad)-1)
		pcad    =subs(pcad,at("|",pcad)+1)
		pcampo  =subs(pcad,1)
		obj_area=val(obj_area)
		sele (obj_area)
		seek ppref+&pcampo
		sele (cur_area)
		retu
	ENDPROC

	PROCEDURE mh_tresdigi
		for i=wbase+1 to wtope
		    do case
		       case i-wbase=1 and wn(i)>0
		            c1(i)=iif(wbase>0 and wn(i)=1,"UN",a1(wn(i)))
		       case i-wbase=2 and wn(i)>0
		            if wn(i)>1
		               if wn(i-1)=0
		                  c1(i)=a3(wn(i))
		               else
		                  c1(i)   = a4(wn(i))
		                  c1(i-1) = ltrim(c1(i-1))
		               endif   
		            else
		               c1(i-1)=iif(wn(i-1)=0,"DIEZ",a2(wn(i-1)))
		            endif   
		       case i-wbase=3 and wn(i)>0
		            if wn(i-1)+wn(i-2)=0
		               c1(i)=a5(wn(i))
		            else
		               c1(i)=iif(wn(i)=1,"CIENTO",a5(wn(i)))
		            endif
		     endcase
		endfor 
		retu
		
	ENDPROC

	PROCEDURE mh_ve_archivo		&& muestra el archivo a pantalla
		defi wind consulta from 00,00 to gwalto-2,gwancho system ;
		     Title this.ps_programa_codigo + ".- " + THIS.PS_PRograma_nombre close font 'Terminal' ;
		     name ovearchivo
		
		ovearchivo.Width=_Screen.Width     
		push key clear     
		on key label LeftMouse
		on key label RightMouse                                    
		*modi comm gworka+rtrim(this.ps_programa_codigo)+'.'+right(gcod_cia,1)+right(guser,2) noedit window consulta
		
		modi comm this.ps_ruta + "WORKA\" + this.ps_programa_codigo + '.TXT' noedit window consulta
		
		pop key
		rele wind consulta
		set safety off
		retu
		
	ENDPROC

	PROCEDURE procesos_memoria
		LPARAMETERS lp_indicador as Integer 
		PRIVATE lproc , lcanti, lpos, lcontinua, lca,lcanreg, lnx
		
		SELECT 0
		CREATE CURSOR "TemProAb" (proce c(250))
		
		lproc=SET("Procedure") 
		
		lproc=ALLTRIM(lproc)
		
		
		IF LEN(lproc)>0
			IF 	","$lproc
				llenini=LEN(lproc)
				lcontinua=.T.	
				DO WHILE lcontinua	0
				
					lpos=AT(",",lproc)
					IF lpos>0
						ldat=SUBSTR(lproc,1,lpos-1)
						llenini=llenini-lpos
						INSERT INTO "TemProAb" VALUES (ALLTRIM(ldat))
						lproc=SUBSTR(lproc,lpos+1,llenini)
					ELSE
						lcontinua=.F.	
					ENDIF
				ENDDO 
			ENDIF
			DIMENSION This.Lista_proceso_memoria[1]
			This.Lista_proceso_memoria[1]=""
		
			INSERT INTO "TemProAb" VALUES (ALLTRIM(lproc))
			SELECT 	"TemProAb"
			lcanreg=RECCOUNT()
			DIMENSION This.Lista_proceso_memoria[lcanreg] 
			SELECT 	"TemProAb"
			GO top
			lnx=1
			SCAN
				This.Lista_proceso_memoria[lnx]=ALLTRIM(TemProAb.proce)
				lnx=lnx+1
				SELECT 	"TemProAb"
			ENDSCAN
			IF USED("TemProAb")
				USE IN "TemProAb"
			ENDIF
			
			IF lp_indicador=1
				This.Cantidad_procesos_entrada = lcanreg
			ELSE
				This.Cantidad_procesos_salida = lcanreg
			ENDIF
		ENDIF
		
		
	ENDPROC

	PROCEDURE Unload
		RELEASE ALL LIKE L6_*
		*CLOSE DATABASES ALL
		
		This.mh_ejecuta_sqlrollback()
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS cls_setupformato AS custom 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*p: ps_cadena_llave		&& guarda la cadena llave del registro actual
		*p: ps_codigo_programa		&& codigo de la opcion,  (configuración de programa)
		*p: ps_indicador		&& "1" = crea archivo .MEN,      "2" = Ejecuta el formato
		*p: ps_nombre_programa		&& nombre del programa
		*p: ps_opcion		&& "P" = Pantalla,     "I" = Impresora
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "cls_setupformato"
		ps_cadena_llave = 
		ps_codigo_programa = 
		ps_indicador = ('1')
		ps_nombre_programa = 
		ps_opcion = ('P')
	*</PropValue>

ENDDEFINE

DEFINE CLASS opcion_formato_plataforma AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Option" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="BtnAceptar" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="BtnConfigura" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="BtnCancela" UniqueID="" Timestamp="" />

	*<PropValue>
		AutoCenter = .T.
		BorderStyle = 0
		Caption = "Opción de Impresión"
		Closable = .F.
		DoCreate = .T.
		Height = 148
		Icon = ..\imag\note06.ico
		MaxButton = .F.
		MinButton = .F.
		Name = "opcion_formato_plataforma"
		Width = 271
		WindowType = 0
	*</PropValue>

	ADD OBJECT 'BtnAceptar' AS commandbutton WITH ;
		Caption = "\<Aceptar", ;
		Default = .T., ;
		FontName = "MS Sans Serif", ;
		Height = 27, ;
		Left = 12, ;
		Name = "BtnAceptar", ;
		Top = 96, ;
		Width = 96
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'BtnCancela' AS commandbutton WITH ;
		Cancel = .T., ;
		Caption = "\<Cancelar", ;
		FontName = "MS Sans Serif", ;
		Height = 27, ;
		Left = 156, ;
		Name = "BtnCancela", ;
		Top = 96, ;
		Width = 96
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'BtnConfigura' AS commandbutton WITH ;
		Caption = "Configura \<Printer...", ;
		FontName = "MS Sans Serif", ;
		Height = 27, ;
		Left = 156, ;
		Name = "BtnConfigura", ;
		Top = 36, ;
		Width = 96
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Option' AS optiongroup WITH ;
		BackStyle = 0, ;
		ButtonCount = 2, ;
		Height = 57, ;
		Left = 16, ;
		Name = "Option", ;
		Top = 25, ;
		Value = 1, ;
		Width = 105, ;
		Option1.AutoSize = .T., ;
		Option1.BackStyle = 0, ;
		Option1.Caption = "Pantalla", ;
		Option1.FontName = "MS Sans Serif", ;
		Option1.Height = 15, ;
		Option1.Left = 17, ;
		Option1.Name = "Option1", ;
		Option1.Top = 9, ;
		Option1.Value = 1, ;
		Option1.Width = 56, ;
		Option2.AutoSize = .T., ;
		Option2.BackStyle = 0, ;
		Option2.Caption = "Impresora", ;
		Option2.FontName = "MS Sans Serif", ;
		Option2.Height = 15, ;
		Option2.Left = 17, ;
		Option2.Name = "Option2", ;
		Option2.Top = 28, ;
		Option2.Width = 64
		*< END OBJECT: BaseClass="optiongroup" />
	
	PROCEDURE Init
		gn=""
		
	ENDPROC

	PROCEDURE BtnAceptar.Click
		IF ThisForm.Option.Value = 1 
			gn="PANTALLA "
		ENDIF
		IF ThisForm.Option.Value = 2 
			gn="IMPRESORA"
		ENDIF
		ThisForm.Release() 
		
	ENDPROC

	PROCEDURE BtnCancela.Click
		gn=""
		ThisForm.Release() 
	ENDPROC

	PROCEDURE BtnConfigura.Click
		IF TYPE("Otbr.BtnConfiguraPrinter")=="O"
			Otbr.BtnConfiguraPrinter.Click()
		ENDIF
		
	ENDPROC

ENDDEFINE

DEFINE CLASS reporte_excel AS custom 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: angulo
		*m: central_seleccion
		*m: centrar
		*m: centrar_vertical
		*m: color
		*m: columna_final
		*m: crea_hoja_excel
		*m: font
		*m: importa_datos_dbf
		*m: justificar
		*m: lineas_cuadrado
		*m: lineas_division
		*m: linea_arriba
		*m: linea_filas_division
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "reporte_excel"
	*</PropValue>
	
	PROCEDURE angulo
		LPARAMETERS lp_rango
		IF PARAMETERS()=0 OR TYPE("lp_rango")<>"O"
			RETURN 
		ENDIF
		Selection=lp_rango
		
		With Selection
		    .HorizontalAlignment = 1
		    .VerticalAlignment = -4107
		    .WrapText = .F.
		    .Orientation = 90
		    .AddIndent = .F.
		    .IndentLevel = 0
		    .ShrinkToFit = .F.
		    .ReadingOrder = -5002 
		    .MergeCells = .F.
		EndWith
		
		
	ENDPROC

	PROCEDURE central_seleccion
		LPARAMETERS lp_rango
		IF PARAMETERS()=0 OR TYPE("lp_rango")<>"O"
			RETURN 
		ENDIF
		Selection=lp_rango
		With Selection
		    .HorizontalAlignment = 7
		    .VerticalAlignment = -4107
		    .WrapText = .F.
		    .Orientation = 0
		    .AddIndent = .F.
		    .IndentLevel = 0
		    .ShrinkToFit = .F.
		    .ReadingOrder = -5002
		    .MergeCells = .F.
		EndWith
		
	ENDPROC

	PROCEDURE centrar
		LPARAMETERS lp_rango
		IF PARAMETERS()=0 OR TYPE("lp_rango")<>"O"
			RETURN 
		ENDIF
		Selection=lp_rango
		With Selection
		    .HorizontalAlignment = 7
		    .VerticalAlignment = -4107
		    .WrapText = .F.
		    .Orientation = 0
		    .AddIndent = .F.
		    .IndentLevel = 0
		    .ShrinkToFit = .F.
		    .ReadingOrder = -5002
		    .MergeCells = .F.
		ENDWITH
		
		
		
	ENDPROC

	PROCEDURE centrar_vertical
		LPARAMETERS lp_rango
		IF PARAMETERS()=0 OR TYPE("lp_rango")<>"O"
			RETURN 
		ENDIF
		Selection=lp_rango
		With Selection
		    .HorizontalAlignment = 1
		    .VerticalAlignment = -4108
		    .WrapText = .F.
		    .Orientation = 0
		    .AddIndent = .F.
		    .IndentLevel = 0
		    .ShrinkToFit = .F.
		    .ReadingOrder =  -5002 
		    .MergeCells = .F.
		EndWith
	ENDPROC

	PROCEDURE color
		LPARAMETERS lp_rango,lp_numero
		IF PARAMETERS()=0 OR TYPE("lp_rango")<>"O"
			RETURN 
		ENDIF
		
		
		Selection=lp_rango
		With Selection.Interior
		    .ColorIndex = lp_numero
		    .Pattern = 1
		EndWith
		
	ENDPROC

	PROCEDURE columna_final
		LPARAMETERS lp_colini as String, li_nrocol as Integer 
		
		&& Chr(64+1)=A
		&& Chr(64+26)=Z
		
		
		PRIVATE lretu,lletraini,letraeval,lposicion,ln,ldifer1,ldifer2,lletrasres,lcolfin
		STORE 0 TO lposicion,ldifer1,ldifer2,lletrasres
		lletraini=""
		lretu=""
		letraeval=lp_colini
		lletrasres=26
		lcolfin=""
		
		
		IF LEN(ALLTRIM(lp_colini))=2
			lletraini="A"
			letraeval=SUBSTR(lp_colini,2,1)
		ENDIF
		
		FOR ln=1 TO 25
			IF CHR(64+ln)==letraeval
				lposicion=ln
				EXIT
			ENDIF
		ENDFOR
		IF lposicion>1
			lletrasres=lletrasres-lposicion
		ENDIF
		
		IF li_nrocol>lletrasres
			IF li_nrocol<=52
				lletraini="A"
			ELSE
				lletrasres=52
				lletraini="B"
			ENDIF
			ldifer1= li_nrocol - lletrasres
			lcolfin=lletraini+CHR(64+ldifer1)
				
		ELSE
			lcolfin=lletraini+CHR(64+lposicion+(li_nrocol-1))		
		ENDIF
		lretu=lcolfin
		RETURN lretu 
		
		
		
	ENDPROC

	PROCEDURE crea_hoja_excel
		PRIVATE lp_xcm
		
		lp_xcm=CREATEOBJECT("Excel.Application")
		lp_xcm.Workbooks.Add
		
		RETURN lp_xcm 
	ENDPROC

	PROCEDURE font
		LPARAMETERS lp_rango,lp_tipo,lp_tamano,lp_style
		
		IF PARAMETERS()=0 OR TYPE("lp_rango")<>"O"
			RETURN 
		ENDIF
		Selection=lp_rango
		lbold=lp_style
		
		With Selection.Font
		    .Name = lp_tipo
		    .Size = lp_tamano
		    .Strikethrough = .F.
		    .Superscript = .F.
		    .Subscript = .F.
		    .OutlineFont = .F.
		    .Shadow = .F.
		    .Underline = -4142
		    .ColorIndex = -4105 
		    .Bold		= lbold
		EndWith
		
	ENDPROC

	PROCEDURE importa_datos_dbf
		LPARAMETERS lp_hoja as Object , lp_rango as Object , lp_sentencia as String, lp_sourcefileconnection as String   
		
		lcadena=""+;
		"OLEDB;Provider=SQLOLEDB.1;"+;
		"Persist Security Info=True;"+;
		"User ID="+Ocnx.Usuario+";"+;
		"Data Source="+Ocnx.servidor+";"+;
		"Use Procedure for Prepare=1;"+;
		"Auto Translate=True;"+;
		"Packet Size=4096;"+;
		"Use Encryption for Data=False;"+;	
		"Tag with column collation when possible=False;"+;
		"Initial Catalog="+Ocnx.Basedatos+";Password="+ALLTRIM(Ocnx.password)
		
		IF !FILE(lp_sourcefileconnection)
			MESSAGEBOX("No Existe el Archivo: "+NVL(lp_sourcefileconnection,""),16,"Error")
			RETURN .F.
		ENDIF
		
		
		lp_array=lp_hoja.QueryTables.Add(lcadena,lp_rango)
		lp_array.CommandType= 2  && xlCmdSql 
		lp_array.CommandText =lp_sentencia
		lp_array.Name ="Consulta OSIS"
		lp_array.FieldNames = .T.
		lp_array.RowNumbers = .F.
		lp_array.FillAdjacentFormulas = .F.
		lp_array.PreserveFormatting = .T.
		lp_array.RefreshOnFileOpen = .F.
		lp_array.BackgroundQuery = .T.
		lp_array.RefreshStyle = 1  && xlInsertDeleteCells
		lp_array.SavePassword = .F.
		lp_array.SaveData = .T.
		lp_array.AdjustColumnWidth = .T.
		lp_array.RefreshPeriod = 0
		lp_array.PreserveColumnInfo = .T.
		lp_array.SourceConnectionFile = lp_sourcefileconnection
		WAIT WINDOW "Ejecutando Sentencia SQL con OLEDB....." NOWAIT 
		lp_array.Refresh(.F.)
		WAIT CLEAR 
		
		*!*	.CommandType = xlCmdSql
		*!*	.CommandText = Array("Select * From dbo.ZONA_VENTA_ZVE")
		*!*	.Name = "servidor PROCHETSA ZONA_VENTA_ZVE"
		*!*	.FieldNames = True
		*!*	.RowNumbers = False
		*!*	.FillAdjacentFormulas = False
		*!*	.PreserveFormatting = True
		*!*	.RefreshOnFileOpen = False
		*!*	.BackgroundQuery = True
		*!*	.RefreshStyle = xlInsertDeleteCells
		*!*	.SavePassword = False
		*!*	.SaveData = True
		*!*	.AdjustColumnWidth = True
		*!*	.RefreshPeriod = 0
		*!*	.PreserveColumnInfo = True
		*!*	.SourceConnectionFile = _
		*!*	"C:\Documents and Settings\Epalomino\Mis documentos\Mis archivos de origen de datos\servidor PROCHETSA ZONA_VENTA_ZVE.odc"
		*!*	.Refresh BackgroundQuery:=False
		
	ENDPROC

	PROCEDURE justificar
		LPARAMETERS lp_rango
		IF PARAMETERS()=0 OR TYPE("lp_rango")<>"O"
			RETURN 
		ENDIF
		Selection=lp_rango
		
		With Selection
		    .HorizontalAlignment = -4130 
		    .VerticalAlignment = -4107
		    .WrapText = .F.
		    .AddIndent = .F.
		    .ShrinkToFit = .F.
		    .ReadingOrder =  -5002
		    .MergeCells = .F.
		EndWith
		
	ENDPROC

	PROCEDURE lineas_cuadrado
		LPARAMETERS lp_rango
		
		IF PARAMETERS()=0 OR TYPE("lp_rango")<>"O"
			RETURN 
		ENDIF
		
		*-------------------
		
		#Define xlDiagonalDown  5
		#Define xlDiagonalUp 	6
		#Define xlEdgeBottom 	9
		#Define xlEdgeLeft	7
		#Define xlEdgeRight	 10
		#Define xlEdgeTop	 8
		#Define xlInsideHorizontal 12
		#Define xlInsideVertical 11
		
		#Define xlContinuous  1
		#Define xlDash	-4115
		#Define xlDashDot  4
		#Define xlDashDotDot 	5
		#Define xlDot 	-4118
		#Define xlDouble  -4119
		#Define xlLineStyleNone	-4142
		#Define xlSlantDashDot	 13
		
		#Define xlHairline	 1
		#Define xlMedium	 -4138
		#Define xlThick	 4
		#Define xlThin	 2
		
		#Define xlAutomatic -4105
		
		#Define xlNone	-4142
		#Define xlDown	-4121
		
		
		*------
		Selection = lp_rango
		
		Selection.Borders(xlDiagonalDown).LineStyle = xlNone
		Selection.Borders(xlDiagonalUp).LineStyle = xlNone
		With Selection.Borders(xlEdgeLeft)
		    .LineStyle = xlContinuous
		    .Weight = xlThin
		    .ColorIndex = xlAutomatic
		EndWith
		With Selection.Borders(xlEdgeTop)
		    .LineStyle = xlContinuous
		    .Weight = xlThin
		    .ColorIndex = xlAutomatic
		EndWith
		With Selection.Borders(xlEdgeBottom)
		    .LineStyle = xlContinuous
		    .Weight = xlThin
		    .ColorIndex = xlAutomatic
		EndWith
		With Selection.Borders(xlEdgeRight)
		    .LineStyle = xlContinuous
		    .Weight = xlThin
		    .ColorIndex = xlAutomatic
		EndWith
		Selection.Borders(xlInsideVertical).LineStyle = xlNone
		
	ENDPROC

