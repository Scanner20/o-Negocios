		ENDIF
		
	ENDPROC

	PROCEDURE Cnt_Proceso_Migracion.Resize
		This.Top    = This.parent.Cnt_Contenedor.Top
		This.Left   = This.parent.Cnt_Contenedor.Left
		This.Height = This.parent.Cnt_Contenedor.Height
		This.Width  = This.Parent.Cnt_Contenedor.Width
		This.Grd_Examinar.Width = This.Width - 8
		This.Lbl_Titulo_Migracion.Width = This.Grd_Examinar.Width
		This.Shp_Tabla_Migracion.Width  = This.Grd_Examinar.Width
		
		This.Grd_Examinar.Height = This.Height - ;
			(This.lbl_titulo_Migracion.Height + This.lbl_origen_Migracion.Height +;
			 This.shp_origen_Migracion.Height + This.shp_tabla_Migracion.Height) - 150
		
		This.grd_Configura_Campos.Top   = (This.Grd_Examinar.top + This.Grd_Examinar.Height) + 1
		This.grd_Configura_Campos.Width = This.Width - This.clS_PROGRESO.Width - 10
		 
		This.grd_Configura_Campos.Height = (This.Height - ;
			(This.lbl_titulo_Migracion.Height + This.lbl_origen_Migracion.Height +;
			 This.shp_origen_Migracion.Height + This.shp_tabla_Migracion.Height + This.Grd_Examinar.Height) - 11)
		
		This.grd_Configura_Campos.column5.Width = (This.grd_Configura_Campos.Width - ;
												   This.grd_Configura_Campos.column1.Width - ;
												   This.grd_Configura_Campos.column2.Width - ;
												   This.grd_Configura_Campos.column3.Width - ;
												   This.grd_Configura_Campos.column4.Width) - 40
		
		This.cmd_Exportar.Top = (This.grd_Configura_Campos.Top + This.grd_Configura_Campos.Height) - This.cmd_Exportar.Height
		This.cmd_Retornar.Top = This.cmd_Exportar.Top
		
		This.clS_PROGRESO.Top  = This.grd_Configura_Campos.Top
		This.clS_PROGRESO.Left = (This.Width - This.clS_PROGRESO.Width) - 5
		
		This.cmd_Retornar.Left = This.Width - This.cmd_Retornar.Width - 100
		This.cmd_Exportar.Left = This.Width - This.cmd_Retornar.Width - This.cmd_Exportar.Width - 110
		
		
		*!*	This.cmd_Exportar.Left = This.Width - This.cmd_Exportar.Width - 100
		*!*	This.cmd_Retornar.Left = This.Width - This.cmd_Exportar.Width - This.cmd_Retornar.Width - 110
		
		
		
	ENDPROC

