	ENDPROC

	PROCEDURE mh_objetos_miembros_formulario
		***======================================================================================================
		*** Configura los objetos miembros del formulario
		***======================================================================================================
		This.ph_s_nombre_control_statusbar = ""
		Ps_Objeto_Nivel_0 = "Thisform"
		AMEMBERS(Pa_Array_Objetos,EVALUATE(Ps_Objeto_Nivel_0),2)
		FOR pn_contador=1 TO ALEN(Pa_Array_Objetos,1)
			Po_Objeto = UPPER(ALLTRIM(Pa_Array_Objetos(1,pn_contador)))
			IF UPPER(ALLTRIM(Po_Objeto))<>"OBJECT"
			    Ps_Objeto_Nivel_1 = Ps_Objeto_Nivel_0 + "." + Po_Objeto
			    Ps_BaseClass      = UPPER(ALLTRIM(EVALUATE(Ps_Objeto_Nivel_1 + "." + "BaseClass")))
			    Ps_Class          = UPPER(ALLTRIM(EVALUATE(Ps_Objeto_Nivel_1 + "." + "Class")))
			    Ps_ParentClass    = UPPER(ALLTRIM(EVALUATE(Ps_Objeto_Nivel_1 + "." + "ParentClass")))
				IF Ps_BaseClass=="OLECONTROL" AND Ps_Class=="OLECONTROL"
					This.ph_s_nombre_control_statusbar = Ps_Objeto_Nivel_1
				ENDIF
			ENDIF
		ENDFOR
		
	ENDPROC

	PROCEDURE mh_proceso_abrir_tabla_dbf
		***======================================================================================================
		*** Abrir - Use tabla DBF
		***======================================================================================================
		PRIVATE PS_Nombre_Archivo,PS_Objeto_Archivo,PN_Tamano_Archivo,PS_Cadena_Texto
		STORE "" TO PS_Nombre_Archivo,PS_Objeto_Archivo,PS_Cadena_Texto
		STORE 0 TO PN_Tamano_Archivo
		This.mh_inicializa_ejecuta_consulta()
		
		This.ph_s_ruta_nombre_archivo = ""
		ps_directorio = ALLTRIM(This.userp_directorio_dbf)
		IF !EMPTY(ALLTRIM(ps_directorio))
			ps_default_tabla_dbf = ALLTRIM(This.ph_s_curdir) + ps_directorio
			IF DIRECTORY(ps_default_tabla_dbf)
				SET DEFAULT TO (ps_default_tabla_dbf)
			ENDIF
		ENDIF
		This.ph_s_ruta_nombre_archivo = ALLTRIM(UPPER(GETFILE("DBF","Tabla Dbf","Abrir",1,"Seleccione la tabla Dbf")))
		IF EMPTY(ALLTRIM(This.ph_s_ruta_nombre_archivo))
			RETURN
		ENDIF
		PS_Nombre_Archivo=This.ph_s_ruta_nombre_archivo
		IF USED("CUR_DATOS")
			USE IN "CUR_DATOS"
		ENDIF
		ps_macro = "USE '" + PS_Nombre_Archivo + "' IN 0 EXCLU ALIAS CUR_DATOS"
		&ps_macro
		
		this.mh_registros_totales_consulta()
		This.mh_registros_campos_consulta()
		
		SELECT "CUR_DATOS"
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.RecordSource = "CUR_DATOS"
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.AfterRowColChange()
		This.Cnt_Proceso_Migracion.Grd_Examinar.RecordSource = "CUR_DATOS"
		This.Cnt_Proceso_Migracion.Grd_Examinar.AfterRowColChange()
		IF ALLTRIM(This.ph_s_verision_visual_vfp)>="08"
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.AutoFit()
			This.Cnt_Proceso_Migracion.Grd_Examinar.AutoFit()
		ENDIF
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.Refresh()
		This.Cnt_Proceso_Migracion.Grd_Examinar.Refresh()
		
		
		
		
		
		
	ENDPROC

	PROCEDURE mh_proceso_coneccion_base_datos
		***======================================================================================================
		*** Proceso de conexión a la base de datos
		***======================================================================================================
		PARAMETERS p_accion
		This.Cnt_Contenedor.Opt_Acciones.Refresh()
		
		***--- Cancelar
		IF p_accion=="0"
			This.Cnt_Coneccion_Base_Datos.Txt_Servidor.Value        = This.ph_s_servidor
			This.Cnt_Coneccion_Base_Datos.Txt_Base_datos_ODBC.Value = This.ph_s_odbc_BDatos
			This.Cnt_Coneccion_Base_Datos.Txt_Usuario.Value         = This.ph_s_usuario
			This.Cnt_Coneccion_Base_Datos.Txt_Contrasena.Value      = This.ph_s_contrasena
			This.Cnt_Coneccion_Base_Datos.Visible = .f.
			This.Cnt_Contenedor.Visible = .t.
		ENDIF
		
		***--- Aceptar
		IF p_accion=="1"
			This.ph_s_servidor    = ALLTRIM(This.Cnt_Coneccion_Base_Datos.Txt_Servidor.Value)
			This.ph_s_odbc_BDatos = ALLTRIM(This.Cnt_Coneccion_Base_Datos.Txt_Base_datos_ODBC.Value)
			This.ph_s_usuario     = ALLTRIM(This.Cnt_Coneccion_Base_Datos.Txt_Usuario.Value)
			This.ph_s_contrasena  = ALLTRIM(This.Cnt_Coneccion_Base_Datos.Txt_Contrasena.Value)
			***---validaciones: Nombre del Servidor
			IF This.Cnt_Coneccion_Base_Datos.Opt_Tipo_Conexion.Conexion_Directo.Value = 1
				IF EMPTY(This.ph_s_servidor)
					MESSAGEBOX("Ingrese el nombre del Servidor",64,"Conexión a la base de datos")
					This.Cnt_Coneccion_Base_Datos.Txt_Servidor.SetFocus()
					RETURN .F.
				ENDIF
			ENDIF
			***---validaciones: Nombre del origen de datos ODBC
			IF EMPTY(This.ph_s_odbc_BDatos)
				ps_mensaje = "Ingrese el nombre del origen de datos ODBC"
				IF This.Cnt_Coneccion_Base_Datos.Opt_Tipo_Conexion.Conexion_Directo.Value = 1
					ps_mensaje = "Ingrese el nombre de la base de datos"
				ENDIF
				MESSAGEBOX(ps_mensaje,64,"Conexión a la base de datos")
				This.Cnt_Coneccion_Base_Datos.Txt_Base_datos_ODBC.SetFocus()
				RETURN .F.
			ENDIF
			***---validaciones: Nombre del Usuario de la base de datos
			IF EMPTY(This.ph_s_usuario)
				MESSAGEBOX("Ingrese el usuario de la base de datos",64,"Conexión a la base de datos")
				This.Cnt_Coneccion_Base_Datos.Txt_Usuario.SetFocus()
				RETURN .F.
			ENDIF
			***---validaciones: Contraseña del Usuario
			IF EMPTY(This.ph_s_contrasena)
				MESSAGEBOX("Ingrese la contraseña del usuario",64,"Conexión a la base de datos")
				This.Cnt_Coneccion_Base_Datos.Txt_Contrasena.SetFocus()
				RETURN .F.
			ENDIF
			IF (UPPER(ALLTRIM(This.ph_s_servidor))    == UPPER(ALLTRIM(This.ph_s_servidor_imagen)) AND;
			    UPPER(ALLTRIM(This.ph_s_odbc_BDatos)) == UPPER(ALLTRIM(This.ph_s_odbc_BDatos_imagen)) AND;
			    UPPER(ALLTRIM(This.ph_s_usuario))     == UPPER(ALLTRIM(This.ph_s_usuario_imagen)) AND;
			    UPPER(ALLTRIM(This.ph_s_contrasena))  == UPPER(ALLTRIM(This.ph_s_contrasena_imagen)))
				This.ph_l_cambio_origen_de_datos = .F.
			ELSE
				This.ph_l_cambio_origen_de_datos = .T.
				SELECT "CUR_TABLAS"
				ZAP
				This.Cnt_Disenador_Relacion.Grd_Tablas_Seleccionadas.AfterRowColChange()
				This.Cnt_Contenedor.Cnt_Relacion_Tablas.Grd_Tablas.AfterRowColChange()
				
			ENDIF
			***--- Desconecta conexión de Migración
			This.mh_proceso_migracion_desconexion_base_datos()
			This.ph_l_migracion_exito_conexion = .f.
			This.Cnt_Proceso_Migracion.Txt_Servidor_Destino.Value = ""
			This.Cnt_Proceso_Migracion.Txt_Base_Datos_ODBC_Destino.Value = ""
			This.Cnt_Proceso_Migracion.Txt_Usuario_Destino.Value = ""
			This.Cnt_Proceso_Migracion.Txt_Contrasena_Destino.Value = ""
			This.ph_s_migracion_servidor    = ""
			This.ph_s_migracion_odbc_BDatos = ""
			This.ph_s_migracion_usuario     = ""
			This.ph_s_migracion_contrasena  = ""
			This.Cnt_Proceso_Migracion.Opt_Conexion_Migracion.Conexion.Value        = 0
			This.Cnt_Proceso_Migracion.Opt_Conexion_Migracion.Nueva_Conexion.Value  = 1
			This.Cnt_Proceso_Migracion.Opt_Conexion_Migracion.Nueva_Conexion.Click()
			This.Cnt_Proceso_Migracion.opt_Tipo_Conexion.conexion_Directo.Value     = 0
			This.Cnt_Proceso_Migracion.opt_Tipo_Conexion.Referencia_Origen.Value      = 0
			This.Cnt_Proceso_Migracion.opt_Tipo_Conexion.conexion_Origen_ODBC.Value = 1
			
			***--- Desconecta conexión Origen
			this.mh_desconexion_base_datos()
			This.ph_l_exito_conexion = .f.
			IF This.Cnt_Coneccion_Base_Datos.Opt_Tipo_Conexion.Conexion_Origen_ODBC.Value = 1
				***--- conexión por ORIGEN DE DATOS ODBC
				This.conexion = SQLCONNECT(This.ph_s_odbc_BDatos,This.ph_s_usuario,This.ph_s_contrasena)
			ELSE
				***--- Conexión DIRECTA POR CODIGO - servidor
				ps_cadena_ocnx="driver=SQL Server;server="+ALLTRIM(This.ph_s_servidor)+;
		   		               ";database="+ALLTRIM(This.ph_s_odbc_BDatos)+";uid="+ALLTRIM(This.ph_s_usuario)+;
		   		               ";pwd="+ALLTRIM(This.ph_s_contrasena) 		  
				This.Conexion=SQLSTRINGCONNECT(ps_cadena_ocnx)
			ENDIF		
			IF This.conexion < 1
				MESSAGEBOX("Error en la conexión a la base de datos"+CHR(13)+MESSAGE(),16,"Conexión a Base de Datos")
				RETURN .F.
			ENDIF
			This.ph_l_exito_conexion = .t.
			This.ph_s_servidor_imagen    = This.ph_s_servidor
			This.ph_s_odbc_BDatos_imagen = This.ph_s_odbc_BDatos
			This.ph_s_usuario_imagen     = This.ph_s_usuario
			This.ph_s_contrasena_imagen  = This.ph_s_contrasena
		
			This.Cnt_Coneccion_Base_Datos.Visible = .f.
			This.Cnt_Contenedor.Visible = .t.
		ENDIF
		this.BackColor = this.ph_n_backcolor_original
		
		
	ENDPROC

	PROCEDURE mh_proceso_ejecuta_cadena_sql
		***======================================================================================================
		*** Ejecuta la cadena SQL - Devuelve cursor de datos
		***======================================================================================================
		This.mh_inicializa_ejecuta_consulta()
		IF !This.mh_verifica_conexion_base_datos()
			RETURN .f.
		ENDIF
		PRIVATE ps_cadena
		ps_cadena=""
		ps_cadena=ALLTRIM(This.Cnt_Contenedor.Edt_Cadena_SQL.Value)
		IF EMPTY(ps_cadena)
			MESSAGEBOX("Ingrese la cadena SQL",64,"Ejecuta Cadena SQL")
			RETURN .f.
		ENDIF
		
		WAIT WINDOW "Procesando la consulta en el origen de datos : [ " + this.ph_s_odbc_bdatos + "]" +CHR(13)+;
					"Sirvase esperar ...!!!" NOWAIT
		IF SQLEXEC(this.conexion,ps_cadena,"CUR_DATOS")<1
			MESSAGEBOX("Error al ejecutar la consulta de datos"+CHR(13)+MESSAGE(),16,"Ejecuta Cadena SQL")
			RETURN .F.
		ENDIF
		this.mh_registros_totales_consulta()
		This.mh_registros_campos_consulta()
		
		SELECT "CUR_DATOS"
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.RecordSource = "CUR_DATOS"
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.AfterRowColChange()
		This.Cnt_Proceso_Migracion.Grd_Examinar.RecordSource = "CUR_DATOS"
		This.Cnt_Proceso_Migracion.Grd_Examinar.AfterRowColChange()
		IF ALLTRIM(This.ph_s_verision_visual_vfp)>="08"
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.AutoFit()
			This.Cnt_Proceso_Migracion.Grd_Examinar.AutoFit()
		ENDIF
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.Refresh()
		This.Cnt_Proceso_Migracion.Grd_Examinar.Refresh()
		
		
	ENDPROC

	PROCEDURE mh_proceso_grabar_abrir_consulta
		***======================================================================================================
		*** Grabar / Abrir : Consulta
		***======================================================================================================
		PARAMETERS P_ACCION
		IF P_ACCION<>"1" AND P_ACCION<>"0"
			RETURN .F.
		ENDIF
		PRIVATE PS_Nombre_Archivo,PS_Objeto_Archivo,PN_Tamano_Archivo,PS_Cadena_Texto
		STORE "" TO PS_Nombre_Archivo,PS_Objeto_Archivo,PS_Cadena_Texto
		STORE 0 TO PN_Tamano_Archivo
		This.ph_s_ruta_nombre_archivo = ""
		ps_directorio = ALLTRIM(This.userp_directorio_consultas)
		IF !EMPTY(ALLTRIM(ps_directorio))
			ps_default_graficos = ALLTRIM(This.ph_s_curdir) + ps_directorio
			IF DIRECTORY(ps_default_graficos)
				SET DEFAULT TO (ps_default_graficos)
			ENDIF
		ENDIF
		DO CASE
			CASE P_ACCION=="1"
				IF EMPTY(ALLTRIM(This.Cnt_Contenedor.Edt_Cadena_SQL.Value))
					MESSAGEBOX("No se ha definido la cadena de consulta a guardar. verifique...!!!",64,"CADENA SQL DE CONSULTA")
					RETURN .F.
				ENDIF
				This.ph_s_ruta_nombre_archivo = PUTFILE("Grabar Consulta","","TXT")
				IF !EMPTY(ALLTRIM(This.ph_s_ruta_nombre_archivo))
					PS_Nombre_Archivo=This.ph_s_ruta_nombre_archivo		
					PS_Objeto_Archivo=fcreate(PS_Nombre_Archivo,0)
					IF PS_Objeto_Archivo<0
						MESSAGEBOX("Error al crear el archivo de consulta : " + PS_Nombre_Archivo,16,"CREA ARCHIVO DE CONSULTA")
						RETURN .F.
					ENDIF
					PS_Cadena_Texto = ALLTRIM(This.Cnt_Contenedor.Edt_Cadena_SQL.Value)
					=fput(PS_Objeto_Archivo,PS_Cadena_Texto)
					=fclose(PS_Objeto_Archivo)
				ENDIF
			
			CASE P_ACCION=="0"
				This.ph_s_ruta_nombre_archivo = ALLTRIM(UPPER(GETFILE("TXT","Consulta","Abrir",1,"Seleccione Origen de la Consulta")))
				IF !EMPTY(ALLTRIM(This.ph_s_ruta_nombre_archivo))
					PS_Nombre_Archivo=This.ph_s_ruta_nombre_archivo
					PS_Objeto_Archivo=FOPEN(PS_Nombre_Archivo)
					IF PS_Objeto_Archivo<0
						MESSAGEBOX("Error al abrir el archivo de consulta : " + PS_Nombre_Archivo,16,"ABRIR ARCHIVO CONSULTA")
						RETURN .F.
					ENDIF
					PN_Tamano_Archivo =  FSEEK(PS_Objeto_Archivo, 0, 2)     && Move pointer to EOF
					IF PN_Tamano_Archivo <= 0
						MESSAGEBOX("El archivo de consulta esta vacio : " + PS_Nombre_Archivo,16,"ARCHIVO CONSULTA - VACIO")
						RETURN .F.
					ELSE
						=FSEEK(PS_Objeto_Archivo, 0, 0)      				&& Move pointer to BOF
						PS_Cadena_Texto = FREAD(PS_Objeto_Archivo, PN_Tamano_Archivo)
					ENDIF
					=fclose(PS_Objeto_Archivo)
					This.Cnt_Contenedor.Edt_Cadena_SQL.Value = ALLTRIM(PS_Cadena_Texto)
				ENDIF	
		ENDCASE
		
	ENDPROC

	PROCEDURE mh_proceso_migracion_base_datos
		***======================================================================================================
		***--- Migración de base de datos
		***--- Los resultados de la consulta se migran a otra base de datos
		***--- P_ACCION:
		***--- 0 = Volver a la pantalla principal
		***--- 1 = Ejecuta proceso de migración
		***======================================================================================================
		PARAMETERS P_ACCION
		****--- Volver a la pantalla principal
		IF P_ACCION=="0"
			This.Cnt_Proceso_Migracion.Visible = .F.
			This.Cnt_Proceso_Migracion.Grd_Examinar.Visible = .F.
			This.Cnt_Contenedor.Visible = .T.
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Visible = .t.
			This.BackColor = this.ph_n_backcolor_original
			RETURN
		ENDIF
		
		ps_cod_usuario = This.ph_s_migracion_usuario
		SELECT "CUR_DATOS"
		GO TOP
		ps_nombre_tabla = ALLTRIM(NVL(This.Cnt_Proceso_Migracion.Cbo_Tabla_Nombre_Migracion.Value,''))
		ps_propietario  = ALLTRIM(NVL(This.Cnt_Proceso_Migracion.Txt_Tabla_Propietario_Migracion.Value,''))
		ps_tipo_origen  = ALLTRIM(NVL(This.Cnt_Proceso_Migracion.Txt_Tabla_Tipo_Migracion.Value,''))
		
		ps_macro_tabla  = "<TABLA>."
		***--- Arma cadenas de campos
		PRIVATE ps_nombre_campo,ps_cadena_campo,ps_cadena_tabla_campo
		PRIVATE ps_cadena_insert_into,ps_cadena_update,ps_cadena_campo_actualiza
		PRIVATE ps_INSERT_INTO,ps_UPDATE,ps_DELETE,ps_BUSCA_PK
		STORE "" TO ps_nombre_campo,ps_cadena_campo,ps_cadena_tabla_campo,ps_cadena_campo_actualiza
		STORE "" TO ps_cadena_insert_into,ps_cadena_update
		STORE "" TO ps_INSERT_INTO,ps_UPDATE,ps_DELETE,ps_BUSCA_PK
		SELECT "CUR_INDICES"
		GO TOP
		SCAN
			ps_nombre_campo       = UPPER(ALLTRIM(NVL(CUR_INDICES.cur_nomcam,'')))
			ps_tipo_dato          = UPPER(ALLTRIM(NVL(CUR_INDICES.cur_tipdad,'')))
			ps_configura_nulo     = NVL(CUR_INDICES.cur_cfgnul,0)
			ps_no_actualizable    = NVL(CUR_INDICES.cur_notact,0)
			ps_valor_por_defecto  = ALLTRIM(NVL(CUR_INDICES.cur_valdft,''))
			ps_cadena_campo       = ps_cadena_campo + ps_nombre_campo + ","
			ps_valor_campo        = ps_macro_tabla + ps_nombre_campo
			IF ((RIGHT(ps_nombre_campo,7)=="_CODUSU" OR RIGHT(ps_nombre_campo,7)=="_FECACT" OR ;
				 RIGHT(ps_nombre_campo,7)=="_USUMOD" OR RIGHT(ps_nombre_campo,7)=="_FECMOD") AND;
				(ps_configura_nulo = 0 AND EMPTY(ALLTRIM(ps_valor_por_defecto))))
				ps_valor_campo    = IIF(RIGHT(ps_nombre_campo,7)=="_CODUSU", "'" + ps_cod_usuario + "'",;
									IIF(RIGHT(ps_nombre_campo,7)=="_FECACT", "GETDATE()",;
									IIF(RIGHT(ps_nombre_campo,7)=="_USUMOD", "'" + ps_cod_usuario + "'",;
									IIF(RIGHT(ps_nombre_campo,7)=="_FECMOD", "GETDATE()",""))))
			ENDIF
			IF ps_configura_nulo = 1
				ps_valor_campo    = "NULL"
			ENDIF
			IF !EMPTY(ALLTRIM(ps_valor_por_defecto))
				ps_valor_campo    = IIF(ps_tipo_dato=="C", ps_valor_por_defecto, ps_valor_por_defecto)
			ENDIF
			IF ps_no_actualizable = 1
				***--- esta marcado como no actualizable. entonces no se adiciona a la cadena SQL
			ELSE
				***--- si es actualizable : insert, update
				ps_cadena_campo_actualiza = ps_cadena_campo_actualiza + ps_nombre_campo + ","
				ps_cadena_insert_into     = ps_cadena_insert_into + ps_valor_campo  + ","
				ps_cadena_update          = ps_cadena_update      + ps_nombre_campo + "=" + ps_valor_campo + ","
			ENDIF
			SELECT "CUR_INDICES"
		ENDSCAN
		GO TOP
		***--- arma cadena de campos llaves pk
		PRIVATE ps_cadena,ps_cadena_llaves,ps_campos_llaves,ps_valor_campo
		STORE "" TO ps_cadena,ps_cadena_llaves,ps_campos_llaves,ps_valor_campo
		ps_cadena="sp_pkeys " + ps_nombre_tabla
		IF SQLEXEC(This.Conexion,ps_cadena,"tmpval")<1
			MESSAGEBOX("Error al Ejecutar consulta de Llaves PK"+CHR(13)+MESSAGE(),16,"Consulta Llave PK")
			RETURN .f.
		ENDIF
		SELECT "tmpval"
		GO TOP
		SCAN
			ps_campo_pk      = UPPER(ALLTRIM(NVL(tmpval.column_name,'')))
			ps_valor_campo   = ps_macro_tabla + ps_campo_pk
			SELECT "CUR_INDICES"
			GO TOP
			SET FILTER TO UPPER(ALLTRIM(NVL(CUR_INDICES.cur_nomcam,'')))==UPPER(ALLTRIM(NVL(tmpval.column_name,'')))
			GO TOP
			ps_valor_por_defecto = ALLTRIM(NVL(CUR_INDICES.cur_valdft,''))
			ps_valor_campo   = IIF(!EMPTY(ps_valor_por_defecto),ps_valor_por_defecto,ps_valor_campo)
			ps_cadena_llaves = ps_cadena_llaves + ps_campo_pk + "=" + ps_valor_campo + " AND "
			ps_campos_llaves = ps_campos_llaves + ps_campo_pk + ","
			SELECT "tmpval"
		ENDSCAN
		SELECT "CUR_INDICES"
		SET FILTER TO
		GO TOP
		IF LEN(ALLTRIM(ps_cadena_llaves))==0
			this.ph_s_mensaje_error_sql = "Error: La tabla no tiene campos llaves - PK" +CHR(13)+;
										  "Tabla                          : " + ps_nombre_tabla+CHR(13)+;
										  "Servidor origen          : "        + This.ph_s_servidor+CHR(13)+;
										  "Base de datos origen : "            + this.ph_s_odbc_bdatos
			IF MESSAGEBOX("La tabla no tiene campos de llaves primarios PK. en la base de datos de ORIGEN"+CHR(13)+;
						  "Desea proceder a buscar los campos llaves en la tabla de base de datos de destino"+CHR(13)+;
						  "Tabla                            : " + ps_nombre_tabla+CHR(13)+;
						  "Servidor destino           : "       + This.ph_s_migracion_servidor+CHR(13)+;
						  "Base de datos Destino : "            + this.ph_s_migracion_odbc_bdatos,36,"Llaves de la tabla")<>6
				RETURN .f.
			ENDIF
			***--- Si no se detecta los campos llaves en la tabla de origen, se busca las llaves en la tabla de destino
			***--- servidor y base de datos de destino
			PRIVATE ps_cadena,ps_cadena_llaves,ps_campos_llaves,ps_valor_campo
			STORE "" TO ps_cadena,ps_cadena_llaves,ps_campos_llaves,ps_valor_campo
			ps_cadena="sp_pkeys " + ps_nombre_tabla
			IF SQLEXEC(This.Migracion_Conexion,ps_cadena,"tmpval")<1
				MESSAGEBOX("Error al Ejecutar consulta de Llaves PK"+CHR(13)+MESSAGE(),16,"BASE DATOS DESTINO - Consulta Llave PK")
				RETURN .f.
			ENDIF
			SELECT "tmpval"
			GO TOP
			SCAN
				ps_campo_pk      = UPPER(ALLTRIM(NVL(tmpval.column_name,'')))
				ps_valor_campo   = ps_macro_tabla + ps_campo_pk
				SELECT "CUR_INDICES"
				GO TOP
				SET FILTER TO UPPER(ALLTRIM(NVL(CUR_INDICES.cur_nomcam,'')))==UPPER(ALLTRIM(NVL(tmpval.column_name,'')))
				GO TOP
				ps_valor_por_defecto = ALLTRIM(NVL(CUR_INDICES.cur_valdft,''))
				ps_valor_campo   = IIF(!EMPTY(ps_valor_por_defecto),ps_valor_por_defecto,ps_valor_campo)
				ps_cadena_llaves = ps_cadena_llaves + ps_campo_pk + "=" + ps_valor_campo + " AND "
				ps_campos_llaves = ps_campos_llaves + ps_campo_pk + ","
				SELECT "tmpval"
			ENDSCAN
			SELECT "CUR_INDICES"
			SET FILTER TO
			GO TOP
			IF LEN(ALLTRIM(ps_cadena_llaves))==0
				this.ph_s_mensaje_error_sql = "Error: La tabla no tiene campos llaves - PK" +CHR(13)+;
											  "TABLA :   " + ps_nombre_tabla+CHR(13)+;
											  "SE BUSCO EN BASE DE DATOS DESTINO Y TAMPOCO TIENE LLAVES...!!!"
				RETURN .F.
			ENDIF
		ENDIF
		
		ps_cadena_llaves          = SUBSTR(ALLTRIM(ps_cadena_llaves),1,LEN(ALLTRIM(ps_cadena_llaves))-4)
		ps_cadena_llaves          = STRTRAN(ps_cadena_llaves,"<TABLA>.","?CUR_DATOS.")
		ps_campos_llaves          = SUBSTR(ALLTRIM(ps_campos_llaves),1,LEN(ALLTRIM(ps_campos_llaves))-1)
		***--- Arma cadenas INSERT, UPDATE, DELETE
		ps_cadena_campo           =SUBSTR(ALLTRIM(ps_cadena_campo),1,LEN(ALLTRIM(ps_cadena_campo))-1)
		ps_cadena_campo_actualiza = SUBSTR(ALLTRIM(ps_cadena_campo_actualiza),1,LEN(ALLTRIM(ps_cadena_campo_actualiza))-1)
		ps_cadena_insert_into     =SUBSTR(ALLTRIM(ps_cadena_insert_into),1,LEN(ALLTRIM(ps_cadena_insert_into))-1)
		ps_cadena_insert_into     =STRTRAN(ps_cadena_insert_into,"<TABLA>.","?CUR_DATOS.")
		ps_cadena_update          =SUBSTR(ALLTRIM(ps_cadena_update),1,LEN(ALLTRIM(ps_cadena_update))-1)
		ps_cadena_update          =STRTRAN(ps_cadena_update,"<TABLA>.","?CUR_DATOS.")
		IF !EMPTY(ALLTRIM(ps_cadena_insert_into))
			***ps_INSERT_INTO=               " INSERT INTO " + ps_propietario + "." + ps_nombre_tabla + " (" + ps_cadena_campo + ") "
			ps_INSERT_INTO=               " INSERT INTO " + ps_propietario + "." + ps_nombre_tabla + " (" + ps_cadena_campo_actualiza + ") "
			ps_INSERT_INTO=ps_INSERT_INTO+" VALUES (" + ps_cadena_insert_into + ") "
		ENDIF
		IF !EMPTY(ALLTRIM(ps_cadena_update))
			ps_UPDATE     =               " UPDATE " + ps_propietario + "." + ps_nombre_tabla + " SET "
			ps_UPDATE     =ps_UPDATE     +  ps_cadena_update
			ps_UPDATE     =ps_UPDATE     +" WHERE " + ps_cadena_llaves
		ENDIF
		IF (!EMPTY(ALLTRIM(ps_campos_llaves)) AND !EMPTY(ALLTRIM(ps_propietario)) AND;
		    !EMPTY(ALLTRIM(ps_nombre_tabla)) AND !EMPTY(ALLTRIM(ps_cadena_llaves)))
			ps_BUSCA_PK=            " SELECT " + ps_campos_llaves + " FROM " + ps_propietario + "." + ps_nombre_tabla
			ps_BUSCA_PK=ps_BUSCA_PK+" WHERE " + ps_cadena_llaves
		ENDIF
		ps_DELETE="X"
		IF (EMPTY(ALLTRIM(ps_INSERT_INTO)) OR EMPTY(ALLTRIM(ps_UPDATE)) OR EMPTY(ALLTRIM(ps_DELETE)) OR;
		    EMPTY(ALLTRIM(ps_BUSCA_PK)))
			RETURN .f.
		ENDIF
		
		
		*!*	MESSAGEBOX("Cadena Insert Into"+CHR(13)+ps_INSERT_INTO)
		*!*	MESSAGEBOX("Cadena Update"+CHR(13)+ps_UPDATE)
		*!*	MESSAGEBOX("Cadena Busca Llave PK"+CHR(13)+ps_BUSCA_PK)
		
		*!*	RETURN
		
		
		
		this.ph_s_mensaje_error_sql = ""		
		SELECT "CUR_DATOS"
		GO TOP
		COUNT TO pn_registros
		GO TOP
		SCAN
			This.Cnt_Proceso_Migracion.Cls_progreso.ejecuta("Procesando. Sirvase esperar...!!! ",pn_registros,"F")
			IF SQLEXEC(This.Migracion_Conexion,ps_BUSCA_PK,"tmpval")<1
				this.ph_s_mensaje_error_sql = "Error al Ejecutar consulta - Busca si ya existe llave PK"+CHR(13)+MESSAGE()
				RETURN .f.
			ENDIF
			IF EOF("tmpval")
				IF SQLEXEC(This.Migracion_Conexion,ps_INSERT_INTO)<1
					this.ph_s_mensaje_error_sql = "Error al INSERTAR registros en la tabla : < " + ps_nombre_tabla + " >"+CHR(13)+;
							   					  MESSAGE()
					RETURN .f.
				ENDIF
			ELSE
				IF SQLEXEC(This.Migracion_Conexion,ps_UPDATE)<1
					this.ph_s_mensaje_error_sql = "Error al ACTUALIZAR registros en la tabla : < " + ps_nombre_tabla + " >"+CHR(13)+;
							   					  MESSAGE()
					RETURN .f.
				ENDIF	
			ENDIF
		ENDSCAN
		GO TOP
		WAIT CLEAR
		
	ENDPROC

	PROCEDURE mh_proceso_migracion_conexion_base_datos
		***======================================================================================================
		*** Proceso de conexion a la base de datos de migración
		***======================================================================================================
		This.ph_s_migracion_servidor    = ALLTRIM(This.Cnt_Proceso_Migracion.Txt_Servidor_Destino.Value)
		This.ph_s_migracion_odbc_BDatos = ALLTRIM(This.Cnt_Proceso_Migracion.Txt_Base_Datos_ODBC_Destino.Value)
		This.ph_s_migracion_usuario     = ALLTRIM(This.Cnt_Proceso_Migracion.txt_usuario_Destino.Value)
		This.ph_s_migracion_contrasena  = ALLTRIM(This.Cnt_Proceso_Migracion.txt_Contrasena_Destino.Value)
		***
		***---validaciones: Nombre del Servidor
		IF This.Cnt_Proceso_Migracion.Opt_Tipo_Conexion.Conexion_Directo.Value = 1
			IF EMPTY(This.ph_s_migracion_servidor)
				MESSAGEBOX("Ingrese el nombre del Servidor",64,"Conexión a la base de datos - Migración")
				This.Cnt_Proceso_Migracion.Txt_Servidor_Destino.SetFocus()
				RETURN .F.
			ENDIF
		ENDIF
		***---validaciones: Nombre del origen de datos ODBC
		IF EMPTY(This.ph_s_migracion_odbc_BDatos)
			ps_mensaje = "Ingrese el nombre del origen de datos ODBC"
			IF This.Cnt_Proceso_Migracion.Opt_Tipo_Conexion.Conexion_Directo.Value = 1
				ps_mensaje = "Ingrese el nombre de la base de datos"
			ENDIF
			MESSAGEBOX(ps_mensaje,64,"Conexión a la base de datos - Migración")
			This.Cnt_Proceso_Migracion.Txt_Base_Datos_ODBC_Destino.SetFocus()
			RETURN .F.
		ENDIF
		***---validaciones: Nombre del Usuario de la base de datos
		IF EMPTY(This.ph_s_migracion_usuario)
			MESSAGEBOX("Ingrese el usuario de la base de datos",64,"Conexión a la base de datos - Migración")
			This.Cnt_Proceso_Migracion.txt_usuario_Destino.SetFocus()
			RETURN .F.
		ENDIF
		***---validaciones: Contraseña del Usuario
		IF EMPTY(This.ph_s_migracion_contrasena)
			MESSAGEBOX("Ingrese la contraseña del usuario",64,"Conexión a la base de datos - Migración")
			This.Cnt_Proceso_Migracion.txt_Contrasena_Destino.SetFocus()
			RETURN .F.
		ENDIF
		
		This.mh_proceso_migracion_desconexion_base_datos()
		This.ph_l_migracion_exito_conexion = .f.
		
		***--- Conexión DIRECTA POR CODIGO - servidor
		ps_cadena_ocnx="driver=SQL Server;server="+ALLTRIM(This.ph_s_migracion_servidor)+;
		               ";database="+ALLTRIM(This.ph_s_migracion_odbc_BDatos)+";uid="+ALLTRIM(This.ph_s_migracion_usuario)+;
		               ";pwd="+ALLTRIM(This.ph_s_migracion_contrasena) 		  
		This.Migracion_Conexion = SQLSTRINGCONNECT(ps_cadena_ocnx)
		IF This.Migracion_Conexion < 1
			MESSAGEBOX("Error en la conexión a la base de datos de Migración"+CHR(13)+MESSAGE(),16,"Conexión a Base de Datos - Migración")
			RETURN .F.
		ENDIF
		This.ph_l_migracion_exito_conexion = .t.
		
		This.Cnt_Proceso_Migracion.Refresh()
		
	ENDPROC

	PROCEDURE mh_proceso_migracion_desconexion_base_datos
		***======================================================================================================
		*** Desconexion a base de datos - Migración
		***======================================================================================================
		IF this.ph_l_migracion_exito_conexion = .t.
			=SQLDISCONNECT(this.Migracion_Conexion)
		ENDIF
		this.ph_l_migracion_exito_conexion = .f.
		
	ENDPROC

	PROCEDURE mh_proceso_ordena_selecciona_tablas
		***======================================================================================================
		*** Ordena la selección de las tablas
		***======================================================================================================
		PRIVATE pn_recno,ps_corite
		SELECT "CUR_LISTA_TABLAS"
		IF NVL(CUR_LISTA_TABLAS.cur_indica,0)=1
			***--- Acción : Adiciona Tabla
			SELECT "CUR_TABLAS"
			pn_recno = RECNO()
			APPEND BLANK
			REPLACE CUR_TABLAS.cur_corite WITH ''
			REPLACE CUR_TABLAS.cur_bdatos WITH ALLTRIM(NVL(CUR_LISTA_TABLAS.cur_bdatos,''))
			REPLACE CUR_TABLAS.cur_propie WITH ALLTRIM(NVL(CUR_LISTA_TABLAS.cur_propie,''))
			REPLACE CUR_TABLAS.cur_tiptab WITH ALLTRIM(NVL(CUR_LISTA_TABLAS.cur_tiptab,''))
			REPLACE CUR_TABLAS.cur_nomtab WITH ALLTRIM(NVL(CUR_LISTA_TABLAS.cur_nomtab,''))
			REPLACE CUR_TABLAS.cur_destab WITH ALLTRIM(NVL(CUR_LISTA_TABLAS.cur_destab,''))
		ELSE
			***--- Acción : Quita Tabla
			SELECT "CUR_TABLAS"
			pn_recno = RECNO()
			LOCATE FOR (ALLTRIM(NVL(CUR_TABLAS.cur_bdatos,''))==ALLTRIM(NVL(CUR_LISTA_TABLAS.cur_bdatos,'')) AND;
			            ALLTRIM(NVL(CUR_TABLAS.cur_propie,''))==ALLTRIM(NVL(CUR_LISTA_TABLAS.cur_propie,'')) AND;
			            ALLTRIM(NVL(CUR_TABLAS.cur_nomtab,''))==ALLTRIM(NVL(CUR_LISTA_TABLAS.cur_nomtab,'')))
			IF FOUND()
				DELETE
			ENDIF
			GO TOP
		ENDIF 
		STORE "00" TO ps_corite
		SELECT "CUR_TABLAS"
		GO TOP
		SCAN
			ps_corite = PADL(ALLTRIM(STR(VAL(ps_corite)+1)),3,"0")
			REPLACE CUR_TABLAS.cur_corite WITH ps_corite
		ENDSCAN
		GO TOP
		This.Cnt_Disenador_Relacion.Grd_Tablas_Seleccionadas.AfterRowColChange()
		
	ENDPROC

	PROCEDURE mh_proceso_relacionar_tablas
		***======================================================================================================
		*** Proceso para relacionar tablas : automaticamente segun las referencias SP_FKEYS
		***======================================================================================================
		
		*!*	DO setear
		*!*	PUBLIC ocnx
		*!*	ocnx = SQLCONNECT("ximesa","lhuapaya","luihua")
		*!*	DO cursor_tablas
		*!*	DO procesar
		*!*	=SQLDISCONNECT(ocnx)
		*!*	DO setear
		*!*	RETURN
		
		
		*!*	PROCEDURE procesar
		*!*	ps_cur_corite = "00000"
		*!*	***--- Cursor de tablas
		*!*	SELECT "cur_tablas"
		*!*	GO TOP
		*!*	SCAN
		*!*		ps_nomtabla = ALLTRIM(NVL(cur_tablas.cur_nomtab,''))
		*!*		ps_cadena="sp_fkeys '" + ps_nomtabla + "'"
		*!*		IF SQLEXEC(ocnx,ps_cadena,"tmpval")<1
		*!*			MESSAGEBOX("Error al abrir el cursor de referencias FK de la tabla [ "+ ps_nomtabla +" ]"+CHR(13)+;
		*!*						MESSAGE(),16,"ERROR REFERENCIAS FK")
		*!*			RETURN .f.
		*!*		ENDIF
		*!*		***--- Cursor de tablas Imagen
		*!*		SELECT "cur_tablas_TMP"
		*!*		GO TOP
		*!*		SCAN FOR ALLTRIM(NVL(cur_tablas_TMP.cur_nomtab,''))<>ALLTRIM(NVL(cur_tablas.cur_nomtab,''))
		*!*			STORE 0 TO Pn_contador
		*!*			SELECT "tmpval"
		*!*			SET FILTER TO ALLTRIM(NVL(tmpval.fktable_name,''))==ALLTRIM(NVL(cur_tablas_TMP.cur_nomtab,''))
		*!*			COUNT TO Pn_contador
		*!*			IF Pn_contador > 0
		*!*				GO TOP
		*!*				SCAN
		*!*					SELECT "cur_relacion"
		*!*					IF !SEEK(UPPER(ALLTRIM(NVL(tmpval.PKTABLE_NAME,'')))+UPPER(ALLTRIM(NVL(tmpval.PKCOLUMN_NAME,'')))+;
		*!*							 UPPER(ALLTRIM(NVL(tmpval.FKTABLE_NAME,'')))+UPPER(ALLTRIM(NVL(tmpval.FKCOLUMN_NAME,''))),"cur_relacion","L")
		*!*						GO BOTTOM
		*!*						ps_cur_corite = PADL(ALLTRIM(STR(VAL(ps_cur_corite)+1)),5,"0")
		*!*						APPEND BLANK
		*!*						REPLACE cur_relacion.cur_corite WITH ps_cur_corite 
		*!*						REPLACE cur_relacion.cur_PK_bda WITH UPPER(ALLTRIM(NVL(tmpval.PKTABLE_QUALIFIER,'')))
		*!*						REPLACE cur_relacion.cur_PK_pro WITH UPPER(ALLTRIM(NVL(tmpval.PKTABLE_OWNER,'')))
		*!*						REPLACE cur_relacion.cur_PK_tab WITH UPPER(ALLTRIM(NVL(tmpval.PKTABLE_NAME,'')))
		*!*						REPLACE cur_relacion.cur_PK_cam WITH UPPER(ALLTRIM(NVL(tmpval.PKCOLUMN_NAME,'')))
		*!*						REPLACE cur_relacion.cur_FK_bda WITH UPPER(ALLTRIM(NVL(tmpval.FKTABLE_QUALIFIER,'')))
		*!*						REPLACE cur_relacion.cur_FK_pro WITH UPPER(ALLTRIM(NVL(tmpval.FKTABLE_OWNER,'')))
		*!*						REPLACE cur_relacion.cur_FK_tab WITH UPPER(ALLTRIM(NVL(tmpval.FKTABLE_NAME,'')))
		*!*						REPLACE cur_relacion.cur_FK_cam WITH UPPER(ALLTRIM(NVL(tmpval.FKCOLUMN_NAME,'')))
		*!*						REPLACE cur_relacion.cur_keyseq WITH NVL(tmpval.KEY_SEQ,0)
		*!*						REPLACE cur_relacion.cur_updrul WITH NVL(tmpval.UPDATE_RULE,0)
		*!*						REPLACE cur_relacion.cur_delrul WITH NVL(tmpval.DELETE_RULE,0)
		*!*						REPLACE cur_relacion.cur_FK_nam WITH UPPER(ALLTRIM(NVL(tmpval.FK_NAME,'')))
		*!*						REPLACE cur_relacion.cur_PK_nam WITH UPPER(ALLTRIM(NVL(tmpval.PK_NAME,'')))
		*!*						REPLACE cur_relacion.cur_deferr WITH NVL(tmpval.DEFERRABILITY,0)
		*!*					ENDIF
		*!*					SELECT "tmpval"
		*!*				ENDSCAN
		*!*			ENDIF
		*!*			SELECT "cur_tablas_TMP"
		*!*		ENDSCAN
		*!*		SELECT "cur_tablas"
		*!*	ENDSCAN
		*!*	SELECT "cur_tablas"
		*!*	GO TOP
		*!*	SELECT "cur_relacion"
		*!*	GO TOP
		*!*	BROWSE
		
		*!*	RETURN
		
		
		*!*	PROCEDURE cursor_tablas
		*!*	CREATE CURSOR cur_tablas (cur_corite c(3), cur_nomtab c(50))
		*!*	CREATE CURSOR cur_tablas_TMP (cur_corite c(3), cur_nomtab c(50))
		*!*	CREATE CURSOR cur_relacion (cur_corite c(5)  ,;
		*!*								cur_PK_bda c(50)  ,cur_PK_pro c(50),  cur_PK_tab c(50),  cur_PK_cam c(50),;
		*!*								cur_FK_bda c(50)  ,cur_FK_pro c(50),  cur_FK_tab c(50),  cur_FK_cam c(50),;
		*!*								cur_keyseq n(12,0),cur_updrul n(12,0),cur_delrul n(12,0),cur_FK_nam c(100),;
		*!*								cur_PK_nam c(100), cur_deferr n(12,0))
		*!*	INDEX ON ALLTRIM(cur_PK_tab)+ALLTRIM(cur_PK_cam)+ALLTRIM(cur_FK_tab)+ALLTRIM(cur_FK_cam) TAG L ADDITIVE
		*!*	INDEX ON ALLTRIM(cur_corite) TAG I ADDI
		*!*	SET ORDER TO I
		*!*	INSERT INTO cur_tablas (cur_corite,cur_nomtab) VALUES ('001','KARDEX_ALMACEN_KAC')
		*!*	INSERT INTO cur_tablas (cur_corite,cur_nomtab) VALUES ('002','KARDEX_ALMACEN_KAD')
		*!*	INSERT INTO cur_tablas (cur_corite,cur_nomtab) VALUES ('003','ALMACENES_ALM')
		*!*	INSERT INTO cur_tablas (cur_corite,cur_nomtab) VALUES ('004','PRODUCTOS_PRD')
		
		*!*	SELECT "cur_tablas"
		*!*	GO TOP
		*!*	SCAN
		*!*		INSERT INTO cur_tablas_TMP (cur_corite,cur_nomtab) VALUES (cur_tablas.cur_corite,cur_tablas.cur_nomtab)
		*!*	ENDSCAN
		*!*	GO TOP IN "cur_tablas"
		*!*	GO TOP IN "cur_tablas_TMP"						
		*!*	RETURN
		
		
		*!*	PROCEDURE setear
		*!*	CLOSE DATABASES ALL
		*!*	SET SAFETY OFF
		*!*	SET TALK OFF
		*!*	SET EXACT ON
		*!*	RETURN
		
	ENDPROC

	PROCEDURE mh_proceso_seleccionar_tablas		&& presenta listado de tablas para seleccionar
		***======================================================================================================
		*** Proceso de selección de tabla
		***======================================================================================================
		PARAMETERS p_accion
		PRIVATE ps_cadena,ps_corite,ps_vfp_tidato
		This.Cnt_Seleccionar_Tablas.Visible = .f.
		This.Cnt_Seleccionar_Tablas.grd_Lista_Tablas.Visible = .f.
		This.Cnt_Disenador_Relacion.Visible = .f.
		This.Cnt_Disenador_Relacion.Grd_Tablas_Seleccionadas.Visible = .f.
		
		This.Cnt_Contenedor.Visible = .t.
		this.BackColor = this.ph_n_backcolor_original
		STORE "" TO ps_cadena,ps_vfp_tidato
		STORE "00000" TO ps_corite
		SELECT "CUR_LISTA_CAMPOS"
		ZAP
		SELECT "CUR_TABLAS"
		GO TOP
		SCAN
			SELECT "CUR_LISTA_CAMPOS"
			GO BOTTOM
			ps_corite = PADL(ALLTRIM(STR(VAL(ps_corite)+1)),5,"0")
			APPEND BLANK
			REPLACE CUR_LISTA_CAMPOS.cur_corite WITH ps_corite
			REPLACE CUR_LISTA_CAMPOS.cur_bdatos WITH ALLTRIM(NVL(CUR_TABLAS.cur_bdatos,''))	&& base de datos de tabla
			REPLACE CUR_LISTA_CAMPOS.cur_propie WITH ALLTRIM(NVL(CUR_TABLAS.cur_propie,''))	&& propietario de tabla
			REPLACE CUR_LISTA_CAMPOS.cur_tiptab WITH ALLTRIM(NVL(CUR_TABLAS.cur_tiptab,''))	&& tipo de tabla
			REPLACE CUR_LISTA_CAMPOS.cur_nomtab WITH ALLTRIM(NVL(CUR_TABLAS.cur_nomtab,''))	&& nombre de tabla
			REPLACE CUR_LISTA_CAMPOS.cur_alitab WITH ALLTRIM(NVL(CUR_TABLAS.cur_alitab,''))	&& alias de tabla
			REPLACE CUR_LISTA_CAMPOS.cur_destab WITH ALLTRIM(NVL(CUR_TABLAS.cur_destab,''))	&& descrip. de tabla
			REPLACE CUR_LISTA_CAMPOS.cur_nomcam WITH "*"
			REPLACE CUR_LISTA_CAMPOS.cur_tipdat WITH "CHAR"
			REPLACE CUR_LISTA_CAMPOS.cur_tidato WITH "C"
			REPLACE CUR_LISTA_CAMPOS.cur_longit WITH 1
			REPLACE CUR_LISTA_CAMPOS.cur_decima WITH 0
		
			ps_cadena="sp_columns '" + ALLTRIM(NVL(CUR_TABLAS.cur_nomtab,'')) + "'"
			IF SQLEXEC(this.conexion,ps_cadena,"tmpval")<1
				MESSAGEBOX("Error al ejecuta consulta de campos de la tabla"+CHR(13)+;
						   "Tabla : " + ALLTRIM(NVL(CUR_TABLAS.tab_nomtab,'')),16,"Campos de Tabla")
				RETURN .f.
			ENDIF
			SELECT "tmpval"
			GO TOP
			SCAN
				SELECT "CUR_LISTA_CAMPOS"
				GO BOTTOM
				ps_corite = PADL(ALLTRIM(STR(VAL(ps_corite)+1)),5,"0")
				ps_vfp_tidato = this.mh_vfp_tipo_dato_campo(UPPER(ALLTRIM(NVL(tmpval.column_name,''))),UPPER(ALLTRIM(NVL(tmpval.type_name,''))))
				APPEND BLANK
				REPLACE CUR_LISTA_CAMPOS.cur_corite WITH ps_corite
				REPLACE CUR_LISTA_CAMPOS.cur_bdatos WITH ALLTRIM(NVL(CUR_TABLAS.cur_bdatos,''))	&& base de datos de tabla
				REPLACE CUR_LISTA_CAMPOS.cur_propie WITH ALLTRIM(NVL(CUR_TABLAS.cur_propie,''))	&& propietario de tabla
				REPLACE CUR_LISTA_CAMPOS.cur_tiptab WITH ALLTRIM(NVL(CUR_TABLAS.cur_tiptab,''))	&& tipo de tabla
				REPLACE CUR_LISTA_CAMPOS.cur_nomtab WITH ALLTRIM(NVL(CUR_TABLAS.cur_nomtab,''))	&& nombre de tabla
				REPLACE CUR_LISTA_CAMPOS.cur_alitab WITH ALLTRIM(NVL(CUR_TABLAS.cur_alitab,''))	&& alias de tabla
				REPLACE CUR_LISTA_CAMPOS.cur_destab WITH ALLTRIM(NVL(CUR_TABLAS.cur_destab,''))	&& descrip. de tabla
				REPLACE CUR_LISTA_CAMPOS.cur_nomcam WITH UPPER(ALLTRIM(NVL(tmpval.column_name,'')))	&& nombre de campo
				REPLACE CUR_LISTA_CAMPOS.cur_tipdat WITH UPPER(ALLTRIM(NVL(tmpval.type_name,'')))	&& tipo de dato de campo
				REPLACE CUR_LISTA_CAMPOS.cur_tidato WITH ps_vfp_tidato								&& VFP - tipo de dato de campo
				REPLACE CUR_LISTA_CAMPOS.cur_longit WITH NVL(tmpval.precision,0)					&& longitud de campo
				REPLACE CUR_LISTA_CAMPOS.cur_decima WITH NVL(tmpval.scale,0)						&& decimales de campo
				SELECT "tmpval"
			ENDSCAN
			SELECT "CUR_TABLAS"
		ENDSCAN
		
		SELECT "CUR_CAMPOS"
		GO TOP
		REPLACE ALL CUR_CAMPOS.cur_indest WITH "0"
		GO TOP
		
		SELECT "CUR_TABLAS"
		GO TOP
		SCAN
			SELECT "CUR_CAMPOS"
			GO TOP
			REPLACE ALL CUR_CAMPOS.cur_alitab WITH ALLTRIM(NVL(CUR_TABLAS.cur_alitab,'')) FOR ;
				(UPPER(ALLTRIM(NVL(CUR_CAMPOS.cur_bdatos,'')))==UPPER(ALLTRIM(NVL(CUR_TABLAS.cur_bdatos,''))) AND;
				 UPPER(ALLTRIM(NVL(CUR_CAMPOS.cur_propie,'')))==UPPER(ALLTRIM(NVL(CUR_TABLAS.cur_propie,''))) AND;
				 UPPER(ALLTRIM(NVL(CUR_CAMPOS.cur_tiptab,'')))==UPPER(ALLTRIM(NVL(CUR_TABLAS.cur_tiptab,''))) AND;
				 UPPER(ALLTRIM(NVL(CUR_CAMPOS.cur_nomtab,'')))==UPPER(ALLTRIM(NVL(CUR_TABLAS.cur_nomtab,''))))
			GO TOP
			REPLACE ALL CUR_CAMPOS.cur_indest WITH "1" FOR ;
				(UPPER(ALLTRIM(NVL(CUR_CAMPOS.cur_bdatos,'')))==UPPER(ALLTRIM(NVL(CUR_TABLAS.cur_bdatos,''))) AND;
				 UPPER(ALLTRIM(NVL(CUR_CAMPOS.cur_propie,'')))==UPPER(ALLTRIM(NVL(CUR_TABLAS.cur_propie,''))) AND;
				 UPPER(ALLTRIM(NVL(CUR_CAMPOS.cur_tiptab,'')))==UPPER(ALLTRIM(NVL(CUR_TABLAS.cur_tiptab,''))) AND;
				 UPPER(ALLTRIM(NVL(CUR_CAMPOS.cur_nomtab,'')))==UPPER(ALLTRIM(NVL(CUR_TABLAS.cur_nomtab,''))))
			SELECT "CUR_TABLAS"
		ENDSCAN
		SELECT "CUR_TABLAS"
		GO TOP
		
		SELECT "CUR_CAMPOS"
		GO TOP
		DELETE ALL FOR CUR_CAMPOS.cur_indest=="0"
		
		SELECT "CUR_CAMPOS"
		GO TOP
		COUNT TO pn_registros
		GO TOP
		IF pn_registros=0
			This.Cnt_Contenedor.Opt_Mantiene_Campos.Nuevo.Click()
			SELECT "CUR_CAMPOS"
			REPLACE CUR_CAMPOS.cur_nomcam WITH "*"
			REPLACE CUR_CAMPOS.cur_indest WITH "1"
			This.Cnt_Contenedor.Grd_Campos_Tabla.Col_Columna_Nombre.Cbo_Listado_Columnas.Valid()
			SELECT "CUR_CAMPOS"
			REPLACE CUR_CAMPOS.cur_bdatos WITH CUR_LISTA_CAMPOS.cur_bdatos
			REPLACE CUR_CAMPOS.cur_propie WITH CUR_LISTA_CAMPOS.cur_propie
			REPLACE CUR_CAMPOS.cur_tiptab WITH CUR_LISTA_CAMPOS.cur_tiptab
			REPLACE CUR_CAMPOS.cur_nomtab WITH CUR_LISTA_CAMPOS.cur_nomtab
			REPLACE CUR_CAMPOS.cur_alitab WITH CUR_LISTA_CAMPOS.cur_alitab
			REPLACE CUR_CAMPOS.cur_destab WITH CUR_LISTA_CAMPOS.cur_destab
			REPLACE CUR_CAMPOS.cur_descam WITH CUR_LISTA_CAMPOS.cur_descam
			REPLACE CUR_CAMPOS.cur_tipdat WITH CUR_LISTA_CAMPOS.cur_tipdat
			REPLACE CUR_CAMPOS.cur_tidato WITH CUR_LISTA_CAMPOS.cur_tidato
			REPLACE CUR_CAMPOS.cur_longit WITH CUR_LISTA_CAMPOS.cur_longit
			REPLACE CUR_CAMPOS.cur_decima WITH CUR_LISTA_CAMPOS.cur_decima
		ENDIF
		
		This.Cnt_Contenedor.Grd_Campos_Tabla.Col_columna_Nombre.cbo_Listado_Columnas.Requery()
		This.Cnt_Contenedor.Grd_Campos_Tabla.Col_columna_Nombre.cbo_Listado_Columnas.Refresh()
		This.Cnt_Contenedor.Cnt_Relacion_Tablas.Grd_Tablas.AfterRowColChange()
		This.Cnt_Contenedor.Grd_Campos_Tabla.AfterRowColChange()
		
		
	ENDPROC

	PROCEDURE mh_quita_origen_de_datos
		***======================================================================================================
		*** Quita el origen de datos de las tablas al momento de cerrarse
		***======================================================================================================
		This.Cnt_Contenedor.Cnt_Relacion_Tablas.Grd_Tablas.RecordSource = ""
		This.Cnt_Contenedor.Grd_Campos_Tabla.col_Columna_Nombre.cbo_Listado_Columnas.RowSource = ""
		This.Cnt_Contenedor.Grd_Campos_Tabla.Col_Campo_Tipo_Orden.Cbo_Campo_Tipo_Orden.RowSource = ""
		This.Cnt_Contenedor.Grd_Campos_Tabla.RecordSource = ""
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.RecordSource = ""
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Indices_Busqueda.RecordSource = ""
		This.Cnt_Seleccionar_Tablas.Grd_Lista_Tablas.RecordSource = ""
		This.Cnt_Disenador_Relacion.Grd_Tablas_Seleccionadas.RecordSource = ""
		This.Cnt_Proceso_Migracion.Grd_Examinar.RecordSource = ""
		This.Cnt_Proceso_Migracion.Grd_Configura_Campos.RecordSource = ""
		This.Cnt_Proceso_Migracion.Cbo_Tabla_Nombre_Migracion.RowSource = ""
		
	ENDPROC

	PROCEDURE mh_registros_campos_consulta
		***======================================================================================================
		*** Guarda en cursor los campos de la consulta
		***======================================================================================================
		IF !USED("CUR_INDICES")
			CREATE CURSOR CUR_INDICES(cur_indica n(1), cur_nomcam c(50), cur_tipdad c(1),;
								      cur_longit n(18,0), cur_decima n(5,0), cur_indnul l,;
									  cur_cfgnul n(1), cur_valdft c(100), cur_notact n(1))
		ENDIF
		SELECT "CUR_INDICES"
		ZAP
		SELECT "CUR_DATOS"
		AFIELDS(pa_array_campos,"CUR_DATOS")
		FOR pn_contador=1 TO ALEN(pa_array_campos,1)
			SELECT "CUR_INDICES"
			APPEND BLANK
			REPLACE CUR_INDICES.cur_indica WITH 0
			REPLACE CUR_INDICES.cur_nomcam WITH pa_array_campos(pn_contador,1)
			REPLACE CUR_INDICES.cur_tipdad WITH pa_array_campos(pn_contador,2)
			REPLACE CUR_INDICES.cur_longit WITH pa_array_campos(pn_contador,3)
			REPLACE CUR_INDICES.cur_decima WITH pa_array_campos(pn_contador,4)
			REPLACE CUR_INDICES.cur_indnul WITH pa_array_campos(pn_contador,5)
			REPLACE CUR_INDICES.cur_cfgnul WITH 0
			REPLACE CUR_INDICES.cur_valdft WITH ""
			REPLACE CUR_INDICES.cur_notact WITH 0
		ENDFOR
		ERASE pa_array_campos
		SELECT "CUR_INDICES"
		GO TOP
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Indices_Busqueda.RecordSource = "CUR_INDICES"
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Indices_Busqueda.Column1.ControlSource = "CUR_INDICES.cur_indica"
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Indices_Busqueda.Column2.ControlSource = "CUR_INDICES.cur_nomcam"
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Indices_Busqueda.Column3.ControlSource = "CUR_INDICES.cur_tipdad"
		
		This.Cnt_Proceso_Migracion.Grd_Configura_Campos.RecordSource = "CUR_INDICES"
		This.Cnt_Proceso_Migracion.Grd_Configura_Campos.Column2.ControlSource = "CUR_INDICES.cur_nomcam"
		This.Cnt_Proceso_Migracion.Grd_Configura_Campos.Column3.ControlSource = "CUR_INDICES.cur_tipdad"
		This.Cnt_Proceso_Migracion.Grd_Configura_Campos.Column1.ControlSource = "CUR_INDICES.cur_cfgnul"
		This.Cnt_Proceso_Migracion.Grd_Configura_Campos.column4.ControlSource = "CUR_INDICES.cur_notact"
		This.Cnt_Proceso_Migracion.Grd_Configura_Campos.column5.ControlSource = "CUR_INDICES.cur_valdft"
		
	ENDPROC

	PROCEDURE mh_registros_campos_generar_indice
		***======================================================================================================
		*** Genera indice al cursor de datos
		***======================================================================================================
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Registros_Consulta.Txt_Registros_Indice_Busqueda.Value = ""
		IF !USED("CUR_INDICES")
			MESSAGEBOX("Pulse sobre el botón ejecutar para generar el cursor de datos",64,"INDICES")
			RETURN .f.
		ENDIF
		SELECT "CUR_DATOS"
		IF !EMPTY(TAG())
			SET KEY TO
			GO TOP
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.AfterRowColChange()
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.Refresh()
			This.mh_registros_totales_consulta()
		ENDIF
		
		PRIVATE Ps_Campo_Tipo_Dato,Ps_Campo_Indice_Caracter,Ps_cadena_Indice,Ps_campo_Nombre
		PRIVATE Ps_Campo_Longitud,Ps_Campo_Decimales
		STORE "" TO Ps_Campo_Tipo_Dato,Ps_Campo_Indice_Caracter,Ps_cadena_Indice,Ps_campo_Nombre
		STORE 0 TO Ps_Campo_Longitud,Ps_Campo_Decimales
		SELECT "CUR_INDICES"
		GO TOP
		SCAN FOR NVL(CUR_INDICES.cur_indica,0)=1
			Ps_campo_Nombre    = ALLTRIM(UPPER(NVL(CUR_INDICES.cur_nomcam,'')))
			Ps_Campo_Tipo_Dato = UPPER(ALLTRIM(NVL(CUR_INDICES.cur_tipdad,'')))
			Ps_Campo_Longitud  = ALLTRIM(STR(NVL(CUR_INDICES.cur_longit,0)))
			Ps_Campo_Decimales = ALLTRIM(STR(NVL(CUR_INDICES.cur_decima,0)))
			Ps_Campo_Indice_Caracter = ;
				IIF(Ps_Campo_Tipo_Dato=="C",;
					"ALLTRIM(" + Ps_campo_Nombre + ")" ,;
				IIF((Ps_Campo_Tipo_Dato=="N" OR Ps_Campo_Tipo_Dato=="F" OR Ps_Campo_Tipo_Dato=="I" OR ;
					 Ps_Campo_Tipo_Dato=="B" OR Ps_Campo_Tipo_Dato=="Y"),;
					"ALLTRIM(STR(" + Ps_campo_Nombre + "," + Ps_Campo_Longitud + "," + Ps_Campo_Decimales + "))" ,;
				IIF((Ps_Campo_Tipo_Dato=="D" OR Ps_Campo_Tipo_Dato=="T"),;
					"ALLTRIM(DTOS(" + UPPER(ALLTRIM(Ps_campo_Nombre)) + "))" ,"")))
			IF !EMPTY(Ps_Campo_Indice_Caracter)
				Ps_cadena_Indice = Ps_cadena_Indice + Ps_Campo_Indice_Caracter +  "+"
			ENDIF
		ENDSCAN
		Ps_cadena_Indice=SUBSTR(ALLTRIM(Ps_cadena_Indice),1,LEN(Ps_cadena_Indice)-1)
		Ps_cadena_Indice=(Ps_cadena_Indice)
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Registros_Consulta.Txt_Registros_Indice_Busqueda.Value = Ps_cadena_Indice
		
		IF !EMPTY(Ps_cadena_Indice)
			SELECT "CUR_DATOS"
			Ps_cadena_Indice="INDEX ON " + Ps_cadena_Indice + " TAG I ADDI"
			&Ps_cadena_Indice
			GO TOP
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.AfterRowColChange()	
		ENDIF
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Buscar.Txt_Buscar.When()
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Buscar.SetFocus()
		
		
	ENDPROC

	PROCEDURE mh_registros_totales_consulta
		***======================================================================================================
		*** Totales de registros de la consulta
		***======================================================================================================
		PRIVATE pn_contador
		STORE 0 TO pn_contador
		SELECT "CUR_DATOS"
		COUNT TO pn_contador
		GO TOP
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Registros_Consulta.Txt_Registros_Consulta.Value = NVL(pn_contador,0)
		
	ENDPROC

	PROCEDURE mh_setear_entorno
		***======================================================================================================
		*** Setear entorno
		***======================================================================================================
		SET SAFETY OFF
		SET TALK OFF
		SET CENTURY on
		SET DATE BRITISH
		SET DELETED ON
		
	ENDPROC

	PROCEDURE mh_tamano_estandar_formulario
		***======================================================================================================
		*** Redimensiona el formulario. maximiza o vuelve a su tamaño normal
		***======================================================================================================
		thisform.LockScreen = .t.
		IF ((thisform.Height == this.ph_n_height_formulario) AND (thisform.Width == this.ph_n_width_formulario))
			thisform.WindowState = 2
		ELSE
			thisform.Height = this.ph_n_height_formulario
			thisform.Width  = this.ph_n_width_formulario
		ENDIF
		thisform.AutoCenter = .t.
		thisform.Resize()
		thisform.Refresh()
		thisform.LockScreen = .f.
		
	ENDPROC

	PROCEDURE mh_verifica_conexion_base_datos
		IF This.ph_l_exito_conexion = .f.
			MESSAGEBOX("Error: No existe la conexion a la base de datos"+CHR(13)+;
					   "Reliace la conexión a la base de datos...!!!",64,"Conexion")
			RETURN .f.
		ENDIF
		
	ENDPROC

	PROCEDURE mh_vfp_tipo_dato_campo
		***======================================================================================================
		*** Activa pantalla de conexión a la base de datos
		***======================================================================================================
		PARAMETERS p_nombre_campo, p_tipo_campo_base_datos
		PRIVATE ps_tipodato,Ps_Campo_Tipo_Dato 
		ps_tipodato = p_tipo_campo_base_datos
		STORE "" TO Ps_Campo_Tipo_Dato
		DO CASE
			***--- Tipos de datos - Cadena
			***--- cadena de caracteres         : char, varchar, text
			***--- cadena de caracteres unicode : nchar, nvarchar, ntext
			CASE ((ps_tipodato==UPPER("char")) OR (ps_tipodato==UPPER("varchar")) OR (ps_tipodato==UPPER("text")) OR;
				  (ps_tipodato==UPPER("nchar")) OR (ps_tipodato==UPPER("nvarchar")) OR (ps_tipodato==UPPER("ntext")))
				Ps_Campo_Tipo_Dato = "C"
		
			***--- Tipos de datos - Numericos
			***--- numericos exactos           :
			***---                             integer -  bigint, int, smallint, tinyint
			***---                             bit     -  bit
			***--- decimal y numeric           : decimal, numeric
			***--- money y smallmoney          : money, smallmoney
			***--- numericos con aproximación  : float, real
			CASE ((ps_tipodato==UPPER("bigint")) OR (ps_tipodato==UPPER("int")) OR (ps_tipodato==UPPER("smallint")) OR;
				  (ps_tipodato==UPPER("tinyint")) OR (ps_tipodato==UPPER("bit")) OR (ps_tipodato==UPPER("decimal")) OR;
				  (ps_tipodato==UPPER("numeric")) OR (ps_tipodato==UPPER("money")) OR (ps_tipodato==UPPER("smallmoney")) OR;
				  (ps_tipodato==UPPER("float")) OR (ps_tipodato==UPPER("real")))
				Ps_Campo_Tipo_Dato = "N"
			***--- Tipos de datos - Fecha
			***--- datetime y smalldatetime : datetime, smalldatetime
			CASE ((ps_tipodato==UPPER("datetime")) OR (ps_tipodato==UPPER("smalldatetime")))
				Ps_Campo_Tipo_Dato = "D"
		
			CASE RIGHT(p_nombre_campo,7)=="_INDEST"		&& Indicador de estado
				Ps_Campo_Tipo_Dato = "C"
			CASE RIGHT(p_nombre_campo,7)=="_CODUSU"		&& usuario de creación
				Ps_Campo_Tipo_Dato = "C"
			CASE RIGHT(p_nombre_campo,7)=="_FECACT"		&& fecha de creación
				Ps_Campo_Tipo_Dato = "D"
			CASE RIGHT(p_nombre_campo,7)=="_USUMOD"		&& usuario de modificación
				Ps_Campo_Tipo_Dato = "C"
			CASE RIGHT(p_nombre_campo,7)=="_FECMOD"		&& fecha de modificación
				Ps_Campo_Tipo_Dato = "D"
			
		ENDCASE
		RETURN Ps_Campo_Tipo_Dato
	ENDPROC

	PROCEDURE Refresh
		IF this.ph_l_inicializa_objeto = .t.
			thisform.LockScreen = .t.
			Thisform.AutoCenter = .t.
			ThisForm.HalfHeightCaption = .t.
			this.Width  = thisform.Width
			this.Height = thisform.Height
			This.Resize()
			thisform.LockScreen = .f.
		ENDIF
		this.ph_l_inicializa_objeto = .f.
		
	ENDPROC

	PROCEDURE Resize
		Thisform.LockScreen = .t.
		PRIVATE pn_height,pn_widht,pn_height_statusbar,ps_macro
		pn_height_statusbar = 0
		IF !EMPTY(ALLTRIM(this.ph_s_nombre_control_statusbar))
			ps_macro = "pn_height_statusbar = " + This.ph_s_nombre_control_statusbar + ".height"
			&ps_macro
		ENDIF
		pn_height = Thisform.Height - pn_height_statusbar
		pn_widht  = Thisform.Width
		IF pn_height < this.ph_n_height_objeto
			Thisform.Height = this.ph_n_height_objeto + pn_height_statusbar
		ENDIF
		IF pn_widht  < this.ph_n_width_objeto
			Thisform.Width  = this.ph_n_width_objeto
		ENDIF
		This.Height = Thisform.Height - pn_height_statusbar
		this.Width  = Thisform.Width
		
		This.cnt_contenedor.Height = this.Height - 5
		This.cnt_contenedor.Width  = this.Width - 4
		
		This.Cnt_Seleccionar_Tablas.Resize()
		This.Cnt_Coneccion_Base_Datos.Resize()
		This.Cnt_Disenador_Relacion.Resize()
		This.Cnt_Proceso_Migracion.Resize()
		
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Width = This.cnt_contenedor.Width - 8
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Height = ((This.cnt_contenedor.Height - ;
			This.Cnt_Contenedor.Cnt_Relacion_Tablas.Height - This.Cnt_Contenedor.Grd_Campos_Tabla.Height - ;
			This.Cnt_Contenedor.Edt_Cadena_SQL.Height)) - 10
		
		This.Cnt_Contenedor.Opt_Acciones.Left        = (This.cnt_contenedor.Width - This.Cnt_Contenedor.Opt_Acciones.Width)-4
		This.Cnt_Contenedor.Opt_Mantiene_Campos.Left = (This.cnt_contenedor.Width - This.Cnt_Contenedor.Opt_Mantiene_Campos.Width)-4
		This.Cnt_Contenedor.Cnt_Nro_Registros.Left   = (This.cnt_contenedor.Width - This.Cnt_Contenedor.Cnt_Nro_Registros.Width)-4
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Exportar.Left = (This.cnt_contenedor.Width - ;
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Exportar.Width)-10 &&4
		
		This.Cnt_Contenedor.Cnt_Relacion_Tablas.Width = (This.cnt_contenedor.Width - This.Cnt_Contenedor.Opt_Acciones.Width)-10
		This.Cnt_Contenedor.Cnt_Relacion_Tablas.Cnt_Seleccionar_Tablas.Left = (This.Cnt_Contenedor.Cnt_Relacion_Tablas.Width - ;
			This.Cnt_Contenedor.Cnt_Relacion_Tablas.Cnt_Seleccionar_Tablas.Width) - 3
		
		This.Cnt_Contenedor.Grd_Campos_Tabla.Width = (This.cnt_contenedor.Width - This.Cnt_Contenedor.Opt_Mantiene_Campos.Width)-9
		This.Cnt_Contenedor.Edt_Cadena_SQL.Width = (This.cnt_contenedor.Width - This.Cnt_Contenedor.Cnt_Nro_Registros.Width)-10
		
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Buscar.Width = (This.cnt_contenedor.Width - ;
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Mantiene_Tabla.Width - ;
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Exportar.Width) - 12
		
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Buscar.Txt_Buscar.Width = (This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Buscar.Width - ;
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Buscar.Lbl_Buscar.Width - ;
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Buscar.chk_Buscar.Width) - 28
		
		
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.Width = (This.cnt_contenedor.Width - ;
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Indices_Busqueda.Width)-12
		
		
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Indices_Busqueda.Left   = (This.cnt_contenedor.Width - ;
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Indices_Busqueda.Width) - 10
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cmd_Indices_Busqueda.Left   = This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Indices_Busqueda.Left
		
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.Height = (This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Height - ;
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Mantiene_Tabla.Height - ;
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Registros_Consulta.Height) - 5 &&6
		
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Indices_Busqueda.Height = ;
			(This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.Height - ;
			 This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cmd_Indices_Busqueda.Height) - 1
		
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cmd_Indices_Busqueda.Top = ;
			(This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.Top + ;
			 This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Indices_Busqueda.Height) + 1
			
		
		*!*	This.Cnt_Contenedor.Grd_Indices_Busqueda.Height = (This.Cnt_Contenedor.Grd_Examinar.Height - ;
		*!*		This.Cnt_Contenedor.Cmd_Indices_Busqueda.Height) - 1
		*!*	This.Cnt_Contenedor.Grd_Indices_Busqueda.Left   = (This.cnt_contenedor.Width - This.Cnt_Contenedor.Grd_Indices_Busqueda.Width)-4
		*!*	This.Cnt_Contenedor.Cmd_Indices_Busqueda.Left   = This.Cnt_Contenedor.Grd_Indices_Busqueda.Left
		*!*	This.Cnt_Contenedor.Cmd_Indices_Busqueda.Top    = (This.Cnt_Contenedor.Grd_Examinar.Top + ;
		*!*		This.Cnt_Contenedor.Grd_Indices_Busqueda.Height) + 1
		
		*!*	This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Registros_Consulta.Top = (This.cnt_contenedor.Height - ;
		*!*		This.Cnt_Contenedor.Cnt_Registros_Consulta.Height) - 3
		
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Registros_Consulta.Top = (This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Height -;
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Registros_Consulta.Height) - 2
		
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Registros_Consulta.Width = 	(This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.Width + ;
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Indices_Busqueda.Width) + 1
		
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Registros_Consulta.Txt_Registros_Indice_Busqueda.Width = (;
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Registros_Consulta.Width - ;
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Registros_Consulta.lbl_Registros_Consulta.Width - ;
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Registros_Consulta.txt_Registros_Consulta.Width - ;
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Registros_Consulta.lbl_Registro_Activo_Consulta.Width - ;
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Registros_Consulta.txt_Registro_Activo_Consulta.Width - ;
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Registros_Consulta.lbl_Registros_Indice_Busqueda.Width) - 35
		
		This.Cnt_Contenedor.Cnt_Relacion_Tablas.Grd_Tablas.Width = This.Cnt_Contenedor.Cnt_Relacion_Tablas.Width -;
			This.Cnt_Contenedor.Cnt_Relacion_Tablas.Cnt_Seleccionar_Tablas.Width - 8
		
		
		
		this.Refresh()
		Thisform.LockScreen = .f.
		
	ENDPROC

