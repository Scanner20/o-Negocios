		*!*	    With lo_Selection2.Borders(xlEdgeBottom)
		*!*	        .LineStyle = xlContinuous
		*!*	        .Weight = xlMedium
		*!*	        .ColorIndex = xlAutomatic
		*!*	    EndWith
		*!*	    With lo_Selection2.Borders(xlEdgeRight)
