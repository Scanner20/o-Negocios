	PROCEDURE Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Buscar.Chk_Buscar.Click
		IF !USED("CUR_DATOS")
			RETURN
		ENDIF
		IF This.Value = 0
			SELECT "CUR_DATOS"
			IF EMPTY(TAG())
				RETURN
			ENDIF
			SET KEY TO
			GO TOP
		ENDIF
		This.parent.Txt_Buscar.InteractiveChange()
		This.parent.Txt_Buscar.SetFocus()
		
	ENDPROC

	PROCEDURE Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Buscar.Chk_Buscar.When
		IF ALLTRIM(This.parent.Txt_Buscar.Value)=="FALTA GENERAR INDICE"
			RETURN .f.
		ENDIF
		
	ENDPROC

	PROCEDURE Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Buscar.Txt_Buscar.InteractiveChange
		IF !USED("CUR_DATOS")
			RETURN
		ENDIF
		SELECT "CUR_DATOS"
		IF EMPTY(TAG())
			RETURN
		ENDIF
		
		This.parent.parent.parent.parent.ph_activa_busqueda = .t.
		
		IF This.parent.Chk_Buscar.Value = 0
			=SEEK(ALLTRIM(NVL(This.Value,'')))
		ELSE
			SET KEY TO ALLTRIM(NVL(This.Value,''))
			GO TOP
			This.parent.parent.parent.parent.mh_registros_totales_consulta()
		ENDIF
		This.parent.parent.Grd_Examinar.AfterRowColChange()
		
	ENDPROC

	PROCEDURE Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Buscar.Txt_Buscar.When
		IF EMPTY(ALLTRIM(This.parent.parent.Cnt_Registros_Consulta.Txt_Registros_Indice_Busqueda.Value))
			This.BackColor = RGB(192,192,192)
			This.value = "FALTA GENERAR INDICE"
			This.parent.Chk_Buscar.Value = 0
			This.parent.Chk_Buscar.When()
			RETURN .f.
		ELSE
			this.BackColor = RGB(255,255,255)
			IF ALLTRIM(This.Value)=="FALTA GENERAR INDICE"
				this.Value = ""
			ENDIF
		ENDIF
		This.InteractiveChange()
		
	ENDPROC

	PROCEDURE Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Exportar.cmd_Exporta_Base_Datos.Click
		IF !This.parent.parent.parent.parent.mh_verifica_conexion_base_datos()
			RETURN .f.
		ENDIF
		IF !USED("CUR_DATOS")
			MESSAGEBOX("Pulse sobre el botón ejecutar para generar el cursor de datos",64,"INDICES")
			RETURN .f.
		ENDIF
		Thisform.LockScreen = .t.
		This.parent.parent.Visible = .f.
		This.parent.parent.parent.parent.mh_activa_migracion_base_datos("1")
		This.Parent.Parent.Parent.Parent.Cnt_Proceso_Migracion.Refresh()
		Thisform.LockScreen = .f.
		
	ENDPROC

