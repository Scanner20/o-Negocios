		*!*	    lo_Selection2.Borders(xlDiagonalDown).LineStyle = xlNone
		*!*	    lo_Selection2.Borders(xlDiagonalUp).LineStyle = xlNone
		*!*	    With lo_Selection2.Borders(xlEdgeLeft)
