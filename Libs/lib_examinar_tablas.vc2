	PROCEDURE Cnt_Contenedor.Grd_Campos_Tabla.Col_Columna_Nombre.Cbo_Listado_Columnas.Valid
		IF !USED("CUR_CAMPOS")
			RETURN
		ENDIF
		SELECT "CUR_CAMPOS"
		REPLACE CUR_CAMPOS.cur_bdatos WITH CUR_LISTA_CAMPOS.cur_bdatos
		REPLACE CUR_CAMPOS.cur_propie WITH CUR_LISTA_CAMPOS.cur_propie
		REPLACE CUR_CAMPOS.cur_tiptab WITH CUR_LISTA_CAMPOS.cur_tiptab
		REPLACE CUR_CAMPOS.cur_nomtab WITH CUR_LISTA_CAMPOS.cur_nomtab
		REPLACE CUR_CAMPOS.cur_alitab WITH CUR_LISTA_CAMPOS.cur_alitab
		REPLACE CUR_CAMPOS.cur_destab WITH CUR_LISTA_CAMPOS.cur_destab
		REPLACE CUR_CAMPOS.cur_descam WITH CUR_LISTA_CAMPOS.cur_descam
		REPLACE CUR_CAMPOS.cur_tipdat WITH CUR_LISTA_CAMPOS.cur_tipdat
		REPLACE CUR_CAMPOS.cur_tidato WITH CUR_LISTA_CAMPOS.cur_tidato
		REPLACE CUR_CAMPOS.cur_longit WITH CUR_LISTA_CAMPOS.cur_longit
		REPLACE CUR_CAMPOS.cur_decima WITH CUR_LISTA_CAMPOS.cur_decima
		
		This.parent.parent.AfterRowColChange()
		
	ENDPROC

