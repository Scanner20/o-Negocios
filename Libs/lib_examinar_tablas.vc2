	PROCEDURE Destroy
		This.mh_quita_origen_de_datos()
		this.mh_desactiva_onkey_label()
		this.mh_desconexion_base_datos()
		This.mh_proceso_migracion_desconexion_base_datos()
		CLOSE DATABASES ALL 
		
		
	ENDPROC

	PROCEDURE Init
		This.mh_activa_onkey_label()
		
		this.mh_setear_entorno()
		this.mh_objetos_miembros_formulario()
		
		***--- asigna valores de referencia de conexión activa
		This.ph_l_referencia_servidor_activo         = IIF(EMPTY(ALLTRIM(This.userp_referencia_servidor_activo)),"",;
														ALLTRIM(This.userp_referencia_servidor_activo))
		This.ph_l_referencia_bados_datos_odbc_activo = IIF(EMPTY(ALLTRIM(This.userp_referencia_bados_datos_odbc_activo)),"",;
														ALLTRIM(This.userp_referencia_bados_datos_odbc_activo))
		This.ph_l_referencia_usuario_activo          = IIF(EMPTY(ALLTRIM(This.userp_referencia_usuario_activo)),"",;
														ALLTRIM(This.userp_referencia_usuario_activo))
		This.ph_l_referencia_contrasena_activo       = IIF(EMPTY(ALLTRIM(This.userp_referencia_contrasena_activo)),"",;
														ALLTRIM(This.userp_referencia_contrasena_activo))
		
		
		This.ph_s_servidor    = ""
		This.ph_s_odbc_BDatos = ""
		This.ph_s_usuario     = ""
		This.ph_s_contrasena  = ""
		This.ph_s_servidor_imagen    = ""
		This.ph_s_odbc_BDatos_imagen = ""
		This.ph_s_usuario_imagen     = ""
		This.ph_s_contrasena_imagen  = ""
		This.ph_l_cambio_origen_de_datos = .t.
		This.ph_l_exito_conexion = .f.
		
		This.ph_s_curdir = CURDIR()
		Thisform.Caption = "Examinar Tabla"
		ThisForm.ShowTips = .t.
		
		This.ph_s_verision_visual_vfp = VERSION(4)
		This.ph_s_verision_visual_vfp = LEFT(This.ph_s_verision_visual_vfp,2)
		This.mh_configura_graficos()
		
		this.ph_l_inicializa_objeto = .t.
		this.ph_n_height_objeto = this.Height
		this.ph_n_width_objeto  = this.Width
		
		this.ph_n_height_formulario = thisform.Height
		this.ph_n_width_formulario  = thisform.Width
		
		This.Cnt_Coneccion_Base_Datos.Visible = .f.
		This.Cnt_Seleccionar_Tablas.Visible = .f.
		
		this.ph_n_backcolor_original = this.BackColor
		This.ph_n_backcolor_accion   = RGB(192,192,192)
		
		This.ph_l_cambio_origen_de_datos = .t.
		This.Cnt_Contenedor.Opt_Acciones.Conexion.Click()
		
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.RecordSource = ""
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.ColumnCount = -1
		
		*!*	This.Cnt_Coneccion_Base_Datos.OPt_Tipo_Conexion.Conexion_Directo.Click()
		*!*	This.Cnt_Coneccion_Base_Datos.OPt_Tipo_Conexion.Conexion_Directo.Value = 1
		*!*	This.Cnt_Coneccion_Base_Datos.OPt_Tipo_Conexion.conexion_Origen_ODBC.Value = 0
		*!*	This.Cnt_Coneccion_Base_Datos.TXT_Servidor.Value = "LHUAPAYA"
		*!*	This.Cnt_Coneccion_Base_Datos.TXt_Base_datos_ODBC.Value = "XIMESA"
		*!*	This.Cnt_Coneccion_Base_Datos.TXT_Usuario.Value = "LHUAPAYA"
		*!*	This.Cnt_Coneccion_Base_Datos.TXT_Contrasena.Value = "LUIHUA"
		
	ENDPROC

	PROCEDURE mh_activa_coneccion_base_datos		&& activa pantalla de conexion a la base de datos
		***======================================================================================================
		*** Activa pantalla de conexión a la base de datos
		***======================================================================================================
		thisform.LockScreen = .t.
		This.Cnt_Coneccion_Base_Datos.Resize()
		This.Cnt_Coneccion_Base_Datos.Visible = .t.
		thisform.LockScreen = .f.
		
		IF this.ph_l_inicializa_objeto = .t.
			This.Cnt_Coneccion_Base_Datos.Opt_Tipo_Conexion.Conexion_Origen_ODBC.Value = 1
			This.Cnt_Coneccion_Base_Datos.Opt_Tipo_Conexion.Referencia_Conexion_Activa.Value      = 0
			This.Cnt_Coneccion_Base_Datos.Opt_Tipo_Conexion.Conexion_Directo.Value     = 0
			This.Cnt_Coneccion_Base_Datos.Opt_Tipo_Conexion.Conexion_Origen_ODBC.Click()
		ENDIF
		
	ENDPROC

	PROCEDURE mh_activa_migracion_base_datos
		***======================================================================================================
		*** Activa Migracion de base de datos
		***======================================================================================================
		PARAMETERS p_accion
		This.Cnt_Proceso_Migracion.Grd_Examinar.Visible = .t.
		This.Cnt_Proceso_Migracion.Grd_Examinar.AfterRowColChange()
		This.BackColor = This.ph_n_backcolor_accion
		
		
		This.Cnt_Proceso_Migracion.Txt_Servidor_Origen.Value   = ALLTRIM(This.ph_s_servidor)
		This.Cnt_Proceso_Migracion.txt_Base_Datos_Origen.Value = ALLTRIM(This.ph_s_odbc_BDatos)
		This.Cnt_Proceso_Migracion.txt_usuario_Origen.Value    = ALLTRIM(This.ph_s_usuario)
		This.Cnt_Proceso_Migracion.Txt_Contrasena.Value        = ALLTRIM(This.ph_s_contrasena)
		IF This.Cnt_Coneccion_Base_Datos.Opt_Tipo_Conexion.Conexion_Directo.Value = 1
			This.Cnt_Proceso_Migracion.lbl_base_Datos_Origen.Caption = "Base de Datos:"
		ELSE
			This.Cnt_Proceso_Migracion.lbl_base_Datos_Origen.Caption = "ODBC:"
		ENDIF
		SELECT "CUR_TABLAS"
		GO TOP
		
		IF !EMPTY(ALLTRIM(This.Cnt_Proceso_Migracion.txt_servidor_Destino.Value))
			This.Cnt_Proceso_Migracion.Opt_Tipo_Conexion.Conexion_Origen_ODBC.Value = 0
			This.Cnt_Proceso_Migracion.Opt_Tipo_Conexion.Referencia_Origen.Value      = 0	
			This.Cnt_Proceso_Migracion.Opt_Tipo_Conexion.Conexion_Directo.Value     = 1
			This.Cnt_Proceso_Migracion.Opt_Tipo_Conexion.Conexion_Directo.Click()
		ELSE
			This.Cnt_Proceso_Migracion.Opt_Tipo_Conexion.Conexion_Origen_ODBC.Value = 1
			This.Cnt_Proceso_Migracion.Opt_Tipo_Conexion.Referencia_Origen.Value      = 0	
			This.Cnt_Proceso_Migracion.Opt_Tipo_Conexion.Conexion_Directo.Value     = 0
			This.Cnt_Proceso_Migracion.Opt_Tipo_Conexion.Conexion_Origen_ODBC.Click()
		ENDIF
		
		SELECT "CUR_DATOS"
		GO TOP
		SELECT "CUR_INDICES"
		GO TOP
		
		SELECT "CUR_MIGRA_TABLAS"
		ZAP
		SELECT "CUR_TABLAS"
		GO TOP
		SCAN
			SELECT "CUR_MIGRA_TABLAS"
			APPEND BLANK
			REPLACE CUR_MIGRA_TABLAS.cur_corite WITH CUR_TABLAS.cur_corite
			REPLACE CUR_MIGRA_TABLAS.cur_bdatos WITH CUR_TABLAS.cur_bdatos
			REPLACE CUR_MIGRA_TABLAS.cur_propie WITH CUR_TABLAS.cur_propie
			REPLACE CUR_MIGRA_TABLAS.cur_tiptab WITH CUR_TABLAS.cur_tiptab
			REPLACE CUR_MIGRA_TABLAS.cur_nomtab WITH CUR_TABLAS.cur_nomtab
			REPLACE CUR_MIGRA_TABLAS.cur_alitab WITH CUR_TABLAS.cur_alitab
			REPLACE CUR_MIGRA_TABLAS.cur_destab WITH CUR_TABLAS.cur_destab
		ENDSCAN
		SELECT "CUR_TABLAS"
		GO TOP
		***--- carga por defecto el primer registro de las tablas seleccionadas. el primero es el principal
		SELECT "CUR_MIGRA_TABLAS"
		GO TOP
		This.Cnt_Proceso_Migracion.Cbo_Tabla_Nombre_Migracion.Requery()
		IF !EOF("CUR_MIGRA_TABLAS")
			This.Cnt_Proceso_Migracion.Cbo_Tabla_Nombre_Migracion.ListIndex = 1
		ENDIF
		
		This.Cnt_Proceso_Migracion.Cbo_Tabla_Nombre_Migracion.InteractiveChange()
		
		This.Cnt_Proceso_Migracion.clS_PROGRESO.mh_limpiar()
		
		This.Cnt_Proceso_Migracion.Visible = .t.
		This.Cnt_Proceso_Migracion.Resize()
		This.Cnt_Proceso_Migracion.Refresh()
		
		
	ENDPROC

	PROCEDURE mh_activa_onkey_label
		***======================================================================================================
		*** Activa teclas de acceso rapido
		***======================================================================================================
		ps_nombre_objeto = ALLTRIM(This.Name)
		ps_macro = "ON KEY LABEL F5 " + "_screen.activeform." + ps_nombre_objeto + ;
				   ".Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Mantiene_Tabla.Cmd_Ejecuta_SQL.click()"
		&ps_macro
		ps_macro = "ON KEY LABEL CTRL+F11 " + "_screen.activeform." + ps_nombre_objeto + ;
		           ".mh_tamano_estandar_formulario"
		&ps_macro
		
		ps_macro_f2 = "ON KEY LABEL F2 _screen.ActiveForm." + ps_nombre_objeto + ".Cnt_Contenedor.Opt_Mantiene_Campos.Nuevo.Click()"
		ps_macro_f3 = "ON KEY LABEL F3 _screen.ActiveForm." + ps_nombre_objeto + ".Cnt_Contenedor.Opt_Mantiene_Campos.Elimina.Click()"
		&ps_macro_f2
		&ps_macro_f3
		
	ENDPROC

	PROCEDURE mh_activa_relacion_tablas
		***======================================================================================================
		*** Activa Relación de tablas
		***======================================================================================================
		PARAMETERS p_accion
		This.Cnt_Disenador_Relacion.Grd_Tablas_Seleccionadas.Visible = .t.
		This.Cnt_Disenador_Relacion.Grd_Tablas_Seleccionadas.AfterRowColChange()
		
		This.Cnt_Disenador_Relacion.Opt_Selecciona_Tablas.Aceptar.Value = 0
		This.Cnt_Disenador_Relacion.Opt_Selecciona_Tablas.Cancelar.Value = 0
		
		This.BackColor = This.ph_n_backcolor_accion
		This.Cnt_Disenador_Relacion.Visible = .t.
		This.Cnt_Disenador_Relacion.Resize()
		
	ENDPROC

	PROCEDURE mh_activa_seleccionar_tablas		&& activa listado para seelccionar tablas
		***======================================================================================================
		*** Activa listado de selección de tablas
		***======================================================================================================
		PARAMETERS p_accion
		This.Cnt_Seleccionar_Tablas.Grd_Lista_Tablas.RecordSource = ""
		This.Cnt_Seleccionar_Tablas.Grd_Lista_Tablas.Visible = .t.
		This.Cnt_Disenador_Relacion.Grd_Tablas_Seleccionadas.Visible = .t.
		IF !USED("CUR_LISTA_TABLAS")
			CREATE CURSOR CUR_LISTA_TABLAS (cur_indica n    , cur_bdatos c(100), cur_propie c(100),;
										    cur_tiptab c(10), cur_nomtab c(100), cur_destab c(100))
			INDEX ON ALLTRIM(CUR_LISTA_TABLAS.cur_nomtab) TAG i ADDITIVE
		ENDIF
		IF This.ph_l_cambio_origen_de_datos = .T.
			SELECT "CUR_LISTA_TABLAS"
			ZAP
			DO CASE
				CASE p_accion == "BD"
					PRIVATE ps_cadena
					ps_cadena="SP_TABLES "
					IF SQLEXEC(this.conexion,ps_cadena,"TMPVAL")<1
						MESSAGEBOX("Error al abrir el cursor de tablas < SP_TABLES >"+CHR(13)+MESSAGE(),16,"TABLAS")
						This.ph_l_cambio_origen_de_datos = .T.
						RETURN .F.
					ENDIF
				CASE p_accion == "DI"
		
				OTHERWISE
		
			ENDCASE
			SELECT "TMPVAL"
			GO TOP
			SCAN FOR (ALLTRIM(TMPVAL.Table_Type)=="TABLE" OR ALLTRIM(TMPVAL.Table_Type)=="VIEW")
				SELECT "CUR_LISTA_TABLAS"
				APPEND BLANK
				REPLACE CUR_LISTA_TABLAS.cur_indica WITH 0
				REPLACE CUR_LISTA_TABLAS.cur_bdatos WITH UPPER(NVL(TMPVAL.TABLE_QUALIFIER,''))
				REPLACE CUR_LISTA_TABLAS.cur_propie WITH UPPER(NVL(TMPVAL.TABLE_OWNER,''))
				REPLACE CUR_LISTA_TABLAS.cur_tiptab WITH UPPER(NVL(TMPVAL.TABLE_TYPE,''))
				REPLACE CUR_LISTA_TABLAS.cur_nomtab WITH UPPER(NVL(TMPVAL.TABLE_NAME,''))
				REPLACE CUR_LISTA_TABLAS.cur_destab WITH ""
				SELECT "TMPVAL"
			ENDSCAN
			SELECT "CUR_LISTA_TABLAS"
			GO TOP
		ENDIF
		This.ph_l_cambio_origen_de_datos = .F.
		SELECT "CUR_LISTA_TABLAS"
		
		This.Cnt_Seleccionar_Tablas.Grd_Lista_Tablas.RecordSourceType = 1
		This.Cnt_Seleccionar_Tablas.Grd_Lista_Tablas.RecordSource     = "CUR_LISTA_TABLAS"
		This.Cnt_Seleccionar_Tablas.Grd_Lista_Tablas.Column1.ControlSource = "UPPER(CUR_LISTA_TABLAS.cur_tiptab)"
		This.Cnt_Seleccionar_Tablas.Grd_Lista_Tablas.Column2.ControlSource = "UPPER(CUR_LISTA_TABLAS.cur_nomtab)"
		This.Cnt_Seleccionar_Tablas.Grd_Lista_Tablas.Column3.ControlSource = "CUR_LISTA_TABLAS.cur_indica"
		
		This.ph_l_activa_seleccion_tablas = .t.
		This.Cnt_Seleccionar_Tablas.Grd_Lista_Tablas.AfterRowColChange()
		This.Cnt_Seleccionar_Tablas.txt_busca.SetFocus()
		This.Cnt_Seleccionar_Tablas.txt_busca.InteractiveChange()
		This.Cnt_Disenador_Relacion.Grd_Tablas_Seleccionadas.AfterRowColChange()
		
		This.Cnt_Disenador_Relacion.Opt_Selecciona_Tablas.Aceptar.Value = 0
		This.Cnt_Disenador_Relacion.Opt_Selecciona_Tablas.Cancelar.Value = 0
		This.Cnt_Seleccionar_Tablas.Opt_Filtros_Selecciona_Tablas.Todos.Value = 0
		This.Cnt_Seleccionar_Tablas.Opt_Filtros_Selecciona_Tablas.Tablas.Value = 0
		This.Cnt_Seleccionar_Tablas.Opt_Filtros_Selecciona_Tablas.Vistas.Value = 0
		This.Cnt_Seleccionar_Tablas.Opt_Filtros_Selecciona_Tablas.desmarcar.Value = 0
		
		This.Cnt_Seleccionar_Tablas.Resize()
		
		This.BackColor = This.ph_n_backcolor_accion
		This.Cnt_Seleccionar_Tablas.Visible = .t.
		This.Cnt_Disenador_Relacion.Visible = .t.
		This.Cnt_Seleccionar_Tablas.Resize()
		This.ph_l_activa_seleccion_tablas = .f.
		
	ENDPROC

	PROCEDURE mh_conexion_commit		&& ejecuta commit a la conexion
		***======================================================================================================
		*** Ejecuta COMMIT a la conexió
		*** parametro:
		*** p_indica_bdatos = "A" = Base de datos - Original,    "B" = Base de datos de Migración - Exporta
		***======================================================================================================
		PARAMETERS p_indica_bdatos
		IF p_indica_bdatos=="A"
		***----------------------------------------------------------------------------
		***--- Conexión de base de datos
		***----------------------------------------------------------------------------
			IF This.ph_l_conexion_Commit_transactions
				IF UPPER(This.ph_s_conexion_configuracion)=="TRANSACTIONS"
				   IF SQLCOMMIT(This.conexion)<0
				      MESSAGEBOX(MESSAGE(),"COMMIT: ERROR AL ACTUALIZAR BASE DE DATOS")
				      RETURN .F.
				   EndIf		
				ELSE
				   MESSAGEBOX("La Configuración No Esta en Tipo TRANSACTION",16,"COMMIT: ERROR DE CONEXION")
				   RETURN .F.
				ENDIF
			ELSE
			   IF SQLCOMMIT(This.conexion)<0
			      MESSAGEBOX(MESSAGE(),"COMMIT: ERROR AL ACTUALIZAR BASE DE DATOS")
			      RETURN .F.
			   ENDIF
			ENDIF
			RETURN .T.
		ELSE
		***----------------------------------------------------------------------------
		***--- Conexión de base de datos de MIGRACION
		***----------------------------------------------------------------------------
			IF This.ph_l_conexion_Commit_transactions
				IF UPPER(This.ph_s_conexion_configuracion)=="TRANSACTIONS"
				   IF SQLCOMMIT(This.MIGRACION_conexion)<0
				      MESSAGEBOX(MESSAGE(),"COMMIT: ERROR AL ACTUALIZAR BASE DE DATOS - MIGRACION")
				      RETURN .F.
				   EndIf		
				ELSE
				   MESSAGEBOX("La Configuración No Esta en Tipo TRANSACTION",16,"COMMIT: ERROR DE CONEXION - MIGRACION")
				   RETURN .F.
				ENDIF
			ELSE
			   IF SQLCOMMIT(This.MIGRACION_conexion)<0
			      MESSAGEBOX(MESSAGE(),"COMMIT: ERROR AL ACTUALIZAR BASE DE DATOS - MIGRACION")
			      RETURN .F.
			   ENDIF
			ENDIF
			RETURN .T.
		ENDIF
		
	ENDPROC

	PROCEDURE mh_conexion_configura
		***======================================================================================================
		*** Configura la conexión 
		*** parametro:
		*** p_indica_bdatos = "A" = Base de datos - Original,    "B" = Base de datos de Migración - Exporta
		***======================================================================================================
		PARAMETERS p_indica_bdatos
		IF p_indica_bdatos=="A"
		***----------------------------------------------------------------------------
		***--- Conexión de base de datos <Original>
		***----------------------------------------------------------------------------
			IF This.conexion>0 AND !EMPTY(This.ph_s_conexion_configuracion)
			   IF SQLSETPROP(This.conexion,This.ph_s_conexion_configuracion,This.ph_n_conexion_parametro)<0
			      MESSAGEBOX(MESSAGE(),16,"ERROR AL CONFIGURAR CONEXION")
			      RETURN .f. 
			   EndIf
			ELSE
			    MESSAGEBOX("NO SE HA INDICADO LA CONFIGURACION DE CONEXION",16,"ERROR AL CONFIGURAR")
				RETURN .f.
			ENDIF
		ELSE
		***----------------------------------------------------------------------------
		***--- Conexión de base de datos de MIGRACION
		***----------------------------------------------------------------------------
			IF This.MIGRACION_conexion>0 AND !EMPTY(This.ph_s_conexion_configuracion)
			   IF SQLSETPROP(This.MIGRACION_conexion,This.ph_s_conexion_configuracion,This.ph_n_conexion_parametro)<0
			      MESSAGEBOX(MESSAGE(),16,"ERROR AL CONFIGURAR CONEXION - MIGRACION")
			      RETURN .f. 
			   EndIf
			ELSE
			    MESSAGEBOX("NO SE HA INDICADO LA CONFIGURACION DE CONEXION - MIGRACION",16,"ERROR AL CONFIGURAR")
				RETURN .f.
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE mh_conexion_modo		&& modo de configuracion de la conexion.  transaccion,  o normal
		***======================================================================================================
		*** Modo de Configuración la conexión : transacción o normal
		*** Parametros:
		*** lmodo           = Modo de conexion:  1 = Libre,  2 = transacción
		*** p_indica_bdatos = "A" = Base de datos - Original,    "B" = Base de datos de Migración - Exporta     
		***======================================================================================================
		LPARAMETERS p_indica_bdatos,lmodo
		IF PARAMETERS()=0 OR !TYPE("lmodo")=="N" OR !BETWEEN(lmodo,1,2) OR !BETWEEN(p_indica_bdatos,"A","B")
		    MESSAGEBOX("El Metodo Modo de conexión tiene que enviarsele el Parametro 1 o 2"+CHR(13)+;
		    		   "Ademas debe de indicarse el origen de la base de datos  A o B",64,"MODO")
		    RETURN .f.
		ENDIF
		IF lmodo=1
		   IF UPPER(ALLTRIM(This.ph_s_conexion_configuracion))=="TRANSACTIONS"  AND This.ph_n_conexion_parametro=2
			  This.ph_n_conexion_parametro=1
			  This.mh_conexion_configura(p_indica_bdatos)
		   ENDIF
		   This.ph_s_conexion_configuracion="Asynchronous" 
		   This.ph_n_conexion_parametro=.f.
		ENDIF
		IF lmodo=2
		   This.ph_s_conexion_configuracion="Transactions" 
		   This.ph_n_conexion_parametro=2
		ENDIF
		IF !This.mh_conexion_configura(p_indica_bdatos)
			RETURN .f.
		ENDIF
		
	ENDPROC

	PROCEDURE mh_conexion_rollback		&& ejecuta rollback a la conexion
		***======================================================================================================
		*** Ejecuta ROLLBACK a la conexió
		*** parametro:
		*** p_indica_bdatos = "A" = Base de datos - Original,    "B" = Base de datos de Migración - Exporta
		***======================================================================================================
		PARAMETERS p_indica_bdatos
		IF p_indica_bdatos=="A"
		***----------------------------------------------------------------------------
		***--- Conexión de base de datos
		***----------------------------------------------------------------------------
			IF This.ph_l_conexion_Commit_transactions
				IF UPPER(This.ph_s_conexion_configuracion)=="TRANSACTIONS"
				   IF SQLROLLBACK(This.Conexion)<0
				      MESSAGEBOX(MESSAGE(),"ROLLBACK : ERROR AL ACTUALIZAR BASE DE DATOS")
				      RETURN .F.
				   EndIf		
				ELSE
				   MESSAGEBOX("La Configuración No Esta en Tipo TRANSACTION",16,"ROLLBACK : ERROR DE CONEXION")
				   RETURN .F.
				ENDIF
			ELSE
				IF SQLROLLBACK(This.Conexion)<0
					MESSAGEBOX(MESSAGE(),"ROLLBACK : ERROR AL ACTUALIZAR BASE DE DATOS")
					RETURN .F.
				EndIf		
			ENDIF
			RETURN .T.
		ELSE
		***----------------------------------------------------------------------------
		***--- Conexión de base de datos de MIGRACION
		***----------------------------------------------------------------------------
			IF This.ph_l_conexion_Commit_transactions
				IF UPPER(This.ph_s_conexion_configuracion)=="TRANSACTIONS"
				   IF SQLROLLBACK(This.MIGRACION_conexion)<0
				      MESSAGEBOX(MESSAGE(),"ROLLBACK : ERROR AL ACTUALIZAR BASE DE DATOS - MIGRACION")
				      RETURN .F.
				   EndIf		
				ELSE
				   MESSAGEBOX("La Configuración No Esta en Tipo TRANSACTION",16,"ROLLBACK : ERROR DE CONEXION - MIGRACION")
				   RETURN .F.
				ENDIF
			ELSE
				IF SQLROLLBACK(This.MIGRACION_conexion)<0
					MESSAGEBOX(MESSAGE(),"ROLLBACK : ERROR AL ACTUALIZAR BASE DE DATOS - MIGRACION")
					RETURN .F.
				EndIf		
			ENDIF
			RETURN .T.
		ENDIF
		
	ENDPROC

	PROCEDURE mh_configura_cadena_select_sql
		***============================================================================================
		***--- Configura la cadena SQL
		***--- Segun la seleccion que realize el usuario
		***============================================================================================
		PARAMETERS p_estado
		IF !USED("CUR_CAMPOS")
			RETURN
		ENDIF
		IF This.Cnt_Contenedor.Cnt_Nro_Registros.Chk_Avanzado.Value = 1
			***--- Indicador de avanzado. No necesita el asistente de campos
			RETURN
		ENDIF
		
		SELECT "CUR_CAMPOS"
		This.ph_n_recno_actual = RECNO()
		GO TOP
		COUNT TO PN_REGISTROS
		GO TOP
		IF PN_REGISTROS=0
			This.ph_n_recno_actual = 0
			RETURN
		ENDIF
		
		
		STORE "" TO ps_cadena_SQL,ps_cadena_campos,ps_cadena_tablas,ps_cadena_where
		STORE "" TO ps_configura_where,ps_cadena_top,ps_configura_order
		STORE "" TO ps_configura_where_or_1,ps_configura_where_or_2,ps_configura_where_or_3
		SELECT "CUR_CAMPOS"
		GO TOP
		SCAN
			ps_campo             = ALLTRIM(NVL(CUR_CAMPOS.cur_nomcam,''))
			ps_campo_alias       = ALLTRIM(NVL(CUR_CAMPOS.cur_alicam,''))
			ps_tabla             = ALLTRIM(NVL(CUR_CAMPOS.cur_nomtab,''))
			ps_tabla_propietario = ALLTRIM(NVL(CUR_CAMPOS.cur_propie,''))
			ps_tabla_alias       = ALLTRIM(NVL(CUR_CAMPOS.cur_alitab,''))
			pn_resultado         = NVL(CUR_CAMPOS.cur_result,0)
			ps_tipo_orden        = ALLTRIM(NVL(CUR_CAMPOS.cur_tipord,''))
			pn_secuencia_orden   = NVL(CUR_CAMPOS.cur_nroord,0)
			ps_sintaxis_where    = ALLTRIM(NVL(CUR_CAMPOS.cur_criter,''))
			ps_or_where_1        = ALLTRIM(NVL(CUR_CAMPOS.cur_expre1,''))
			ps_or_where_2        = ALLTRIM(NVL(CUR_CAMPOS.cur_expre2,''))
			ps_or_where_3        = ALLTRIM(NVL(CUR_CAMPOS.cur_expre3,''))
			IF !EMPTY(ALLTRIM(ps_campo)) AND !EMPTY(ALLTRIM(ps_tabla))
				ps_configura_tabla = IIF(EMPTY(ps_tabla_alias), ps_tabla, ps_tabla_alias)
				ps_configura_tabla_campo = ps_configura_tabla + "." + ps_campo
		
				ps_configura_campo = IIF((EMPTY(ps_campo_alias) OR ps_campo=="*") , ps_campo, ps_campo + " AS " + "'" + ps_campo_alias+ "'")
				ps_configura_campo = ps_configura_tabla + "." + ps_configura_campo
		
				IF pn_resultado=1
					ps_cadena_campos = ps_cadena_campos + ps_configura_campo + ", "
				ENDIF
				ps_cadena_tablas   = "FROM " + IIF(!EMPTY(ps_tabla_propietario), ps_tabla_propietario + ".", "") + ps_tabla +;
									 IIF(EMPTY(ps_tabla_alias),"", " AS " + ps_tabla_alias)	
				ps_configura_where = ""
				IF !EMPTY(ps_sintaxis_where)
					ps_configura_where  = ps_configura_tabla_campo + " " + ps_sintaxis_where
					***--- SINTAXIS PARA UN VERIFICAR QUE ES IGUAL (=)
					ps_configura_where  = STRTRAN(UPPER(ps_configura_where), "AND=", "AND " + ps_configura_tabla_campo + " = ")
					ps_configura_where  = STRTRAN(UPPER(ps_configura_where), "OR=" , "OR "  + ps_configura_tabla_campo + " = ")
					***--- caso de excepción. despues de un AND o un OR, deja 1 espacio para colocar el igual
					ps_configura_where  = STRTRAN(UPPER(ps_configura_where), "AND =", "AND " + ps_configura_tabla_campo + " = ")
					ps_configura_where  = STRTRAN(UPPER(ps_configura_where), "OR =" , "OR "  + ps_configura_tabla_campo + " = ")		
					***--- caso de excepción. despues de un AND o un OR, deja 2 espacios para colocar el igual
					ps_configura_where  = STRTRAN(UPPER(ps_configura_where), "AND  =", "AND " + ps_configura_tabla_campo + " = ")
					ps_configura_where  = STRTRAN(UPPER(ps_configura_where), "OR  =" , "OR "  + ps_configura_tabla_campo + " = ")		
		
		
					***--- SINTAXIS PARA UN VERIFICAR QUE ES DIFERENTE (<>)
					ps_configura_where  = STRTRAN(UPPER(ps_configura_where), "AND<>", "AND " + ps_configura_tabla_campo + " <> ")
					ps_configura_where  = STRTRAN(UPPER(ps_configura_where), "OR<>" , "OR "  + ps_configura_tabla_campo + " <> ")
					***--- caso de excepción. despues de un AND o un OR, deja 1 espacio para colocar el igual
					ps_configura_where  = STRTRAN(UPPER(ps_configura_where), "AND <>", "AND " + ps_configura_tabla_campo + " <> ")
					ps_configura_where  = STRTRAN(UPPER(ps_configura_where), "OR <>" , "OR "  + ps_configura_tabla_campo + " <> ")		
					***--- caso de excepción. despues de un AND o un OR, deja 2 espacios para colocar el igual
					ps_configura_where  = STRTRAN(UPPER(ps_configura_where), "AND  <>", "AND " + ps_configura_tabla_campo + " <> ")
					ps_configura_where  = STRTRAN(UPPER(ps_configura_where), "OR  <>" , "OR "  + ps_configura_tabla_campo + " <> ")		
		
				ENDIF
				ps_cadena_where    = ps_cadena_where + IIF(!EMPTY(ps_configura_where), " ( " + ps_configura_where + " ) " + CHR(13) + "   AND ", "")
			
				ps_configura_order = ps_configura_order + ;
									 IIF((EMPTY(ALLTRIM(NVL(ps_tipo_orden,''))) OR ps_tipo_orden="0" OR ps_campo=="*"),"",;
									 IIF(ps_tipo_orden="0", "", ps_configura_tabla_campo) +;
									 IIF(ps_tipo_orden="0", "", IIF(ps_tipo_orden="1", " ASC",;
									 IIF(ps_tipo_orden="2", " DESC", ""))) + ", ")
									 
				ps_configura_where_or_1 = ps_configura_where_or_1 + ;
										  IIF(EMPTY(ps_or_where_1), "", ps_or_where_1 + " AND ")
				ps_configura_where_or_2 = ps_configura_where_or_2 + ;
										  IIF(EMPTY(ps_or_where_2), "", ps_or_where_2 + " AND ")
				ps_configura_where_or_3 = ps_configura_where_or_3 + ;
										  IIF(EMPTY(ps_or_where_3), "", ps_or_where_3 + " AND ")
			ENDIF
		ENDSCAN
		ps_cadena_campos = ALLTRIM(SUBSTR(ALLTRIM(ps_cadena_campos),1,LEN(ALLTRIM(ps_cadena_campos ))-1))
		ps_cadena_where  = ALLTRIM(SUBSTR(ALLTRIM(ps_cadena_where),1,LEN(ALLTRIM(ps_cadena_where))-4))
		ps_cadena_where  = IIF(!EMPTY(ps_cadena_where), "WHERE " + ps_cadena_where, "")
		
		ps_cadena_or_1   = ALLTRIM(SUBSTR(ALLTRIM(ps_configura_where_or_1),1,LEN(ALLTRIM(ps_configura_where_or_1))-4))
		ps_cadena_or_2   = ALLTRIM(SUBSTR(ALLTRIM(ps_configura_where_or_2),1,LEN(ALLTRIM(ps_configura_where_or_2))-4))
		ps_cadena_or_3   = ALLTRIM(SUBSTR(ALLTRIM(ps_configura_where_or_3),1,LEN(ALLTRIM(ps_configura_where_or_3))-4))
		
		ps_cadena_where  = ps_cadena_where + ;
						   IIF((!EMPTY(ps_cadena_where) AND !EMPTY(ps_cadena_or_1)), " "   + ps_cadena_or_1,;
						   IIF(( EMPTY(ps_cadena_where) AND !EMPTY(ps_cadena_or_1)), "WHERE " + ps_cadena_or_1, ""))
		
		ps_cadena_where  = ps_cadena_where + ;
						   IIF((!EMPTY(ps_cadena_where) AND !EMPTY(ps_cadena_or_2)), " "   + ps_cadena_or_2,;
						   IIF(( EMPTY(ps_cadena_where) AND !EMPTY(ps_cadena_or_2)), "WHERE " + ps_cadena_or_2, ""))
		
		ps_cadena_where  = ps_cadena_where + ;
						   IIF((!EMPTY(ps_cadena_where) AND !EMPTY(ps_cadena_or_3)), " "   + ps_cadena_or_3,;
						   IIF(( EMPTY(ps_cadena_where) AND !EMPTY(ps_cadena_or_3)), "WHERE " + ps_cadena_or_3, ""))
		
		
		ps_cadena_top    = IIF(This.Cnt_Contenedor.Cnt_Nro_Registros.Chk_Nro_Registros.Value=1,;
						   IIF(This.Cnt_Contenedor.Cnt_Nro_Registros.Spn_Nro_Registros.Value=0, "1",;
						   ALLTRIM(STR(This.Cnt_Contenedor.Cnt_Nro_Registros.Spn_Nro_Registros.Value))), "")
						   
		ps_cadena_top    = IIF(!EMPTY(ps_cadena_top), " TOP " + ps_cadena_top + " ", "")
		
		ps_cadena_order  = ALLTRIM(SUBSTR(ALLTRIM(ps_configura_order),1,LEN(ALLTRIM(ps_configura_order))-1))
		ps_cadena_order  = IIF(!EMPTY(ps_cadena_order), " ORDER BY " + ps_cadena_order, "")
		
		
		ps_cadena_tablas = IIF(!EMPTY(ps_cadena_tablas), CHR(13) + ps_cadena_tablas, "")
		ps_cadena_where  = IIF(!EMPTY(ps_cadena_where),  CHR(13) + ps_cadena_where, "")
		ps_cadena_order  = IIF(!EMPTY(ps_cadena_order),  IIF(EMPTY(ps_cadena_where),CHR(13),"") + ps_cadena_order, "")
		ps_cadena_SQL    = IIF(!EMPTY(ps_cadena_campos),;
						   "SELECT " + ps_cadena_top +;
						   ps_cadena_campos + " " + ps_cadena_tablas + " " + ps_cadena_where + "" + ps_cadena_order + " ","")
		
		SELECT "CUR_CAMPOS"
		GO TOP
		SCAN
			IF RECNO()==This.ph_n_recno_actual
				EXIT
			ENDIF
		ENDSCAN
		This.Cnt_Contenedor.Grd_Campos_Tabla.Refresh()
		
		IF !EMPTY(ALLTRIM(ps_cadena_SQL))
			This.Cnt_Contenedor.Edt_Cadena_SQL.Value = ps_cadena_SQL
		ENDIF
		
	ENDPROC

	PROCEDURE mh_configura_campos_imagen
		***======================================================================================================
