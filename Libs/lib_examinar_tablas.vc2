		this.RecordSource = ""
	ENDPROC

	PROCEDURE Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.Init
		This.RecordSourceType = 1
		This.RecordSource     = ""
		
	ENDPROC

	PROCEDURE Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.Refresh
		IF !USED(This.RecordSource)
			RETURN
		ENDIF
		SELECT (This.RecordSource)
		ps_regno = ALLTRIM(STR(RECNO()))
		IF This.parent.parent.parent.ph_activa_busqueda = .t.
			this.SetAll("DynamicBackColor","iif(recno()=&ps_regno,RGB(232,232,232),RGB(255,255,255))","COLUMN")
			this.SetAll("DynamicForeColor","iif(recno()=&ps_regno,RGB(0,0,128),RGB(0,0,0))","COLUMN")
		ELSE
			IF This.parent.parent.parent.ph_desactivar_color_grid_examinar = .t.
				this.SetAll("DynamicBackColor","iif(recno()=&ps_regno,RGB(255,255,255),RGB(255,255,255))","COLUMN")
				this.SetAll("DynamicForeColor","iif(recno()=&ps_regno,RGB(0,0,0),RGB(0,0,0))","COLUMN")
			ENDIF
		ENDIF
		This.parent.parent.parent.ph_desactivar_color_grid_examinar = .f.
		
	ENDPROC

	PROCEDURE Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.When
		This.parent.parent.parent.ph_activa_busqueda = .f.
		IF This.parent.parent.parent.ph_activa_busqueda = .t.
			This.parent.parent.parent.ph_desactivar_color_grid_examinar = .f.
		ELSE
			This.parent.parent.parent.ph_desactivar_color_grid_examinar = .t.
		ENDIF
		this.AfterRowColChange()
		This.parent.parent.parent.ph_desactivar_color_grid_examinar = .f.
		
	ENDPROC

