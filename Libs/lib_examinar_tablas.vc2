			RETURN .t.
		ELSE
			RETURN .f.
		ENDIF
		
	ENDPROC

	PROCEDURE Cnt_Proceso_Migracion.Cmd_Exportar.Click
		IF This.Parent.Opt_Conexion_Migracion.Nueva_Conexion.Value=1
			MESSAGEBOX("Error: Ejecute la conexión a la base de datos de MIGRACION",16,"Valida Conexión")
			RETURN .f.
		ENDIF
		IF EMPTY(ALLTRIM(NVL(This.Parent.Cbo_Tabla_Nombre_Migracion.Value,'')))
			MESSAGEBOX("Debe de ingresar el nombre de la tabla a exportar...!!!",64,"Tabla Exportar")
			RETURN .f.
		ENDIF
		
		IF This.Parent.Parent.ph_l_migracion_exito_conexion=.f.
			MESSAGEBOX("Error: No existe la conexion a la base de datos < MIGRACION >"+CHR(13)+;
					   "Reliace la conexión a la base de datos...!!!",64,"Conexion")
			RETURN .f.
		ENDIF
		IF MESSAGEBOX("Desea ejecutar el proceso de exportar datos ?",36,"Exportar")<>6
			RETURN .f.
		ENDIF
		This.parent.parent.Cnt_Proceso_Migracion.clS_PROGRESO.mh_limpiar()
		
		This.parent.parent.PH_L_Conexion_proceso_exito = .t.
		***--- configura la conexion a modo transacción
		
		This.parent.parent.MH_Conexion_modo("B",2)
		IF !This.parent.parent.mh_proceso_migracion_base_datos("1")
			This.parent.parent.PH_L_Conexion_proceso_exito = .f.
		ENDIF
		IF This.parent.parent.PH_L_Conexion_proceso_exito = .T.
			***--- si hubo exito: ejecuta commit
			This.parent.parent.mh_conexion_commit("B")
		ELSE
			***--- no hubo exito: ejecuta rollback
			This.parent.parent.MH_Conexion_rollback("B")
		ENDIF
		***--- configura la conexion a modo asincrono
		This.parent.parent.MH_Conexion_modo("B",1)
		
		IF This.parent.parent.PH_L_Conexion_proceso_exito = .T.
			MESSAGEBOX("Proceso termino con Exito...",64,"Exporta")
		ELSE
			This.parent.parent.Cnt_Proceso_Migracion.clS_PROGRESO.mh_limpiar()
			MESSAGEBOX(This.Parent.Parent.ph_s_mensaje_error_sql,16,"Proceso Migración")
		ENDIF
		WAIT CLEAR
		
	ENDPROC

