		*!*	        .ColorIndex = xlAutomatic
		*!*	    EndWith
		*!*	*-------------------------
		*!*	SCAN
		*!*		WITH lo_range4
		*!*			FOR li_i  = 1 TO (li_col - 4)
		*!*			**ldata = FIELD(li_i)
		*!*				IF li_i >= 8
		*!*					ldata = FIELD(li_i+1)
