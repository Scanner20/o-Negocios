	ENDPROC

	PROCEDURE Cnt_Contenedor.Grd_Campos_Tabla.Init
		This.RecordSourceType = 1
		This.RecordSource     = ""
		CREATE CURSOR CUR_CAMPOS(cur_corite c(5)  , cur_bdatos c(100) , cur_propie c(100),;
								 cur_tiptab c(10) , cur_nomtab c(100) , cur_alitab c(100),;
								 cur_destab c(100), cur_nomcam c(50)  , cur_descam c(100),;
								 cur_tipdat c(30) , cur_tidato c(1)   , cur_longit n(18,0),;
								 cur_decima n(10) , cur_alicam c(50)  , cur_result n(1,0),;
								 cur_tipord c(1)  , cur_nroord n(2,0) , cur_criter c(220),;
								 cur_expre1 c(220), cur_expre2 c(220) , cur_expre3 c(220),;
								 IMG_corite c(5)  , IMG_bdatos c(100) , IMG_propie c(100),;
								 IMG_tiptab c(10) , IMG_nomtab c(100) , IMG_alitab c(100),;
								 IMG_destab c(100), IMG_nomcam c(50)  , IMG_descam c(100),;
								 IMG_tipdat c(30) , IMG_tidato c(1)   , IMG_longit n(18,0),;
								 IMG_decima n(10) , IMG_alicam c(50)  , IMG_result n(1,0),;
								 IMG_tipord c(1)  , IMG_nroord n(2,0) , IMG_criter c(220),;
								 IMG_expre1 c(220), IMG_expre2 c(220) , IMG_expre3 c(220),;
								 cur_indest c(1))
		
		CREATE CURSOR CUR_LISTA_CAMPOS(cur_corite c(5)  , cur_bdatos c(100) , cur_propie c(100),;
								       cur_tiptab c(10) , cur_nomtab c(100) , cur_alitab c(100),;
								       cur_destab c(100), cur_nomcam c(50)  , cur_descam c(100),;
								       cur_tipdat c(30) , cur_tidato c(1)   , cur_longit n(18,0),;
								       cur_decima n(10))
		INDEX ON CUR_LISTA_CAMPOS.cur_corite TAG I ADDITIVE
		
		This.RecordSource                       = "CUR_CAMPOS"
		This.Col_Columna_Nombre.ControlSource   = "CUR_CAMPOS.cur_nomcam"
		This.Col_Columna_Alias.ControlSource    = "CUR_CAMPOS.cur_alicam"
		This.Col_tabla_Nombre.ControlSource     = "CUR_CAMPOS.cur_nomtab"
		This.Col_tabla_Alias.ControlSource      = "CUR_CAMPOS.cur_alitab"
		This.col_Campo_Resultado.ControlSource  = "CUR_CAMPOS.cur_result"
		This.Col_campo_Tipo_Orden.ControlSource = "CUR_CAMPOS.cur_tipord"
		This.Col_campo_Orden.ControlSource      = "CUR_CAMPOS.cur_nroord"
		This.Col_campo_Criterios.ControlSource  = "CUR_CAMPOS.cur_criter"
		This.Col_campo_Expresion.ControlSource  = "CUR_CAMPOS.cur_expre1"
		
		This.Col_Columna_Nombre.Cbo_Listado_Columnas.RowSourceType = 6
		This.Col_Columna_Nombre.Cbo_Listado_Columnas.RowSource     = "CUR_LISTA_CAMPOS.cur_nomcam,cur_nomtab,cur_tiptab,cur_descam"
		This.Col_Columna_Nombre.Cbo_Listado_Columnas.BoundColumn   = 1
		This.Col_Columna_Nombre.Cbo_Listado_Columnas.ColumnCount   = 4
		This.Col_Columna_Nombre.Cbo_Listado_Columnas.ColumnWidths  = "120,200,30,250"
		This.Col_Columna_Nombre.Cbo_Listado_Columnas.Requery()
		This.Col_Columna_Nombre.Cbo_Listado_Columnas.Refresh()
		
		
		
	ENDPROC

