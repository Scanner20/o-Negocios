		REPLACE CUR_CAMPOS.IMG_alitab WITH CUR_CAMPOS.cur_alitab
		REPLACE CUR_CAMPOS.IMG_destab WITH CUR_CAMPOS.cur_destab
		REPLACE CUR_CAMPOS.IMG_nomcam WITH CUR_CAMPOS.cur_nomcam
		REPLACE CUR_CAMPOS.IMG_descam WITH CUR_CAMPOS.cur_descam
		REPLACE CUR_CAMPOS.IMG_tipdat WITH CUR_CAMPOS.cur_tipdat
		REPLACE CUR_CAMPOS.IMG_tidato WITH CUR_CAMPOS.cur_tidato
		REPLACE CUR_CAMPOS.IMG_longit WITH CUR_CAMPOS.cur_longit
		REPLACE CUR_CAMPOS.IMG_decima WITH CUR_CAMPOS.cur_decima
		REPLACE CUR_CAMPOS.IMG_alicam WITH CUR_CAMPOS.cur_alicam
		REPLACE CUR_CAMPOS.IMG_result WITH CUR_CAMPOS.cur_result
		REPLACE CUR_CAMPOS.IMG_tipord WITH CUR_CAMPOS.cur_tipord
		REPLACE CUR_CAMPOS.IMG_nroord WITH CUR_CAMPOS.cur_nroord
		REPLACE CUR_CAMPOS.IMG_criter WITH CUR_CAMPOS.cur_criter
		REPLACE CUR_CAMPOS.IMG_expre1 WITH CUR_CAMPOS.cur_expre1
		REPLACE CUR_CAMPOS.IMG_expre2 WITH CUR_CAMPOS.cur_expre2
		
	ENDPROC

	PROCEDURE mh_configura_graficos
		PRIVATE ps_mtabla_sql,ps_mtabla_nuevo,ps_mtabla_elimina,ps_mtabla_inserta,ps_mtabla_graba
		PRIVATE ps_exporta_excel,ps_exporta_dbf
		PRIVATE ps_accion_conexion,ps_accion_salir
		PRIVATE ps_selecciona_tabla
		PRIVATE ps_grabar_consulta,ps_abrir_consulta
		PRIVATE ps_ruta_graficos
		PRIVATE ps_campo_sql_nuevo,ps_campo_sql_elimina,ps_campo_sql_inserta
		PRIVATE ps_migracion_exportar,ps_migracion_retorna
		PRIVATE ps_icono_sql
		
		STORE "" TO ps_mtabla_sql,ps_mtabla_nuevo,ps_mtabla_elimina,ps_mtabla_inserta,ps_mtabla_graba
		STORE "" TO ps_exporta_excel,ps_exporta_dbf
		STORE "" TO ps_accion_conexion,ps_accion_salir
		STORE "" TO ps_selecciona_tabla 
		STORE "" TO ps_grabar_consulta,ps_abrir_consulta
		STORE "" TO ps_campo_sql_nuevo,ps_campo_sql_elimina,ps_campo_sql_inserta
		STORE "" TO ps_migracion_exportar,ps_migracion_retorna
		STORE "" TO ps_icono_sql
		ps_ruta_graficos = IIF(!EMPTY(ALLTRIM(This.userp_directorio_graficos)),;
							ALLTRIM(This.userp_directorio_graficos),"")
		ps_icono_sql        = ps_ruta_graficos + "EXAMINADOR_ICONO_SQL.ico"
		***--- mantiene tabla
		ps_mtabla_sql       = ps_ruta_graficos + "EXAMINADOR_ejecutar.bmp"
		ps_mtabla_nuevo     = ps_ruta_graficos + "EXAMINADOR_nuevo.bmp"
		ps_mtabla_elimina   = ps_ruta_graficos + "EXAMINADOR_eliminar.bmp"
		ps_mtabla_graba     = ps_ruta_graficos + "EXAMINADOR_grabar.bmp"
		***--- exportar registros
		ps_exporta_excel    = ps_ruta_graficos + "EXAMINADOR_excel.bmp"
		ps_exporta_dbf      = ps_ruta_graficos + "EXAMINADOR_data.bmp"
		***--- acciones
		ps_accion_conexion  = ps_ruta_graficos + "EXAMINADOR_procesar.bmp"
		ps_accion_salir     = ps_ruta_graficos + "EXAMINADOR_cerrar.bmp"
		***--- relaciones de tablas
		ps_selecciona_tabla = ps_ruta_graficos + "EXAMINADOR_tabla.bmp"
		ps_relacion_tabla   = ps_ruta_graficos + "EXAMINADOR_relacion.bmp"
		***--- Grabar y abrir consulta
		ps_grabar_consulta  = ps_ruta_graficos + "EXAMINADOR_closed.bmp"
		ps_abrir_consulta   = ps_ruta_graficos + "EXAMINADOR_open.bmp"
		
		***--- Mantiene campos de selecciona de consulta
		ps_campo_sql_nuevo   = ps_ruta_graficos + "EXAMINADOR_Mas.bmp"
		ps_campo_sql_elimina = ps_ruta_graficos + "EXAMINADOR_Menos.bmp"
		ps_campo_sql_inserta = ""
		
		***--- Migración de tablas de base de datos
		ps_migracion_exportar = ps_ruta_graficos + "EXAMINADOR_exportar.bmp"
		ps_migracion_retorna  = ps_ruta_graficos + "EXAMINADOR_retornar.bmp"
		
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.cnt_mantiene_Tabla.cmd_ejecuta_SQL.Picture   = ps_mtabla_sql
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.cnt_mantiene_Tabla.Cmd_Abrir_DBF.Picture   = ps_mtabla_nuevo
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.cnt_mantiene_Tabla.cmd_Tabla_ELIMINA.Picture = ps_mtabla_elimina
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.cnt_mantiene_Tabla.cmd_Tabla_GRABA.Picture   = ps_mtabla_graba
		
		
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Exportar.Cmd_Exporta_Dbf.Picture        = ps_exporta_dbf
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Exportar.Cmd_Exporta_Excel.Picture      = ps_exporta_excel
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Exportar.cmd_Exporta_Base_Datos.Picture = ps_migracion_exportar
		
		This.Cnt_Contenedor.Opt_Acciones.Conexion.Picture = ps_accion_conexion
		This.Cnt_Contenedor.Opt_Acciones.Salir.Picture    = ps_accion_salir
		
		This.Cnt_Contenedor.Cnt_Relacion_Tablas.Cnt_Seleccionar_Tablas.Cmd_Seleccionar_Tablas.Picture = ps_selecciona_tabla 
		This.Cnt_Contenedor.Cnt_Relacion_Tablas.Cnt_Seleccionar_Tablas.cmd_Relacion_Tablas.Picture    = ps_relacion_tabla
		
		This.Cnt_Contenedor.Cnt_Nro_Registros.Cmd_Grabar_Consulta.Picture = ps_grabar_consulta
		This.Cnt_Contenedor.Cnt_Nro_Registros.Cmd_Abrir_Consulta.Picture  = ps_abrir_consulta
		This.Cnt_Contenedor.Cnt_Nro_Registros.Cmd_Grabar_Consulta.Caption = IIF(FILE(ps_grabar_consulta),"",This.Cnt_Contenedor.Cnt_Nro_Registros.Cmd_Grabar_Consulta.Caption)
		This.Cnt_Contenedor.Cnt_Nro_Registros.Cmd_Abrir_Consulta.Caption  = IIF(FILE(ps_abrir_consulta),"",This.Cnt_Contenedor.Cnt_Nro_Registros.Cmd_Abrir_Consulta.Caption)
		
		This.Cnt_Contenedor.Opt_Mantiene_Campos.Nuevo.Picture   = ps_campo_sql_nuevo
		This.Cnt_Contenedor.Opt_Mantiene_Campos.elimina.Picture = ps_campo_sql_elimina
		This.Cnt_Contenedor.Opt_Mantiene_Campos.inserta.Picture = ps_campo_sql_inserta
		This.Cnt_Contenedor.Opt_Mantiene_Campos.Nuevo.Caption   = IIF(FILE(ps_campo_sql_nuevo),"",This.Cnt_Contenedor.Opt_Mantiene_Campos.Nuevo.Caption)
		This.Cnt_Contenedor.Opt_Mantiene_Campos.elimina.Caption = IIF(FILE(ps_campo_sql_elimina),"",This.Cnt_Contenedor.Opt_Mantiene_Campos.elimina.Caption)
		This.Cnt_Contenedor.Opt_Mantiene_Campos.inserta.Caption = "I"
		
		This.Cnt_Proceso_Migracion.cmd_Exportar.Picture = ps_migracion_exportar
		This.Cnt_Proceso_Migracion.Cmd_Retornar.Picture = ps_migracion_retorna
		
		IF ALLTRIM(This.ph_s_verision_visual_vfp)>="08"
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.cnt_mantiene_Tabla.cmd_ejecuta_SQL.PicturePosition  = 1
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.cnt_mantiene_Tabla.Cmd_Abrir_DBF.PicturePosition  = 1
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.cnt_mantiene_Tabla.cmd_Tabla_ELIMINA.PicturePosition = 1
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.cnt_mantiene_Tabla.cmd_Tabla_GRABA.PicturePosition   = 1
		
		
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Exportar.Cmd_Exporta_Dbf.PicturePosition = 1
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Exportar.Cmd_Exporta_Excel.PicturePosition = 1
			This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Exportar.cmd_Exporta_Base_Datos.PicturePosition = 1
			
			This.Cnt_Contenedor.Opt_Acciones.Conexion.PicturePosition = 1
			This.Cnt_Contenedor.Opt_Acciones.Salir.PicturePosition = 1
		
			This.Cnt_Contenedor.Cnt_Relacion_Tablas.Cnt_Seleccionar_Tablas.Cmd_Seleccionar_Tablas.PicturePosition = 1
			This.Cnt_Contenedor.Cnt_Relacion_Tablas.Cnt_Seleccionar_Tablas.cmd_Relacion_Tablas.PicturePosition = 1
		ENDIF
		if file(ps_icono_sql)
			thisform.icon = ps_icono_sql
		endif
		
	ENDPROC

	PROCEDURE mh_desactiva_onkey_label
		***======================================================================================================
		*** Desactiva teclaso de acceso rapido
		***======================================================================================================
		ON KEY LABEL F2
		ON KEY LABEL F3
		ON KEY LABEL F5
		ON KEY LABEL CTRL+F11
		
	ENDPROC

	PROCEDURE mh_desconexion_base_datos
		***======================================================================================================
		*** Desconexion a base de datos
		***======================================================================================================
		IF this.ph_l_exito_conexion = .t.
			=SQLDISCONNECT(this.conexion)
		ENDIF
		this.ph_l_exito_conexion = .f.
		
	ENDPROC

	PROCEDURE mh_exportar_datos_dbf
		***======================================================================================================
		*** Exportar datos DBF
		***======================================================================================================
		PRIVATE PS_Nombre_Archivo,ps_cadena_macro
		IF !USED("CUR_DATOS")
			MESSAGEBOX("Pulse sobre el botón ejecutar para generar el cursor de datos",64,"INDICES")
			RETURN .f.
		ENDIF
		STORE "" TO This.ph_s_ruta_nombre_archivo,ps_cadena_macro
		ps_directorio = ALLTRIM(This.userp_directorio_dbf)
		IF !EMPTY(ALLTRIM(ps_directorio))
			ps_default_dbf = ALLTRIM(This.ph_s_curdir) + ps_directorio
			IF DIRECTORY(ps_default_dbf)
				SET DEFAULT TO (ps_default_dbf)
			ENDIF
		ENDIF
		This.ph_s_ruta_nombre_archivo = UPPER(ALLTRIM(PUTFILE("EXPORTAR DBF","","DBF")))
		IF EMPTY(ALLTRIM(This.ph_s_ruta_nombre_archivo))
			RETURN .F.
		ENDIF
		WAIT WINDOW "Exportando registros hacia formato < DBF >"+CHR(13)+;
					"Sirvase esperar...!!!" NOWAIT
		SELECT "CUR_DATOS"
		PS_Nombre_Archivo=This.ph_s_ruta_nombre_archivo
		ps_cadena_macro="SELECT * FROM CUR_DATOS INTO TABLE '" + PS_Nombre_Archivo + "'"
		&ps_cadena_macro
		ps_alias_activo = SELECT()
		USE IN (ps_alias_activo)
		SELECT "CUR_DATOS"
		GO TOP
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.AfterRowColChange()
	ENDPROC

	PROCEDURE mh_exportar_datos_excel
		***======================================================================================================
		*** Exportar datos a EXCEL
		***======================================================================================================
		PRIVATE PS_Nombre_Archivo,ps_cadena_macro
		IF !USED("CUR_DATOS")
			MESSAGEBOX("Pulse sobre el botón ejecutar para generar el cursor de datos",64,"INDICES")
			RETURN .f.
		ENDIF
		STORE "" TO This.ph_s_ruta_nombre_archivo,ps_cadena_macro
		ps_directorio = ALLTRIM(This.userp_directorio_excel)
		IF !EMPTY(ALLTRIM(ps_directorio))
			ps_default_excel = ALLTRIM(This.ph_s_curdir) + ps_directorio
			IF DIRECTORY(ps_default_excel)
				SET DEFAULT TO (ps_default_excel)
			ENDIF
		ENDIF
		This.ph_s_ruta_nombre_archivo = UPPER(ALLTRIM(PUTFILE("EXPORTAR EXCEL","","XLS")))
		IF EMPTY(ALLTRIM(This.ph_s_ruta_nombre_archivo))
			RETURN .F.
		ENDIF
		WAIT WINDOW "Exportando registros hacia formato < EXCEL >"+CHR(13)+;
					"Sirvase esperar...!!!" NOWAIT
		SELECT "CUR_DATOS"
		
		PS_Nombre_Archivo=This.ph_s_ruta_nombre_archivo
		ps_cadena_macro="COPY TO '" + PS_Nombre_Archivo + "' TYPE XLS"
		&ps_cadena_macro
		
		*ps_titulo = "EXPORTA DATOS A EXCEL"
		*This.mh_exportar_datos_excel_con_formato("CUR_DATOS",ps_titulo)
		
		SELECT "CUR_DATOS"
		GO TOP
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.AfterRowColChange()
	ENDPROC

	PROCEDURE mh_exportar_datos_excel_con_formato
		LPARAMETERS lpTable,p_titulo
		*-------------------
		lmesg = CHR(13)+"Enviando Reporte a Excel ......Sirvase Esperar"+CHR(13)
		li_ix = 0
		
		WAIT WINDOW lmesg  AT 900,1  nowa
		
		*-------------------
		SELECT(ALLTRIM(lpTable))
		*-----------------------
		*!*	DO CASE 
		*!*		CASE gOrden = 1
		*!*		SET ORDER TO D DESCENDING
		*!*		CASE gOrden = 2
		*!*		SET ORDER TO P1 DESCENDING
		*!*		CASE gOrden = 3
		*!*		SET ORDER TO P2 DESCENDING
		*!*	ENDCASE
		*-------------------
		#DEfine xlAscending 1 
		#Define xlDescending 2
		#DEfine xlGuess 0
		#Define xlTopToBottom 1
		#Define xlDiagonalDown  5
		#Define xlDiagonalUp 	6
