		*!*	*/------------------
		
		*!*	    With lo_XLS.ActiveSheet.PageSetup
		*!*	        .LeftMargin = lo_XLS.InchesToPoints(0.13)
		*!*	        .TopMargin = lo_XLS.InchesToPoints(0.13)
		*!*	        .Zoom = .F.
		*!*	        .FitToPagesWide = 1
		*!*	        .FitToPagesTall = 1
		*!*	    ENDWITH
		
		*!*	*//
		*!*	lo_sh = lo_XLS.ActiveWorkbook.ActiveSheet
		*!*	*//
		*!*	*!*	WITH lo_sh
		*!*	*!*	    .Columns("H:H").Select
		*!*	*!*	    .Range("H2").Activate
