		*m: mh_conexion_modo		&& modo de configuracion de la conexion.  transaccion,  o normal
		*m: mh_conexion_rollback		&& ejecuta rollback a la conexion
		*m: mh_configura_cadena_select_sql
		*m: mh_configura_campos_imagen
		*m: mh_configura_graficos
		*m: mh_desactiva_onkey_label
		*m: mh_desconexion_base_datos
		*m: mh_exportar_datos_dbf
		*m: mh_exportar_datos_excel
		*m: mh_exportar_datos_excel_con_formato
		*m: mh_inicializa_ejecuta_consulta
		*m: mh_mantiene_campos
		*m: mh_mantiene_tablas		&& insert, update, delete .  de la tabla sql
		*m: mh_objetos_miembros_formulario
		*m: mh_proceso_abrir_tabla_dbf
		*m: mh_proceso_coneccion_base_datos
		*m: mh_proceso_ejecuta_cadena_sql
		*m: mh_proceso_grabar_abrir_consulta
		*m: mh_proceso_migracion_base_datos
		*m: mh_proceso_migracion_conexion_base_datos
		*m: mh_proceso_migracion_desconexion_base_datos
		*m: mh_proceso_ordena_selecciona_tablas
		*m: mh_proceso_relacionar_tablas
		*m: mh_proceso_seleccionar_tablas		&& presenta listado de tablas para seleccionar
		*m: mh_quita_origen_de_datos
		*m: mh_registros_campos_consulta
		*m: mh_registros_campos_generar_indice
		*m: mh_registros_totales_consulta
		*m: mh_setear_entorno
		*m: mh_tamano_estandar_formulario
		*m: mh_verifica_conexion_base_datos
		*m: mh_vfp_tipo_dato_campo
		*p: conexion		&& propiedad de conexion a base de datos
		*p: migracion_conexion
		*p: ph_activa_busqueda
		*p: ph_desactivar_color_grid_examinar
		*p: ph_l_activa_seleccion_tablas		&& .t. = se activa la seleccion de tablas,   .f. = no se activa
		*p: ph_l_cambio_origen_de_datos		&& .t. = cambio el carga nuevamente el origen de datos de la tabla, por lo tanto se procede a carga el listao de las tablas nuevas del origen de datos. nuevo .f. = no cambio. sigue con el mismo origen de datos.
		*p: ph_l_conexion_commit_transactions
		*p: ph_l_conexion_proceso_exito		&& .t. = el proceso de actualizacion a la base de datos tuvo exito,  .f. = no tuvo exito
		*p: ph_l_exito_conexion		&& exito en conexion a la base de datos
		*p: ph_l_inicializa_objeto
		*p: ph_l_migracion_exito_conexion
		*p: ph_l_referencia_bados_datos_odbc_activo
		*p: ph_l_referencia_contrasena_activo
		*p: ph_l_referencia_servidor_activo
		*p: ph_l_referencia_usuario_activo
		*p: ph_n_backcolor_accion
		*p: ph_n_backcolor_original
		*p: ph_n_conexion_parametro		&& parametro de configuracion de la conexion
		*p: ph_n_height_formulario
		*p: ph_n_height_objeto
		*p: ph_n_recno_actual
		*p: ph_n_width_formulario
		*p: ph_n_width_objeto
		*p: ph_s_conexion_configuracion		&& guarda el la confguracion de la conexion
		*p: ph_s_contrasena
		*p: ph_s_contrasena_imagen
		*p: ph_s_curdir
		*p: ph_s_mensaje_error_sql
		*p: ph_s_migracion_contrasena
		*p: ph_s_migracion_odbc_bdatos
		*p: ph_s_migracion_servidor
		*p: ph_s_migracion_usuario
		*p: ph_s_nombre_control_statusbar		&& guarda el nombre del objeto status bar.  para redimensionar el alto del objeto
		*p: ph_s_odbc_bdatos
		*p: ph_s_odbc_bdatos_imagen
		*p: ph_s_ruta_nombre_archivo
		*p: ph_s_servidor
		*p: ph_s_servidor_imagen
		*p: ph_s_usuario
		*p: ph_s_usuario_imagen
		*p: ph_s_verision_visual_vfp
		*p: userp_directorio_consultas
		*p: userp_directorio_dbf
		*p: userp_directorio_excel
		*p: userp_directorio_graficos
		*p: userp_referencia_bados_datos_odbc_activo		&& referencia de la base de datos u origen de odbc. Del SISTEMA
		*p: userp_referencia_contrasena_activo		&& referencia de contraseña activo - DEL SISTEMA
		*p: userp_referencia_servidor_activo		&& nombre de servidor activo. En el Sistema
		*p: userp_referencia_usuario_activo		&& referencia del usuario activo - DEL SISTEMA
	*</DefinedPropArrayMethod>

	*<PropValue>
		BorderWidth = 0
