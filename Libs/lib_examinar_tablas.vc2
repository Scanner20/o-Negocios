	PROCEDURE Cnt_Seleccionar_Tablas.Resize
		This.Top    = This.parent.Cnt_Contenedor.Top
		This.Left   = This.parent.Cnt_Contenedor.Left
		This.Height = This.parent.Cnt_Contenedor.Height
		This.Width  = This.Parent.Cnt_Contenedor.Width
		
		This.Opt_Filtros_Selecciona_Tablas.Top = (this.Height - This.Opt_Filtros_Selecciona_Tablas.Height) - 4
		
		This.Shp_Lista_Tablas.Height = This.Height - This.Shp_Buscar_Tablas.Height - ;
									   This.Opt_Filtros_Selecciona_Tablas.Height - 10
		This.Grd_Lista_Tablas.Height = This.Shp_Lista_Tablas.Height - 10
		
		
		IF This.Visible = .T.
			This.parent.Cnt_Disenador_Relacion.Top    = This.Shp_Buscar_Tablas.Top + 4
			This.parent.Cnt_Disenador_Relacion.Left   = This.Shp_Buscar_Tablas.Width + 12
			This.parent.Cnt_Disenador_Relacion.Height = This.Height - 8
			This.parent.Cnt_Disenador_Relacion.Width  = (This.Width - This.Shp_Buscar_Tablas.Width) - 15
			This.parent.Cnt_Disenador_Relacion.Resize()
		ENDIF
		
	ENDPROC

	PROCEDURE Cnt_Seleccionar_Tablas.txt_busca.InteractiveChange
		IF !USED("CUR_LISTA_TABLAS")
			RETURN
		ENDIF
		
		SELECT "CUR_LISTA_TABLAS"
		SET ORDER TO I
		SET EXACT OFF
		IF This.Parent.Parent.ph_l_activa_seleccion_tablas=.t.
		ELSE
			=SEEK(ALLTRIM(this.Value))
		ENDIF
		This.parent.Grd_Lista_Tablas.AfterRowColChange()
		
		
	ENDPROC

	PROCEDURE Cnt_Seleccionar_Tablas.txt_busca.When
		this.InteractiveChange()
		
	ENDPROC

ENDDEFINE

DEFINE CLASS cls_progreso AS container 
 	*< CLASSDATA: Baseclass="container" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Shape10" UniqueID="" Timestamp="" />
