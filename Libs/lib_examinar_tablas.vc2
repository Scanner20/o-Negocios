	PROCEDURE Cnt_Coneccion_Base_Datos.Opt_Tipo_Conexion.Referencia_Conexion_Activa.Click
		This.parent.parent.Txt_Servidor.Value        = This.parent.parent.parent.ph_l_referencia_servidor_activo
		This.parent.parent.Txt_Base_datos_ODBC.Value = This.parent.parent.parent.ph_l_referencia_bados_datos_odbc_activo
		This.parent.parent.Txt_Usuario.Value         = This.parent.parent.parent.ph_l_referencia_usuario_activo
		This.parent.parent.Txt_Contrasena.Value      = This.parent.parent.parent.ph_l_referencia_contrasena_activo
		IF !EMPTY(ALLTRIM(This.parent.parent.parent.ph_l_referencia_servidor_activo))
			This.parent.parent.txt_servidor.Enabled    = .t.
			This.parent.parent.Lbl_Odbc_BDatos.Caption = "Base de Datos"
			This.Parent.Conexion_Directo.Value         = 1
			This.Parent.conexion_Origen_ODBC.Value     = 0
			This.parent.parent.Txt_Servidor.SetFocus()
		ELSE
			This.parent.parent.txt_servidor.Enabled = .f.
			This.parent.parent.Txt_Servidor.Value = ""
			This.parent.parent.Lbl_Odbc_BDatos.Caption = "Odbc"
			This.Parent.Conexion_Directo.Value         = 0
			This.Parent.conexion_Origen_ODBC.Value     = 1
			This.parent.parent.Txt_Base_datos_ODBC.SetFocus()
		ENDIF
		This.Value = 0
		
	ENDPROC

