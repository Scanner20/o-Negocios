		*!*	*//
		*!*	lo_XLS.Cells[1,1].Select()
		*!*	*//
		*!*	lo_range= lo_sh.UsedRange
		*!*	lo_range.Font.Size = 8    
		*!*	*//
		*!*	WITH lo_XLS.ActiveWorkbook.ActiveSheet
		*!*	    .Columns("A:A").EntireColumn.AutoFit
		*!*	    .Columns("A:A").ColumnWidth = 29.29
		*!*	    .Columns("A:A").ColumnWidth = 29.71
		*!*	    .Columns("B:B").ColumnWidth = 9
		*!*	    .Columns("C:C").ColumnWidth = 9.29
		*!*		.Columns("H:H").ColumnWidth = 7.86
		*!*		.Columns("H:H").ColumnWidth = 6.71
		*!*	    .Columns("I:I").ColumnWidth = 7.57
		*!*	    .Columns("J:J").ColumnWidth = 7.43
		*!*	    .Columns("K:K").ColumnWidth = 7.29
		*!*	    .Columns("L:L").ColumnWidth = 8.14
		*!*	    .Columns("L:L").ColumnWidth = 9
		*!*	ENDWITH
		*!*	*//
		*!*	**MESSAGEBOX(gOrden)
		*!*	DO CASE 
		*!*		CASE gOrden = 1
		*!*		    lo_range_ord1 = lo_XLS.Cells(3,1)
		*!*		    lo_range_ord2 = lo_XLS.Cells(RECCOUNT()+1,(li_col - 4))
		*!*		    **lo_Selection_orden = lo_range_tot2.Item[1,(li_col-4)]
		*!*		    lo_XLS.Range(lo_range_ord1.Address+":"+lo_range_ord2.Address).Select
		*!*		    lo_Selection_orden = lo_XLS.Selection
		*!*		    lo_Selection_orden.Activate	    
		*!*		    lo_Selection_orden.Sort(lo_range_ord1,xlAscending)
		*!*		CASE gOrden = 2
		*!*			lo_range_ord0 = lo_XLS.Cells(3,2)
		*!*		    lo_range_ord1 = lo_XLS.Cells(3,1)
		*!*		    lo_range_ord2 = lo_XLS.Cells(RECCOUNT()+1,(li_col - 4))
		*!*		    lo_XLS.Range(lo_range_ord1.Address+":"+lo_range_ord2.Address).Select
		*!*		    lo_Selection_orden = lo_XLS.Selection
		*!*		    lo_Selection_orden.Activate
		*!*			lo_Selection_orden.Sort(lo_range_ord0,xlDescending)
		*!*			*//
		*!*		CASE gOrden = 3
		*!*			lo_range_ord0 = lo_XLS.Cells(3,3)
		*!*		    lo_range_ord1 = lo_XLS.Cells(3,1)
		*!*		    lo_range_ord2 = lo_XLS.Cells(RECCOUNT()+1,(li_col - 4))
		*!*		    **lo_Selection_orden = lo_range_tot2.Item[1,(li_col-4)]
		*!*		    lo_XLS.Range(lo_range_ord1.Address+":"+lo_range_ord2.Address).Select
		*!*		    lo_Selection_orden = lo_XLS.Selection
		*!*		    lo_Selection_orden.Activate	    
		*!*		    lo_Selection_orden.Sort(lo_range_ord0,xlDescending)	    
		*!*		OTHERWISE
		*!*		    lo_range_ord1 = lo_XLS.Cells(3,1)
		*!*		    lo_range_ord2 = lo_XLS.Cells(RECCOUNT()+1,(li_col - 4))
		*!*		    **lo_Selection_orden = lo_range_tot2.Item[1,(li_col-4)]
		*!*		    lo_XLS.Range(lo_range_ord1.Address+":"+lo_range_ord2.Address).Select
		*!*		    lo_Selection_orden = lo_XLS.Selection	
		*!*		    lo_Selection_orden.Activate	    
		*!*		    lo_Selection_orden.Sort(lo_range_ord1,xlAscending)
		*!*	ENDCASE
		*!*	*//
		*!*	**lo_Selection_orden.Sort(lo_range_ord1,xlDescending)
		*!*	IF ThisForm.opc_orden.option1.Value = 1 then  
		*!*	*//
		*!*	lo_range_costo = lo_XLS.Cells(3,10)
		*!*	lo_range_utlnet = lo_XLS.Cells(3,12)
		*!*	*//
		*!*	lo_range_dest_costo1 = lo_XLS.Cells(3,10)
		*!*	lo_range_dest_costo2 = lo_XLS.Cells(RECCOUNT()+1,10)
		*!*	lo_range_dest_costo3 = lo_XLS.Range(lo_range_dest_costo1.Address+":"+lo_range_dest_costo2.Address)
		*!*	*//
		*!*	lo_range_dest_utlnet1 = lo_XLS.Cells(3,12)
		*!*	lo_range_dest_utlnet2 = lo_XLS.Cells(RECCOUNT()+1,12)
		*!*	lo_range_dest_utlnet3 = lo_XLS.Range(lo_range_dest_utlnet1.Address+":"+lo_range_dest_utlnet2.Address)
		*!*	*//
		*!*	lo_range_costo.FormulaR1C1 = "=RC[-1]*(RC[-8]-RC[-6])"
		*!*	lo_range_utlnet.FormulaR1C1 = "=RC[-6]-RC[-2]"
		*!*	*//
		*!*	lo_range_costo.Select
		*!*	lo_XLS.Selection.AutoFill(lo_range_dest_costo3)
		*!*	lo_range_utlnet.Select
		*!*	lo_XLS.Selection.AutoFill(lo_range_dest_utlnet3)
		*!*	*//
		*!*	ENDIF
		*!*	*//
		*!*	lo_XLS.Cells(3,1).Select
		
		*!*	*!*	lo_range_dest_utlnet1 = lo_XLS.Cells(RECCOUNT()+1,(li_col - 4)
		*!*	*!*	lo_XLS.Range(lo_range_ord1.Address+":"+lo_range_ord2.Address).Select
		
		*!*	*//
		
		
		*!*	*---, xlDescending, xlGuess,1, .F.,xlTopToBottom)
		*!*	lo_XLS.visible = .T.
		*!*	lo_XLS.ActiveWindow.Zoom = 100
		
		
		*!*	**WAIT WINDOW "Enviado Reporte a Excel ......" AT 50,50 nowa
		
		*!*	*!*	    lo_range_tot7 = lo_XLS.Cells(1,1)
		*!*	*!*	    lo_range_tot8 = lo_XLS.Cells(RECCOUNT()+3,(li_col-3))
		*!*	*!*		lo_Selection4 = lo_XLS.Range(lo_range_tot7.Address+":"+lo_Selection4.Address)
		
		*!*	*!*	  	lo_XLS.ActiveSheet.PageSetup.PrintArea = lo_Selection4.Address
		*!*	*-------
		*!*	RETURN
		
		
	ENDPROC

	PROCEDURE mh_inicializa_ejecuta_consulta
		***======================================================================================================
		*** Inicializa objetos, para inicializar nueva consulta
		***======================================================================================================
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.RecordSourceType = 1
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.RecordSource = ""
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Examinar.ColumnCount = -1
		
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Registros_Consulta.Txt_Registros_Consulta.Value = 0
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Registros_Consulta.txt_Registro_Activo_Consulta.Value = 0
		
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Indices_Busqueda.RecordSourceType = 1
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Grd_Indices_Busqueda.RecordSource = ""
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Registros_Consulta.Txt_Registros_Indice_Busqueda.Value = ""
		
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Buscar.Chk_Buscar.Value = 0
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Cnt_Buscar.txt_Buscar.Value = ""
		
		This.Cnt_Proceso_Migracion.Grd_Examinar.RecordSourceType = 1
		This.Cnt_Proceso_Migracion.Grd_Examinar.RecordSource = ""
		This.Cnt_Proceso_Migracion.Grd_Examinar.ColumnCount = -1
		
		This.Cnt_Proceso_Migracion.Grd_Configura_Campos.RecordSourceType = 1
		This.Cnt_Proceso_Migracion.Grd_Configura_Campos.RecordSource = ""
		
		This.Cnt_Contenedor.Refresh()
		This.Cnt_Contenedor.Cnt_Mantiene_Cursor_Tabla.Refresh()
		
	ENDPROC

	PROCEDURE mh_mantiene_campos
		***======================================================================================================
		*** Mantiene tabla de campos, para diseñar la consulta
		***======================================================================================================
		PARAMETERS P_ACCION
		PRIVATE ps_cadena,ps_corite
		DO CASE
			***--- Nuevo registro
			CASE P_ACCION=="N"
				SELECT "CUR_CAMPOS"
				GO BOTTOM
				ps_corite = PADL(ALLTRIM(STR(VAL(NVL(CUR_CAMPOS.cur_corite,"00000"))+1)),5,"0")
				APPEND BLANK
				REPLACE CUR_CAMPOS.cur_corite WITH ps_corite		
				REPLACE CUR_CAMPOS.cur_bdatos WITH ""
				REPLACE CUR_CAMPOS.cur_propie WITH ""
				REPLACE CUR_CAMPOS.cur_tiptab WITH ""
				REPLACE CUR_CAMPOS.cur_nomtab WITH ""
				REPLACE CUR_CAMPOS.cur_alitab WITH ""
				REPLACE CUR_CAMPOS.cur_destab WITH ""
				REPLACE CUR_CAMPOS.cur_nomcam WITH ""
				REPLACE CUR_CAMPOS.cur_descam WITH ""
				REPLACE CUR_CAMPOS.cur_tipdat WITH ""
				REPLACE CUR_CAMPOS.cur_tidato WITH ""
				REPLACE CUR_CAMPOS.cur_longit WITH 0
				REPLACE CUR_CAMPOS.cur_decima WITH 0
				REPLACE CUR_CAMPOS.cur_alicam WITH ""
				REPLACE CUR_CAMPOS.cur_result WITH 1
				REPLACE CUR_CAMPOS.cur_tipord WITH "0"
				REPLACE CUR_CAMPOS.cur_nroord WITH 0
				REPLACE CUR_CAMPOS.cur_criter WITH ""
				REPLACE CUR_CAMPOS.cur_expre1 WITH ""
				REPLACE CUR_CAMPOS.cur_expre2 WITH ""
				REPLACE CUR_CAMPOS.cur_expre3 WITH ""
				REPLACE CUR_CAMPOS.cur_indest WITH "1"
				This.mh_configura_campos_imagen("1")
				
				
			***--- Elimina registro
			CASE P_ACCION=="E"
				SELECT "CUR_CAMPOS"
				DELETE
				IF !EOF("CUR_CAMPOS")
					SKIP
					IF EOF("CUR_CAMPOS")
						GO BOTTOM
					ENDIF
				ELSE
					GO BOTTOM
				ENDIF
		ENDCASE
		This.Cnt_Contenedor.Grd_Campos_Tabla.AfterRowColChange()
		
	ENDPROC

