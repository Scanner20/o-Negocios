		this.RecordSource = ""
	ENDPROC

	PROCEDURE Cnt_Contenedor.Cnt_Relacion_Tablas.Grd_Tablas.Init
		IF !USED("CUR_TABLAS")
			CREATE CURSOR CUR_TABLAS (cur_corite c(3),  cur_bdatos c(100), cur_propie c(100),;
									  cur_tiptab c(10), cur_nomtab c(100), cur_alitab c(50),;
									  cur_destab c(100))
		ENDIF
		This.RecordSourceType = 1
		This.RecordSource          = "CUR_TABLAS"
		This.Column1.ControlSource = "CUR_TABLAS.cur_corite"
		This.Column2.ControlSource = "CUR_TABLAS.cur_bdatos"
		This.Column3.ControlSource = "CUR_TABLAS.cur_propie"
		This.Column4.ControlSource = "CUR_TABLAS.cur_tiptab"
		This.Column5.ControlSource = "CUR_TABLAS.cur_alitab"
		This.Column6.ControlSource = "CUR_TABLAS.cur_nomtab"
		This.AfterRowColChange()
		
		WITH This.parent.parent.parent.Cnt_Disenador_Relacion.Grd_Tablas_Seleccionadas
			.RecordSourceType = 1
			.RecordSource = "CUR_TABLAS"
			.Column1.ControlSource = "CUR_TABLAS.cur_corite"
			.Column2.ControlSource = "CUR_TABLAS.cur_bdatos"
			.Column3.ControlSource = "CUR_TABLAS.cur_propie"
			.Column4.ControlSource = "CUR_TABLAS.cur_tiptab"
			.Column5.ControlSource = "CUR_TABLAS.cur_alitab"
			.Column6.ControlSource = "CUR_TABLAS.cur_nomtab"
			.AfterRowColChange()
		ENDWITH
		
		
	ENDPROC

