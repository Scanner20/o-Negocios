	PROCEDURE Cnt_Proceso_Migracion.Cbo_Tabla_Nombre_Migracion.Init
		CREATE CURSOR CUR_MIGRA_TABLAS (cur_corite c(3),  cur_bdatos c(100), cur_propie c(100),;
								  		cur_tiptab c(10), cur_nomtab c(100), cur_alitab c(50),;
								  		cur_destab c(100))
