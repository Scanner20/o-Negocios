	PROCEDURE Cnt_Contenedor.Grd_Campos_Tabla.Col_Campo_Tipo_Orden.Cbo_Campo_Tipo_Orden.Init
		CREATE CURSOR CUR_TIPO_ORDEN (cur_codord c(1), cur_descri c(50))
		INSERT INTO CUR_TIPO_ORDEN (cur_codord,cur_descri) values('1','Ascendente')
		INSERT INTO CUR_TIPO_ORDEN (cur_codord,cur_descri) values('2','Descendente')
		INSERT INTO CUR_TIPO_ORDEN (cur_codord,cur_descri) values('0','')
		This.RowSourceType = 6
		This.RowSource     = "CUR_TIPO_ORDEN.cur_descri,cur_codord"
		This.BoundColumn   = 2
		this.ColumnCount   = 2
		this.ColumnWidths  = "70,10"
		this.Requery()
		
	ENDPROC

