		*!*	    ENDWITH
		*!*	    *//
		*!*	   	lo_XLS.Columns("A:A").EntireColumn.AutoFit()
		*!*	   	
		
		*!*	    *-----------
		*!*		    lo_XLS.Range(ALLTRIM(STR(RECCOUNT()+2))+":"+ALLTRIM(STR(RECCOUNT()+2))).Insert (xlDown)
		*!*		    lo_range_tot1 = lo_XLS.Cells(RECCOUNT()+3,1)
		*!*		    lo_range_tot2 = lo_range_tot1.Item[1,1]
		*!*		    lo_Selection3 = lo_range_tot2.Item[1,(li_col-4)]
		*!*		    lo_XLS.Range(lo_range_tot2.Address+":"+lo_Selection3.Address).Select
