	PROCEDURE Cnt_Proceso_Migracion.Opt_Tipo_Conexion.Referencia_Origen.Click
		IF !EMPTY(ALLTRIM(This.Parent.Parent.Parent.ph_s_servidor))
			***--- Es una migración directa
			This.parent.parent.Lbl_Base_Datos_ODBC_Destino.Caption = "Base de Datos:"
			This.parent.parent.Txt_Servidor_Destino.Enabled = .t.
			This.parent.conexion_Directo.Value     = 1
			This.parent.conexion_Origen_ODBC.Value = 0
			This.parent.parent.Txt_Servidor_Destino.SetFocus()	
		ELSE
			***--- Conexión por Odbc
			This.parent.parent.Lbl_Base_Datos_ODBC_Destino.Caption = "Odbc:"
			This.parent.parent.Txt_Servidor_Destino.Enabled = .f.
			This.parent.conexion_Directo.Value     = 0
			This.parent.conexion_Origen_ODBC.Value = 1
			This.parent.parent.Txt_Servidor_Destino.SetFocus()
		ENDIF
		This.Parent.Parent.Txt_Servidor_Destino.Value        = This.Parent.Parent.Parent.ph_s_servidor
		This.Parent.Parent.Txt_Base_Datos_ODBC_Destino.Value = This.Parent.Parent.Parent.ph_s_odbc_BDatos
		This.Parent.Parent.Txt_Usuario_Destino.Value         = This.Parent.Parent.Parent.ph_s_usuario
		This.Parent.Parent.Txt_Contrasena_Destino.Value      = This.Parent.Parent.Parent.ph_s_contrasena
		This.Value = 0
		
	ENDPROC

