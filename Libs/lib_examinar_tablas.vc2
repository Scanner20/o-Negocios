	*< OBJECTDATA: ObjPath="Shape14" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="lblEscapeMessage" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: ejecuta
		*m: mh_limpiar
		*m: mh_relleno
		*m: mh_valores_iniciales
		*p: ccurrenttask
		*p: contador
		*p: cthermref
		*p: ibasis
		*p: ipercentage
		*p: iprogress
		*p: nroregistros
		*p: shpthermbarmaxwidth
		*p: userp_titulo
		*p: valprogreso
	*</DefinedPropArrayMethod>

	*<PropValue>
		BackStyle = 0
		BorderWidth = 0
		ccurrenttask = ('')
		contador = (0)
		cthermref = ('')
		Height = 89
		ibasis = (0)
		ipercentage = (0)
		iprogress = (0)
		Name = "cls_progreso"
		nroregistros = (0)
		shpthermbarmaxwidth = 322
		userp_titulo = Barra de progreso
		valprogreso = (0)
		Width = 358
	*</PropValue>

	ADD OBJECT 'lblEscapeMessage' AS label WITH ;
		Alignment = 2, ;
		BackColor = 192,192,192, ;
		BackStyle = 0, ;
		Caption = "", ;
		FontBold = .F., ;
		FontName = "MS Sans Serif", ;
		FontSize = 8, ;
		Height = 14, ;
		Left = 19, ;
		Name = "lblEscapeMessage", ;
		Top = 69, ;
		Width = 322, ;
		WordWrap = .F.
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblPercentage' AS label WITH ;
		BackStyle = 0, ;
		Caption = "0%", ;
		FontName = "MS Sans Serif", ;
		FontSize = 8, ;
		Height = 13, ;
		Left = 172, ;
		Name = "lblPercentage", ;
		Top = 48, ;
		Width = 16
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblPercentage2' AS label WITH ;
		BackColor = 0,0,255, ;
		BackStyle = 0, ;
		Caption = "Label1", ;
		FontName = "MS Sans Serif", ;
		FontSize = 8, ;
		ForeColor = 255,255,255, ;
		Height = 13, ;
		Left = 172, ;
		Name = "lblPercentage2", ;
		Top = 48, ;
		Width = 0
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblTask' AS label WITH ;
		BackColor = 192,192,192, ;
		BackStyle = 0, ;
		Caption = "", ;
		FontName = "MS Sans Serif", ;
		FontSize = 8, ;
		Height = 16, ;
		Left = 20, ;
		Name = "lblTask", ;
		Top = 28, ;
		Width = 330, ;
		WordWrap = .F.
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'lblTitle' AS label WITH ;
		BackColor = 192,192,192, ;
		BackStyle = 0, ;
		Caption = "", ;
		FontName = "MS Sans Serif", ;
		FontSize = 8, ;
		Height = 16, ;
		Left = 20, ;
		Name = "lblTitle", ;
		Top = 15, ;
		Width = 330, ;
		WordWrap = .F.
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Shape1' AS shape WITH ;
		BackStyle = 0, ;
		Height = 88, ;
		Left = 2, ;
		Name = "Shape1", ;
		Top = 1, ;
		Width = 356
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Shape10' AS shape WITH ;
		BorderColor = 128,128,128, ;
		Height = 81, ;
		Left = 5, ;
		Name = "Shape10", ;
		Top = 3, ;
		Width = 1
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Shape11' AS shape WITH ;
		BorderColor = 128,128,128, ;
		Height = 1, ;
		Left = 18, ;
		Name = "Shape11", ;
		Top = 46, ;
		Width = 322
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Shape12' AS shape WITH ;
		BorderColor = 255,255,255, ;
		Height = 1, ;
		Left = 18, ;
		Name = "Shape12", ;
		Top = 62, ;
		Width = 323
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Shape13' AS shape WITH ;
		BorderColor = 0,0,160, ;
		Height = 16, ;
		Left = 18, ;
		Name = "Shape13", ;
		Top = 46, ;
		Width = 1
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Shape14' AS shape WITH ;
		BorderColor = 255,255,255, ;
		Height = 17, ;
		Left = 340, ;
		Name = "Shape14", ;
		Top = 46, ;
		Width = 1
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Shape2' AS shape WITH ;
		BorderColor = 255,255,255, ;
		Height = 1, ;
		Left = 3, ;
		Name = "Shape2", ;
		Top = 3, ;
		Width = 353
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Shape3' AS shape WITH ;
		BorderColor = 255,255,255, ;
		Height = 85, ;
		Left = 3, ;
		Name = "Shape3", ;
		Top = 3, ;
		Width = 1
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Shape4' AS shape WITH ;
		BorderColor = 128,128,128, ;
		Height = 1, ;
		Left = 3, ;
		Name = "Shape4", ;
		Top = 87, ;
		Width = 354
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Shape5' AS shape WITH ;
		BorderStyle = 0, ;
		FillColor = 192,192,192, ;
		FillStyle = 0, ;
		Height = 15, ;
		Left = 19, ;
		Name = "Shape5", ;
		Top = 48, ;
		Width = 322
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Shape6' AS shape WITH ;
		BorderColor = 128,128,128, ;
		Height = 86, ;
		Left = 356, ;
		Name = "Shape6", ;
		Top = 2, ;
		Width = 1
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Shape7' AS shape WITH ;
		BorderColor = 255,255,255, ;
		Height = 1, ;
		Left = 5, ;
		Name = "Shape7", ;
		Top = 85, ;
		Width = 350
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Shape8' AS shape WITH ;
		BorderColor = 255,255,255, ;
		Height = 82, ;
		Left = 354, ;
		Name = "Shape8", ;
		Top = 4, ;
		Width = 1
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Shape9' AS shape WITH ;
		BorderColor = 128,128,128, ;
		Height = 1, ;
		Left = 5, ;
		Name = "Shape9", ;
		Top = 4, ;
		Width = 349
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'shpThermBar' AS shape WITH ;
		BorderStyle = 0, ;
		FillColor = 128,128,128, ;
		FillStyle = 0, ;
		Height = 16, ;
		Left = 19, ;
		Name = "shpThermBar", ;
		Top = 47, ;
		Width = 0
		*< END OBJECT: BaseClass="shape" />
	
	PROCEDURE ejecuta
		Parameters cTask ,iProgress ,pestado
		*!*	IF Oprogreso.Visible = .f.
		*!*		Oprogreso.Show()
		*!*	ENDIF
		LOCAL iPercentage,iAvgCharWidth 
		If This.NroRegistros<>iProgress
		  This.ValProgreso  = (322/iProgress) / 3.3
		  This.NroRegistros = iProgress
		Endif
		This.Contador = This.Contador + 1
		iProgress = This.ValProgreso
		this.iProgress = this.iProgress + iProgress
		this.cCurrentTask = cTask
		iPercentage = this.iProgress
		iPercentage = min(100,max(0,iPercentage))
		if iPercentage <> this.iPercentage
		  if len(alltrim(str(iPercentage,3)))<>len(alltrim(str(this.iPercentage,3)))
			iAvgCharWidth=fontmetric(6,this.lblPercentage.FontName, ;
				          this.lblPercentage.FontSize, ;
					      iif(this.lblPercentage.FontBold,'B','')+ ;
					      iif(this.lblPercentage.FontItalic,'I',''))
			this.lblPercentage.Width=txtwidth(alltrim(str(iPercentage,3)) + '%', ;
			              this.lblPercentage.FontName,this.lblPercentage.FontSize, ;
					      iif(this.lblPercentage.FontBold,'B','')+ ;
					      iif(this.lblPercentage.FontItalic,'I','')) * iAvgCharWidth
			this.lblPercentage.Left=int((this.shpThermBarMaxWidth- ;
					      this.lblPercentage.Width) / 2)+this.shpThermBar.Left-1
			this.lblPercentage2.Left=this.lblPercentage.Left
		  endif
		  this.iPercentage = m.iPercentage
		  this.shpThermBar.Width = int((this.shpThermBarMaxWidth)*this.iPercentage/100)
		  this.lblPercentage.Caption = alltrim(str(iPercentage,3)) + '%'
		  this.lblPercentage2.Caption = this.lblPercentage.Caption
		  if this.shpThermBar.Left + this.shpThermBar.Width -1 >= ;
				          this.lblPercentage2.Left
		    if this.shpThermBar.Left + this.shpThermBar.Width - 1 >= ;
			              this.lblPercentage2.Left + this.lblPercentage.Width - 1
			  this.lblPercentage2.Width = this.lblPercentage.Width
			else
			  this.lblPercentage2.Width = this.shpThermBar.Left + this.shpThermBar.Width - ;
						  this.lblPercentage2.Left - 1
			endif
		  else
			this.lblPercentage2.Width = 0
		  endif
		endif
		if !this.lblTask.Caption == this.cCurrentTask
			this.lblTask.Caption = this.cCurrentTask
		endif
		***--- Rellena si contador es igual a la cantidad de registros
		***--- dado como parametro y estado sea igual a F (Finaliza)
		If This.Contador = This.NroRegistros And pestado="F"
		  This.mh_relleno('F')
		  ***OProgreso.Hide()
		  ***This.mh_limpiar()
		Endif
		
		
	ENDPROC

	PROCEDURE Init
		This.lblTitle.caption = This.userp_titulo
		
	ENDPROC

	PROCEDURE mh_limpiar
		this.shpThermBar.Width = 0
		this.lblPercentage2.Width = 0
		This.lblPercentage.Width = 0
		This.mh_valores_iniciales()
		This.Refresh()
		
	ENDPROC

	PROCEDURE mh_relleno
		Para WEstado ,Can_progreso
		Do Case
		  Case Westado='I'
		    This.Ejecuta("Procesando  ...!",20,"R")	&& Inicia el Progreso
		  Case Westado='P'
		    This.Ejecuta("Procesando  ...!",Can_progreso,"R")	&& Inicia el Progreso
		  Case Westado='F'
		    This.Ejecuta("Proceso concluido  ...!",0,"R")	&& Completa el Progreso
		  OtherWise
		    This.Ejecuta("Proceso concluido  ...!",0,"R")	&& Completa el Progreso
		EndCase  
		
		
		
	ENDPROC

	PROCEDURE mh_valores_iniciales
		this.iPercentage=0
		This.ccurrenttask        = ''
		This.cthermref           = ''
		This.ibasis              = 0
		This.ipercentage         = 0
		This.iprogress           = 0
		This.nroregistros        = 0
		This.shpthermbarmaxwidth = 322
		This.valprogreso         = 0
		This.lblTask.caption     = ''
		This.contador            = 0
		
		
		iPercentage = 0
		iAvgCharWidth = 0
		this.shpThermBar.Width = 0
		this.lblPercentage2.Width = 0
		
		
	ENDPROC

ENDDEFINE
