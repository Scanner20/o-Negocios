	PROCEDURE Init
		LPARAMETERS ldatosfijos
		DODEFAULT(ldatosfijos)
		THISFORM.m_carga_grid()
	ENDPROC

	PROCEDURE mu_selecciona_datos
	ENDPROC

	PROCEDURE m_carga_grid
		thisform.LockScreen=.t.
		
		*************
		* PROVEEDOR *
		*************
		this.pageframe1.page1.grid1.RecordSource=SPACE(0)
		IF USED("PROVEEDOR")
			USE IN "PROVEEDOR"
		ENDIF 
		wcad=" select distinct 0 as ind,a.AUX_CODDOC AS DPP_CODPRO,b.AUX_NOMAUX "
		wcad=wcad+" from cuenta_corriente_cte a with (readpast) "
		wcad=wcad+" Inner join auxiliares_aux b  "
		wcad=wcad+" ON (b.cia_codcia=a.cia_codcia "
		wcad=wcad+" and b.aux_codaux=a.aux_coddoc) "
		wcad=wcad+" where a.CIA_CODCIA=?this.entorno.codigocia and "
		wcad=wcad+" 	a.SUC_CODSUC=?this.entorno.codigosuc and "
		wcad=wcad+" 	a.cte_codpag='P' and a.cte_indest<>'0'  "
		IF SQLEXEC(ocnx.conexion,wcad,'PROVEEDOR')<0
			MESSAGEBOX(MESSAGE())
			RETURN .f.
		ENDIF
		INDEX ON dpp_codpro TAG a
		INDEX ON aux_nomaux TAG b
		this.pageframe1.page1.grid1.RecordSource='proveedor'
		this.pageframe1.page1.grid1.column1.ControlSource='proveedor.ind'
		this.pageframe1.page1.grid1.column2.ControlSource='proveedor.dpp_codpro'
		this.pageframe1.page1.grid1.column3.ControlSource='proveedor.aux_nomaux'
		
		
		*************
		* ORDEN     *
		*************
		this.pageframe1.page2.grid1.RecordSource=SPACE(0)
		IF USED("ORDEN")
			USE IN "ORDEN"
		ENDIF 
		wcad=" select distinct 0 as ind,a.AUX_CODAUX,b.AUX_NOMAUX "
		wcad=wcad+" from cuenta_corriente_cte a with (readpast) "
		wcad=wcad+" Inner join auxiliares_aux b  "
		wcad=wcad+" ON (b.cia_codcia=a.cia_codcia "
		wcad=wcad+" and b.aux_codaux=a.aux_codaux) "
		wcad=wcad+" where a.CIA_CODCIA=?this.entorno.codigocia and "
		wcad=wcad+" 	a.SUC_CODSUC=?this.entorno.codigosuc and "
		wcad=wcad+" 	a.cte_codpag='P' and a.cte_indest<>'0'  "
		IF SQLEXEC(ocnx.conexion,wcad,'ORDEN')<0
			MESSAGEBOX(MESSAGE())
			RETURN .f.
		ENDIF
		INDEX ON aux_codaux TAG a
		INDEX ON aux_nomaux TAG b
		this.pageframe1.page2.grid1.RecordSource='orden'
		this.pageframe1.page2.grid1.column1.ControlSource='orden.ind'
		this.pageframe1.page2.grid1.column2.ControlSource='orden.aux_codaux'
		this.pageframe1.page2.grid1.column3.ControlSource='orden.aux_nomaux'
		
		
		*************
		* DOCUMENTOS*
		*************
		this.pageframe1.page3.grid1.RecordSource=SPACE(0)
		IF USED("DOCUMENTO")
			USE IN "DOCUMENTO"
		ENDIF 
		wcad=" select distinct 0 as ind,a.TDO_CODTDO,b.TDO_DESLAR "
		wcad=wcad+" from cuenta_corriente_cte a with (readpast) "
		wcad=wcad+" Inner join tipo_de_documento_tdo b  "
		wcad=wcad+" ON (b.tdo_codtdo=a.tdo_codtdo) "
		wcad=wcad+" where a.CIA_CODCIA=?this.entorno.codigocia and "
		wcad=wcad+" 	a.SUC_CODSUC=?this.entorno.codigosuc and "
		wcad=wcad+" 	a.cte_codpag='P' and a.cte_indest<>'0'  "
		IF SQLEXEC(ocnx.conexion,wcad,'DOCUMENTO')>0
			INDEX ON TDO_DESLAR TAG b
			INDEX ON TDO_CODTDO TAG a
		ELSE 
			MESSAGEBOX(MESSAGE())
			RETURN .f.
		ENDIF
		this.pageframe1.page3.grid1.RecordSource='documento'
		this.pageframe1.page3.grid1.column1.ControlSource='documento.ind'
		this.pageframe1.page3.grid1.column2.ControlSource='documento.tdo_codtdo'
		this.pageframe1.page3.grid1.column3.ControlSource='documento.tdo_deslar'
		
		*************
		* CUENTA *
		*************
		this.pageframe1.page5.grid1.RecordSource=SPACE(0)
		IF USED("CUENTA")
			USE IN "CUENTA"
		ENDIF 
		wcad=" select distinct 0 as ind,a.CCT_CODCCT,b.CCT_NOMCTA "
		wcad=wcad+" from cuenta_corriente_cte a with (readpast) "
		wcad=wcad+" Inner join cuenta_contable_cct b  "
		wcad=wcad+" ON (b.cia_codcia=a.cia_codcia "
		wcad=wcad+" and b.cct_codcct=a.cct_codcct) "
		wcad=wcad+" where a.CIA_CODCIA=?this.entorno.codigocia and "
		wcad=wcad+" 	a.SUC_CODSUC=?this.entorno.codigosuc and "
		wcad=wcad+" 	a.cte_codpag='P' and a.cte_indest<>'0'  "
		IF SQLEXEC(ocnx.conexion,wcad,'CUENTA')<0
			MESSAGEBOX(MESSAGE())
			RETURN .f.
		ENDIF
		INDEX ON cct_nomcta TAG b
		INDEX ON cct_codcct TAG a
		this.pageframe1.page5.grid1.RecordSource='cuenta'
		this.pageframe1.page5.grid1.column1.ControlSource='cuenta.ind'
		this.pageframe1.page5.grid1.column2.ControlSource='cuenta.cct_codcct'
		this.pageframe1.page5.grid1.column3.ControlSource='cuenta.cct_nomcta'
		
		
		thisform.LockScreen=.f.
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE botongrupo.Cmb_Cancelar.Click
		IF USED('PROVEEDOR')
			SELECT ('PROVEEDOR')
			=TABLEUPDATE()
		ENDIF	
		
		IF USED('ORDEN')
			SELECT ('ORDEN')
			=TABLEUPDATE()
		ENDIF	
		
		IF USED('DOCUMENTO')
			SELECT ('DOCUMENTO')
			=TABLEUPDATE()
		ENDIF	
		
		
		DODEFAULT()
	ENDPROC

