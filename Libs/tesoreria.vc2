		ENDIF 	
	ENDPROC

	PROCEDURE Pageframe1.Page1.Optiongroup1.Option1.Click
		this.Parent.Parent.grid1.Enabled=.f.
		this.Parent.Parent.text1.Enabled=.f.
		this.Parent.Parent.text2.Enabled=.f.
		thisform.Refresh()
		
	ENDPROC

