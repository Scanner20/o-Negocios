	PROCEDURE Pageframe1.Page1.Text1.Valid
		Thisform.pageframe1.page1.Text2.Value=This.Value
	ENDPROC

	PROCEDURE Pageframe1.Page1.Text3.InteractiveChange
		SELECT proveedor
		SET KEY TO UPPER(ALLTRIM(this.Value))
		GO top
		thisform.pageframe1.page1.grid1.Refresh()
	ENDPROC

	PROCEDURE Pageframe1.Page1.Text3.Refresh
		IF thisform.pageframe1.page1.optiongroup1.option2.Value=1
			this.Enabled=.t.
		ELSE
			this.Enabled=.f.
		ENDIF
		
		
	ENDPROC

