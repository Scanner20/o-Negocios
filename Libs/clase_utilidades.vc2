	PROCEDURE conecta_usuario
		*------- Realiza Conexion
		This.Conexion_Osis.Servidor = Ocnx.Servidor
		This.Conexion_Osis.Usuario = This.Administra_Documento.Usuario 
		This.Conexion_Osis.Password = This.Administra_documento.Password  
		This.Conexion_Osis.Tipo_BD = Ocnx.Tipo_BD
		This.Conexion_Osis.BaseDatos = This.Administra_documento.BaseDatos 
		 
		This.Administra_documento.BDConexion=This.Conexion_Osis  
		
	ENDPROC

	PROCEDURE Init
		LPARAMETERS lpcodddi as Integer,lpcodopc as String,lpNomdoc as String,lpDesgdo as String   
		
		IF PARAMETERS()<3
			MESSAGEBOX("Validación: Debe de enviar dos parametros ..[CODIGO DE DOCUMENTO / CODIGO DE OPCION / NOMBRE DE DOCUMENTO]..!! ",64,ThisForm.Caption)
			RETURN .F.
		ENDIF  
		
		ThisForm.ls_s07_cods07=ALLTRIM(NVL(lpcodopc,'')) 
		ThisForm.li_ddi_codddi=NVL(lpcodddi,0) 
		ThisForm.ls_namefile=ALLTRIM(NVL(lpNomdoc,'')) 
		ThisForm.Contenedor2.txtDirectory.Value=ThisForm.Administra_Documento.ps_directorio_documentos+"\"+ALLTRIM(NVL(lpDesgdo,''))
		ThisForm.Administra_Documento.ps_directorio_documentos=ThisForm.Contenedor2.txtDirectory.Value
		ThisForm.contenedor2.txtFileName.Value=ThisForm.ls_namefile
		   
		This.Conecta_usuario()    
		
		
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE btnCancelar.Click
		ThisForm.Cerrar() 
		
	ENDPROC

	PROCEDURE Contenedor2.btnBrowse.Click
		oShell = CREATEOBJECT("Shell.Application")
		oFolder = oShell.Application.BrowseForFolder(0,;
		        "Seleccione el Directio para generar documento...", 1, "")
		        
		IF TYPE("oFolder.self.Path")<>"O"
			RETURN 
		ENDIF 
		        
		ThisForm.contenedor2.txtDirectory.value=oFolder.self.Path 
		
	ENDPROC

	PROCEDURE Contenedor2.btnGenera.Click
		&&LPARAMETERS lpCodddi as Integer, lpCodopc as String,lpNewFile as String, lpNameFile as String  
		
		
		lpNewFile=ALLTRIM(NVL(ThisForm.Contenedor2.txtDirectory.Value,''))  
		lpNameFile=ALLTRIM(NVL(ThisForm.Contenedor2.txtFileName.Value,''))  
		
		IF EMPTY(lpNewFile)
			MESSAGEBOX("Validación: Seleccione el directorio donde se genera archivo...!!",64,ThisForm.Caption)
			RETURN .F.
		ENDIF  
		
		IF EMPTY(lpNameFile)
			MESSAGEBOX("Validación: Ingrese nombre de archivo a generar...!!",64,ThisForm.Caption)
			RETURN .F.
		ENDIF  
		ThisForm.Administra_documento.Crea_archivo_imagenes=.T.  
		IF ThisForm.Administra_documento.Visualiza_Documento(ThisForm.li_ddi_codddi,ThisForm.ls_s07_cods07,lpNewFile,lpNameFile) 	
			&&MESSAGEBOX("Generación de Documento termino satisfactoriamente...!!",64,ThisForm.Caption)
			WAIT WINDOW "Generación de Documento termino satisfactoriamente...!!" NoWa
			ThisForm.Cerrar() 
			RETURN 
		ENDIF 
		
		
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS funciones_administra_documento AS custom 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: adjunta_documento
		*m: adjunta_documentos_temporales
		*m: cambia_conexion_usuario
		*m: creaestructura_table
		*m: ejecuta_shell
		*m: elimina_documento
		*m: elimina_documentos_adjuntos
		*m: genera_documento
		*m: graba_documentos_adjuntos
		*m: obtiene_data_imagen
		*m: restaura_conexion_usuario
		*m: seleccionar_documento
		*m: verifica_coneccion
		*m: verifica_existe_documentos_adjuntados
		*m: visualiza_documento
		*p: basedatos
		*p: bdconexion
		*p: createmporal
		*p: crea_archivo_imagenes
		*p: ls_filename
		*p: password
		*p: ps_directorio_documentos
		*p: ps_directorio_temporal
		*p: ps_name_table
		*p: usuario
	*</DefinedPropArrayMethod>

	*<PropValue>
		basedatos = JROJAS_IMG
		bdconexion = 
		createmporal = .F.
		crea_archivo_imagenes = .F.
		Height = 12
		ls_filename = ("")
		Name = "funciones_administra_documento"
		password = db_usuario_sistema
		ps_directorio_documentos = ("")
		ps_directorio_temporal = ("")
		ps_name_table = ("")
		usuario = db_usuario_sistema
		Width = 110
	*</PropValue>
	
	PROCEDURE adjunta_documento
		LPARAMETERS lpCodddi as integer,lpCodopc as String, lpFile as String,lpExt_File as Integer, lpGloUsu as String,lpCodgdo as Integer,lpCodKey as String     
		
		
		*!*	Alter Procedure PA_AdjuntaDocumento
		*!*	(
		*!*		@p_ddi_docddi int,
		*!*		@p_s07_codopc char(15),
		*!*		@p_gdo_codgdo int,
		*!*		@p_ddi_docdig image,
		*!*		@p_tpa_codtpa int,
		*!*		@p_ddi_glousu varchar(80),
		*!*		@p_ddi_glotec varchar(80),
		*!*		@p_ddi_refori varchar(80)
		*!*	)
		
		IF !This.Verifica_coneccion() 
			RETURN .F.
		ENDIF 
		
		STORE "" to ps_cadena, ps_ddi_glotec,ps_ddi_refori,ps_ddi_nomdoc,ps_filename
		STORE 0 TO x,y
		
		
		*--- Create Cursor para Data Binaria
		CREATE CURSOR Cur_Documento_Adjunto (Documento blob(4))
		
		
		IF !FILE(ALLTRIM(NVL(lpFile,'')))
			MESSAGEBOX("Validación: No existe el documento a Adjuntar [ "+ALLTRIM(lpFile)+" ]",64,ThisForm.Caption)
			RETURN .F.
		ENDIF 
		
		*----- Hallar Nombre de Archivo
		x=RATC("\",ALLTRIM(NVL(lpFile,'')),1)
		ps_filename=RIGHT(ALLTRIM(NVL(lpFile,'')),LEN(ALLTRIM(NVL(lpFile,'')))-x)
		y=RATC(".",ps_filename,1)
		ps_ddi_nomdoc=LEFT(ps_filename,y-1)
		
		IF EMPTY(ps_ddi_nomdoc)
			MESSAGEBOX("Validación: No se logro obtener el nombre de archivo a adjuntar..!!",64,ThisForm.Caption)
			RETURN .F.
		ENDIF 
		
		
		SELECT "Cur_Documento_Adjunto"
		INSERT INTO Cur_Documento_Adjunto (Documento) VALUES (FILETOSTR(lpFile)) 
		
		
		ps_ddi_glotec="GENERADO DESDE LA OPCION: "+lpCodopc 
		ps_ddi_refori=ps_ddi_glotec
		
		
		
		ps_cadena="Execute dbo.PA_AdjuntaDocumento "+;
				  "	@p_ddi_docddi=?lpCodddi,		"+;
				  "	@p_s07_codopc=?lpCodopc,		"+;
				  "	@p_gdo_codgdo=?lpCodgdo,		"+;
				  "	@p_ddi_docdig=?Cur_Documento_Adjunto.Documento,	"+;
				  "	@p_tpa_codtpa=?lpExt_File,		"+;
				  "	@p_ddi_glousu=?lpGloUsu,		"+;
				  "	@p_ddi_glotec=?ps_ddi_glotec,	"+;
				  "	@p_ddi_refori=?ps_ddi_refori,	"+;
				  "	@p_ddi_nomdoc=?ps_ddi_nomdoc,	"+;
				  " @p_ddi_codkey='"+ALLTRIM(lpCodKey)+"' 	"
		
		
		This.BDConexion.Modo(2)		
		IF SQLEXEC(This.BDConexion.Conexion,ps_cadena)<1
			MESSAGEBOX("Error: Al Adjuntar Documento..!"+CHR(13)+;
						MESSAGE(),48,ThisForm.Caption)
			This.BDConexion.RollBack()				
			RETURN .F.				
		ELSE
			This.BDConexion.Commit()
			This.BDConexion.Modo(1)
			RETURN .T.
		ENDIF 
		
		
						
				
				  
				  
				  
				   
				   
	ENDPROC

	PROCEDURE adjunta_documentos_temporales
		LPARAMETERS lpCodopc as String, lpFile as String,lpExt_File as Integer, lpGloUsu as String,lpCodgdo as Integer,lpCodKey as String     
		
		
		STORE "" to ps_cadena, ps_ddi_glotec,ps_ddi_refori,ps_ddi_nomdoc,ps_filename
		STORE 0 TO x,y
		
		
		
		IF EMPTY(ALLTRIM(NVL(This.ps_name_table,'')))
			MESSAGEBOX("Validación: No se ha definido Nombre de Archivo Temporal de Documentos Adjuntados..!!",64,ThisForm.Caption)
			RETURN .F.
		ENDIF 
		
		IF !USED(This.ps_name_table)
			This.Creaestructura_table() 
		ENDIF 
		
		
		IF !FILE(ALLTRIM(NVL(lpFile,'')))
			MESSAGEBOX("Validación: No existe el documento a Adjuntar [ "+ALLTRIM(lpFile)+" ]",64,ThisForm.Caption)
			RETURN .F.
		ENDIF 
		
		*----- Hallar Nombre de Archivo
		x=RATC("\",ALLTRIM(NVL(lpFile,'')),1)
		ps_filename=RIGHT(ALLTRIM(NVL(lpFile,'')),LEN(ALLTRIM(NVL(lpFile,'')))-x)
		y=RATC(".",ps_filename,1)
		ps_ddi_nomdoc=LEFT(ps_filename,y-1)
		
		IF EMPTY(ps_ddi_nomdoc)
			MESSAGEBOX("Validación: No se logro obtener el nombre de archivo a adjuntar..!!",64,ThisForm.Caption)
			RETURN .F.
		ENDIF 
		
		
		IF !EMPTY(ALLTRIM(NVL(lpGloUsu,'')))
			ps_ddi_glotec="GENERADO DESDE LA OPCION: "+lpCodopc 
		ELSE
			ps_ddi_glotec=lpGloUsu	
		ENDIF 	
		
		
		IF !SEEK(ALLTRIM(NVL(lpCodKey,'')),Alltrim(This.ps_name_table),"I")
			SELECT Alltrim(This.ps_name_table)
			APPEND BLANK 
			Replace ddi_codkey WITH lpCodKey,;
					s07_codopc WITH lpCodopc,;
					ddi_docdig WITH FILETOSTR(lpFile),;
					tpa_codtpa WITH lpExt_File,;
					gdo_codgdo WITH lpCodgdo,;
					ddi_nomdoc WITH ps_ddi_nomdoc,;
					ddi_glousu WITH ps_ddi_glotec
				
		ENDIF 
		
		
		
		
		
		
		
		
		
		
						
				
				  
				  
				  
				   
				   
	ENDPROC

	PROCEDURE cambia_conexion_usuario
	ENDPROC

	PROCEDURE creaestructura_table
		*---- Crea Estructura Temporal
		IF USED(ALLTRIM(This.ps_Name_Table))
			USE IN (ALLTRIM(This.ps_Name_Table))
		ENDIF 
		
		CREATE CURSOR Alltrim(This.ps_Name_Table) (ddi_codkey c(40),s07_codopc c(15),ddi_docdig blob(4),tpa_codtpa n(16,0),;
											gdo_codgdo n(16,0),ddi_nomdoc c(80),ddi_glousu c(80),estado c(1) NULL)
			
		SELECT  Alltrim(This.ps_name_table)
		INDEX ON ALLTRIM(NVL(ddi_codkey,'')) TAG I
		
		
			
	ENDPROC

	PROCEDURE Destroy
		DODEFAULT()
		
		
	ENDPROC

	PROCEDURE ejecuta_shell
		***FUNCTION ShellExec
		LPARAMETER lcLink, lcAction, lcParms
		
		lcAction = IIF(EMPTY(lcAction), "Open", lcAction)
		
		lcParms = IIF(EMPTY(lcParms), "", lcParms)
		
		DECLARE INTEGER ShellExecute IN SHELL32.dll INTEGER nWinHandle, STRING cOperation, STRING cFileName, STRING cParameters, STRING cDirectory, INTEGER nShowWindow
		DECLARE INTEGER FindWindow IN WIN32API STRING cNull,STRING cWinName
		
		RETURN ShellExecute(FindWindow(0, _SCREEN.caption), lcAction, lcLink, lcParms, SYS(2023), 1)
		
	ENDPROC

	PROCEDURE elimina_documento
		LPARAMETERS lpCodddi as integer
		
		IF !This.Verifica_coneccion() 
			RETURN .F.
		ENDIF 
		
		
		ps_cadena="Execute dbo.PA_EliminaDocAdjunto "+;
				  "	@p_ddi_codddi=?lpCodddi		"
		
		This.BDConexion.Modo(2)		  
		IF SQLEXEC(This.BDConexion.Conexion,ps_cadena)<1
			MESSAGEBOX("Error: Al Eiminar Documento Adjunto..!"+CHR(13)+;
						MESSAGE(),48,ThisForm.Caption)
			This.BDConexion.RollBack()				
			RETURN .F.				
		ELSE
			This.BDConexion.Commit()
			This.BDConexion.Modo(1)
			RETURN .T.
		ENDIF 
		
		
				
				
				
				  
				  
				  
				   
				   
	ENDPROC

	PROCEDURE elimina_documentos_adjuntos
		LPARAMETERS lpCodOpc as String,lpCodKey as String
		
		STORE "" TO ls_cad    
		STORE 0 TO li_reg
		
		IF !This.Verifica_Coneccion() 
			RETURN .F.
		ENDIF 
		
		
		ls_cad="Delete				"+;
				"From jrojas_img.dbo.DOCU_DIGI_DDI			"+;
				"Where LTRIM(LTRIM(s07_codopc)) = '"+ALLTRIM(lpCodOpc)+"'	"+;
				"And   LTRIM(RTRIM(ddi_codkey)) = '"+ALLTRIM(lpCodKey)+"'	"
		
		IF SQLEXEC(This.BDConexion.Conexion,ls_cad)<0
			MESSAGEBOX("Error: Al Eliminar Documentos Adjuntos [JROJAS_IMG.dbo.DOCU_DIGI_DDI] "+CHR(13)+;
						MESSAGE(),64,Thisform.Caption)
			RETURN .f.
		ENDIF 
		
		
	ENDPROC

	PROCEDURE genera_documento
		LPARAMETERS lpCodddi as Integer, lpCodopc as String,lpNewFile as String, lpNameFile as String  
		
		
		*-------- Verificar si existe directorio
		IF UPPER(ALLTRIM(NVL(lpNewFile,'')))==UPPER(ALLTRIM(This.ps_directorio_documentos))
			IF !DIRECTORY(This.ps_directorio_documentos)
				MKDIR (This.ps_directorio_documentos)
			ENDIF 	
		ENDIF 
		
		*---- Crear File
		lext=ALLTRIM(NVL(CurFile.tpa_codext,''))
		IF This.Createmporal==.T.
			IF !DIRECTORY(This.ps_directorio_Temporal)
				MKDIR(This.ps_directorio_Temporal)
			ENDIF 
			lFile=ALLTRIM(SYS(2015))+"."+lext
			lpNewFile=This.ps_directorio_Temporal+"\"+lFile	
		ELSE
			lFile=ALLTRIM(NVL(lpNameFile,''))+"."+lext
			lpNewFile=lpNewFile+"\"+lFile
		ENDIF  
		
		lret=STRTOFILE(CurFile.ddi_docdig,lpNewFile)
		IF lret=0
			=MESSAGEBOX("Error: Al Generar Vista de Documento..!"+CHR(13)+;
						MESSAGE(),64,ThisForm.Caption)
			RETURN .F.
		ENDIF 
		
		*------Abrir Documento
		This.Ejecuta_Shell(lpNewFile,"Open")
		
		
		
		
	ENDPROC

	PROCEDURE graba_documentos_adjuntos
		*------- Graba Documentos Adjuntados
		STORE 0 to li_reg
		
		IF !USED(alltrim(This.ps_name_table))
			This.Creaestructura_table() 
		ENDIF 
		
		SELECT alltrim(This.ps_name_table)
		COUNT TO li_reg
		
		IF li_reg=0
			MESSAGEBOX("Validación: No Existen Documentos Adjuntados..!!",64,ThisForm.Caption)
			RETURN .F.
		ENDIF 
		
		
		IF !This.Verifica_coneccion() 
			RETURN .F.
		ENDIF 
		
		STORE "" to ps_cadena, ps_ddi_glotec,ps_ddi_refori,ps_ddi_nomdoc,ps_filename
		STORE 0 TO x,y,lpCodgdo,lpExt_File
		STORE .F. TO lb_error
		STORE "" TO lpCodddi,lpCodopc,lpDoc,lpGloUsu,lpCodKey,ps_ddi_refori,ps_ddi_glotec,ps_ddi_nomdoc
		
		
		This.BDConexion.Modo(2)		
		
		
		SELECT Alltrim(This.ps_name_table)
		SCAN FOR EMPTY(ALLTRIM(NVL(Estado,'')))
			lpCodddi	= 0
			lpCodopc	= ALLTRIM(s07_codopc)	
			lpDoc		= ddi_docdig
			lpExt_File	= tpa_codtpa
			lpCodgdo	= gdo_codgdo
			lpCodKey	= ALLTRIM(ddi_codkey)
			lpGloUsu	= ALLTRIM(ddi_glousu)
			ps_ddi_nomdoc = ALLTRIM(ddi_nomdoc) 
			
			ps_ddi_glotec="GENERADO DESDE LA OPCION: "+lpCodopc 
			ps_ddi_refori=ps_ddi_glotec
			
			ps_cadena="Execute dbo.PA_AdjuntaDocumento "+;
					  "	@p_ddi_docddi=?lpCodddi,		"+;
					  "	@p_s07_codopc=?lpCodopc,		"+;
					  "	@p_gdo_codgdo=?lpCodgdo,		"+;
					  "	@p_ddi_docdig=?lpDoc,	"+;
					  "	@p_tpa_codtpa=?lpExt_File,		"+;
					  "	@p_ddi_glousu=?lpGloUsu,		"+;
					  "	@p_ddi_glotec=?ps_ddi_glotec,	"+;
					  "	@p_ddi_refori=?ps_ddi_refori,	"+;
					  "	@p_ddi_nomdoc=?ps_ddi_nomdoc,	"+;
					  " @p_ddi_codkey='"+ALLTRIM(lpCodKey)+"' 	"
		
			IF SQLEXEC(This.BDConexion.Conexion,ps_cadena)<0
				MESSAGEBOX("Error: Al Adjuntar Documento..!"+CHR(13)+;
							MESSAGE(),48,ThisForm.Caption)
				lb_error=.T.
				SELECT Alltrim(This.ps_name_table)	
				Replace estado WITH '0' FOR ALLTRIM(ddi_codkey)==lpCodKey		
			ELSE
				lb_error=.F.
				SELECT Alltrim(This.ps_name_table)	
				Replace estado WITH '1' FOR ALLTRIM(ddi_codkey)==lpCodKey
			ENDIF 
			SELECT Alltrim(This.ps_name_table)	
		ENDSCAN
		
		
		*------ Cancelar Grabacion si hay errores
		IF lb_error==.T.
			This.BDConexion.RollBack()				
			This.BDConexion.Modo(1)	
			RETURN .F.
		ELSE 	
			This.BDConexion.Commit()
			This.BDConexion.Modo(1)
			RETURN .T.
		ENDIF 				
				
				  
				  
				  
				   
				   
	ENDPROC

	PROCEDURE Init
		DODEFAULT()
		This.ps_directorio_documentos=SYS(5)+"\Documentos Digitalizados"
		This.ps_directorio_Temporal=SYS(5)+"\Documentos Digitalizados\Temp"
		
		
	ENDPROC

	PROCEDURE obtiene_data_imagen
		LPARAMETERS lpCodddi as Integer
		
		LOCAL ObjectData as Object 
		STORE "" TO ls_cadena 
		
		
		IF !This.Verifica_coneccion() 
			RETURN .F.
		ENDIF 
		
		*---- Setea cursor para obtener data Binaria 
		CURSORSETPROP("MapBinary",.T.,0)
		
		*----- Consulta data en SQL 
		ls_cadena ="Select a.ddi_docdig,b.tpa_codext				"+;
					"From Jrojas_img.dbo.DOCU_DIGI_DDI a			"+;
					"Inner Join Jrojas_img.dbo.TIPO_ARCHIVO_TPA b	"+;
					"On	(b.tpa_codtpa = a.tpa_codtpa)				"+;
					"Where a.ddi_codddi = ?lpCodddi 				"
								
		IF SQLEXEC(This.BDConexion.Conexion,ls_cadena,'CurFile')<1			
			=MESSAGEBOX("Error: Al consultar archivos de documentos [dbo.DOCU_DIGI_DDI]"+CHR(13)+;
						MESSAGE(),64,ThisForm.Caption)
			RETURN .F.				
		ENDIF 
		ObjectData =CurFile.ddi_docdig
		
		IF USED("CurFile")
		 	USE IN "CurFile"
		ENDIF 
		
		
		RETURN ObjectData 
		
		
		
		
	ENDPROC

	PROCEDURE restaura_conexion_usuario
	ENDPROC

	PROCEDURE seleccionar_documento
		LPARAMETERS lpCodtpa as Integer
		
		STORE "" TO ls_cadena,ls_codext,ls_desext,ls_file
		This.ls_FileName=""
		
		
		IF !This.Verifica_Coneccion()
			RETURN .F.
		ENDIF
		
		ls_cadena="Select tpa_deslar,tpa_codext				"+;
					"From Jrojas_img.dbo.TIPO_ARCHIVO_TPA	"+;
					"Where tpa_codtpa = ?lpCodtpa 			"
					
		IF SQLEXEC(This.BDConexion.Conexion,ls_cadena,'CurExtension')<1
			MESSAGEBOX("Error: Al abrir archivo [Jrojas_img.dbo.TIPO_ARCHIVO_TPA] "+CHR(13)+;
						MESSAGE(),64,ThisForm.Caption)
			RETURN .F.
		ENDIF 
		ls_codext=ALLTRIM(NVL(CurExtension.tpa_codext,''))
		ls_desext=ALLTRIM(NVL(CurExtension.tpa_deslar,''))
		
		ls_file=GETFILE(ls_codext,"Seleccione el archivo:","Seleccionar",0,"Seleccione un archivo "+ls_desext)
		
		IF EMPTY(ALLTRIM(NVL(ls_file,'')))
			MESSAGEBOX("Validación: No ha seleccionado un archivo..!!",64,ThisForm.Caption)
			RETURN .F.
		ENDIF 	
		
		 
		This.ls_FileName=ls_file
		RETURN .T.
		
	ENDPROC

	PROCEDURE verifica_coneccion
		
		IF TYPE("This.BDConexion")<>"O" 
			MESSAGEBOX("Error: No se inicializado el parametro conección.!!",64,thisform.Caption)
			RETURN .F.
		ENDIF 
		
		IF This.BDConexion.Conexion=-1 
			This.BDConexion.Usuario_Osis = .F.
			IF !This.BDConexion.Conectar() 
				MESSAGEBOX("Error: No se logro realizar la coneccion del sistema...!!"+CHR(13)+MESSAGE(),64,Thisform.Caption)	
				RETURN .F.
			ENDIF 
		ENDIF 	
		
		
	ENDPROC

	PROCEDURE verifica_existe_documentos_adjuntados
		LPARAMETERS lpCodOpc as String,lpCodKey as String
		
		STORE "" TO ls_cad    
		STORE 0 TO li_reg
		
		IF !This.Verifica_Coneccion() 
			RETURN .F.
		ENDIF 
		
		
		ls_cad="Select ddi_codddi				"+;
				"From jrojas_img.dbo.DOCU_DIGI_DDI			"+;
				"Where LTRIM(LTRIM(s07_codopc)) = '"+ALLTRIM(lpCodOpc)+"'	"+;
				"And   LTRIM(RTRIM(ddi_codkey)) = '"+ALLTRIM(lpCodKey)+"'	"
		
		IF SQLEXEC(This.BDConexion.Conexion,ls_cad,'CurValida')<0
			MESSAGEBOX("Error: Al Consultar Archivo [JROJAS_IMG.dbo.DOCU_DIGI_DDI] "+CHR(13)+;
						MESSAGE(),64,Thisform.Caption)
			RETURN .f.
		ENDIF 
		
		SELECT "CurValida"
		COUNT TO li_reg 
		
		IF USED("CurValida")
			USE IN "CurValida"
		ENDIF 
		
		IF li_reg=0
			RETURN .F.
		ELSE
			RETURN .T.
		ENDIF 
	ENDPROC

	PROCEDURE visualiza_documento
		LPARAMETERS lpCodddi as Integer, lpCodopc as String,lpNewFile as String, lpNameFile as String  
		
		STORE "" TO ls_cadena 
		
		IF !This.Verifica_Coneccion() 
			RETURN .F.
		ENDIF 
		
		
		*---- Setea cursor para obtener data Binaria 
		CURSORSETPROP("MapBinary",.T.,0)
		
		*----- Consulta data en SQL 
		ls_cadena ="Select a.ddi_docdig,b.tpa_codext,b.tpa_indimg				"+;
					"From Jrojas_img.dbo.DOCU_DIGI_DDI a			"+;
					"Inner Join Jrojas_img.dbo.TIPO_ARCHIVO_TPA b	"+;
					"On	(b.tpa_codtpa = a.tpa_codtpa)				"+;
					"Where a.ddi_codddi = ?lpCodddi 				"
								
		IF SQLEXEC(This.BDConexion.Conexion,ls_cadena,'CurFile')<1			
			=MESSAGEBOX("Error: Al consultar archivos de documentos [dbo.DOCU_DIGI_DDI]"+CHR(13)+;
						MESSAGE(),64,ThisForm.Caption)
			RETURN .F.				
		ENDIF 
		
		IF NVL(CurFile.tpa_indimg,0)=0 Or This.Crea_Archivo_Imagenes==.T.
			IF !This.Genera_documento(lpCodddi,lpCodopc,lpNewFile,lpNameFile)
				RETURN .F.
			ENDIF 
		ELSE
			DO FORM forms\frm_visor_imagenes WITH CurFile.ddi_docdig 
		ENDIF 
		
		IF USED("CurFile")
		 	USE IN "CurFile"
		ENDIF 
	ENDPROC

ENDDEFINE

DEFINE CLASS funciones_envio_email AS custom 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: enviarcorreo
		*m: lee_archivoconfiguracion
		*p: contenido_correo
		*p: correo_emisor
		*p: escorreo_html
		*p: esservidoriis
		*p: objetocom
		*p: password_server_smtp
		*p: prioridad		&& 0 - Normal, 1 - Bajo, 2 - Alta
		*p: puertocorreo_envio_smtp
		*p: servercorreo_smtp
		*p: serverdominio
		*p: usuariodominio
	*</DefinedPropArrayMethod>

	*<PropValue>
		contenido_correo = ("")
		correo_emisor = ""
		escorreo_html = .T.
		esservidoriis = .F.
		Name = "funciones_envio_email"
		objetocom = ("OsisLibrary_Mail.Library_Mail")
		password_server_smtp = ("")
		prioridad = 2
		puertocorreo_envio_smtp = 25
		servercorreo_smtp = ("")
		serverdominio = ""
		usuariodominio = .F.
	*</PropValue>
	
	PROCEDURE enviarcorreo
		LPARAMETERS lpDesde as String, lpPara as String,lpAsunto as string,lpContenido as String,lpCopiarA as String,lpBCC as String, lpArchivos_Adjuntos as String
		
		PRIVATE ObjectMail as Object
		PRIVATE lret as Boolean 
		
		lret=.F.
		
		IF !This.Lee_archivoconfiguracion() 
			RETURN .F.
		ENDIF 
		&&----- Crea Instancia de Objeto de Envio de Correo
		ObjectMail= CREATEOBJECT(This.Objetocom)
		&&------ Valida 
		IF EMPTY(ALLTRIM(NVL(This.ServerCorreo_SMTP,'')))
			MESSAGEBOX("Validación: Debe de indicar el Servidor de Correo SMTP..!!",16,"Servcio de Envio de Alertas por correo.")
			RETURN .f.
		ENDIF 
		
		IF This.PuertoCorreo_Envio_SMTP=0
			MESSAGEBOX("Validación: Debe de indicar el Puerto del Servidor de Correo SMTP..!!",16,"Servcio de Envio de Alertas por correo.")
			RETURN .f.	
		ENDIF 
		IF EMPTY(ALLTRIM(NVL(This.Password_Server_SMTP,'')))
			MESSAGEBOX("Validación: Debe de ingresar la Contraseña de la cuenta desde donde se envia el correo..!!",16,"Servcio de Envio de Alertas por correo.")
			RETURN .f.	
		ENDIF 
		
		IF EMPTY(ALLTRIM(NVL(This.Correo_emisor,'')))
			MESSAGEBOX("Validación: Debe de ingresar el Correo Emisor de la cuenta desde donde se envia el correo..!!",16,"Servcio de Envio de Alertas por correo.")
			RETURN .f.	
		ENDIF 
		
		&&----- Configura 
		WITH ObjectMail
			.SMTPServer = This.ServerCorreo_SMTP
			.PortSMTP = This.puertocorreo_envio_smtp
			.Password = This.Password_Server_SMTP
			.IsBodyHTML = This.EsCorreo_HTML
			.Prioridad = This.Prioridad 
		ENDWITH  
		IF This.EsServidorIIS=1 
			ObjectMail.Usuario = This.Usuariodominio  
		ELSE
			ObjectMail.Usuario = This.Correo_Emisor 
		ENDIF 
		&&----- Envia Correo
		lpDesde = This.Correo_Emisor
		lret=ObjectMail.EnviarEmail(lpDesde,lpPara,lpAsunto,lpContenido,lpCopiarA,lpBCC,"",lpArchivos_Adjuntos)
		
		RETURN lret
		
		
		
		
		
		
		
		
		       
	ENDPROC

	PROCEDURE lee_archivoconfiguracion
		*----- Lee archivo de configuracion
		lcad="Select cia_codcia,cac_codser,cac_coremi,	 "+;
			 "		 cac_pwdemi,cac_smtpp,cac_serdom,	 "+;
			 "		 cac_usudom,cac_seriis 				 "+;	
			 "  From dbo.Configuracion_Alerta_Correo_cac "+;
			 "  Where cia_codcia = ?Oentorno.CodigoCia    "
		IF SQLEXEC(Ocnx.Conexion,lcad,'CurAlertas')<0
			MESSAGEBOX("Error: Al Consultar archivo de configuracion de Alertas..!!"+CHR(13)+MESSAGE(),64,"Servicio de Alertas")
			RETURN .F.
		ENDIF 
		SELECT "CurAlertas"
		This.Servercorreo_smtp=ALLTRIM(NVL(CurAlertas.cac_codser,'')) 
		This.Correo_Emisor=ALLTRIM(NVL(CurAlertas.cac_coremi,''))
		This.Password_server_smtp=ALLTRIM(NVL(CurAlertas.cac_pwdemi,'')) 
		This.Puertocorreo_envio_smtp=NVL(CurAlertas.cac_smtpp,0) 
		This.Serverdominio=ALLTRIM(NVL(CurAlertas.cac_serdom,''))
		This.Usuariodominio=ALLTRIM(NVL(CurAlertas.cac_usudom,'')) 
		This.EsServidorIIS = NVL(CurAlertas.cac_seriis,0)
		
		
		IF USED("CurAlertas")
			USE IN "CurAlertas"
		ENDIF 
		
	ENDPROC

ENDDEFINE

DEFINE CLASS visor_imagenes AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="imagen" UniqueID="" Timestamp="" />

	*<PropValue>
		Caption = "Visor de Imagenes"
		DoCreate = .T.
		Name = "visor_imagenes"
		ScrollBars = 3
		WindowState = 2
	*</PropValue>

	ADD OBJECT 'imagen' AS image WITH ;
		Height = 48, ;
		Left = 0, ;
		Name = "imagen", ;
		Top = 0, ;
		Width = 100
		*< END OBJECT: BaseClass="image" />
	
	PROCEDURE Activate
		This.Resize() 
		This.Refresh() 
		
	ENDPROC

	PROCEDURE Init
		LPARAMETERS lpData as String  
		DODEFAULT()
		
		ThisForm.imagen.PictureVal=lpData 
		ThisForm.Resize()     
		
	ENDPROC

	PROCEDURE Resize
		
		DODEFAULT()
		This.imagen.Width=This.Width+200
		This.Imagen.Height=This.Height+200
		         
		
		        
	ENDPROC

ENDDEFINE
