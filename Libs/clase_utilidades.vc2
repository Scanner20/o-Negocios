	PROCEDURE Activate
		This.Resize() 
		This.Refresh() 
	ENDPROC

	PROCEDURE arma_filtro
		
		STORE "" TO ls_CadenaWhere
		
		This.ls_filtro=""
		
		IF This.Cnt_busqueda.chkGrupoDocumento.Value=1 AND !EMPTY(ALLTRIM(Thisform.Cnt_busqueda.cmbGrupo.Value)) 
			ls_CadenaWhere=" a.gdo_codgdo = "+ALLTRIM(Thisform.Cnt_busqueda.cmbGrupo.Value)+" "
			IF !EMPTY(ALLTRIM(NVL(This.ls_filtro,''))) 
				This.ls_filtro=This.ls_filtro+ls_CadenaWhere
			ELSE
				This.ls_filtro=ls_CadenaWhere
			ENDIF 
		ENDIF 	
		
		IF This.Cnt_busqueda.chkFechaDocumento.Value=1
			ls_CadenaWhere=IIF(!EMPTY(ALLTRIM(NVL(ls_CadenaWhere,'')))," And ","")+" Convert(char,a.ddi_feccre,112) Between '"+DTOC(ThisForm.Cnt_busqueda.OleFecdes.Object.Value,1)+"' And '"+DTOC(ThisForm.Cnt_busqueda.OleFechas.Object.Value,1)+"' "   
			IF !EMPTY(ALLTRIM(NVL(This.ls_filtro,''))) 
				This.ls_filtro=This.ls_filtro+ls_CadenaWhere
			ELSE
				This.ls_filtro=ls_CadenaWhere
			ENDIF 	 	
		ENDIF 	
		
	ENDPROC

	PROCEDURE cargatablas
		ThisForm.Datos1.selecciona()  
		
		
	ENDPROC

	PROCEDURE conecta_usuario
		*------- Realiza Conexion
		This.Conexion_Osis.Servidor = Ocnx.Servidor
		This.Conexion_Osis.Usuario = This.Administra_Documento.Usuario 
		This.Conexion_Osis.Password = This.Administra_documento.Password  
		This.Conexion_Osis.Tipo_BD = Ocnx.Tipo_BD
		This.Conexion_Osis.BaseDatos = This.Administra_documento.BaseDatos 
		 
		This.Administra_documento.BDConexion=This.Conexion_Osis  
		
		
		
		
		
	ENDPROC

	PROCEDURE Init
		LPARAMETERS lps07_codopc, lps07_noms07, lpddi_codkey, lpValida,lpFiltraOpcion,lpPermiteAdjuntar
		
		DODEFAULT()
		
		IF EMPTY(NVL(lps07_codopc,'')) 
			MESSAGEBOX("Validación: No se ha enviado el parametro de Codigo de Opción...!",64,ThisForm.Caption) 
			RETURN .F.
		ENDIF 
		IF EMPTY(NVL(lps07_noms07,'')) 
			MESSAGEBOX("Validación: No se ha enviado el parametro de Nombre de Opción...!",64,ThisForm.Caption) 
			RETURN .F.
		ENDIF 
		
		
		ThisForm.ls_s07_codopc = ALLTRIM(nvl(lps07_codopc,''))
		Thisform.ls_s07_noms07 = ALLTRIM(nvl(lps07_noms07,''))
		ThisForm.ls_ddi_codkey = ALLTRIM(nvl(lpddi_codkey,''))
		ThisForm.Filtra_Opcion = lpFiltraOpcion
		ThisForm.Valida_existe_documento_adjunto = lpValida
		ThisForm.ctnTitle.lblOpcion.Caption = Thisform.ls_s07_noms07
		ThisForm.Conecta_usuario() 
		ThisForm.cargatablas() 
		ThisForm.Resize()
		ThisForm.Cnt_busqueda.BtnAdjuntar.Enabled = lpPermiteAdjuntar   
		ThisForm.Detalle.Column3.Enabled = lpPermiteAdjuntar   
		ThisForm.Detalle.Column4.Enabled = lpPermiteAdjuntar     
		Thisform.Refresh() 
		
		
		
		
		   
	ENDPROC

	PROCEDURE Load
		DODEFAULT()
		
	ENDPROC

	PROCEDURE Resize
		DODEFAULT()
		This.ctnTitle.Width=This.Width-10
		This.detalle.Width=This.Width-10
		This.Detalle.Height=This.Height-This.ctnTitle.Height-This.cnt_busqueda.Height-27
		This.cnt_busqueda.Top=This.Detalle.Height+This.ctnTitle.Height+7
		This.cnt_busqueda.Width=This.Width-10
		
		
	ENDPROC

	PROCEDURE botongrupo.Cmb_Aceptar.Click
		STORE .F. TO lb_ret
		
		DO FORM forms\frm_adjunta_doc WITH ThisForm.Entorno.Programa TO lb_ret
		
		IF lb_ret==.T.
			ThisForm.Datos1.selecciona()    
			ThisForm.Detalle.AfterRowColChange()  
			ThisForm.Detalle.Refresh()  
		ENDIF 
		
	ENDPROC

	PROCEDURE cnt_busqueda.btnAdjuntar.Click
		STORE .F. TO lb_ret
		
		DO FORM forms\frm_adjunta_doc WITH ThisForm.Entorno.Programa,ThisForm.ls_ddi_codkey  TO lb_ret
		
		IF lb_ret==.T.
			ThisForm.Datos1.selecciona()    
			ThisForm.Detalle.AfterRowColChange()  
			ThisForm.Detalle.Refresh()  
		ENDIF 
		
	ENDPROC

	PROCEDURE cnt_busqueda.btnCerrar.Click
		ThisForm.Cerrar() 
		
	ENDPROC

	PROCEDURE cnt_busqueda.btnSelecciona.Click
		
		
		IF ThisForm.Cnt_busqueda.chkFechaDocumento.Value=1
			IF ThisForm.Cnt_busqueda.OleFecdes.Object.Value>ThisForm.Cnt_busqueda.OleFecHas.Object.Value
				MESSAGEBOX("Validación: La Fecha inicio no puede ser mayor a la fecha final..!!",64,ThisForm.Caption)
				RETURN .F.
			ENDIF     
		ENDIF   
		
		
		ThisForm.arma_filtro() 
		Thisform.Datos1.Sqlselect="" 
		Thisform.Datos1.Defineselect()   
		ThisForm.Datos1.selecciona()  
		ThisForm.Detalle.Refresh()  
		
		
	ENDPROC

	PROCEDURE cnt_busqueda.chkAll.Click
		IF This.Value=1
			ThisForm.Cnt_busqueda.chkFechaDocumento.Value=1
			ThisForm.Cnt_busqueda.chkFechaDocumento.Enabled=.F. 
			ThisForm.Cnt_busqueda.ChkFechaDocumento.Click()   
		ELSE
			ThisForm.Cnt_busqueda.chkFechaDocumento.Value=0
			ThisForm.Cnt_busqueda.chkFechaDocumento.Enabled=.T.
			ThisForm.Cnt_busqueda.ChkFechaDocumento.Click()   	 
		ENDIF 
		
	ENDPROC

	PROCEDURE cnt_busqueda.chkFechaDocumento.Click
		IF This.Value=1
			This.Parent.oleFecDes.Object.Enabled = .T.
			This.Parent.oleFecHas.Object.Enabled = .T.	
		ELSE
			This.Parent.oleFecDes.Object.Enabled = .F.
			This.Parent.oleFecHas.Object.Enabled = .F.		
		ENDIF 
	ENDPROC

	PROCEDURE cnt_busqueda.chkGrupoDocumento.Click
		IF This.Value=1
			This.Parent.cmbGrupo.Enabled = .T. 
		ELSE
			This.Parent.cmbGrupo.Enabled = .F.
			This.Parent.cmbGrupo.Value=""
			This.Parent.cmbGrupo.Refresh()   
		ENDIF 
		
	ENDPROC

	PROCEDURE cnt_busqueda.CmbGrupo.Init
		LPARAMETERS lpObj as Object 
		ThisForm.Conecta_usuario() 
		IF !Thisform.Administra_documento.Verifica_coneccion()
			RETURN .f.
		ENDIF   
		DODEFAULT(ThisForm.Conexion_Osis) 
		
	ENDPROC

	PROCEDURE cnt_busqueda.CmbGrupo.InteractiveChange
		DODEFAULT()
		ThisForm.Cnt_busqueda.btnSelecciona.Click()   
		
		
	ENDPROC

	PROCEDURE Datos1.defineselect
		STORE "" TO ls_cadena,ls_filtro1 
		
		
		ls_filtro1 =IIF(Thisform.Cnt_busqueda.chkAll.Value=1,""," Rtrim(Ltrim(a.ddi_codkey))='"+ALLTRIM(ThisForm.ls_ddi_codkey)+"' ")
		IF EMPTY(ALLTRIM(NVL(ls_filtro1 ,'')))
			ls_filtro1 =IIF(ThisForm.Filtra_opcion," a.s07_codopc='"+ALLTRIM(ThisForm.ls_s07_codopc)+"'	","")
		ELSE
			ls_filtro1 =ls_filtro1+IIF(ThisForm.Filtra_opcion," And a.s07_codopc='"+ALLTRIM(ThisForm.ls_s07_codopc)+"'	","")
		ENDIF 
		
		ls_cadena = "Select a.ddi_codddi,a.s07_codopc,a.gdo_codgdo,c.gdo_desgdo,a.ddi_glousu,a.ddi_feccre,a.ddi_nomdoc, d.tpa_deslar,	"+;
					"'' as Campo1, '' as Campo2,'' as Campo3, '' as Campo4,a.tpa_codtpa,'' as Campo5		"+;
					"From Jrojas_img.dbo.DOCU_DIGI_DDI a						"+;
					"Inner Join Jrojas.dbo.sys_tabla_opciones_s07 b				"+;
					"On	(b.s07_codopc = a.s07_codopc)							"+;
					"Inner Join Jrojas_img.dbo.GRUPO_DOCDIG_GDO c				"+;
					"On	(c.gdo_codgdo = a.gdo_codgdo)							"+;
					"Inner Join Jrojas_img.dbo.Tipo_Archivo_tpa	d				"+;
					"On	 (d.tpa_codtpa = a.tpa_codtpa)							"+;
					"Where  "+ls_filtro1+;
					IIF(!EMPTY(ALLTRIM(NVL(ls_filtro1 ,''))) And !EMPTY(ALLTRIM(NVL(ThisForm.ls_filtro,'')))," And "," ")+ThisForm.ls_filtro 
					
								
		This.SqlSelect=ls_cadena
		
	ENDPROC

	PROCEDURE Datos1.selecciona
		PRIVATE lwheadi,lfin,lrefre,lsetfo,lcalcula,lsqlcad,leje
		
		
		thisForm.conecta_usuario() 
		IF !ThisForm.Administra_documento.Verifica_coneccion()  
			RETURN .F.
		ENDIF 
		
		IF !This.IndicadorActivado
		    RETURN
		ENDIF
		
		IF !EMPTY(NVL(ALLTRIM(This.CuadriculaAsociada),'')) 
			leje=ALLTRIM(This.CuadriculaAsociada)+".Reordena_Columnas()"
			&leje
		ENDIF
		
		
		This.NombreTabla=ALLTRIM(This.NombreTabla) 
		
		IF EMPTY(This.Alias)
		   This.Alias=This.Nombretabla
		EndIf
		
		This.Alias=ALLTRIM(This.Alias)
		
		lcuad=.f.
		
		lacci1=" l1=1 "
		lacci2=" l1=1 "
		lacci3=" l1=1 "
		lacci4=" l1=1 "
		lacci5=" l1=1 "
		
		IF !EMPTY(This.CuadriculaAsociada )
		    lacci1=" ThisForm.LockScreen=.T. "
		    lacci2=" ThisForm.LockScreen=.F. "
		    lacci3=ALLTRIM(This.CuadriculaAsociada)+".RecordSource=SPACE(0)"
		    lacci4=ALLTRIM(This.CuadriculaAsociada)+".AsociaTabla(This)"
		    lacci5="TYPE('"+ALLTRIM(This.CuadriculaAsociada)+"')=='O'"
		ENDIF
		
		&lacci1
		&lacci3
		IF ThisForm.Conexion_Osis.conexion<0 AND !EMPTY(This.NombreTabla)
		   MESSAGEBOX("No hay Conexion or No Tiene",48,"Error")
		   RETURN .f.
		ENDIF
		
		*!*	IF ThisForm.Conexion_Osis.Tipo_BD=4 AND UPPER(ALLTRIM(This.Alias))<>"TCUR"
		*!*		   This.SqlSelect = ""	
		*!*	ENDIF 
		
		This.DefineSelect() 
		If EMPTY(This.SqlSelect)
		   wdbo=""
		   IF This.indicar_dbo AND (ThisForm.Conexion_Osis.Tipo_BD=1 OR ThisForm.Conexion_Osis.Tipo_BD=4)
		      wdbo="dbo."
		   ENDIF
		   lwhe="" 
		   lrep=""
		   IF !EMPTY(This.Parametros)
		      lini=1
		      lpos=0
		      If ","$This.Parametros
			      FOR ln=1 TO 20
			    	  lpos=ATC(",",This.Parametros,ln)
			    	  lfin=lpos-lini
			    	  IF lpos>0 
			    	  	 IF (ThisForm.Conexion_Osis.Tipo_BD=1 OR ThisForm.Conexion_Osis.Tipo_BD=3)
				    	 	lwhe=lwhe+ALLTRIM(This.LlavePrimaria[ln])+"=?"+SUBSTR(This.Parametros,lini,lfin)+" AND "
				    	 ENDIF
				    	 IF ThisForm.Conexion_Osis.Tipo_BD=4
				    	 	 ldato=SUBSTR(This.Parametros,lini,lfin)
					    	 lwhe=lwhe+ALLTRIM(This.LlavePrimaria[ln])+"="+This.Devuelve_cadena(ldato)+" AND "
				    	 ENDIF
			    	 	 lrep=lrep+ALLTRIM(This.LlavePrimaria[ln])+" WITH "+SUBSTR(This.Parametros,lini,lfin)+","
				    	 lini=lpos + 1
			    	  ELSE
			    	  	IF (ThisForm.Conexion_Osis.Tipo_BD=1 OR ThisForm.Conexion_Osis.Tipo_BD=3)
			    	    	lwhe=lwhe+ALLTRIM(This.LlavePrimaria[ln])+"=?"+SUBSTR(This.Parametros,lini,LEN(ALLTRIM(This.Parametros)))+" AND "
			    	    ENDIF
			    	    IF ThisForm.Conexion_Osis.Tipo_Bd=4
				    	 	ldcampo=SUBSTR(This.Parametros,lini,LEN(ALLTRIM(This.Parametros)))
			    	    	lwhe=lwhe+ALLTRIM(This.LlavePrimaria[ln])+"="+This.Devuelve_cadena(ldcampo)+" AND "
			    	    ENDIF
			    	    		
			    	    Exit  
			    	  EndIf
			   	  ENDFOR
		   	  ELSE
		         IF (ThisForm.Conexion_Osis.Tipo_BD=1 OR ThisForm.Conexion_Osis.Tipo_BD=3)   	  	
		   	     	lwhe=lwhe+ALLTRIM(This.LlavePrimaria[1,1])+"=?"+Allt(This.Parametros)+" AND "
		   	     ENDIF
		   	     IF ThisForm.Conexion_Osis.Tipo_BD=4
		   	     	lpdato=Allt(This.Parametros)
		   	        lwhe=lwhe+ALLTRIM(This.LlavePrimaria[1,1])+"="+This.Devuelve_cadena(lpdato) +" AND "
		   	     ENDIF
		   	     
		   	     lrep=lrep+ALLTRIM(This.LlavePrimaria[1,1])+" WITH "+ALLT(This.Parametros)+","
		   	  EndIF
		      IF !EMPTY(lwhe)   
		      	 lwhe=LEFT(lwhe,LEN(lwhe) - 5) 
		      	 lwhe=" WHERE "+lwhe
		      	 lrep=LEFT(lrep,LEN(lrep) - 1) 
		      	 This.Replace=" REPLACE "+lrep
		   	  ENDIF
		   	  IF !EMPTY(This.SqlWhere)
		   	     IF EMPTY(lwhe)   
		   	        lwhe=" WHERE "+This.SqlWhere
		   	     ELSE
		   	        lwhe=lwhe+" AND "+This.SqlWhere
		   	     ENDIF
		   	  ENDIF
		   	  
		   ENDIF
		   lwheadi=""
		   IF !EMPTY(This.SqlWhere)
		       IF !EMPTY(lwhe)
		           lwheadi=" AND "+This.SqlWhere
		       ELSE
		           lwheadi=" WHERE "+This.SqlWhere
		       ENDIF
		       		
		   ENDIF
		
		   IF ALLTRIM(This.Campos)=="*" AND !This.Indicador_consulta AND TYPE("This.Estructura[1,1]")=="C"
				PRIVATE lcolums
				lcolums=This.Columnas_select() 
				IF LEN(lcolums)>0
					This.Campos=lcolums
				ENDIF
		   ENDIF
		   PRIVATE lreadpast
		   lreadpast=""
		   IF ThisForm.Conexion_Osis.Tipo_BD=1 AND THis.Readpast 
			   lreadpast=" With (READPAST) "
		   Endif
		   
		   This.SqlSelect="Select "+This.Campos+" From "+wdbo+ALLTRIM(This.NombreTabla)+lreadpast+lwhe+lwheadi
		EndIf
		IF USED(This.Alias)
		   lsele="Select '"+This.Alias+"'"
		   &lsele
		   IF CURSORGETPROP("Buffering",ALLTRIM(This.Alias))<>1
		      =TABLEREVERT(.t.) 
		   ENDIF
		ENDIF
		
		SET MESSAGE to "Ejecutando Consulta....."+This.Alias+"...."
		
		lsqlcad=This.SqlSelect
		
		IF (ThisForm.Conexion_Osis.Tipo_BD=1 or ThisForm.Conexion_Osis.Tipo_BD=3)
			IF SQLEXEC(ThisForm.Conexion_Osis.Conexion,lsqlcad,This.Alias)<0
			   &lacci2
			   MESSAGEBOX(MESSAGE()+CHR(13)+lsqlcad,16,"Error")
			   RETURN .f.
			ENDIF
		ENDIF
		IF ThisForm.Conexion_Osis.Tipo_BD=4
		   IF ThisForm.Conexion_Osis.MS_Ejecuta_SQL(lsqlcad,This.Alias,ThisForm.DataSessionId)<0	
		      &lacci2
		      RETURN .F.
		   ENDIF
		ENDIF
		
		
		This.Area=SELECT()
		
		
		
		&& Carga Imagen
		IF !This.Indicador_Consulta &&AND This.TipoVerificacion=1 
		    IF (ThisForm.Conexion_Osis.Tipo_BD=1 OR ThisForm.Conexion_Osis.Tipo_BD=3)
				IF SQLEXEC(ThisForm.Conexion_Osis.Conexion,This.SqlSelect,ALLTRIM(This.Alias)+"_Imagen")<0
				   &lacci2
				   MESSAGEBOX(MESSAGE()+CHR(13)+This.SqlSelect,16,"Error Imagen")
				   RETURN .f.
				ENDIF
			ENDIF
		    IF ThisForm.Conexion_Osis.Tipo_BD=4
				IF ThisForm.Conexion_Osis.MS_Ejecuta_SQL(This.SqlSelect,ALLTRIM(This.Alias)+"_Imagen",ThisForm.DataSessionId)<0
				   &lacci2
				   RETURN .f.
				ENDIF
			ENDIF
			
			This.AreaImagen=SELECT()
			
			lindex=""
			lcampo=""
			FOR ln=1 TO This.Columnas
		    	IF This.Estructura[ln,2]=0
		    	   lcoman="ltipo=TYPE('"+ALLTRIM(This.Alias)+"_Imagen."+ALLTRIM(This.Estructura[ln,1])+"')"
		    	   &lcoman
		    	   IF ltipo=="C"
		    	      lcampo=ALLTRIM(This.Estructura[ln,1])
		    	   EndIf	
		    	   IF ltipo=="N"
		    	      lcampo="STR("+ALLTRIM(This.Estructura[ln,1])+")"
		    	   EndIf	
		    	   IF ltipo$"DT"
		    	      lcampo="DTOS("+ALLTRIM(This.Estructura[ln,1])+")"
		    	   ENDIF
		    	   IF !EMPTY(lcampo)
			       	  lindex=lindex+lcampo+"+"
			       ENDIF
			    EndIf
			ENDFOR
			SELECT (This.Area)
		ENDIF
		IF !EMPTY(This.LLave_Original)
		   lindex=UPPER(ALLTRIM(This.LLave_Original))+" "
		ENDIF
		
		&&IF EMPTY(This.Llave)
		   IF !This.Indicador_Consulta 
				IF This.CrearIndiceLlave 
				   IF !EMPTY(lindex) or !EMPTY(This.Llave) 
					   This.Llave_Original=LEFT(lindex,LEN(lindex)-1)  
					   IF EMPTY(This.LLave) 
						  This.Llave=This.Llave_Original
					   EndIf	   
					   lcreind="INDEX ON "+This.Llave_Original+" TAG PRINCIPAL" 
					   &lcreind
					   lcreind="INDEX ON "+This.Llave+" TAG LLAVE " 
					   &lcreind
				   ENDIF
				   IF This.AreaImagen<>0 &&AND This.TipoVerificacion=1
					  SELECT (This.AreaImagen)
					  IF !EMPTY(lindex) 
						  This.Llave_Original=LEFT(lindex,LEN(lindex)-1)  
						  lcreind="INDEX ON "+This.Llave_Original+" TAG PRINCIPAL" 
						  &lcreind
					  ENDIF
				   ENDIF
				ENDIF
		   ENDIF
		   IF This.Indicador_consulta AND !EMPTY(This.LLave) 
		   	  SELECT (This.Area) 
			  lcreind="INDEX ON "+This.Llave+" TAG LLAVE " 
			  &lcreind
		   ENDIF
		   	
		
		IF !EMPTY(This.CuadriculaAsociada )
		    lcalcula=ALLTRIM(This.CuadriculaAsociada)+".Calcula()"
		    &lcalcula
		ENDIF
		
		SELECT (This.Area)
		IF This.Inicia_Ultimo_Registro 
		   GO BOTTOM
		Else   
		   GO TOP
		ENDIF
		
		
		&lacci2
		IF &lacci5
		   &lacci4
		ENDIf	
		
		SET MESSAGE TO ""
		
		
		
		
	ENDPROC

	PROCEDURE Detalle.AfterRowColChange
		LPARAMETERS nColIndex
		DODEFAULT(nColIndex)
		
		     
		
		
	ENDPROC

	PROCEDURE Detalle.Column10.btnViewDoc.Click
		
		STORE 0 TO li_ddi_codddi
		STORE "" TO ls_s07_codopc
		
		li_ddi_codddi=Thisform.Datos1.Campo_Valor("ddi_codddi") 
		ls_s07_codopc=Thisform.Datos1.Campo_Valor("s07_codopc") 
		ThisForm.Administra_Documento.CreaTemporal=.T.
		WAIT WINDOW "Generando Vista de Documento..!!" NOWAIT 
		ThisForm.Administra_Documento.Visualiza_documento(li_ddi_codddi,ls_s07_codopc,"","")
		
	ENDPROC

	PROCEDURE Detalle.Column2.btnView.Click
		
		STORE 0 TO li_ddi_codddi
		STORE "" TO ls_s07_codopc,ls_ddi_nomdoc,ls_gdo_desgdo
		
		li_ddi_codddi=ThisForm.Datos1.Campo_valor("ddi_codddi") 
		ls_s07_codopc=ThisForm.Datos1.Campo_valor("s07_codopc") 
		ls_ddi_nomdoc=ThisForm.Datos1.Campo_valor("ddi_nomdoc") 
		ls_gdo_desgdo=ThisForm.Datos1.Campo_valor("gdo_desgdo") 
		DO FORM forms\frm_gene_docu With li_ddi_codddi,ls_s07_codopc,ls_ddi_nomdoc,ls_gdo_desgdo
		
		
		
	ENDPROC

	PROCEDURE Detalle.Column3.btnEdita.Click
		
		STORE .F. TO lb_ret
		STORE 0 TO li_ddi_codddi,li_tpa_codtpa,li_gdo_codgdo
		STORE "" TO ls_ddi_glousu
		
		li_ddi_codddi=ThisForm.Datos1.campo_valor("ddi_codddi") 
		li_tpa_codtpa=ThisForm.Datos1.campo_valor("tpa_codtpa") 
		li_gdo_codgdo=ThisForm.Datos1.campo_valor("gdo_codgdo") 
		ls_ddi_glousu=ThisForm.Datos1.campo_valor("ddi_glousu") 
		DO FORM forms\frm_adjunta_doc WITH ThisForm.Entorno.Programa,ThisForm.ls_ddi_codkey,li_ddi_codddi,li_tpa_codtpa,li_gdo_codgdo,ls_ddi_glousu TO lb_ret
		
		IF lb_ret==.T.
			ThisForm.Datos1.selecciona()    
			ThisForm.Detalle.AfterRowColChange()  
			ThisForm.Detalle.Refresh()  
		ENDIF 
		
	ENDPROC

	PROCEDURE Detalle.Column4.btnDelete.Click
		
		STORE 0 TO li_ddi_codddi
		
		*!*	IF ThisForm.Valida_existe_documento_adjunto==.t. 
		*!*		SELECT(ThisForm.Datos1.alias) 
		*!*		GO TOP 
		*!*		IF RECCOUNT()=1
		*!*			MESSAGEBOX("Validación: No se pueden eliminar todos los documentos adjuntos..!!",64,ThisForm.Caption)
		*!*			RETURN .F.
		*!*		ENDIF 
		*!*	ENDIF 
		
		ThisForm.Administra_documento.BDConexion=ThisForm.Conexion_Osis   
		IF MESSAGEBOX("¿Seguro de Quitar Documento?",32+4+256,ThisForm.Caption)=6
			li_ddi_codddi=ThisForm.Datos1.Campo_Valor("ddi_codddi") 
			IF ThisForm.Administra_Documento.Elimina_documento(li_ddi_codddi) 
				ThisForm.Datos1.Selecciona()  
				ThisForm.Detalle.Refresh()  
			ENDIF 	
		ENDIF  
		
	ENDPROC

	PROCEDURE Detalle.Column7.Header1.Click
		MESSAGEBOX(This.Parent.CurrentControl)   
		
	ENDPROC

