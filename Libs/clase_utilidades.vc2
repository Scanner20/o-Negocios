		ForeColor = 255,255,255, ;
		Left = 186, ;
		Name = "Etiqueta1", ;
		TabIndex = 6, ;
		Top = 10, ;
		ZOrderSet = 6
		*< END OBJECT: ClassLib="claseosis.vcx" BaseClass="label" />
	
	PROCEDURE conecta_usuario
		*------- Realiza Conexion
		This.Conexion_Osis.Servidor = Ocnx.Servidor
		This.Conexion_Osis.Usuario = This.Administra_Documento.Usuario 
		This.Conexion_Osis.Password = This.Administra_documento.Password  
		This.Conexion_Osis.Tipo_BD = Ocnx.Tipo_BD
		This.Conexion_Osis.BaseDatos = This.Administra_documento.BaseDatos 
		 
		This.Administra_documento.BDConexion=This.Conexion_Osis  
		
	ENDPROC

	PROCEDURE Init
		LPARAMETERS lps07_cods07 as String,lpCodKey as String,lpddi_codddi as Integer,lpCodtpa as Integer,lpCodgdo as Integer, lpGlousu as String
		
		
		
		IF EMPTY(ALLTRIM(NVL(lps07_cods07,'')))
			MESSAGEBOX("Validación: Debe de enviar el parametro de Codigo de Opción del sistema..!!",64,ThisForm.Caption)
			RETURN .F.
		ENDIF 
		
		IF EMPTY(ALLTRIM(NVL(lps07_cods07,'')))
			MESSAGEBOX("Validación: Debe de enviar el parametro de LLAVE de Opcion del sistema..!!",64,ThisForm.Caption)
			RETURN .F.
		ENDIF 
		
		
		ThisForm.ls_s07_cods07=ALLTRIM(NVL(lps07_cods07,''))
		ThisForm.li_ddi_codddi=NVL(lpddi_codddi,0)  
		ThisForm.ls_ddi_codkey=ALLTRIM(NVL(lpCodKey,''))
		
		
		IF PARAMETERS()=6
		 	ThisForm.etiqueta1.Caption=ALLTRIM(ThisForm.etiqueta1.Caption)+SPACE(20)+"[EDICION]"  
		 	ThisForm.Contenedor2.Cmb_tipo_archivo.Value=lpCodtpa
		 	ThisForm.Contenedor2.cmb_grupo_documento.Value=lpCodgdo
		 	ThisForm.contenedor2.txtGlosa.Value=lpGlousu      
		ENDIF 
		
		This.conecta_usuario() 
		
		
	ENDPROC

	PROCEDURE Unload
		DODEFAULT()
		
	ENDPROC

	PROCEDURE valida
		*-- Validaciones
		
		IF Empty(ThisForm.Contenedor2.cmb_grupo_documento.Value)
			MESSAGEBOX("Validación: Seleccione grupo de documentos..!!",64,ThisForm.Caption)
			RETURN .F.
		ENDIF   
		
		IF Empty(ThisForm.Contenedor2.cmb_tipo_archivo.Value)
			MESSAGEBOX("Validación: Seleccione tipo de archivo [EXCEL,WORD,ACROBAT READER,..]..!!",64,ThisForm.Caption)
			RETURN .F.
		ENDIF   
		
		IF EMPTY(ALLTRIM(NVL(ThisForm.Contenedor2.txtGlosa.Value,'')))
			MESSAGEBOX("Validación: Ingrese una glosa para el documento..!!",64,ThisForm.Caption)
			RETURN .F.
		ENDIF   
		
		IF EMPTY(ALLTRIM(NVL(ThisForm.edtRuta.Value,'')))
			MESSAGEBOX("Validación: Seleccione documento a adjuntar..!!",64,ThisForm.Caption)
			RETURN .F.
		ENDIF   
		
		
		
	ENDPROC

	PROCEDURE botongrupo.Cmb_Aceptar.Click
		&&LPARAMETERS lpCodddi as integer,lpCodopc as String, lpFile as String,lpExt_File as Integer, lpGloUsu as String,lpCodgdo as Integer   
		
		STORE 0 to lpCodddi,lpExt_File,lpCodgdo 
		STORE "" TO lpCodopc,lpFile,lpGloUsu,lpCodKey  
		
		
		IF !ThisForm.valida() 
			RETURN .F.
		ENDIF 
		
		 
		lpCodddi = ThisForm.li_ddi_codddi 
		lpExt_File=ThisForm.Contenedor2.cmb_tipo_archivo.Value  
		lpCodgdo  =ThisForm.Contenedor2.cmb_grupo_documento.Value  
		lpFile	  =ALLTRIM(NVL(ThisForm.edtRuta.value,''))
		lpGloUsu  =ALLTRIM(NVL(ThisForm.contenedor2.txtGlosa.value,''))
		lpCodopc  =UPPER(ALLTRIM(nvl(ThisForm.ls_s07_cods07,''))) 
		lpCodKey  =ThisForm.ls_ddi_codkey 
		
		IF !ThisForm.Administra_documento.Adjunta_documento(lpCodddi,lpCodopc,lpFile,lpExt_File,lpGloUsu,lpCodgdo,lpCodKey)
			MESSAGEBOX("No se Adjunto correctamente el archivo: [ "+lpFile+" ]",48,ThisForm.Caption)	
			RETURN 
		ELSE
			MESSAGEBOX("Se Adjunto correctamente el archivo: [ "+lpFile+" ]",64,ThisForm.Caption)	
			ThisForm.Cerrar() 
			RETURN 
		ENDIF 
	ENDPROC

	PROCEDURE Contenedor2.btnBuscar.Click
		IF ThisForm.Administra_Documento.Seleccionar_documento(ThisForm.contenedor2.Cmb_tipo_archivo.Value)  
			ThisForm.edtRuta.Value=IIF(!EMPTY(ALLTRIM(NVL(ThisForm.Administra_documento.ls_filename,''))),ALLTRIM(NVL(ThisForm.Administra_documento.ls_filename,'')),ThisForm.edtRuta.Value)   
		ENDIF 
		
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE Contenedor2.Cmb_grupo_documento.Init
		LPARAMETERS lpObj as Object 
		thisform.Conecta_usuario() 
		IF !thisform.Administra_documento.Verifica_coneccion()  	
			RETURN .f.
		ENDIF 
		DODEFAULT(Thisform.Conexion_Osis)
		
	ENDPROC

	PROCEDURE Contenedor2.Cmb_tipo_archivo.Init
		LPARAMETERS lpObj as Object 
		thisform.Conecta_usuario() 
		IF !thisform.Administra_documento.Verifica_coneccion()  	
			RETURN .f.
		ENDIF 
		DODEFAULT(Thisform.Conexion_Osis) 
	ENDPROC

ENDDEFINE

