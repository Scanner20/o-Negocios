		lexe="DO FORM Forms\"+This.Formulario_Documentos+" With '"+ALLTRIM(This.Programa)+"','"+ALLTRIM(This.Titulo)+"','"+ALLTRIM(This.Llave)+"', "+IIF(This.Valida_Existe_Documento_Adjunto==.T.,".T.",".F.")+", "+IIF(This.Filtra_Opcion==.T.,".T.",".F.")+", "+IIF(This.Permite_Adjuntar==.T.,".T.",".F.")
