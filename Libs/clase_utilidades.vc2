DEFINE CLASS cmb_grupo_documento AS combo OF "claseosis.vcx" 
 	*< CLASSDATA: Baseclass="combobox" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<PropValue>
		DisabledBackColor = 192,192,192
		Name = "cmb_grupo_documento"
	*</PropValue>
	
	PROCEDURE Destroy
		DODEFAULT()
		ps_cursor = "T"+ALLTRIM(This.Name)
		IF USED("&ps_cursor")
			USE IN "&ps_cursor"
		ENDIF 
	ENDPROC

	PROCEDURE Init
		LPARAMETERS lpObj as Object 
		
		DODEFAULT()
		
		lArea=SELECT()
		PRIVATE ps_cursor, ps_cadena
		
		ps_cursor = "T"+ALLTRIM(This.Name)
		ps_cadena = "Select gdo_codgdo,gdo_desgdo			"+;
					"From Jrojas_img.dbo.GRUPO_DOCDIG_GDO	"+;
					"Where gdo_indest = '1'					"
		
		IF SQLEXEC(lpObj.Conexion,ps_cadena,ps_cursor)<1
			=MESSAGEBOX("Error: Al abrir archivo [Jrojas_img.dbo.GRUPO_DOCDIG_GDO] "+CHR(13)+;
						MESSAGE(),64,ThisForm.Caption)
			RETURN .F.				
		ENDIF 
		
		SELECT(ps_cursor)
		This.RowSourceType = 2
		This.ColumnCount = 2
		This.RowSource = ALLTRIM(ps_cursor) + ".gdo_desgdo,gdo_codgdo"
		This.BoundColumn = 2
		This.ColumnWidths="300,20"
		This.Requery() 
		
		SELECT(lArea)
		
	ENDPROC

ENDDEFINE

