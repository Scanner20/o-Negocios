		ilength=ALEN(pLLave,1)
		IF ilength=0
			MESSAGEBOX("Validación: El Objeto datos "+This.DatoObjeto.Alias+" No tiene Llave..!!",64,"Validación")
			RETURN .F.
		ENDIF 
		STORE "" TO ls_campo,ls_llave,ls_alias
		
		lexe="ls_alias="+This.DatoObjeto+".Alias"
		&lexe
		
		FOR i=1 TO ilength
			
			ls_campo=pLLave[i]
			lexe="ls_campo="+ls_alias+"."+ls_campo
			&lexe
			
			DO CASE  
				CASE TYPE("ls_campo")=="N"
					ls_campo=ALLTRIM(STR(ls_campo))
