DEFINE CLASS ayuda_fecha AS responde OF "claseosis.vcx" 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="OleCalendario" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: fecha
	*</DefinedPropArrayMethod>

	*<PropValue>
		DoCreate = .T.
		fecha = ({})
		Height = 239
		Name = "ayuda_fecha"
		Width = 318
		entorno.Name = "entorno"
		StatusBar.Height = 23
		StatusBar.Left = 0
		StatusBar.Name = "StatusBar"
		StatusBar.Top = 216
		StatusBar.Width = 318
		CRISTAL.Name = "CRISTAL"
		botongrupo.AutoSize = .F.
		botongrupo.Cmb_Aceptar.Height = 24
		botongrupo.Cmb_Aceptar.Left = 115
		botongrupo.Cmb_Aceptar.Name = "Cmb_Aceptar"
		botongrupo.Cmb_Aceptar.Top = 5
		botongrupo.Cmb_Ayuda.Height = 24
		botongrupo.Cmb_Ayuda.Left = 5
		botongrupo.Cmb_Ayuda.Name = "Cmb_Ayuda"
		botongrupo.Cmb_Ayuda.Top = 5
		botongrupo.Cmb_Cancelar.Height = 24
		botongrupo.Cmb_Cancelar.Left = 240
		botongrupo.Cmb_Cancelar.Name = "Cmb_Cancelar"
		botongrupo.Cmb_Cancelar.Top = 5
		botongrupo.Height = 34
		botongrupo.Left = 0
		botongrupo.Name = "botongrupo"
		botongrupo.Top = 187
		botongrupo.Width = 324
	*</PropValue>

	ADD OBJECT 'OleCalendario' AS olecontrol WITH ;
		Height = 183, ;
		Left = 2, ;
		Name = "OleCalendario", ;
		Top = 1, ;
		Width = 311
		*< END OBJECT: BaseClass="olecontrol" OLEObject="c:\archivos de programa\microsoft office\office11\mscal.ocx" Value="" />
	
	PROCEDURE Activate
		DODEFAULT()
		This.Resize() 
	ENDPROC

	PROCEDURE Init
		LPARAMETERS lp_fecha as Datetime && Fecha Default 
		
		This.Caption = "Calendario"
		
		IF PARAMETERS()>0 AND TYPE("lp_fecha")$"T,D" AND !EMPTY(lp_fecha)
			This.OleCalendario.OBJECT.Value =  lp_fecha
		ELSE
			This.OleCalendario.OBJECT.Value = DATETIME() 
		ENDIF
		
	ENDPROC

	PROCEDURE Resize
		DODEFAULT()
		This.Botongrupo.Left = 0
		This.Botongrupo.Top = This.StatusBar.Top -  This.Botongrupo.Height - 2
		This.Botongrupo.Width = This.Width - 2
		This.Botongrupo.Cmb_Cancelar.Left = This.Botongrupo.Width - This.Botongrupo.Cmb_Cancelar.Width -2
		This.Botongrupo.Cmb_Ayuda.Left = 0
		This.Botongrupo.Cmb_Aceptar.Left =  INT(This.Botongrupo.Width/2)-INT(This.Botongrupo.Cmb_Aceptar.Width/2)   
		This.OleCalendario.Top = 0
		This.OleCalendario.Left = 0
		This.OleCalendario.Height = This.Height - (This.StatusBar.Height+This.Botongrupo.Height) - 2
		This.OleCalendario.Width = This.Width 
		
		
		 
	ENDPROC

	PROCEDURE Unload
		RETURN This.Fecha 
	ENDPROC

	PROCEDURE botongrupo.Cmb_Aceptar.Click
		ThisForm.Fecha = ThisForm.OleCalendario.OBJECT.Value   
		ThisForm.Cerrar()
	ENDPROC

	PROCEDURE botongrupo.Cmb_Cancelar.Click
		ThisForm.Fecha = {}
		DODEFAULT()
	ENDPROC

ENDDEFINE

DEFINE CLASS btnadmindoc_valida AS boton OF "claseosis.vcx" 
 	*< CLASSDATA: Baseclass="commandbutton" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: obtiene_datos_llave
		*m: obtiene_llave_dato_objeto
		*m: valida_datos
		*p: datoobjeto
		*p: formulario_adjunta
		*p: llave
		*p: ls_glosausu
		*p: programa
		*p: titulo
	*</DefinedPropArrayMethod>

	*<PropValue>
		datoobjeto = 
		formulario_adjunta = frm_adjunta_doc_valida
		Height = 31
		llave = 
		ls_glosausu = ("")
		Name = "btnadmindoc_valida"
		programa = ("")
		titulo = ("")
		Width = 31
	*</PropValue>
	
	PROCEDURE Click
		IF !This.Obtiene_Datos_Llave()
			RETURN .F.
		ENDIF 
		
		IF !This.Obtiene_Llave_Dato_Objeto()
			RETURN .F.
		ENDIF 
		
		IF !This.Valida_datos() 
			RETURN .F.
		ENDIF 
		
		IF !EMPTY(ALLTRIM(NVL(This.ls_glosausu,'')))
			lexe="DO FORM Forms\"+This.Formulario_Adjunta+" With '"+ALLTRIM(This.Programa)+"','"+ALLTRIM(This.Llave)+"' "+"','"+ALLTRIM(This.ls_glosausu)+"' "
		ELSE
			lexe="DO FORM Forms\"+This.Formulario_Adjunta+" With '"+ALLTRIM(This.Programa)+"','"+ALLTRIM(This.Llave)+"' "
		ENDIF 
		&lexe
		
	ENDPROC

	PROCEDURE obtiene_datos_llave
	ENDPROC

	PROCEDURE obtiene_llave_dato_objeto
		*-------Obtener Datos LLave
		IF Type(This.DatoObjeto)<>"O"
			RETURN 
		ENDIF 
		
		LOCAL pDatoObjeto as Object
		LOCAL pNroLlave as Integer 
		
		lexe="pNroLlave="+This.DatoObjeto+".NroLlave"
		&lexe
		
		DIMENSION pLLave[pNroLlave]
		FOR i=1 TO pNroLlave
			lexe="pLLave["+ALLTRIM(STR(i))+"]="+This.DatoObjeto+".LlavePrimaria["+ALLTRIM(STR(i))+"]"
			&lexe
		ENDFOR 
		
		ilength=ALEN(pLLave,1)
		IF ilength=0
			MESSAGEBOX("Validación: El Objeto datos "+This.DatoObjeto.Alias+" No tiene Llave..!!",64,"Validación")
			RETURN .F.
		ENDIF 
		STORE "" TO ls_campo,ls_llave,ls_alias
		
		lexe="ls_alias="+This.DatoObjeto+".Alias"
		&lexe
		
		FOR i=1 TO ilength
			
			ls_campo=pLLave[i]
			lexe="ls_campo="+ls_alias+"."+ls_campo
			&lexe
			
			DO CASE  
				CASE TYPE("ls_campo")=="N"
					ls_campo=ALLTRIM(STR(ls_campo))
				CASE TYPE("ls_campo")=="C"
					ls_campo=ALLTRIM(ls_campo)				
				CASE TYPE("ls_campo")=="D" OR TYPE("ls_campo")=="T"
					ls_campo=ALLTRIM(DTOC(ls_campo,1))							
				OTHERWISE 
					MESSAGEBOX("Validación: Tipo de dato del campo no permitido solo se aceptan tipo de datos caracter..!!",64,"Validación")
					RETURN  .F.
			ENDCASE 
			ls_llave=ls_llave+ls_campo
		ENDFOR 
		
		IF EMPTY(ls_llave)
			MESSAGEBOX("Validación: No se logro obtener datos de llave de archivo "+This.Datoobjeto.Alias+"..!!",64,"Validación")
			RETURN .F.
		ENDIF 
		
		This.Llave=ls_llave
	ENDPROC

	PROCEDURE valida_datos
		*----- Validaciones
		
		IF TYPE("This.Llave")<>"C"
			MESSAGEBOX("Validación: El valor de LLAVE del programa debe ser caracter..!!",64,ThisForm.Caption)
			RETURN .F.
		ENDIF 
		
		IF EMPTY(ALLTRIM(NVL(This.Llave,'')))
		 	MESSAGEBOX("Validación: No se ha especificado la LLAVE del programa..!!",64,ThisForm.Caption)
		 	RETURN .F.
		ENDIF 
		
		*-------- Colocar Datos Predeterminado
		IF EMPTY(ALLTRIM(NVL(This.Programa,'')))
		 	This.Programa=ThisForm.Entorno.Programa
		ENDIF 
		IF EMPTY(ALLTRIM(NVL(This.Titulo,'')))
			This.Titulo=ThisForm.Entorno.Titulo 
		ENDIF 
	ENDPROC

ENDDEFINE

DEFINE CLASS btnadminstra_documentos AS boton OF "claseosis.vcx" 
 	*< CLASSDATA: Baseclass="commandbutton" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: obtiene_datos_llave
		*m: obtiene_llave_dato_objeto
		*m: valida_datos
