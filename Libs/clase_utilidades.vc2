	*</PropValue>
	
	PROCEDURE Click
		IF !EMPTY(ALLTRIM(NVL(This.Objeto_Formulario,'')))
			lexe="lest="+This.Objeto_Formulario+".Estado "
			&lexe
			IF lest==1
				MESSAGEBOX("Validación: Debe de Grabar primero el Registro..Antes de Adjuntar documentos...!!",64,ThisForm.Caption)
				RETURN .F.
			ENDIF 	
		ENDIF 
		
		IF !This.Obtiene_Datos_Llave()
			RETURN .F.
		ENDIF 
		
		IF !This.Obtiene_Llave_Dato_Objeto()
