DEFINE CLASS ctn_administra_documentos AS contenedor OF "claseosis.vcx" 
 	*< CLASSDATA: Baseclass="container" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Btnadminstra_documentos" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Funciones_administra_documento" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Conexion_Osis" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: conecta_usuario
		*m: valida_existe_documentos_adjuntados
		*p: objeto_formulario
	*</DefinedPropArrayMethod>

	*<PropValue>
		Height = 73
		Name = "ctn_administra_documentos"
		objeto_formulario = .F.
		Width = 82
	*</PropValue>

	ADD OBJECT 'Btnadminstra_documentos' AS btnadminstra_documentos WITH ;
		Left = -1, ;
		Name = "Btnadminstra_documentos", ;
		objeto_formulario = ThisForm, ;
		Top = 0
		*< END OBJECT: ClassLib="clase_utilidades.vcx" BaseClass="commandbutton" />

	ADD OBJECT 'Conexion_Osis' AS conexion WITH ;
		Left = 72, ;
		Name = "Conexion_Osis", ;
		Top = 24
		*< END OBJECT: ClassLib="claseosis.vcx" BaseClass="custom" />

	ADD OBJECT 'Funciones_administra_documento' AS funciones_administra_documento WITH ;
		Left = 96, ;
		Name = "Funciones_administra_documento", ;
		Top = 12
		*< END OBJECT: ClassLib="clase_utilidades.vcx" BaseClass="custom" />
	
	PROCEDURE conecta_usuario
		*------- Realiza Conexion
		This.Conexion_Osis.Servidor = Ocnx.Servidor
		This.Conexion_Osis.Usuario = This.Funciones_administra_documento.Usuario 
		This.Conexion_Osis.Password = This.Funciones_administra_documento.Password  
		This.Conexion_Osis.Tipo_BD = Ocnx.Tipo_BD
		This.Conexion_Osis.BaseDatos = This.Funciones_administra_documento.BaseDatos 
		  
		This.Funciones_administra_documento.BDConexion=This.Conexion_Osis   
		
		
		
	ENDPROC

	PROCEDURE valida_existe_documentos_adjuntados
		IF !This.Btnadminstra_documentos.Obtiene_Datos_Llave()
			RETURN .F.
		ENDIF 
		
		IF !This.Btnadminstra_documentos.Obtiene_Llave_Dato_Objeto()
			RETURN .F.
		ENDIF 
		
		IF !This.Btnadminstra_documentos.Valida_datos() 
			RETURN .F.
		ENDIF 
		
		This.Conecta_usuario() 
		IF !This.Funciones_administra_documento.Verifica_existe_documentos_adjuntados(This.Btnadminstra_documentos.Programa,This.Btnadminstra_documentos.Llave)     
			MESSAGEBOX("Validación: No existen Documentos Adjuntados para la Opción: "+This.Btnadminstra_documentos.titulo,64,This.Btnadminstra_documentos.titulo)
			RETURN .F.
		ELSE
			RETURN .T.
		ENDIF 
		
	ENDPROC

ENDDEFINE

DEFINE CLASS ctn_administra_documentos_valida AS contenedor OF "claseosis.vcx" 
 	*< CLASSDATA: Baseclass="container" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Conexion_Osis" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Administra_documento" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: conecta_usuario
		*m: valida_documentos_adjuntos
		*m: valida_documentos_adjuntos_grabados
		*m: valida_documentos_edicion
		*p: datoobjeto_valida
		*p: llave_valida
		*p: programa
		*p: ps_filtra
		*p: titulo
	*</DefinedPropArrayMethod>

	*<PropValue>
		datoobjeto_valida = 
		Height = 42
		llave_valida = ("")
		Name = "ctn_administra_documentos_valida"
		programa = ("")
		ps_filtra = ("")
		titulo = ("")
		Width = 24
	*</PropValue>

	ADD OBJECT 'Administra_documento' AS funciones_administra_documento WITH ;
		Left = 0, ;
		Name = "Administra_documento", ;
		Top = 0
		*< END OBJECT: ClassLib="clase_utilidades.vcx" BaseClass="custom" />

	ADD OBJECT 'Conexion_Osis' AS conexion WITH ;
		Left = 0, ;
		Name = "Conexion_Osis", ;
		Top = 21
		*< END OBJECT: ClassLib="claseosis.vcx" BaseClass="custom" />
	
	PROCEDURE conecta_usuario
		*------- Realiza Conexion
		This.Conexion_Osis.Servidor = Ocnx.Servidor
		This.Conexion_Osis.Usuario = This.Administra_Documento.Usuario 
		This.Conexion_Osis.Password = This.Administra_documento.Password  
		This.Conexion_Osis.Tipo_BD = Ocnx.Tipo_BD
		This.Conexion_Osis.BaseDatos = This.Administra_documento.BaseDatos 
		 
		This.Administra_documento.BDConexion=This.Conexion_Osis  
		
		
		
	ENDPROC

	PROCEDURE Init
		DODEFAULT()
		
		IF EMPTY(ALLTRIM(NVL(This.Programa,''))) 
			This.Programa=ThisForm.Entorno.Programa 
		ENDIF 
		IF EMPTY(ALLTRIM(NVL(This.titulo,''))) 
			This.Titulo=ThisForm.Entorno.Titulo
		ENDIF 
		This.Conecta_usuario() 
		IF EMPTY(ALLTRIM(NVL(This.Administra_documento.ps_name_table,'')))
			ls_Cursor_Name = "T"+This.Programa 
			This.Administra_documento.ps_name_table = ls_Cursor_Name
		ENDIF  
		
		
	ENDPROC

	PROCEDURE valida_documentos_adjuntos
		*-------Obtener Datos LLave
		IF Type(This.DatoObjeto_Valida)<>"O"
			RETURN 
		ENDIF 
		
		LOCAL pDatoObjeto as Object
		LOCAL pNroLlave as Integer 
		LOCAL pAlias as String 
		LOCAL pLlave as String 
		LOCAL pGrid as String 
		
		
		
		larea=SELECT()
		
		lexe="pAlias="+This.DatoObjeto_Valida+".Alias"
		&lexe
		
		IF !USED(ALLTRIM(This.Administra_documento.ps_name_table))
			This.Administra_documento.Creaestructura_table()   
		ENDIF 
		 
		SELECT ALLTRIM(pAlias)
		GO TOP 
		IF !EMPTY(ALLTRIM(NVL(This.ps_Filtra,'')))
			lexe="Set Filter To "+this.ps_filtra
			&lexe 
		ENDIF 
		SCAN
			lexe="pLlave="+This.LLave_valida
			&lexe
			IF !SEEK(pLlave,ALLTRIM(This.Administra_documento.ps_name_table),"I") AND !EMPTY(pLlave)
				MESSAGEBOX("Validación: Debe de Adjuntar Documentos Antes Grabar en "+ALLTRIM(This.Titulo)+"..!!",64,"Validación")
				RETURN .F.
			ENDIF 
			SELECT ALLTRIM(pAlias)
		ENDSCAN 
		
		
		SELECT ALLTRIM(pAlias)
		GO TOP 
		IF !EMPTY(ALLTRIM(NVL(This.ps_Filtra,'')))
			lexe="Set Filter To "
			&lexe 
		ENDIF 
		lexe="pGrid="+This.DatoObjeto_Valida+".CuadriculaAsociada"
		&lexe
		lexe=pGrid+".Refresh()"
		&lexe
		
		SELECT(larea)
		
		
		
		
		
		
		
	ENDPROC

	PROCEDURE valida_documentos_adjuntos_grabados
		*-------Obtener Datos LLave
		IF Type(This.DatoObjeto_Valida)<>"O"
			RETURN 
		ENDIF 
		
		LOCAL pDatoObjeto as Object
		LOCAL pNroLlave as Integer 
		LOCAL pAlias as String 
		LOCAL pLlave as String 
		LOCAL pGrid as String 
		
		
		larea=SELECT()
		
		lexe="pAlias="+This.DatoObjeto_Valida+".Alias"
		&lexe
		 
		SELECT ALLTRIM(pAlias)
		GO TOP 
		IF !EMPTY(ALLTRIM(NVL(This.ps_Filtra,'')))
			lexe="Set Filter To "+this.ps_filtra
			&lexe 
		ENDIF 
		SCAN
			lexe="pLlave="+This.LLave_valida
			&lexe
		
			IF !This.Administra_documento.Verifica_existe_documentos_adjuntados(This.Programa,pLlave)  AND !EMPTY(pLlave)
				MESSAGEBOX("Validación: Existen documentos adjuntados debe de eliminarlos antes de Anular el registro..!!",64,"Validación")	
				RETURN .F.
			ENDIF 
			
			SELECT ALLTRIM(pAlias)
		ENDSCAN 
		
		SELECT ALLTRIM(pAlias)
		GO TOP 
		IF !EMPTY(ALLTRIM(NVL(This.ps_Filtra,'')))
			lexe="Set Filter To "
			&lexe 
		ENDIF 
		lexe="pGrid="+This.DatoObjeto_Valida+".CuadriculaAsociada"
		&lexe
		lexe=pGrid+".Refresh()"
		&lexe
		
		SELECT(larea)
		
		
	ENDPROC

	PROCEDURE valida_documentos_edicion
		*-------Obtener Datos LLave
		IF Type(This.DatoObjeto_Valida)<>"O"
			RETURN 
		ENDIF 
		
		LOCAL pDatoObjeto as Object
		LOCAL pNroLlave as Integer 
		LOCAL pAlias as String 
		LOCAL pLlave as String 
		LOCAL pGrid as String 
		
		
		larea=SELECT()
		
		
		lexe="pAlias="+This.DatoObjeto_Valida+".Alias"
		&lexe
		 
		SELECT ALLTRIM(pAlias)
		GO TOP 
		IF !EMPTY(ALLTRIM(NVL(This.ps_Filtra,'')))
			lexe="Set Filter To "+this.ps_filtra
			&lexe 
		ENDIF 
		SCAN
			lexe="pLlave="+This.LLave_valida
			&lexe
			IF !This.Administra_documento.Verifica_existe_documentos_adjuntados(This.Programa,pLlave)  AND !EMPTY(pLlave)
				MESSAGEBOX("Validación: Debe de Adjuntar  Documentos para Grabar la Planilla de Cobranza..!!",64,"Validación")	
				RETURN .F.
			ENDIF 
			
			SELECT ALLTRIM(pAlias)
		ENDSCAN 
		
		SELECT ALLTRIM(pAlias)
		GO TOP 
		IF !EMPTY(ALLTRIM(NVL(This.ps_Filtra,'')))
			lexe="Set Filter To "
			&lexe 
		ENDIF 
		lexe="pGrid="+This.DatoObjeto_Valida+".CuadriculaAsociada"
		&lexe
		lexe=pGrid+".Refresh()"
		&lexe
		
		SELECT(larea)
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS formulario_adjunta_doc_valida AS formulario_adjunta_documento OF "clase_utilidades.vcx" 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<PropValue>
		DataSession = 1
		DoCreate = .T.
		Name = "formulario_adjunta_doc_valida"
		entorno.Name = "entorno"
		StatusBar.Height = 23
		StatusBar.Left = 0
		StatusBar.Name = "StatusBar"
		StatusBar.Top = 208
		StatusBar.Width = 630
		CRISTAL.Name = "CRISTAL"
		botongrupo.Cmb_Aceptar.Left = 2
		botongrupo.Cmb_Aceptar.Name = "Cmb_Aceptar"
		botongrupo.Cmb_Aceptar.Top = 4
		botongrupo.Cmb_Ayuda.Left = 156
		botongrupo.Cmb_Ayuda.Name = "Cmb_Ayuda"
		botongrupo.Cmb_Ayuda.Top = 96
		botongrupo.Cmb_Cancelar.Left = 3
		botongrupo.Cmb_Cancelar.Name = "Cmb_Cancelar"
		botongrupo.Cmb_Cancelar.Top = 60
		botongrupo.Name = "botongrupo"
		Contenedor2.btnBuscar.Name = "btnBuscar"
		Contenedor2.cmb_grupo_documento.Name = "cmb_grupo_documento"
		Contenedor2.cmb_tipo_archivo.Name = "cmb_tipo_archivo"
		Contenedor2.Etiqueta1.Name = "Etiqueta1"
		Contenedor2.Etiqueta2.Name = "Etiqueta2"
		Contenedor2.Etiqueta3.Name = "Etiqueta3"
		Contenedor2.Etiqueta4.Name = "Etiqueta4"
		Contenedor2.Marco1.Name = "Marco1"
		Contenedor2.Name = "Contenedor2"
		Contenedor2.txtGlosa.Name = "txtGlosa"
		CONTENEDOR1.Name = "CONTENEDOR1"
		Etiqueta1.Name = "Etiqueta1"
		edtRuta.Name = "edtRuta"
		Administra_documento.Name = "Administra_documento"
		Conexion_Osis.Name = "Conexion_Osis"
	*</PropValue>
	
	PROCEDURE Init
		LPARAMETERS lps07_cods07 as String,lpCodKey as String,lpGlousu as String
		
		
		IF EMPTY(ALLTRIM(NVL(lps07_cods07,'')))
			MESSAGEBOX("Validación: Debe de enviar el parametro de Codigo de Opción del sistema..!!",64,ThisForm.Caption)
			RETURN .F.
		ENDIF 
		
		IF EMPTY(ALLTRIM(NVL(lps07_cods07,'')))
			MESSAGEBOX("Validación: Debe de enviar el parametro de LLAVE de Opcion del sistema..!!",64,ThisForm.Caption)
			RETURN .F.
		ENDIF 
		
		
		STORE "" TO ls_Cursor_Name
		
		ThisForm.ls_s07_cods07=ALLTRIM(NVL(lps07_cods07,''))
		ThisForm.ls_ddi_codkey=ALLTRIM(NVL(lpCodKey,''))
		IF EMPTY(ALLTRIM(NVL(ThisForm.Administra_documento.ps_name_table,'')))
			ls_Cursor_Name = "T"+ThisForm.ls_s07_cods07
			ThisForm.Administra_documento.ps_name_table = ls_Cursor_Name
		ENDIF  
		
		
		
	ENDPROC

	PROCEDURE botongrupo.Cmb_Aceptar.Click
		&&LPARAMETERS lpCodddi as integer,lpCodopc as String, lpFile as String,lpExt_File as Integer, lpGloUsu as String,lpCodgdo as Integer   
		
		STORE 0 to lpCodddi,lpExt_File,lpCodgdo 
		STORE "" TO lpCodopc,lpFile,lpGloUsu,lpCodKey  
		
		
		IF !ThisForm.valida() 
			RETURN .F.
		ENDIF 
		
		lpExt_File=VAL(ThisForm.Contenedor2.cmb_tipo_archivo.Value)
		lpCodgdo  =VAL(ThisForm.Contenedor2.cmb_grupo_documento.Value)
		lpFile	  =ALLTRIM(NVL(ThisForm.edtRuta.value,''))
		lpGloUsu  =ALLTRIM(NVL(ThisForm.contenedor2.txtGlosa.value,''))
		lpCodopc  =UPPER(ALLTRIM(nvl(ThisForm.ls_s07_cods07,''))) 
		lpCodKey  =ThisForm.ls_ddi_codkey 
		
		IF !ThisForm.Administra_documento.Adjunta_documentos_temporales(lpCodopc,lpFile,lpExt_File,lpGloUsu,lpCodgdo,lpCodKey)
			MESSAGEBOX("No se Adjunto correctamente el archivo: [ "+lpFile+" ]",48,ThisForm.Caption)	
			RETURN 
		ELSE
			MESSAGEBOX("Se Adjunto correctamente el archivo: [ "+lpFile+" ]",64,ThisForm.Caption)	
			ThisForm.Cerrar() 
			RETURN 
		ENDIF 
	ENDPROC

ENDDEFINE

