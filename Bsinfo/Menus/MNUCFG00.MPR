SET SYSMENU TO
SET SYSMENU AUTOMATIC

DEFINE PAD _6u90xc6fu OF _MSYSMENU PROMPT "Maestros" COLOR SCHEME 3 ;
	KEY ALT+M, ""
DEFINE PAD _6u90xc6fv OF _MSYSMENU PROMPT "Parametros" COLOR SCHEME 3 ;
	KEY ALT+P, ""
DEFINE PAD _6u90xc6fw OF _MSYSMENU PROMPT "Reportes" COLOR SCHEME 3 ;
	KEY ALT+R, ""
DEFINE PAD _6u90xc6fx OF _MSYSMENU PROMPT "Procesos" COLOR SCHEME 3 ;
	KEY ALT+P, ""
DEFINE PAD _6u90xc6fy OF _MSYSMENU PROMPT "Configuracion" COLOR SCHEME 3 ;
	KEY ALT+C, ""
DEFINE PAD _6u90xc6fz OF _MSYSMENU PROMPT "Salir" COLOR SCHEME 3 ;
	KEY ALT+S, ""
ON PAD _6u90xc6fu OF _MSYSMENU ACTIVATE POPUP maestros
ON PAD _6u90xc6fv OF _MSYSMENU ACTIVATE POPUP parametros
ON PAD _6u90xc6fw OF _MSYSMENU ACTIVATE POPUP reportes
ON PAD _6u90xc6fx OF _MSYSMENU ACTIVATE POPUP procesos
ON PAD _6u90xc6fy OF _MSYSMENU ACTIVATE POPUP configurac
ON SELECTION PAD _6u90xc6fz OF _MSYSMENU ;
	DO _6u90xc6g0 ;
	IN LOCFILE("MENUS\MNUCFG00" ,"MPX;MPR|FXP;PRG" ,"WHERE is MNUCFG00?")

DEFINE POPUP maestros MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF maestros PROMPT "\<1.-  Accessos y Seguridad" ;
	SKIP FOR NOT HasAccess('AccesosSeguridad')
DEFINE BAR 2 OF maestros PROMPT "\<2.-"
ON SELECTION BAR 1 OF maestros DO FORM adm_accesos_seguridad.scx
ON SELECTION BAR 2 OF maestros wait window 'En implementacion'

DEFINE POPUP parametros MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF parametros PROMPT "\<1" ;
	SKIP FOR NOT HasAccess('CampanasPrograma')
DEFINE BAR 2 OF parametros PROMPT "\<2" ;
	SKIP FOR NOT HasAccess('PoliticasFacturacion')
DEFINE BAR 3 OF parametros PROMPT "\<3" ;
	SKIP FOR NOT HasAccess('EntregablesUnegocio')

DEFINE POPUP reportes MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF reportes PROMPT "\<Reporte 1"
DEFINE BAR 2 OF reportes PROMPT "\<Reporte 2"
ON SELECTION BAR 1 OF reportes wait window 'En implementacion'
ON SELECTION BAR 2 OF reportes wait window 'En implementacion'

DEFINE POPUP procesos MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF procesos PROMPT "Inicializacion base datos" ;
	SKIP FOR NOT HasAccess('ProcesoInterfaces')
ON SELECTION BAR 1 OF procesos do form int_proceso_maestro_2

DEFINE POPUP configurac MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF configurac PROMPT "Cambio clave de acceso" ;
	SKIP FOR NOT HasAccess('CambioClave')
DEFINE BAR 2 OF configurac PROMPT "Configuración de variables generales" ;
	SKIP FOR NOT HasAccess('VariablesGeneralesContabilidad')
ON SELECTION BAR 1 OF configurac do form adm_cambioclave
ON SELECTION BAR 2 OF configurac do adm_admtcnfg


